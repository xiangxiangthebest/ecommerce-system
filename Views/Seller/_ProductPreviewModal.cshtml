<!-- _ProductPreviewModal.cshtml
     Shared partial included by both AddProduct and EditProduct.
     Requires: buildPreviewModal(imgSrcs), groups, escHtml() to be defined in the host page.
-->

<div id="preview-overlay"
     style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:9000;overflow-y:auto;padding:40px 16px;">
    <div id="preview-modal"
         style="max-width:960px;margin:0 auto;background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 24px 64px rgba(0,0,0,0.35);">

        <!-- Header -->
        <div style="background:#1e1b4b;color:#fff;padding:14px 24px;display:flex;justify-content:space-between;align-items:center;">
            <span style="font-weight:700;font-size:13px;letter-spacing:0.08em;text-transform:uppercase;">
                Customer View Preview
            </span>
            <button onclick="closePreview()"
                    style="background:none;border:none;color:#fff;font-size:24px;cursor:pointer;line-height:1;">&times;</button>
        </div>

        <!-- Product body -->
        <div style="display:flex;flex-wrap:wrap;">

            <!-- LEFT: image gallery -->
            <div style="width:420px;min-width:280px;flex-shrink:0;padding:28px;background:#fafafa;display:flex;flex-direction:column;gap:12px;">
                <!-- Large main image -->
                <div style="width:100%;aspect-ratio:1;border:1px solid #eee;border-radius:10px;overflow:hidden;background:#fff;display:flex;align-items:center;justify-content:center;">
                    <img id="pv-main-img" src="" alt=""
                         style="width:100%;height:100%;object-fit:contain;" />
                </div>
                <!-- Thumbnail row -->
                <div id="pv-thumb-row"
                     style="display:flex;gap:8px;flex-wrap:wrap;"></div>
            </div>

            <!-- RIGHT: product details -->
            <div style="flex:1;min-width:260px;padding:28px 28px 28px 20px;">

                <div id="pv-name"
                     style="font-size:18px;font-weight:700;color:#111;margin-bottom:12px;line-height:1.4;"></div>

                <div style="margin-bottom:16px;">
                    <span id="pv-price"
                          style="font-size:28px;font-weight:800;color:#ee4d2d;"></span>
                </div>

                <!-- Info table -->
                <div style="border-top:1px solid #f0f0f0;padding-top:14px;margin-bottom:14px;">
                    <table style="font-size:13px;width:100%;border-collapse:collapse;">
                        <tr>
                            <td style="color:#aaa;padding:5px 0;width:100px;vertical-align:top;">Category</td>
                            <td id="pv-category" style="color:#333;font-weight:600;"></td>
                        </tr>
                        <tr>
                            <td style="color:#aaa;padding:5px 0;vertical-align:top;">SKU</td>
                            <td id="pv-sku" style="color:#333;"></td>
                        </tr>
                        <tr id="pv-stock-row">
                            <td style="color:#aaa;padding:5px 0;vertical-align:top;">Stock</td>
                            <td id="pv-stock" style="color:#333;"></td>
                        </tr>
                    </table>
                </div>

                <!-- Variations -->
                <div id="pv-variations-section" style="display:none;margin-bottom:16px;">
                    <div id="pv-variations-container"></div>
                </div>

                <!-- Mock action buttons -->
                <div style="display:flex;gap:10px;margin-top:20px;">
                    <div style="flex:1;text-align:center;border:1.5px solid #ee4d2d;color:#ee4d2d;
                                padding:11px;border-radius:6px;font-weight:700;font-size:14px;">
                        <i class="fas fa-shopping-cart"></i> Add to Cart
                    </div>
                    <div style="flex:1;text-align:center;background:#ee4d2d;color:#fff;
                                padding:11px;border-radius:6px;font-weight:700;font-size:14px;">
                        Buy Now
                    </div>
                </div>
                <div style="margin-top:10px;font-size:11px;color:#ccc;text-align:center;">
                    Preview only — buttons are not functional
                </div>
            </div>
        </div>

        <!-- Description section -->
        <div style="border-top:8px solid #f5f5f5;padding:24px 28px;">
            <div style="font-size:13px;font-weight:700;color:#222;margin-bottom:10px;text-transform:uppercase;letter-spacing:0.05em;">
                Product Description
            </div>
            <div id="pv-desc-full"
                 style="font-size:14px;color:#444;white-space:pre-wrap;line-height:1.8;"></div>
        </div>
    </div>
</div>

<script>
// ════════════════════════════════════════════════════════════
// SHARED PREVIEW MODAL LOGIC
// Called by openPreview() in the host page
// ════════════════════════════════════════════════════════════

let _pvImgSrcs = [];        // all image srcs in order
let _pvCurrentImg = 0;      // which image is shown large

function buildPreviewModal(imgSrcs) {
    _pvImgSrcs = imgSrcs;
    _pvCurrentImg = 0;

    // ── Main image
    const mainImg = document.getElementById('pv-main-img');
    if (imgSrcs.length > 0) {
        mainImg.src = imgSrcs[0];
        mainImg.style.display = 'block';
    } else {
        mainImg.src = '/images/placeholder.png';
        mainImg.onerror = () => { mainImg.style.display = 'none'; };
    }

    // ── Thumbnail row
    const thumbRow = document.getElementById('pv-thumb-row');
    thumbRow.innerHTML = '';
    imgSrcs.forEach((src, idx) => {
        const t = document.createElement('div');
        t.style.cssText = `width:60px;height:60px;border-radius:6px;overflow:hidden;cursor:pointer;
                           border:2px solid ${idx === 0 ? '#ee4d2d' : '#eee'};flex-shrink:0;`;
        t.id = 'pv-thumb-' + idx;
        t.onclick = () => pvSelectThumb(idx);
        const img = document.createElement('img');
        img.src = src;
        img.style.cssText = 'width:100%;height:100%;object-fit:cover;';
        t.appendChild(img);
        thumbRow.appendChild(t);
    });

    // ── Name
    document.getElementById('pv-name').textContent =
        document.getElementById('field-name')?.value.trim() || '(No name yet)';

    // ── Price
    const price = parseFloat(document.getElementById('field-price')?.value) || 0;
    document.getElementById('pv-price').textContent = 'RM ' + price.toFixed(2);

    // ── Category
    const catEl = document.getElementById('field-category');
    document.getElementById('pv-category').textContent =
        catEl?.options[catEl.selectedIndex]?.text || '—';

    // ── SKU
    document.getElementById('pv-sku').textContent =
        document.querySelector('input[name="SKU"]')?.value.trim() || '—';

    // ── Stock / Variations
    const groupArr = Object.values(groups || {}).filter(g => g.name || g.values?.length);
    if (groupArr.length > 0) {
        document.getElementById('pv-stock-row').style.display = 'none';
        buildVariationPicker(groupArr);
    } else {
        document.getElementById('pv-stock-row').style.display = '';
        const stock = parseInt(document.getElementById('field-stock')?.value) || 0;
        const stockEl = document.getElementById('pv-stock');
        stockEl.textContent = stock > 0 ? stock + ' available' : 'Out of stock';
        stockEl.style.color = stock > 0 ? '#2e7d32' : '#c62828';
        document.getElementById('pv-variations-section').style.display = 'none';
    }

    // ── Description
    document.getElementById('pv-desc-full').textContent =
        document.getElementById('desc-field')?.value.trim() || '(No description)';
}

function pvSelectThumb(idx) {
    _pvCurrentImg = idx;
    document.getElementById('pv-main-img').src = _pvImgSrcs[idx];
    // Update border highlight
    document.querySelectorAll('#pv-thumb-row > div').forEach((el, i) => {
        el.style.border = i === idx ? '2px solid #ee4d2d' : '2px solid #eee';
    });
}

function buildVariationPicker(groupArr) {
    const section   = document.getElementById('pv-variations-section');
    const container = document.getElementById('pv-variations-container');
    container.innerHTML = '';
    section.style.display = 'block';

    groupArr.forEach(g => {
        const row = document.createElement('div');
        row.style.marginBottom = '14px';

        const label = document.createElement('div');
        label.style.cssText = 'font-size:12px;color:#aaa;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:8px;';
        label.textContent = g.name || 'Variation';
        row.appendChild(label);

        const chipWrap = document.createElement('div');
        chipWrap.style.cssText = 'display:flex;flex-wrap:wrap;gap:8px;';

        g.values.forEach((v, vi) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.style.cssText = `display:flex;align-items:center;gap:8px;
                border:1.5px solid #ddd;background:#fff;border-radius:8px;
                padding:6px 14px;font-size:13px;font-weight:600;cursor:pointer;transition:0.15s;`;
            btn.onmouseover = () => { btn.style.borderColor = '#ee4d2d'; btn.style.color = '#ee4d2d'; };
            btn.onmouseout  = () => { btn.style.borderColor = '#ddd';    btn.style.color = '#111'; };

            // If variation has an image, show it as a tiny thumbnail next to the label
            if (v.imageSrc && v.imageSrc !== '') {
                const vImg = document.createElement('img');
                vImg.src = v.imageSrc;
                vImg.style.cssText = 'width:28px;height:28px;object-fit:cover;border-radius:4px;';
                btn.appendChild(vImg);

                // Clicking switches the main product image to this variation image
                btn.onclick = () => {
                    const thumbRow = document.getElementById('pv-thumb-row');
                    // Check if this variation image is already in our list
                    let imgIdx = _pvImgSrcs.indexOf(v.imageSrc);
                    if (imgIdx < 0) {
                        // Temporarily inject at start for preview
                        _pvImgSrcs.unshift(v.imageSrc);
                        imgIdx = 0;
                        // Add a temp thumb
                        const t = document.createElement('div');
                        t.style.cssText = 'width:60px;height:60px;border-radius:6px;overflow:hidden;cursor:pointer;border:2px solid #eee;flex-shrink:0;';
                        t.id = 'pv-thumb-var-' + vi;
                        t.onclick = () => pvSelectThumb(0);
                        const tImg = document.createElement('img');
                        tImg.src = v.imageSrc;
                        tImg.style.cssText = 'width:100%;height:100%;object-fit:cover;';
                        t.appendChild(tImg);
                        thumbRow.prepend(t);
                    }
                    pvSelectThumb(imgIdx);
                    // Highlight this button
                    chipWrap.querySelectorAll('button').forEach(b => {
                        b.style.borderColor = '#ddd';
                        b.style.background  = '#fff';
                        b.style.color       = '#111';
                    });
                    btn.style.borderColor = '#ee4d2d';
                    btn.style.background  = '#fff5f5';
                    btn.style.color       = '#ee4d2d';
                };
            } else {
                btn.onclick = () => {
                    chipWrap.querySelectorAll('button').forEach(b => {
                        b.style.borderColor = '#ddd';
                        b.style.background  = '#fff';
                        b.style.color       = '#111';
                    });
                    btn.style.borderColor = '#ee4d2d';
                    btn.style.background  = '#fff5f5';
                    btn.style.color       = '#ee4d2d';
                };
            }

            const lbl = document.createElement('span');
            lbl.textContent = v.label;
            btn.appendChild(lbl);
            chipWrap.appendChild(btn);
        });

        row.appendChild(chipWrap);
        container.appendChild(row);
    });
}

function closePreview() {
    document.getElementById('preview-overlay').style.display = 'none';
    document.body.style.overflow = '';
    // Reset any temp-injected variation images
    _pvImgSrcs = [];
}

document.getElementById('preview-overlay').addEventListener('click', function(e) {
    if (e.target === this) closePreview();
});
</script>
