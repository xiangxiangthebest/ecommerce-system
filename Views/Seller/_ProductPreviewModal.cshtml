@* Customer Preview Modal — no @model needed, pure HTML + JS *@

<!-- ══ PREVIEW OVERLAY ══ -->
<div id="preview-overlay" style="
    display:none; position:fixed; inset:0; z-index:9999;
    background:rgba(0,0,0,0.55); overflow-y:auto;">

    <div style="
        min-height:100%; display:flex;
        align-items:flex-start; justify-content:center; padding:40px 16px;">

        <div id="preview-modal" style="
            background:#f4f6fb; border-radius:18px; width:100%; max-width:980px;
            padding:32px; position:relative; box-shadow:0 8px 40px rgba(0,0,0,0.18);">

            <!-- Close button -->
            <button onclick="closePreview()" style="
                position:absolute; top:16px; right:18px;
                background:#fff; border:1.5px solid #e0e0e0; border-radius:50%;
                width:36px; height:36px; font-size:18px; cursor:pointer;
                display:flex; align-items:center; justify-content:center;
                color:#555; line-height:1;">✕</button>

            <div style="font-size:12px; font-weight:700; color:#9a98b6; letter-spacing:1px; margin-bottom:18px;">
                CUSTOMER PREVIEW
            </div>

            <div id="preview-body" style="display:flex; gap:32px; flex-wrap:wrap;">

                <!-- Gallery -->
                <div id="preview-gallery" style="flex:0 0 340px; max-width:340px;">
                    <div style="
                        width:100%; aspect-ratio:1/1; border-radius:14px; overflow:hidden;
                        background:#fff; border:1.5px solid #e8eaf6; margin-bottom:12px;">
                        <img id="preview-main-img" src="" alt="preview"
                             style="width:100%; height:100%; object-fit:cover; display:none;" />
                        <div id="preview-img-placeholder" style="
                            width:100%; height:100%; display:flex; align-items:center;
                            justify-content:center; color:#ccc; font-size:14px;">
                            No image uploaded
                        </div>
                    </div>
                    <div id="preview-thumbs" style="display:flex; gap:8px; flex-wrap:wrap;"></div>
                </div>

                <!-- Info -->
                <div style="flex:1; min-width:260px;">

                    <!-- Category + badge -->
                    <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px;">
                        <span id="pv-category" style="
                            font-size:11px; font-weight:700; color:#7c6af7;
                            background:#ede9ff; border-radius:20px; padding:3px 12px;
                            letter-spacing:.5px; text-transform:uppercase;"></span>
                        <span id="pv-stock-badge" style="
                            font-size:11px; font-weight:700; border-radius:20px;
                            padding:3px 12px; letter-spacing:.5px;"></span>
                    </div>

                    <!-- Name -->
                    <div id="pv-name" style="
                        font-size:22px; font-weight:800; color:#1e1b4b; margin-bottom:8px;
                        line-height:1.3;">Product Name</div>

                    <hr style="border:none; border-top:1px solid #e8eaf6; margin:12px 0;" />

                    <!-- Price -->
                    <div id="pv-price-wrapper">
                        <div id="pv-original-price"
                            style="text-decoration:line-through;
                                    color:#9ca3af;
                                    font-size:16px;
                                    display:none;">
                        </div>
                        <div id="pv-price"
                            style="font-size:28px;
                                    font-weight:900;
                                    color:#4f46e5;">
                            RM 0.00
                        </div>
                        <div id="pv-discount"
                            style="color:#ef4444;
                                    font-weight:700;
                                    display:none;">
                        </div>
                    </div>
                    <div style="font-size:12px; color:#9a98b6; margin-bottom:16px;">
                        Price includes SST where applicable
                    </div>

                    <!-- SKU -->
                    <div id="pv-sku" style="font-size:12px; color:#aaa; margin-bottom:12px;"></div>

                    <hr style="border:none; border-top:1px solid #e8eaf6; margin:12px 0;" />

                    <!-- Description -->
                    <div id="pv-desc" style="
                        font-size:14px; color:#5b587d; line-height:1.7; margin-bottom:18px;
                        white-space:pre-wrap;"></div>

                    <!-- Variations -->
                    <div id="pv-variations" style="margin-bottom:18px;"></div>

                    <!-- Stock note -->
                    <div id="pv-stock-note" style="
                        font-size:13px; color:#888; margin-bottom:14px; display:none;"></div>

                    <!-- Qty -->
                    <div style="display:flex; align-items:center; gap:12px; margin-bottom:18px;">
                        <span style="font-size:13px; font-weight:600; color:#5b587d;">Qty</span>
                        <div style="display:flex; align-items:center; border:1.5px solid #e8eaf6; border-radius:8px; overflow:hidden;">
                            <button onclick="pvAdjustQty(-1)" style="
                                width:36px; height:36px; background:#f8f9ff; border:none;
                                font-size:18px; cursor:pointer; color:#1e1b4b;">−</button>
                            <input id="pv-qty" type="number" value="1" min="1" readonly style="
                                width:48px; text-align:center; border:none; font-size:15px;
                                font-weight:700; color:#1e1b4b; background:#fff;" />
                            <button onclick="pvAdjustQty(1)" style="
                                width:36px; height:36px; background:#f8f9ff; border:none;
                                font-size:18px; cursor:pointer; color:#1e1b4b;">+</button>
                        </div>
                        <span id="pv-stock-left" style="font-size:12px; color:#9a98b6;"></span>
                    </div>

                    <!-- Action buttons -->
                    <div style="display:flex; gap:12px; margin-bottom:14px;">
                        <button id="pv-btn-cart" style="
                            flex:1; padding:13px; background:#1e1b4b; color:#fff;
                            border:none; border-radius:10px; font-size:14px;
                            font-weight:700; cursor:pointer;">Add to Cart</button>
                        <button id="pv-btn-buy" style="
                            flex:1; padding:13px; background:#4f46e5; color:#fff;
                            border:none; border-radius:10px; font-size:14px;
                            font-weight:700; cursor:pointer;">Buy Now</button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
// ═══════════════════════════════════════════════════════════
// PREVIEW MODAL
// ═══════════════════════════════════════════════════════════
let _pvCombos      = {};
let _pvGroups      = [];
let _pvSelected    = [];
let _pvTotalGroups = 0;
let _pvProductImgs = [];

function pvSetMainImg(src) {
    const mainImg     = document.getElementById('preview-main-img');
    const placeholder = document.getElementById('preview-img-placeholder');
    if (src) {
        mainImg.src = src;
        mainImg.style.display = 'block';
        placeholder.style.display = 'none';
    } else {
        mainImg.style.display = 'none';
        placeholder.style.display = 'flex';
    }
}

function buildPreviewModal(imgSrcs, groupsArr, combosMap) {
    _pvGroups      = groupsArr || [];
    _pvCombos      = combosMap || {};
    _pvTotalGroups = _pvGroups.length;
    _pvSelected    = new Array(_pvTotalGroups).fill(null);
    _pvProductImgs = imgSrcs || [];

    // ── Gallery thumbnails
    const thumbsDiv = document.getElementById('preview-thumbs');
    pvSetMainImg(_pvProductImgs.length > 0 ? _pvProductImgs[0] : null);

    thumbsDiv.innerHTML = '';
    _pvProductImgs.forEach((src, i) => {
        const t = document.createElement('div');
        t.style.cssText = `width:60px;height:60px;border-radius:8px;overflow:hidden;
            border:2px solid ${i===0?'#4f46e5':'#e8eaf6'};cursor:pointer;flex-shrink:0;`;
        t.innerHTML = `<img src="${src}" style="width:100%;height:100%;object-fit:cover;" />`;
        t.onclick = () => {
            pvSetMainImg(src);
            thumbsDiv.querySelectorAll('div').forEach(d => d.style.borderColor = '#e8eaf6');
            t.style.borderColor = '#4f46e5';
        };
        thumbsDiv.appendChild(t);
    });

    // ── Text fields (read live from the seller form)
    const nameEl = document.getElementById('field-name');
    document.getElementById('pv-name').textContent =
        (nameEl && nameEl.value.trim()) ? nameEl.value.trim() : 'Product Name';

    const selling =
        parseFloat(document.getElementById('field-price')?.value) || 0;

    const original =
        parseFloat(document.getElementById('field-original-price')?.value) || 0;

    document.getElementById('pv-price').textContent =
        'RM ' + selling.toFixed(2);

    const originalEl =
        document.getElementById('pv-original-price');

    const discountEl =
        document.getElementById('pv-discount');

    if (original > selling && original > 0)
    {
        const discount =
            Math.round(((original - selling) / original) * 100);

        originalEl.style.display = 'block';
        discountEl.style.display = 'block';

        originalEl.textContent =
            'RM ' + original.toFixed(2);

        discountEl.textContent =
            '-' + discount + '%';
    }
    else
    {
        originalEl.style.display = 'none';
        discountEl.style.display = 'none';
    }

    const descEl = document.getElementById('desc-field');
    document.getElementById('pv-desc').textContent =
        (descEl && descEl.value.trim()) ? descEl.value.trim() : 'No description provided.';

    const skuEl  = document.querySelector('[name="SKU"]');
    const skuVal = skuEl ? skuEl.value.trim() : '';
    const skuDiv = document.getElementById('pv-sku');
    skuDiv.textContent  = skuVal ? 'SKU: ' + skuVal : '';
    skuDiv.style.display = skuVal ? 'block' : 'none';

    const catEl = document.getElementById('field-category');
    document.getElementById('pv-category').textContent =
        (catEl && catEl.value) ? catEl.value : 'Uncategorised';

    // Reset qty
    const qtyInput = document.getElementById('pv-qty');
    qtyInput.value = 1;
    qtyInput.max   = 999;
    document.getElementById('pv-stock-note').style.display = 'none';

    // ── Variations
    const varDiv = document.getElementById('pv-variations');
    varDiv.innerHTML = '';

    if (_pvTotalGroups > 0) {
        _pvGroups.forEach((grp, gi) => {
            const groupWrap = document.createElement('div');
            groupWrap.style.marginBottom = '14px';

            // Label row: "FLAVOUR: <selected>"
            const labelRow = document.createElement('div');
            labelRow.style.cssText = 'font-size:12px;font-weight:700;color:#5b587d;' +
                'margin-bottom:6px;text-transform:uppercase;letter-spacing:.5px;';
            labelRow.innerHTML = `${grp.name || 'Variation'}: ` +
                `<span id="pv-sel-label-${gi}" style="color:#4f46e5;font-weight:800;"></span>`;
            groupWrap.appendChild(labelRow);

            const optRow = document.createElement('div');
            optRow.style.cssText = 'display:flex;gap:8px;flex-wrap:wrap;';

            grp.options.forEach(opt => {
                const btn = document.createElement('button');
                btn.type = 'button';

                if (opt.imagePath) {
                    // Swatch button with image + label
                    btn.style.cssText = `padding:4px 10px 4px 4px;border:2px solid #e8eaf6;
                        border-radius:8px;background:#fff;cursor:pointer;
                        display:inline-flex;align-items:center;gap:6px;
                        font-size:13px;font-weight:600;color:#1e1b4b;transition:all .15s;`;
                    btn.innerHTML =
                        `<img src="${opt.imagePath}"
                             style="width:32px;height:32px;border-radius:5px;object-fit:cover;" />
                         <span>${opt.label}</span>`;
                } else {
                    // Plain text button
                    btn.style.cssText = `padding:7px 16px;border:1.5px solid #e8eaf6;
                        border-radius:8px;background:#fff;font-size:13px;font-weight:600;
                        color:#1e1b4b;cursor:pointer;transition:all .15s;`;
                    btn.textContent = opt.label;
                }

                btn.onclick = () => {
                    // Deselect all in this group
                    optRow.querySelectorAll('button').forEach(b => {
                        b.style.borderColor = '#e8eaf6';
                        b.style.background  = '#fff';
                        b.style.color       = '#1e1b4b';
                    });
                    // Highlight selected
                    btn.style.borderColor = '#4f46e5';
                    if (opt.imagePath) {
                        btn.style.background = '#eef0ff';
                    } else {
                        btn.style.background = '#4f46e5';
                        btn.style.color      = '#fff';
                    }

                    document.getElementById('pv-sel-label-' + gi).textContent = opt.label;
                    _pvSelected[gi] = opt.label;

                    // Switch main image to this option's image if it has one
                    if (opt.imagePath) {
                        pvSetMainImg(opt.imagePath);
                        // Deselect product gallery thumb highlights
                        document.getElementById('preview-thumbs')
                            .querySelectorAll('div')
                            .forEach(d => d.style.borderColor = '#e8eaf6');
                    }

                    pvUpdateStock();
                };

                optRow.appendChild(btn);
            });

            groupWrap.appendChild(optRow);
            varDiv.appendChild(groupWrap);
        });

        pvSetStockBadge('select-options', 'Select Options');
        document.getElementById('pv-btn-cart').disabled = true;
        document.getElementById('pv-btn-buy').disabled  = true;
        document.getElementById('pv-btn-cart').style.opacity = '0.5';
        document.getElementById('pv-btn-buy').style.opacity  = '0.5';

    } else {
        // No variations — read global stock field
        const stockEl = document.getElementById('field-stock');
        const stock   = stockEl ? parseInt(stockEl.value) || 0 : 0;
        pvSetStockFromNumber(stock);
        qtyInput.max = stock;
        document.getElementById('pv-btn-cart').disabled = stock <= 0;
        document.getElementById('pv-btn-buy').disabled  = stock <= 0;
        document.getElementById('pv-btn-cart').style.opacity = stock > 0 ? '1' : '0.5';
        document.getElementById('pv-btn-buy').style.opacity  = stock > 0 ? '1' : '0.5';
    }
}

function pvUpdateStock() {
    const allSelected = _pvSelected.every(k => k !== null);
    if (!allSelected) {
        pvSetStockBadge('select-options', 'Select Options');
        document.getElementById('pv-stock-note').style.display = 'none';
        document.getElementById('pv-btn-cart').disabled = true;
        document.getElementById('pv-btn-buy').disabled  = true;
        document.getElementById('pv-btn-cart').style.opacity = '0.5';
        document.getElementById('pv-btn-buy').style.opacity  = '0.5';
        return;
    }

    // Key matches seller form: labels joined by "|"
    const key   = _pvSelected.join('|');
    const stock = _pvCombos[key] ?? 0;
    pvSetStockFromNumber(stock);

    const note = document.getElementById('pv-stock-note');
    note.textContent   = stock > 0 ? stock + ' left for this option' : 'This combination is out of stock';
    note.style.display = 'block';

    const qtyInput = document.getElementById('pv-qty');
    qtyInput.max = stock;
    if (parseInt(qtyInput.value) > stock) qtyInput.value = Math.max(1, stock);

    document.getElementById('pv-btn-cart').disabled = stock <= 0;
    document.getElementById('pv-btn-buy').disabled  = stock <= 0;
    document.getElementById('pv-btn-cart').style.opacity = stock > 0 ? '1' : '0.5';
    document.getElementById('pv-btn-buy').style.opacity  = stock > 0 ? '1' : '0.5';
}

function pvSetStockFromNumber(stock) {
    if (stock <= 0)      pvSetStockBadge('out-of-stock',  'Out of Stock');
    else if (stock <= 5) pvSetStockBadge('low-stock',     'Low Stock');
    else                 pvSetStockBadge('in-stock',      'In Stock');

    document.getElementById('pv-stock-left').textContent = stock > 0 ? stock + ' left' : '';
}

function pvSetStockBadge(type, label) {
    const b = document.getElementById('pv-stock-badge');
    b.textContent = label;
    const styles = {
        'in-stock':       'background:#e6f4ea;color:#2e7d32;',
        'low-stock':      'background:#fff8e1;color:#f57c00;',
        'out-of-stock':   'background:#fdecea;color:#c62828;',
        'select-options': 'background:#f0f0f0;color:#777;',
    };
    b.style.cssText = `font-size:11px;font-weight:700;border-radius:20px;
        padding:3px 12px;letter-spacing:.5px;${styles[type]||''}`;
}

function pvAdjustQty(delta) {
    const input = document.getElementById('pv-qty');
    const max   = parseInt(input.max) || 999;
    input.value = Math.min(max, Math.max(1, parseInt(input.value || 1) + delta));
}

function closePreview() {
    document.getElementById('preview-overlay').style.display = 'none';
    document.body.style.overflow = '';
}

// Close when clicking the dark backdrop
document.getElementById('preview-overlay').addEventListener('click', function(e) {
    if (e.target === this) closePreview();
});
</script>
