@model EcommerceSystem.Models.ChatRoom
@using System.Security.Claims

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

@{
    var currentUserId = int.Parse(User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "0");

    // Seller 视角：对方永远是 Customer
    var chatPartnerName = Model.Seller?.ShopName ?? "Seller"; 
    var firstChar = !string.IsNullOrEmpty(chatPartnerName) ? chatPartnerName[0].ToString().ToUpper() : "C";
}

<div class="container mt-3">
    <div class="card shadow-sm border-0">
        
        <!-- HEADER -->
        <div class="card-header bg-white border-bottom p-3 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">

                <!-- Back to Seller Inbox -->
                <a asp-controller="Chat" asp-action="SellerInbox" class="btn btn-link text-dark p-0 me-3">
                    <i class="bi bi-arrow-left fs-4"></i>
                </a>

                <!-- Avatar -->
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3"
                     style="width: 45px; height: 45px;">
                    <span class="fw-bold">@firstChar</span>
                </div>

                <div class="text-truncate">
                    <h6 class="mb-0 fw-bold text-dark">@chatPartnerName</h6>
                </div>

            </div>
        </div>

        <!-- BODY -->
        <div class="card-body p-0 bg-light" style="height: 500px; display: flex; flex-direction: column;">

            <div id="messageBody" class="p-3 flex-grow-1 overflow-auto"
                 style="display:flex; flex-direction:column; gap:15px;">

                @if (Model.Messages != null && Model.Messages.Any())
                {
                    @foreach (var msg in Model.Messages.OrderBy(m => m.SentAt))
                    {
                        var isMe = msg.SenderId == currentUserId;

                        <div style="display:flex; flex-direction:column;
                                    align-items:@(isMe ? "flex-end" : "flex-start");
                                    max-width:80%; align-self:@(isMe ? "flex-end" : "flex-start");">

                            @if (msg.MessageText != null && msg.MessageText.StartsWith("[IMAGE_CARD]"))
                            {
                                var cleanHtml = msg.MessageText.Replace("[IMAGE_CARD]", "");
                                @Html.Raw(cleanHtml)
                            }
                            else if (msg.MessageText != null && msg.MessageText.StartsWith("[ORDER_TAG]"))
                            {
                                var parts = msg.MessageText.Split('|');
                                var orderId = parts.Length > 1 ? parts[1] : "0";
                                var totalPrice = parts.Length > 2 ? parts[2] : "0.00";
                                var orderImg = parts.Length > 3 ? parts[3] : "/images/default-order.png";

                                <div class="p-2 bg-white rounded shadow-sm border text-start" style="max-width:250px;">
                                    <div class="d-flex align-items-center mb-2">
                                        <img src="@orderImg" class="rounded me-2 border"
                                             style="width:45px;height:45px;object-fit:cover;" />

                                        <div>
                                            <span class="d-block fw-bold small">📋 Order</span>
                                            <span class="text-danger fw-bold small">RM @totalPrice</span>
                                        </div>
                                    </div>

                                    <hr class="my-1" style="opacity:0.15;" />

                                    <div class="text-center">
                                        <a href="/Order/Details/@orderId"
                                           class="text-primary text-decoration-none fw-bold small">
                                            View Order
                                        </a>
                                    </div>
                                </div>
                            }
                            else if (msg.MessageText != null && msg.MessageText.StartsWith("[PRODUCT_CARD]"))
                            {
                                var cleanHtml = msg.MessageText.Replace("[PRODUCT_CARD]", "");
                                @Html.Raw(cleanHtml)
                            }
                               else if (msg.MessageText != null && msg.MessageText.StartsWith("[IMAGE_CARD]"))
                                {
                                    var cleanImgHtml = msg.MessageText.Replace("[IMAGE_CARD]", "");
                                    // 💡 包装一层点击事件，点击时提取内部 img 的 src 并塞给预览模态框
                                    <div class="image-bubble cursor-pointer" onclick="previewChatImage(this)">
                                        @Html.Raw(cleanImgHtml)
                                    </div>
                                }
                            else
                            {
                                <div class="p-3 rounded-3 shadow-sm @(isMe ? "bg-primary text-white" : "bg-white text-dark border")"
                                     style="word-break:break-word; font-size:14px;
                                            border-radius:@(isMe ? "16px 16px 2px 16px" : "16px 16px 16px 2px") !important;">
                                    @msg.MessageText
                                </div>
                            }

                            <small class="text-muted mt-1 px-1" style="font-size:10px;">
                                @msg.SentAt.ToString("HH:mm")
                            </small>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted my-auto">
                        <i class="bi bi-chat-dots fs-1 opacity-25 d-block mb-2"></i>
                        <span class="small">No messages yet. Reply to customer to start conversation.</span>
                    </div>
                }

            </div>

            <!-- FOOTER -->
            <div class="card-footer bg-white border-top p-3">

                @if (ViewBag.IsOrderInitiated == true && ViewBag.InitiatedOrder != null)
                {
                    var initOrder = ViewBag.InitiatedOrder as EcommerceSystem.Models.Order;
                    if (initOrder != null)
                    {
                        var orderCoverImg = initOrder.OrderItems?.FirstOrDefault()?.Product?.ImagePath ?? "/images/default-order.png";

                        <div class="d-flex align-items-center justify-content-between p-3 mb-3 rounded border"
                             style="background:#fff8e1; border-color:#ffe082;" id="orderInitiateBox">

                        <div class="d-flex align-items-center">
                            <img src="@orderCoverImg" class="rounded me-2 border"
                                 style="width:50px;height:50px;object-fit:cover;" />

                            <div>
                                <span class="fw-bold small d-block">Send order information to customer?</span>
                                <span class="text-muted small">
                                    Order #@initOrder.OrderId |
                                    <span class="text-danger fw-bold">RM @initOrder.TotalAmount.ToString("F2")</span>
                                </span>
                            </div>
                        </div>

                        <div>
                            <button type="button" class="btn btn-warning btn-sm fw-bold"
                                    onclick="sendCustomCard('ORDER','','@initOrder.OrderId','@initOrder.TotalAmount.ToString("F2")','@orderCoverImg');
                                             document.getElementById('orderInitiateBox')?.remove();">
                                Send
                            </button>

                            <button type="button" class="btn-close ms-2"
                                    onclick="document.getElementById('orderInitiateBox').remove()"></button>
                        </div>
                    </div>
                }
                }

                <form id="chatForm"
                      asp-controller="Chat"
                      asp-action="SendMessage"
                      method="post"
                      class="d-flex align-items-center"
                      onsubmit="return handleFormSubmit(event)">

                    <input type="hidden" name="chatRoomId" value="@Model.ChatRoomId" />
                    <input type="hidden" name="customerId" value="@Model.CustomerId" />

                    <input type="file"
                    id="photoFileInput"
                    accept="image/*"
                    class="d-none" />

                    <button type="button"
                            class="btn btn-light border"
                            onclick="document.getElementById('photoFileInput').click()">
                        <i class="bi bi-image"></i>
                    </button>

                    <input type="text"
                           id="messageInput"
                           name="messageText"
                           class="form-control rounded-pill me-2"
                           placeholder="Reply to customer..."
                           required />

                    <button type="submit" class="btn btn-primary rounded-circle"
                            style="width:40px;height:40px;">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </form>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-body p-0 text-center position-relative">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                <img id="previewModalImage" src="" class="img-fluid rounded shadow" style="max-height: 85vh; object-fit: contain;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var messageBody = document.getElementById("messageBody");
        if (messageBody) messageBody.scrollTop = messageBody.scrollHeight;

        initImageUpload();
    });

    async function handleFormSubmit(event) {
        event.preventDefault();

        var input = document.getElementById("messageInput");
        if (!input.value.trim()) return false;

        var ready = await ensureChatRoomActivated();
        if (ready) document.getElementById("chatForm").submit();

        return false;
    }

    async function sendCustomCard(type, title, id, price, img) {
        var input = document.getElementById("messageInput");

        var ready = await ensureChatRoomActivated();
        if (!ready) return;

        if (type === 'ORDER') {
            input.value = "[ORDER_TAG]|" + id + "|" + price + "|" + img;
        }

        input.removeAttribute("required");
        document.getElementById("chatForm").submit();
    }

    async function ensureChatRoomActivated() {
        var roomIdInput = document.querySelector('input[name="chatRoomId"]');

        if (roomIdInput && roomIdInput.value === "0") {
            var customerId = "@Model.CustomerId";

            const res = await fetch('/Chat/CreateChatRoom', {
                method: 'POST',
                headers: {'Content-Type':'application/x-www-form-urlencoded'},
                body: new URLSearchParams({ customerId: customerId })
            });

            if (res.ok) {
                const data = await res.json();
                roomIdInput.value = data.chatRoomId;
                return true;
            }

            alert("Failed to start conversation with customer.");
            return false;
        }

        return true;
    }

    function initImageUpload() {
        var fileInput = document.getElementById("imageFileInput");

        fileInput.addEventListener("change", async function () {
            if (!fileInput.files.length) return;

            var file = fileInput.files[0];

            if (!file.type.startsWith("image/")) {
                alert("Invalid image file");
                return;
            }

            var ready = await ensureChatRoomActivated();
            if (!ready) return;

            var reader = new FileReader();
            reader.onload = function (e) {
                var input = document.getElementById("messageInput");
                var form = document.getElementById("chatForm");

                input.value = "[IMAGE_CARD]<div><img src='" + e.target.result + "' style='max-width:200px;border-radius:8px'/></div>";

                input.removeAttribute("required");
                form.submit();
            };

            reader.readAsDataURL(file);
        });
    }

    function previewChatImage(element) {
        // 找到当前气泡里的 img 标签
        var img = element.querySelector('img');
        if (img) {
            var src = img.getAttribute('src');
            // 将大图模态框的 src 替换为当前图片的路径
            document.getElementById('previewModalImage').src = src;
            
            // 弹出 Bootstrap 模态框
            var myModal = new bootstrap.Modal(document.getElementById('imagePreviewModal'));
            myModal.show();
        }
    }

    var attachPhotoBtn = document.getElementById("attachPhotoBtn");
    var photoFileInput = document.getElementById("photoFileInput");

if (photoFileInput) {
    photoFileInput.addEventListener("change", function () {
        var file = this.files[0];
        if (!file) return;

        if (!file.type.startsWith("image/")) {
            alert("Please select an image");
            return;
        }

        if (file.size > 5 * 1024 * 1024) {
            alert("Image too large");
            return;
        }

        var reader = new FileReader();
        reader.onload = function (e) {
            var input = document.getElementById("messageInput");
            var form = document.getElementById("chatForm");

            input.value =
                "[IMAGE_CARD]<div class='p-1 bg-white rounded shadow-sm border text-center'>" +
                "<img src='" + e.target.result + "' style='max-width:200px;border-radius:8px'/>" +
                "</div>";

            input.removeAttribute("required");
            form.submit();
        };

        reader.readAsDataURL(file);
    });
}
</script>
}