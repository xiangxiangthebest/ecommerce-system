@{
    ViewData["Title"] = "Seller Dashboard";
}

<!-- Link to your full-page dashboard styles -->
<link rel="stylesheet" href="~/css/seller/dashboard.css" />
<!-- Ensure FontAwesome is included for the search icon -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<div class="dashboard-wrapper">
    <!-- ── Sidebar ── -->
    <nav class="sidebar">
        <div class="sidebar-header">
            @* Displays your shop name from the database *@
            <h3 class="shop-title">@ViewBag.ShopName</h3>
        </div>
        
        <ul class="nav-links">
            <li class="@(ViewBag.ActiveTab == "General" ? "active" : "")">
                <a href="@Url.Action("Index", "Seller", new { tab = "General" })">
                    <span class="nav-text">General</span>
                </a>
            </li>
            <li class="@(ViewBag.ActiveTab == "Product" ? "active" : "")">
                <a href="@Url.Action("Index", "Seller", new { tab = "Product" })">
                    <span class="nav-text">Product</span>
                </a>
            </li>
            <li class="@(ViewBag.ActiveTab == "Order" ? "active" : "")">
                <a href="@Url.Action("Index", "Seller", new { tab = "Order" })">
                    <span class="nav-text">Order</span>
                </a>
            </li>
            <li class="@(ViewBag.ActiveTab == "Order" ? "active" : "")">
                <a href="@Url.Action("Index", "Seller", new { tab = "Chat" })">
                    <span class="nav-text">Chat</span>
                </a>
            </li>
        </ul>

        <div class="sidebar-footer">
            <form asp-controller="Auth" asp-action="Logout" method="post">
                <button type="submit" class="logout-link">Logout</button>
            </form>
        </div>
    </nav>

    <!-- ── Main Content Area ── -->
    <main class="content-area">
        @if (ViewBag.ActiveTab == "Product")
        {
            <!-- ── Product Management View ── -->
            <div class="product-header">
                <h2 class="section-title">Your Product</h2>
                <div class="header-actions">
                    <div class="search-box">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" placeholder="Search Product...." />
                    </div>
                    @* Button now links to the AddProduct page *@
                    <a href="@Url.Action("AddProduct", "Seller")" class="btn-add-product">+ Add New Product</a>
                </div>
            </div>

            <div class="product-grid">
                @* Logic to only show boxes if products exist in database *@
                @if (ViewBag.Products != null && ((List<EcommerceSystem.Models.Product>)ViewBag.Products).Any())
                {
                    foreach (var item in (List<EcommerceSystem.Models.Product>)ViewBag.Products)
                    {
                        <div class="product-card">
                            <div class="product-image-placeholder">
                                <img src="@item.ImagePath" alt="Product" />
                            </div>
                            <div class="product-info">
                                <h3 class="product-name">@item.Name</h3>
                                <div class="price-row">
                                        <span class="current-price">RM @item.Price.ToString("F2")</span>
                                    </div>
                                <p class="sub-text">@item.Description</p>

                            <div class="product-actions">
                <form asp-action="DeleteProduct" asp-route-id="@item.ProductId" method="post" onsubmit="return confirm('Delete this product?');">
                    <button type="submit" class="btn-delete-small">Delete</button>
                </form>
            </div>
        </div>
    </div>
                        }
                }
                else
                {
                    @* Empty state when no products have been created yet *@
                    <div class="empty-state-full-width">
                        <p>No products created yet. Click "+ Add New Product" to start.</p>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- ── General/Welcome View ── -->
            <div class="details-container">
                <h1 class="welcome-text">Welcome Back, @ViewBag.ShopName!</h1>
                <div class="separator"></div>
                <p class="sub-text">Use the sidebar to manage your products and monitor your orders in real-time.</p>
            </div>
        }
    </main>
</div>