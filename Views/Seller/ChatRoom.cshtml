@model EcommerceSystem.Models.ChatRoom
@using System.Security.Claims

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

@{
    var currentUserId = int.Parse(User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "0");
}

<div class="container mt-3">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom p-3 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <a asp-controller="Chat" asp-action="CustomerInbox" class="btn btn-link text-dark p-0 me-3">
                    <i class="bi bi-arrow-left fs-4"></i>
                </a>
                
                @{
                    var CustomerName = Model.Customer?.FullName ?? "Customer"; 
                    var firstChar = !string.IsNullOrEmpty(CustomerName) ? CustomerName[0].ToString().ToUpper() : "C";
                }

                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px; min-width: 45px;">
                    <span class="fw-bold">@firstChar</span>
                </div>

                <div class="text-truncate">
                    <h6 class="mb-0 fw-bold text-dark">@CustomerName</h6>
                </div>
            </div>
        </div>

<div class="card-body bg-light" id="messageBody" style="height: 500px; overflow-y: auto; padding: 20px;">
    @foreach (var msg in Model.Messages.OrderBy(m => m.SentAt))
    {
        var isMyMessage = msg.SenderId == currentUserId;
        <div class="d-flex @(isMyMessage ? "justify-content-end" : "justify-content-start") mb-3">
            <div class="max-w-75">
                
@if (msg.MessageText != null && msg.MessageText.StartsWith("[PRODUCT_CARD]"))
{
    var cleanHtml = msg.MessageText.Replace("[PRODUCT_CARD]", "");

    <div class="product-card-bubble js-product-card-bubble">
        @Html.Raw(cleanHtml)
    </div>
}
else if (msg.MessageText != null && msg.MessageText.StartsWith("[ORDER_TAG]"))
{
    var parts = msg.MessageText.Split('|');
    var orderId = parts.Length > 1 ? parts[1] : "0";
    var totalPrice = parts.Length > 2 ? parts[2] : "0.00";
    var orderImg = parts.Length > 3 ? parts[3] : "/images/default-product.jpg";
    var coverName = parts.Length > 4 ? parts[4] : "Order Items";

    <div class="product-card-bubble my-2 js-order-card" data-order-id="@orderId">
        <a href="/Customer/OrderDetails/@orderId"
           class="d-block text-decoration-none bg-white p-2 rounded shadow-sm border border-warning-subtle"
           style="max-width:260px; transition: 0.2s; border-radius: 8px;">

            <div class="p-1">
                <div class="text-muted border-bottom pb-1 mb-2 small d-flex justify-content-between" style="font-size:11px;">
                    <span class="fw-bold text-dark">📋 Order ID: #@orderId</span>
                    <span class="text-success fw-bold">
                        Track Order <i class="bi bi-chevron-right"></i>
                    </span>
                </div>

                <div class="d-flex align-items-center mb-1">
                    <img src="@orderImg" 
                         class="rounded border me-2" 
                         style="width: 50px; height: 50px; object-fit: cover;" 
                         onerror="this.src='/images/default-product.jpg'" />
                    <div class="flex-grow-1" style="min-width: 0;">
                        <b class="text-dark small text-truncate d-block" style="font-size:12px;">#@orderId</b>
                        <div class="text-muted small text-truncate" style="font-size:11px;">@coverName</div>
                        <div class="text-danger fw-bold small mt-1">RM @totalPrice</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
}
else if (msg.MessageText != null && msg.MessageText.StartsWith("[IMAGE_CARD]"))
{
    var cleanImgHtml = msg.MessageText.Replace("[IMAGE_CARD]", "");

<div class="image-bubble" style="cursor:pointer; display:inline-block;">
    @Html.Raw(cleanImgHtml)
</div>
}
else if (msg.MessageText != null)
{
    <div class="p-3 rounded-3 shadow-sm @(isMyMessage ? "bg-primary text-white" : "bg-white text-dark")"
         style="word-break:break-word;">

        @msg.MessageText

    </div>
}

                
                <small class="text-muted d-block mt-1 @(isMyMessage ? "text-end" : "text-start")" style="font-size: 11px;">
                    @msg.SentAt.ToLocalTime().ToString("HH:mm")
                </small>
            </div>
        </div>
    }
</div>

<div class="card-footer bg-white border-top p-3">
    
    @if (ViewBag.ChatProduct != null)
    {
        var prod = ViewBag.ChatProduct as EcommerceSystem.Models.Product;
        <div class="product-mini-card d-flex align-items-center justify-content-between p-2 mb-3 bg-light rounded border border-info-subtle shadow-sm">
            <div class="d-flex align-items-center text-truncate me-2">
                <img src="@prod.ImagePath" alt="product" class="rounded me-2 border bg-white" style="width: 50px; height: 50px; object-fit: cover;" />
                <div class="text-truncate">
                    <span class="d-block text-dark fw-bold small text-truncate" style="max-width: 250px;">@prod.Name</span>
                    <span class="text-danger fw-bold small">RM @prod.Price</span>
                </div>
            </div>
            <div>
                <button type="button" class="btn btn-info btn-sm text-white px-3 rounded-pill fw-bold" id="sendProductLinkBtn">
                    Send
                </button>
            </div>
        </div>
    }

    <div class="d-flex align-items-center gap-2">
        
        <button class="btn btn-light border px-3 text-primary d-flex align-items-center justify-content-center" type="button" 
        onclick="var p = document.getElementById('myAttachPanel'); if(p) p.classList.toggle('d-none');" 
        style="height: 38px; width: 45px; border-radius: 6px; font-weight: bold; font-size: 20px;" title="更多功能">
    ＋
</button>

        <form asp-action="SellerSendMessage" asp-controller="Chat" method="post" id="chatForm" class="input-group m-0 flex-grow-1">
            <input type="hidden" name="chatRoomId" value="@Model.ChatRoomId" />
            <input type="hidden" name="sellerId" value="@Model.SellerId" />
            
            <input type="text" name="message" id="messageInput" autocomplete="off" 
                   class="form-control bg-light" placeholder="Type your message..." required style="height: 38px;" />
                   
            <button class="btn btn-primary px-4" type="submit" id="sendBtn">
                <i class="bi bi-send-fill"></i> Send
            </button>
        </form>
    </div>

    <div class="attach-panel d-none mt-3 p-3 bg-light rounded border border-light-subtle shadow-inner" id="myAttachPanel">
        <div class="row g-3 text-center">
            <div class="col-4">
                <div class="attach-item p-3 bg-white rounded border cursor-pointer" id="attachPhotoBtn">
                    <i class="bi bi-image fs-2 text-success"></i>
                    <span class="d-block small text-muted mt-1">Send image</span>
                </div>
                <input type="file" id="photoFileInput" accept="image/*" class="d-none" />
            </div>
            
            <div class="col-4">
                <div class="attach-item p-3 bg-white rounded border cursor-pointer" data-bs-toggle="modal" data-bs-target="#sellerProductsModal">
                    <i class="bi bi-bag-heart fs-2 text-warning"></i>
                    <span class="d-block small text-muted mt-1">Send Product</span>
                </div>
            </div>
            
            <div class="col-4">
                <div class="attach-item p-3 bg-white rounded border cursor-pointer" data-bs-toggle="modal" data-bs-target="#customerOrdersModal">
                    <i class="bi bi-receipt fs-2 text-info"></i>
                    <span class="d-block small text-muted mt-1">Send Order</span>
                </div>
            </div>
        </div>
    </div>
</div>
    </div>
</div>

<div class="modal fade" id="sellerProductsModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="false">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold"><i class="bi bi-bag"></i>Store products</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-2" id="sellerProductsContainer">
                <div class="text-center py-4 text-muted small">Loading store products...</div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="customerOrdersModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="false">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold"><i class="bi bi-receipt"></i>Select related order</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-2" id="customerOrdersContainer">
                <div class="text-center py-4 text-muted small">Loading your order history...</div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="false">
    <div class="modal-dialog modal-dialog-centered modal-lg" style="max-width: 90vw;">
        <div class="modal-content border-0" style="background: rgba(0,0,0,0.85);">
            <div class="modal-body p-2 text-center position-relative">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-2" 
                        data-bs-dismiss="modal" aria-label="Close"></button>
                <img id="previewModalImage" src="" class="img-fluid rounded" 
                     style="max-height: 85vh; object-fit: contain;" />
            </div>
        </div>
    </div>
</div>

<style>
    .image-bubble img {
    max-width: 100%;
    height: auto;
    display: block;
    pointer-events: none;
}

    .max-w-75 { max-width: 75%; }
    #messageBody::-webkit-scrollbar { width: 6px; }
    #messageBody::-webkit-scrollbar-track { background: transparent; }
    #messageBody::-webkit-scrollbar-thumb { background: #ced4da; border-radius: 10px; }
    
    .product-card-bubble a:hover {
        transform: scale(1.02);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
        border-color: #0dcaf0 !important;
    }

    .attach-item {
        transition: all 0.2s ease-in-out;
        cursor: pointer;
    }
    .attach-item:hover {
        background-color: #f8f9fa !important;
        border-color: #0d6efd !important;
        transform: translateY(-2px);
    }
    .cursor-pointer { cursor: pointer; }
    
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        
        var messageBody = document.getElementById("messageBody");
        if (messageBody) {
            messageBody.scrollTop = messageBody.scrollHeight;

            messageBody.addEventListener("click", function (e) {
                var bubble = e.target.closest(".image-bubble");
                if (!bubble) return;

                var img = bubble.querySelector("img");
                if (!img) return;

                document.getElementById("previewModalImage").src = img.src;
                bootstrap.Modal.getOrCreateInstance(
                    document.getElementById("imagePreviewModal"),
                    { backdrop: false }
                ).show();
            });
        }

        var sellerId = "@Model.SellerId";
        var chatRoomId = "@Model.ChatRoomId";
        var customerId = "@Model.CustomerId";

        var sellerProductsModal = document.getElementById('sellerProductsModal');
        if (sellerProductsModal) {
            sellerProductsModal.addEventListener('show.bs.modal', function () {
                var container = document.getElementById("sellerProductsContainer");
                fetch(`/Chat/GetSellerProducts?sellerId=${sellerId}`)
                    .then(response => response.json())
                    .then(data => {
                        if(data.length === 0){
                            container.innerHTML = '<div class="text-center py-3 text-muted">This seller has not listed any other products yet.</div>';
                            return;
                        }
                        let html = '<div class="list-group list-group-flush" style="max-height: 400px; overflow-y: auto;">';
                        data.forEach(p => {
                            html += `
                                <div class="list-group-item d-flex align-items-center justify-content-between p-2 cursor-pointer border-bottom" onclick="sendCustomCard('PRODUCT','${encodeURIComponent(p.name)}','${p.productId}','${p.price}','${p.imagePath}')">
                                    <div class="d-flex align-items-center text-truncate me-2">
                                        <img src="${p.imagePath}" class="rounded border me-2" style="width:40px;height:40px;object-fit:cover;"/>
                                        <div class="text-truncate" style="font-size:13px;">
                                            <b class="d-block text-dark text-truncate" style="max-width:240px;">${p.name}</b>
                                            <span class="text-danger">RM ${p.price}</span>
                                        </div>
                                    </div>
                                    <button class="btn btn-primary btn-sm rounded-pill px-3" style="font-size:11px;">Send</button>
                                </div>`;
                        });
                        html += '</div>';
                        container.innerHTML = html;
                    }).catch(() => {
                        container.innerHTML = '<div class="text-center py-3 text-danger">Failed to load products.</div>';
                    });
            });
        }

        var customerOrdersModal = document.getElementById('customerOrdersModal');
        if (customerOrdersModal) {
            customerOrdersModal.addEventListener('show.bs.modal', function () {
                var container = document.getElementById("customerOrdersContainer");
                fetch(`/Chat/SellerGetTheCustomerOrders?customerId=${customerId}`)
                    .then(response => response.json())
                    .then(data => {
                        if(data.length === 0){
                            container.innerHTML = '<div class="text-center py-3 text-muted">No order records related to this seller.</div>';
                            return;
                        }
                        let html = '<div class="list-group list-group-flush" style="max-height: 400px; overflow-y: auto;">';
                        data.forEach(o => {
                            html += `
                                <div class="list-group-item d-flex align-items-center justify-content-between p-2 border-bottom">
                                    <div class="d-flex align-items-center text-truncate me-2" style="flex-grow:1;">
                                        <img src="${o.coverImage || '/images/default-order.png'}" class="rounded border me-2" style="width:45px;height:45px;object-fit:cover;"/>
                                        <div class="text-truncate" style="font-size:12px; line-height:1.3;">
                                            <b class="text-dark d-block">Order Id: #${o.orderId}</b>
                                            <span class="text-muted d-block text-truncate" style="max-width:200px;">${o.coverName}</span>
                                            <span class="text-danger fw-bold">RM ${o.totalAmount}</span>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-info text-white btn-sm rounded-pill py-1 px-3" style="font-size:11px;" 
                                            onclick="sendCustomCard('ORDER', '', '${o.orderId}', '${o.totalAmount}', '${o.coverImage || ''}')">
                                        Send
                                    </button>
                                </div>`;
                        });
                        html += '</div>';
                        container.innerHTML = html;
                    }).catch(() => {
                        container.innerHTML = '<div class="text-center py-3 text-danger">Failed to load orders.</div>';
                    });
            });
        }

        var sendProductBtn = document.getElementById("sendProductLinkBtn");
        if (sendProductBtn) {
            sendProductBtn.addEventListener("click", function () {
                sendCustomCard('PRODUCT', 
                    `@Html.Raw(ViewBag.ChatProduct != null ? (ViewBag.ChatProduct as EcommerceSystem.Models.Product).Name : "")`,
                    `@ViewBag.ChatProduct?.ProductId`, 
                    `@ViewBag.ChatProduct?.Price`, 
                    `@ViewBag.ChatProduct?.ImagePath`);
            });
        }
    });

    function sendCustomCard(type, title, id, price, img) {
        var input = document.getElementById("messageInput");
        var form = document.getElementById("chatForm");
        
  if (type === 'PRODUCT') {
    var cleanTitle = title.replace(/'/g, "").replace(/"/g, "").replace(/\r/g, "").replace(/\n/g, "").trim();
    var cleanImg = img || "/images/default-product.jpg";
    var cleanPrice = parseFloat(price).toFixed(2) || "0.00";
    var targetProductId = id || "0"; 

    var standardUrl = "/Customer/ProductDetails/" + targetProductId; 

    input.value =
        "[PRODUCT_CARD]" +
        "<a href='" + standardUrl + "' " +
        "class='d-block text-decoration-none bg-white p-2 rounded shadow-sm border border-info-subtle' " +
        "style='max-width:260px; transition:0.2s; text-align: left;'>" +
        "  <div class='p-1'>" +
        "    <div class='text-muted border-bottom pb-1 mb-2 small d-flex justify-content-between' style='font-size:11px;'>" +
        "      <span>Products</span>" +
        "      <span class='text-primary fw-bold'>Click to view</span>" +
        "    </div>" +
        "    <div class='d-flex align-items-center mb-2'>" +
        "      <img src='" + cleanImg + "' class='rounded border me-2' style='width:55px; height:55px; object-fit:cover;' onerror=\"this.src='/images/default-product.jpg'\" />" +
        "      <div class='flex-grow-1' style='min-width: 0; line-height:1.2;'>" +
        "        " +
        "        <span class='d-block fw-bold text-dark text-truncate js-product-title' style='font-size:12px;'>" + cleanTitle + "</span>" +
        "        <small class='text-muted d-block text-truncate' style='font-size:11px;'>Go to product page</small>" +
        "      </div>" +
        "    </div>" +
        "    <div class='text-dark small d-flex justify-content-between align-items-center border-top pt-1 mt-1' style='font-size:12px;'>" +
        "      <span>Price: <b class='text-danger'>RM " + cleanPrice + "</b></span>" +
        "      <span class='text-primary' style='font-size:11px;'>View <i class='bi bi-chevron-right'></i></span>" +
        "    </div>" +
        "  </div>" +
        "</a>";
}
        else if(type === 'ORDER') {
            input.value = "[ORDER_TAG]|" + id + "|" + price + "|" + img;
        }
    
        input.removeAttribute("required");
        form.submit();
    }

        var attachPhotoBtn = document.getElementById("attachPhotoBtn");
        var photoFileInput = document.getElementById("photoFileInput");

        if (attachPhotoBtn && photoFileInput) {
            attachPhotoBtn.addEventListener("click", function () {
                photoFileInput.click();
            });

            photoFileInput.addEventListener("change", function () {
                var file = this.files[0];
                if (!file) return;

                if (!file.type.startsWith("image/")) {
                    alert("请选择有效的图片文件！");
                    return;
                }
                if (file.size > 5 * 1024 * 1024) {
                    alert("图片太大了，请上传 5MB 以内的图片");
                    return;
                }

                var reader = new FileReader();
                reader.onload = function (e) {
                    var base64Data = e.target.result;
                    
                    var input = document.getElementById("messageInput");
                    var form = document.getElementById("chatForm");
                    
                    if (input && form) {
                        input.value = "[IMAGE_CARD]<div class='p-1 bg-white rounded shadow-sm border text-center' style='max-width: 200px;'>\n" +
                            "  <img src='" + base64Data + "' class='img-fluid rounded' style='max-height: 200px; object-fit: contain;' />\n" +
                            "</div>";

                        input.removeAttribute("required");
                        form.submit();
                    }
                };
                reader.readAsDataURL(file);
            });
        }
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {
    @if (User.HasClaim(c => c.Type == "SellerId") || User.IsInRole("Seller"))
    {
        <text>
        console.log("The seller automation product and order tracking engine has been fully activated.");

        document.querySelectorAll(".product-card-bubble").forEach(function(bubble) {
            const titleSpan = bubble.querySelector(".js-product-title") || bubble.querySelector(".text-dark.fw-bold");
            if (titleSpan) {
                let txt = titleSpan.innerText.trim();
                if (txt.includes("search=") || txt.includes("%")) {
                    try {
                        while (txt.includes("%")) {
                            let old = txt;
                            txt = decodeURIComponent(txt);
                            if (old === txt) break;
                        }
                        if (txt.includes("search=")) {
                            txt = txt.split("search=")[1];
                        }
                        const parts = txt.split('/');
                        let finalName = parts[parts.length - 1] || "Product";
                        if (finalName.includes("?")) finalName = finalName.split("?")[0];
                        
                        titleSpan.innerText = finalName.trim();
                    } catch (e) {
                        console.error("Historical text cleaning failed.", e);
                    }
                }
            }
        });

        document.addEventListener("click", function (event) {
            const productBubble = event.target.closest(".product-card-bubble");
            if (productBubble && !event.target.closest(".js-order-card")) {
                const anchor = productBubble.querySelector("a");
                if (anchor) {
                    event.preventDefault();

                    let currentHref = anchor.getAttribute("href") || "";
                    try {
                        while (currentHref.includes("%")) {
                            let old = currentHref;
                            currentHref = decodeURIComponent(currentHref);
                            if (old === currentHref) break;
                        }
                    } catch (e) { }

                    if (currentHref.includes("search=")) {
                        currentHref = currentHref.split("search=")[1];
                    }

                    const hrefParts = currentHref.split('/');
                    let rawValue = hrefParts[hrefParts.length - 1] || "";
                    if (rawValue.includes("?")) {
                        rawValue = rawValue.split("?")[0];
                    }
                    rawValue = rawValue.trim();

                    const isNumber = /^\d+$/.test(rawValue);
                    if (isNumber) {
                        fetch('/Chat/GetProductNameById?id=' + rawValue)
                            .then(response => response.json())
                            .then(data => {
                                if (data && data.name) {
                                    window.location.href = window.location.origin + "/Seller/Home?tab=Product&search=" + encodeURIComponent(data.name);
                                } else {
                                    window.location.href = window.location.origin + "/Seller/Home?tab=Product&search=" + rawValue;
                                }
                            })
                            .catch(err => {
                                window.location.href = window.location.origin + "/Seller/Home?tab=Product&search=" + rawValue;
                            });
                    } 
                    else {
                        if (rawValue.includes("Home?tab=Product&search=")) {
                            rawValue = rawValue.replace("Home?tab=Product&search=", "");
                        }
                        window.location.href = window.location.origin + "/Seller/Home?tab=Product&search=" + encodeURIComponent(rawValue);
                    }
                }
            }

            const orderBubble = event.target.closest(".js-order-card");
            if (orderBubble) {
                const anchor = orderBubble.querySelector("a");
                if (anchor) {
                    event.preventDefault();

                    let orderId = orderBubble.getAttribute("data-order-id") || "0";
                    orderId = orderId.trim();

                    if (orderId === "0") {
                        const idTextSpan = orderBubble.querySelector(".js-order-id-text");
                        if (idTextSpan) {
                            orderId = idTextSpan.innerText.replace("#", "").trim();
                        } else {
                            let hrefAttr = anchor.getAttribute("href") || "";
                            const parts = hrefAttr.split('/');
                            orderId = parts[parts.length - 1] || "0";
                        }
                    }

                    if (orderId && orderId !== "0" && orderId !== "0.00") {
                        const sellerOrderDashboardUrl = window.location.origin + "/Seller/Home?tab=Order&search=" + encodeURIComponent(orderId);
                        console.log("Seller order tracking intercepted at frontend. Successfully rerouted to backend: " + sellerOrderDashboardUrl);
                        window.location.href = sellerOrderDashboardUrl;
                    }
                }
            }
        });
        </text>
    }
});
</script>