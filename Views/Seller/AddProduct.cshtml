@{
    ViewData["Title"] = "Add Product";
}

<link rel="stylesheet" href="~/css/seller/dashboard.css" />
<link rel="stylesheet" href="~/css/seller/add-product.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<div class="dashboard-wrapper">
    <nav class="sidebar">
        <div class="sidebar-header">
            <h3 class="shop-title">@ViewBag.ShopName</h3>
        </div>
        <ul class="nav-links">
            <li><a href="@Url.Action("Home", "Seller", new { tab = "General" })">General</a></li>
            <li class="active">
                <a href="@Url.Action("Home", "Seller", new { tab = "Product" })">Product</a>
                <ul class="sub-nav"><li class="sub-active">Add New Product</li></ul>
            </li>
            <li><a href="@Url.Action("Home", "Seller", new { tab = "Order" })">Order</a></li>
        </ul>
        <div class="sidebar-footer">
            <form asp-controller="Auth" asp-action="Logout" method="post">
                <button type="submit" class="logout-link">Logout</button>
            </form>
        </div>
    </nav>

    <main class="content-area">
        <div class="add-product-container">
            <div class="page-header-row">
                <h1 class="section-title" style="margin:0;">Add New Product</h1>
            </div>

            <div id="val-banner" class="val-banner" style="display:none;"></div>

            <form id="productForm" asp-controller="Seller" asp-action="AddProduct"
                  method="post" enctype="multipart/form-data">
                <div class="form-body">

                    <!-- BASIC INFO -->
                    <div class="form-section-label">Basic Information</div>

                    <div class="form-row">
                        <label>Product Name</label>
                        <input type="text" id="field-name" name="Name" placeholder="Enter product name" />
                    </div>

                    <div class="form-row">
                        <label>Product Description <span class="desc-hint">max 3000 characters</span></label>
                        <textarea name="Description" id="desc-field" rows="4"
                                  placeholder="Describe your product..."
                                  maxlength="3000" class="form-textarea"
                                  oninput="document.getElementById('desc-count').textContent=this.value.length+' / 3000'"></textarea>
                        <div class="char-count" id="desc-count">0 / 3000</div>
                    </div>

                    <!-- IMAGES -->
                    <div class="form-section-label">
                        Cover Image
                        <span class="desc-hint">first image customers see</span>
                    </div>

                    <!-- Cover image slot -->
                    <div class="cover-image-wrap">
                        <div class="cover-slot" id="cover-slot" onclick="document.getElementById('cover-file').click()">
                            <input type="file" id="cover-file" name="ImageFiles" accept="image/*"
                                   style="display:none;" onchange="setCover(this)" />
                            <div class="cover-empty" id="cover-empty">
                                <i class="fas fa-camera"></i>
                                <span>Click to upload cover image</span>
                                <span class="img-hint">Recommended 1:1 ratio</span>
                            </div>
                            <img id="cover-preview" class="cover-preview-img" style="display:none;" />
                            <button type="button" class="cover-remove-btn" id="cover-remove"
                                    style="display:none;" onclick="removeCover(event)">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>

                    <div class="form-section-label" style="margin-top:24px;">
                        Content Images
                        <span class="desc-hint">up to 4 additional images · customers swipe through these</span>
                    </div>

                    <!-- Content image slots -->
                    <div class="img-thumb-strip" id="content-strip">
                        @for (int i = 0; i < 4; i++)
                        {
                            <div class="img-thumb-slot" id="content-slot-@i"
                                 onclick="document.getElementById('content-file-@i').click()"
                                 draggable="true"
                                 ondragstart="dragStart(event,@i)"
                                 ondragover="dragOver(event,@i)"
                                 ondragleave="dragLeave(event,@i)"
                                 ondrop="dragDrop(event,@i)">
                                <input type="file" id="content-file-@i" name="ImageFiles"
                                       accept="image/*" style="display:none;"
                                       onchange="setContent(this,@i)" />
                                <div class="thumb-empty-inner" id="content-empty-@i">
                                    <i class="fas fa-plus"></i>
                                    <span>Image @(i + 2)</span>
                                </div>
                                <img class="thumb-preview" id="content-preview-@i" style="display:none;" />
                                <button type="button" class="thumb-remove-btn" id="content-remove-@i"
                                        style="display:none;" onclick="removeContent(event,@i)">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        }
                    </div>
                    <p class="img-hint">Drag thumbnails to reorder</p>

                    <!-- CATEGORY -->
                    <div class="form-section-label">Category</div>
                    <div class="form-row">
                        <select name="Category" id="field-category" class="category-select">
                            <option value="">-- Select a category --</option>
                            <option value="Fashion/Apparel">Fashion / Apparel</option>
                            <option value="Consumer Electronics">Consumer Electronics</option>
                            <option value="Food and Beverages">Food and Beverages</option>
                            <option value="Beauty and Personal Care">Beauty and Personal Care</option>
                            <option value="Home Improvement">Home Improvement</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <!-- SALES INFO -->
                    <div class="form-section-label">Sales Information</div>
                    <div class="form-row-inline">
                        <div class="form-row" style="flex:1;">
                            <label>Price (RM)</label>
                            <input type="number" id="field-price" name="Price" step="0.01" min="0" placeholder="0.00" />
                        </div>
                        <div class="form-row" style="flex:1;" id="global-stock-wrap">
                            <label>Stock Quantity <span class="desc-hint">set per variation if using variations</span></label>
                            <input type="number" id="field-stock" name="StockQuantity" min="0" placeholder="0" />
                        </div>
                        <div class="form-row" style="flex:1;">
                            <label>SKU</label>
                            <input type="text" name="SKU" placeholder="e.g. SKU-001" />
                        </div>
                    </div>

                    <!-- VARIATIONS -->
                    <div class="form-section-label">Variations</div>
                    <div id="variation-wrapper"></div>
                    <button type="button" class="btn-add-variation" onclick="addVariationGroup()">
                        <i class="fas fa-plus"></i> Add Variation Group
                    </button>
                    <input type="hidden" name="VariationsJson" id="variations-json" value="[]" />

                </div>

                <!-- ACTION BAR -->
                <div class="ap-action-bar">
                    <a href="@Url.Action("Home", "Seller", new { tab = "Product" })" class="btn-ap btn-ap-cancel">Cancel</a>
                    <div style="display:flex;gap:12px;">
                        <button type="button" class="btn-ap btn-ap-draft"   onclick="submitForm('Draft')">Save as Draft</button>
                        <button type="button" class="btn-ap btn-ap-publish" onclick="submitForm('Publish')">Save &amp; Publish</button>
                    </div>
                </div>
                <input type="hidden" name="actionType" id="actionType-input" value="" />
            </form>
        </div>
    </main>
</div>

<style>
/* Cover image */
.cover-image-wrap { margin-bottom: 8px; }

.cover-slot {
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1 / 1;
    border: 2px dashed #c5cae9;
    border-radius: 14px;
    overflow: hidden;
    background: #f8f9ff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    position: relative;
    transition: border-color 0.2s;
}
.cover-slot:hover { border-color: #4f46e5; }

.cover-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: #9a98b6;
    font-size: 13px;
    font-weight: 600;
    pointer-events: none;
}
.cover-empty i { font-size: 40px; color: #c5cae9; }

.cover-preview-img {
    width: 100%; height: 100%;
    object-fit: cover;
    position: absolute; top: 0; left: 0;
}

.cover-remove-btn {
    position: absolute;
    top: 10px; right: 10px;
    width: 28px; height: 28px;
    background: rgba(0,0,0,0.6);
    color: #fff;
    border: none; border-radius: 50%;
    font-size: 12px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    z-index: 10;
}
</style>

<script>
// Cover image
function setCover(input) {
    if (!input.files[0]) return;
    const reader = new FileReader();
    reader.onload = e => {
        document.getElementById('cover-preview').src = e.target.result;
        document.getElementById('cover-preview').style.display = 'block';
        document.getElementById('cover-empty').style.display = 'none';
        document.getElementById('cover-remove').style.display = 'flex';
    };
    reader.readAsDataURL(input.files[0]);
}

function removeCover(event) {
    event.stopPropagation();
    document.getElementById('cover-file').value = '';
    document.getElementById('cover-preview').style.display = 'none';
    document.getElementById('cover-preview').src = '';
    document.getElementById('cover-empty').style.display = 'flex';
    document.getElementById('cover-remove').style.display = 'none';
}

// Content images
function setContent(input, i) {
    if (!input.files[0]) return;
    const reader = new FileReader();
    reader.onload = e => {
        const preview = document.getElementById('content-preview-' + i);
        preview.src = e.target.result;
        preview.style.display = 'block';
        document.getElementById('content-empty-' + i).style.display = 'none';
        document.getElementById('content-remove-' + i).style.display = 'flex';
    };
    reader.readAsDataURL(input.files[0]);
}

function removeContent(event, i) {
    event.stopPropagation();
    document.getElementById('content-file-' + i).value = '';
    document.getElementById('content-preview-' + i).style.display = 'none';
    document.getElementById('content-preview-' + i).src = '';
    document.getElementById('content-empty-' + i).style.display = 'flex';
    document.getElementById('content-remove-' + i).style.display = 'none';
}

function hasImage() {
    if (document.getElementById('cover-file').files.length > 0) return true;
    for (let i = 0; i < 4; i++) {
        if (document.getElementById('content-file-' + i)?.files.length > 0) return true;
    }
    return false;
}

// Drag to reorder content images
let dragIdx = null;
function dragStart(e, i) { dragIdx = i; e.currentTarget.style.opacity = '0.4'; }
function dragOver(e, i)  { e.preventDefault(); document.getElementById('content-slot-' + i).classList.add('drag-over'); }
function dragLeave(e, i) { document.getElementById('content-slot-' + i).classList.remove('drag-over'); }
function dragDrop(e, i) {
    e.preventDefault();
    const slot = document.getElementById('content-slot-' + i);
    slot.classList.remove('drag-over');
    if (dragIdx === null || dragIdx === i) { dragIdx = null; return; }
    // Swap file inputs by swapping preview srcs and file inputs
    swapSlots(dragIdx, i);
    dragIdx = null;
}

function swapSlots(a, b) {
    const slotA = document.getElementById('content-slot-' + a);
    const slotB = document.getElementById('content-slot-' + b);
    slotA.style.opacity = '';
    // Swap preview images
    const previewA = document.getElementById('content-preview-' + a);
    const previewB = document.getElementById('content-preview-' + b);
    const srcA = previewA.src, showA = previewA.style.display;
    previewA.src = previewB.src; previewA.style.display = previewB.style.display;
    previewB.src = srcA; previewB.style.display = showA;
    // Swap empty state visibility
    const emptyA = document.getElementById('content-empty-' + a);
    const emptyB = document.getElementById('content-empty-' + b);
    const emptyDispA = emptyA.style.display;
    emptyA.style.display = emptyB.style.display;
    emptyB.style.display = emptyDispA;
    // Swap remove buttons
    const removeA = document.getElementById('content-remove-' + a);
    const removeB = document.getElementById('content-remove-' + b);
    const removeDispA = removeA.style.display;
    removeA.style.display = removeB.style.display;
    removeB.style.display = removeDispA;
    // Swap actual file inputs by transferring files
    const fileA = document.getElementById('content-file-' + a);
    const fileB = document.getElementById('content-file-' + b);
    const dtA = new DataTransfer(), dtB = new DataTransfer();
    if (fileB.files[0]) dtA.items.add(fileB.files[0]);
    if (fileA.files[0]) dtB.items.add(fileA.files[0]);
    fileA.files = dtA.files;
    fileB.files = dtB.files;
}

// Variations with chip-card style (matches add-product.css)
let groupCount = 0;
let groups = {};

function addVariationGroup(existingName = '', existingValues = []) {
    const id = groupCount++;
    groups[id] = { name: existingName, values: JSON.parse(JSON.stringify(existingValues)) };

    const wrapper = document.getElementById('variation-wrapper');
    const div = document.createElement('div');
    div.className = 'var-group'; div.id = 'vg-' + id;
    div.innerHTML = `
        <div class="var-group-header">
            <input class="var-name-input" type="text"
                   placeholder="Variation name (e.g. Flavour, Size)"
                   value="${escHtml(existingName)}"
                   oninput="groups[${id}].name=this.value; serializeVariations()" />
            <button type="button" class="btn-remove-group" onclick="removeGroup(${id})">
                <i class="fas fa-trash"></i> Remove
            </button>
        </div>
        <div class="chip-area" id="chips-${id}"></div>
        <div class="add-value-row">
            <input type="text"   id="val-input-${id}"   placeholder="Value (e.g. Original, Chicken, S)" />
            <input type="number" id="stock-input-${id}" placeholder="Stock" min="0" class="stock-input" />
            <button type="button" class="btn-add-chip" onclick="addChip(${id})">+ Add</button>
        </div>`;
    wrapper.appendChild(div);
    div.querySelector('#val-input-' + id).addEventListener('keydown', e => {
        if (e.key === 'Enter') { e.preventDefault(); addChip(id); }
    });
    if (existingValues.length > 0) renderChips(id);
    updateGlobalStockVisibility();
}

function removeGroup(id) { document.getElementById('vg-' + id).remove(); delete groups[id]; serializeVariations(); updateGlobalStockVisibility(); }

function addChip(groupId) {
    const valInput   = document.getElementById('val-input-' + groupId);
    const stockInput = document.getElementById('stock-input-' + groupId);
    const label = valInput.value.trim();
    const stock = parseInt(stockInput.value) || 0;
    if (!label) { valInput.focus(); return; }
    // Check for a pending variation image
    const imgFile = document.getElementById('var-pending-img-' + groupId);
    const image   = imgFile?.dataset.preview || '';
    groups[groupId].values.push({ label, stock, image });
    renderChips(groupId);
    valInput.value = ''; stockInput.value = '';
    if (imgFile) { imgFile.dataset.preview = ''; imgFile.value = ''; }
    const pendingWrap = document.getElementById('var-pending-img-wrap-' + groupId);
    if (pendingWrap) pendingWrap.innerHTML = renderPendingImgLabel(groupId);
    valInput.focus();
    serializeVariations();
}

function renderPendingImgLabel(groupId) {
    return `<input type="file" id="var-pending-img-${groupId}" accept="image/*"
                   style="display:none;" onchange="setPendingVarImg(this,${groupId})" />
            <span class="var-img-label" onclick="document.getElementById('var-pending-img-${groupId}').click()">
                <i class="fas fa-image"></i> Add Image
            </span>`;
}

function setPendingVarImg(input, groupId) {
    if (!input.files[0]) return;
    const url = URL.createObjectURL(input.files[0]);
    input.dataset.preview = url;
    const wrap = document.getElementById('var-pending-img-wrap-' + groupId);
    wrap.innerHTML = `
        <input type="file" id="var-pending-img-${groupId}" accept="image/*"
               style="display:none;" onchange="setPendingVarImg(this,${groupId})" />
        <span class="var-img-label" onclick="document.getElementById('var-pending-img-${groupId}').click()" style="padding:4px;">
            <img src="${url}" style="width:28px;height:28px;object-fit:cover;border-radius:4px;" />
            <span>Change</span>
        </span>`;
    document.getElementById('var-pending-img-' + groupId).dataset.preview = url;
}

function removeChip(groupId, index) { groups[groupId].values.splice(index, 1); renderChips(groupId); serializeVariations(); }

function renderChips(groupId) {
    const area = document.getElementById('chips-' + groupId);
    area.innerHTML = '';

    // Pending image row above chip area
    let pendingRow = document.getElementById('var-pending-img-wrap-' + groupId);
    if (!pendingRow) {
        pendingRow = document.createElement('div');
        pendingRow.id = 'var-pending-img-wrap-' + groupId;
        pendingRow.style.cssText = 'margin-bottom:8px;';
        pendingRow.innerHTML = renderPendingImgLabel(groupId);
        area.parentNode.insertBefore(pendingRow, area);
    }

    groups[groupId].values.forEach((v, i) => {
        const card = document.createElement('div');
        card.className = 'chip-card';
        const imgHtml = v.image
            ? `<div class="chip-img-wrap">
                   <img class="chip-img-preview" src="${v.image}" />
                   <button type="button" class="chip-img-remove" onclick="removeChipImg(${groupId},${i})">
                       <i class="fas fa-times"></i>
                   </button>
               </div>`
            : `<div class="chip-img-wrap">
                   <div class="chip-img-empty" onclick="triggerChipImg(${groupId},${i})">
                       <input type="file" id="chip-img-${groupId}-${i}" accept="image/*" style="display:none;"
                              onchange="setChipImg(this,${groupId},${i})" />
                       <i class="fas fa-image"></i>
                       <span>Add</span>
                   </div>
               </div>`;
        card.innerHTML = `${imgHtml}
            <div class="chip-info">
                <span class="chip-label">${escHtml(v.label)}</span>
                <span class="chip-stock">Qty: ${v.stock}</span>
            </div>
            <button type="button" class="chip-remove" onclick="removeChip(${groupId},${i})">
                <i class="fas fa-times"></i>
            </button>`;
        area.appendChild(card);
    });
}

function triggerChipImg(groupId, index) {
    document.getElementById('chip-img-' + groupId + '-' + index)?.click();
}

function setChipImg(input, groupId, index) {
    if (!input.files[0]) return;
    const url = URL.createObjectURL(input.files[0]);
    groups[groupId].values[index].image = url;
    renderChips(groupId);
    serializeVariations();
}

function removeChipImg(groupId, index) {
    groups[groupId].values[index].image = '';
    renderChips(groupId);
    serializeVariations();
}

function escHtml(str) {
    return (str||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function serializeVariations() {
    const data = Object.values(groups).filter(g => g.name || g.values.length > 0);
    document.getElementById('variations-json').value = JSON.stringify(data);
}

function updateGlobalStockVisibility() {
    const hasGroups = Object.keys(groups).length > 0;
    const stockWrap  = document.getElementById('global-stock-wrap');
    const stockField = document.getElementById('field-stock');
    if (hasGroups) { stockWrap.style.opacity = '0.4'; stockField.disabled = true; stockField.value = 0; }
    else           { stockWrap.style.opacity = '1';   stockField.disabled = false; }
}

function submitForm(type) {
    serializeVariations();
    const banner = document.getElementById('val-banner'); banner.style.display = 'none';
    const name     = document.getElementById('field-name').value.trim();
    const price    = parseFloat(document.getElementById('field-price').value) || 0;
    const category = document.getElementById('field-category').value;
    const imgPresent = hasImage();
    const errors = [];
    if (type === 'Publish') {
        if (!name)       errors.push('Product Name is required.');
        if (price <= 0)  errors.push('Price must be greater than 0.');
        if (!category)   errors.push('Please select a Category.');
        if (!imgPresent) errors.push('Please upload at least one image.');
    } else {
        if (!name && !imgPresent && !category)
            errors.push('Please fill in at least one field before saving as draft.');
    }
    if (errors.length > 0) {
        banner.innerHTML = '<i class="fas fa-exclamation-circle"></i> ' + errors.join('<br>');
        banner.style.display = 'block';
        banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
    }
    document.getElementById('actionType-input').value = type;
    document.getElementById('productForm').submit();
}

// Variation image label style (inline, reused in addVariationGroup)
const varImgLabelStyle = `
    .var-img-label {
        display: inline-flex; align-items: center; gap: 5px;
        background: #f8f9ff; border: 1px solid #c5cae9; border-radius: 6px;
        padding: 7px 10px; cursor: pointer; font-size: 12px;
        color: #5b587d; font-weight: 600; white-space: nowrap;
    }
    .var-img-label:hover { border-color: #4f46e5; color: #4f46e5; }
`;
const styleEl = document.createElement('style');
styleEl.textContent = varImgLabelStyle;
document.head.appendChild(styleEl);
</script>
