<script>
    function toggleNotifDropdown() {
        const dd = document.getElementById('notifDropdown');
        dd.style.display = dd.style.display === 'none' ? 'block' : 'none';
        if (dd.style.display === 'block') loadNotifications();
    }

    document.addEventListener('click', function(e) {
        const wrapper = document.getElementById('notifWrapper');
        if (wrapper && !wrapper.contains(e.target))
            document.getElementById('notifDropdown').style.display = 'none';
    });

    async function loadNotifications() {
        const res = await fetch('/Notifications/GetDropdown');
        const data = await res.json();
        const badge = document.getElementById('notifBadge');
        badge.textContent = data.unreadCount;
        badge.style.display = data.unreadCount > 0 ? 'flex' : 'none';
        const list = document.getElementById('notifList');
        if (data.items.length === 0) {
            list.innerHTML = '<p class="notif-empty">No notifications yet.</p>';
            return;
        }
        list.innerHTML = data.items.map(n => `
            <div class="notif-item ${n.isRead ? '' : 'unread'}" onclick="markRead(${n.notificationId}, this)">
                <div class="notif-item-title">${n.title}</div>
                <div class="notif-item-msg">${n.message}</div>
                <div class="notif-item-time">${n.createdAt}</div>
            </div>
        `).join('');
    }

    async function markRead(id, el) {
        await fetch(`/Notifications/MarkRead?id=${id}`, {
            method: 'POST',
            headers: { 'RequestVerificationToken': getAntiForgeryToken() }
        });
        el.classList.remove('unread');
        refreshBadge();
    }

    async function markAllRead() {
        await fetch('/Notifications/MarkAllRead', {
            method: 'POST',
            headers: { 'RequestVerificationToken': getAntiForgeryToken() }
        });
        document.querySelectorAll('.notif-item.unread').forEach(el => el.classList.remove('unread'));
        const badge = document.getElementById('notifBadge');
        if (badge) badge.style.display = 'none';
    }

    async function refreshBadge() {
        try {
            const res = await fetch('/Notifications/GetDropdown');
            if (!res.ok) return;
            
            const data = await res.json();
            const badge = document.getElementById('notifBadge');
            
            if (badge && data && typeof data.unreadCount !== 'undefined') {
                badge.textContent = data.unreadCount;
                badge.style.display = data.unreadCount > 0 ? 'flex' : 'none';
            }
        } catch (err) { 
            console.error("Error refreshing dashboard notification tracking:", err); 
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        refreshBadge();
        // Re-check for new status updates every 20 seconds
        setInterval(refreshBadge, 20000);
    });

    function getAntiForgeryToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    }

    setInterval(refreshBadge, 30000);
    window.addEventListener('load', refreshBadge);
</script>
