                @foreach (var prod in productsWithReviews)
                {
                    var prodReviews   = reviewsByProduct[prod.ProductId].OrderByDescending(r => r.CreatedAt).ToList();
                    var avgRating     = prodReviews.Average(r => r.Rating);
                    var totalProdRevs = prodReviews.Count;
                    var starCounts    = Enumerable.Range(1, 5).Reverse()
