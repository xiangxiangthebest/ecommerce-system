@if (ViewBag.ActiveTab == "Order" && ViewBag.Orders != null)
{
    static (string reason, string embeddedType, string description, Dictionary<int, int> requestedQtys, string returnType) ParseReturnReason(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return ("", "", "", new Dictionary<int, int>(), "");
        var sep = raw.IndexOf("||");
        if (sep < 0) return (raw, "", "", new Dictionary<int, int>(), "");

        var firstPart  = raw[..sep].Trim();
        var rest       = raw[(sep + 2)..];
        var embeddedType = "";
        var reasonText   = firstPart;
        if (firstPart.StartsWith("["))
        {
            var closeBracket = firstPart.IndexOf("]");
            if (closeBracket > 0)
            {
                embeddedType = firstPart[1..closeBracket].Trim();
                reasonText   = firstPart[(closeBracket + 1)..].Trim();
            }
        }
        var returnType = "";
        var sep2 = rest.LastIndexOf("||");
        if (sep2 >= 0 && !rest[(sep2 + 2)..].TrimStart().StartsWith("["))
        {
            returnType = rest[(sep2 + 2)..].Trim();
            rest       = rest[..sep2];
        }
        var description = "";
        var jsonSep = rest.IndexOf("||");
        if (jsonSep >= 0)
        {
            description = rest[..jsonSep].Trim();
            rest        = rest[(jsonSep + 2)..];
        }
        try
        {
            var items = System.Text.Json.JsonSerializer.Deserialize<List<System.Text.Json.JsonElement>>(rest);
            var dict = new Dictionary<int, int>();
            if (items != null)
                foreach (var el in items)
                {
                    dict[el.GetProperty("orderItemId").GetInt32()] = el.GetProperty("returnQty").GetInt32();
                }
            return (reasonText, embeddedType, description, dict, returnType);
        }
        catch
        {
            return (reasonText, embeddedType, description, new Dictionary<int, int>(), returnType);
        }
    }

    static List<string> ParseImagePaths(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new List<string>();
        try { return System.Text.Json.JsonSerializer.Deserialize<List<string>>(json) ?? new List<string>(); }
        catch { return new List<string>(); }
    }

    var ordersForJs = ((List<EcommerceSystem.Models.Order>)ViewBag.Orders)
        .Where(o => (o.CurrentStatus == EcommerceSystem.Models.OrderStatus.RETURN_REFUND
                  || o.CurrentStatus == EcommerceSystem.Models.OrderStatus.AFTER_SALES_REQUESTED)
                 && !o.ReturnApprovedAt.HasValue)
        .Select(o => {
            var (reasonText, embeddedType, description, requestedQtys, parsedReturnType) = ParseReturnReason(o.ReturnReason);
            var returnType = !string.IsNullOrWhiteSpace(embeddedType) ? embeddedType : (!string.IsNullOrWhiteSpace(parsedReturnType) ? parsedReturnType : (o.ReturnType.HasValue ? o.ReturnType.ToString() : ""));
            var useAllItems = requestedQtys.Count == 0;
            var rawSubtotal = o.OrderItems.Sum(oi => oi.Price * oi.Quantity);
            // TotalAmount is merchandise-only (no shipping/SST), so discount = rawSubtotal - TotalAmount
            var vDiscount   = Math.Max(0m, rawSubtotal - o.TotalAmount);
            var discRatio   = rawSubtotal > 0 ? vDiscount / rawSubtotal : 0m;
        
        return new {
            orderId           = o.OrderId,
            returnType        = returnType,
            returnReason      = reasonText,
            returnDescription = description,
            returnImages      = ParseImagePaths(o.ReturnImagePathsJson),
            customerEmail     = o.Customer?.Email ?? "—",
            customerName      = o.Customer?.FullName ?? "",
            items = o.OrderItems.Where(oi => useAllItems || requestedQtys.ContainsKey(oi.OrderItemId)).Select(oi => new {
                orderItemId       = oi.OrderItemId,
                name              = (!string.IsNullOrWhiteSpace(oi.Product?.SKU) ? $"[{oi.Product!.SKU}] " : "") + (oi.Product?.Name ?? $"Item #{oi.OrderItemId}"),
                sku               = oi.Product?.SKU ?? "—",
                orderedQty        = oi.Quantity,
                requestedQty      = requestedQtys.GetValueOrDefault(oi.OrderItemId, oi.Quantity),
                unitPrice         = Math.Round(oi.Price * (1 - discRatio), 2).ToString("F2"),
                selectedVariation = oi.SelectedVariation ?? ""   // e.g. {"Flavour":"Honey Tapioca","Size":"120g"}
            }).ToList()
        };
        }).ToList();

    var allOrdersForDetails = ((List<EcommerceSystem.Models.Order>)ViewBag.Orders)
        .Select(o => {
            var displayReturnReason = o.ReturnReason ?? "";
            var rSep = displayReturnReason.IndexOf("||");
            if (rSep >= 0) displayReturnReason = displayReturnReason[..rSep];
            displayReturnReason = displayReturnReason.Trim();
            if (displayReturnReason.StartsWith("[") && displayReturnReason.EndsWith("]")) displayReturnReason = displayReturnReason[1..^1].Trim();
            return new {
                orderId         = o.OrderId,
                orderTime       = o.OrderTime.ToString("dd MMM yyyy, hh:mm tt"),
                status          = o.CurrentStatus.ToString(),
                paymentMethod   = o.PaymentMethod,
                totalAmount     = o.TotalAmount.ToString("F2"),
                customerMessage = o.CustomerMessage ?? "",
                cancelReason    = o.CancelReason ?? "",
                returnReason    = displayReturnReason,
                returnType      = o.ReturnType.HasValue ? o.ReturnType.ToString() : "",
                customerEmail   = o.Customer?.Email ?? "—",
                customerPhone   = o.Customer?.PhoneNumber ?? "—",
                customerName    = (o.Customer?.FullName ?? ""),
                deliveryName    = o.DeliveryRecipientName,
                deliveryPhone   = o.DeliveryPhoneNumber,
                deliveryLine1   = o.DeliveryAddressLine1,
                deliveryLine2   = o.DeliveryAddressLine2 ?? "",
                deliveryCity    = o.DeliveryCity,
                deliveryPostcode= o.DeliveryPostcode,
                deliveryState   = o.DeliveryState,
                items = o.OrderItems.Select(oi => new {
                    productName       = oi.Product?.Name ?? $"Product #{oi.ProductId}",
                    sku               = oi.Product?.SKU ?? "—",
                    selectedVariation = oi.SelectedVariation ?? "",
                    quantity          = oi.Quantity,
                    unitPrice         = oi.Price.ToString("F2"),
                    subtotal          = (oi.Price * oi.Quantity).ToString("F2"),
                    imagePath         = oi.Product?.ImagePath ?? "/images/placeholder.png"
                }).ToList()
            };
        }).ToList();

    <script>
    const _sellerReturnOrders = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ordersForJs));
    const _allOrderDetails    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(allOrdersForDetails));

    // ── Variation JSON → readable tag line ──────────────────────────────────
    function parseVariation(json) {
        if (!json || json === '{}' || json === '[]' || json === '') return '';
        try {
            const obj = typeof json === 'string' ? JSON.parse(json) : json;
            return Object.entries(obj).map(([k, v]) => `${k}: ${v}`).join(' · ');
        } catch { return ''; }
    }

    function openApproveReturnModal(orderId) {
        const order = _sellerReturnOrders.find(o => o.orderId === orderId);
        if (!order) return;
        document.getElementById('approveReturnOrderId').value = orderId;

        const typeIconMap = { 'Refund Only': { icon: '💰', label: 'Refund Only' }, 'RefundOnly': { icon: '💰', label: 'Refund Only' }, 'Return \u0026 Refund': { icon: '📦', label: 'Return \u0026 Refund' }, 'ReturnRefund': { icon: '📦', label: 'Return \u0026 Refund' } };        const typeInfo   = typeIconMap[order.returnType] || { icon: '🔄', label: order.returnType || 'Not specified' };
        const custName   = order.customerName ? `${order.customerName} (${order.customerEmail})` : order.customerEmail;

        let summaryHtml = `
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid #ffe0b2;">
                <i class="fas fa-user-circle" style="color:#f97316;font-size:16px;flex-shrink:0"></i>
                <div>
                    <div style="font-size:11px;color:#a16207;font-weight:600;text-transform:uppercase;letter-spacing:0.05em">Customer</div>
                    <div style="font-size:13px;color:#1e1b4b;font-weight:600">${custName}</div>
                </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px;">
                <div style="background:#fff;border-radius:8px;padding:8px 10px;border:1px solid #ffe0b2;">
                    <div style="font-size:10px;color:#a16207;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:2px">Return Type</div>
                    <div style="font-size:13px;font-weight:700;color:#1e1b4b">${typeInfo.icon} ${typeInfo.label}</div>
                </div>
                <div style="background:#fff;border-radius:8px;padding:8px 10px;border:1px solid #ffe0b2;">
                    <div style="font-size:10px;color:#a16207;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:2px">Reason</div>
                    <div style="font-size:13px;font-weight:700;color:#1e1b4b">${order.returnReason || '—'}</div>
                </div>
            </div>`;

        if (order.returnDescription) {
            summaryHtml += `
            <div style="background:#fff;border-radius:8px;padding:8px 10px;border:1px solid #ffe0b2;margin-bottom:10px;">
                <div style="font-size:10px;color:#a16207;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:4px"><i class="fas fa-comment-alt" style="margin-right:4px"></i>Description</div>
                <div style="font-size:13px;color:#5d4037;line-height:1.5">${order.returnDescription}</div>
            </div>`;
        }

        if (order.returnImages && order.returnImages.length > 0) {
            let imgHtml = order.returnImages.map(src => `<a href="${src}" target="_blank" style="display:block;width:72px;height:72px;border-radius:8px;overflow:hidden;border:1.5px solid #ffe0b2;flex-shrink:0;"><img src="${src}" style="width:100%;height:100%;object-fit:cover;display:block" onerror="this.src='/images/placeholder.png'" /></a>`).join('');
            summaryHtml += `<div><div style="font-size:10px;color:#a16207;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:6px"><i class="fas fa-camera" style="margin-right:4px"></i>Photo Proof (${order.returnImages.length})</div><div style="display:flex;gap:8px;flex-wrap:wrap">${imgHtml}</div></div>`;
        }

        document.getElementById('approveReturnTypeInfo').innerHTML = summaryHtml;

        let html = '';
        if (!order.items || order.items.length === 0) {
            html = `<div style="color:#9a98b6;font-size:13px;padding:12px 0">No return items found.</div>`;
        } else {
            order.items.forEach(item => {
                const varLine = parseVariation(item.selectedVariation);
                html += `
                <div class="ph-return-item" style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid #f0f0f8;">
                    <input type="checkbox" class="approve-item-chk" data-order-item-id="${item.orderItemId}" data-max="${item.requestedQty}" data-unit-price="${item.unitPrice}" data-name="${item.name}" onchange="syncApproveQty(this);updateRefundBreakdown()" style="width:16px;height:16px;cursor:pointer" />
                    <label style="flex:1">
                        <div style="font-weight:600;font-size:13px">${item.name}</div>
                        ${varLine ? `<div style="font-size:11px;color:#6366f1;margin-bottom:2px"><i class="fas fa-tag" style="margin-right:3px"></i>${varLine}</div>` : ''}
                        <div style="font-size:12px;color:#9a98b6">Qty in order: ${item.orderedQty} &nbsp;|&nbsp; <span style="color:#f97316;font-weight:600">Requested: ${item.requestedQty}</span> &nbsp;|&nbsp; <span style="color:#1e1b4b;font-weight:600">RM ${item.unitPrice} each</span></div>
                    </label>
                    <div style="display:flex;align-items:center;gap:6px">
                        <label style="font-size:12px;color:#9a98b6">Approve qty:</label>
                        <input type="number" class="approve-item-qty" min="1" max="${item.requestedQty}" value="${item.requestedQty}" disabled oninput="updateRefundBreakdown()" style="width:56px;padding:4px 6px;border:1px solid #e0e0f0;border-radius:6px;font-size:13px;text-align:center" />
                    </div>
                </div>`;
            });
        }
        document.getElementById('approveItemsWrap').innerHTML = html;
        updateRefundBreakdown();

        document.getElementById('approveReturnBackdrop').classList.add('active');
        document.getElementById('approveReturnModal').classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function syncApproveQty(chk) {
        const row = chk.closest('.ph-return-item');
        const qty = row.querySelector('.approve-item-qty');
        if (qty) qty.disabled = !chk.checked;
        updateRefundBreakdown();
    }

    function updateRefundBreakdown() {
        const tbody   = document.getElementById('approveBreakdownBody');
        const totalEl = document.getElementById('approveRefundTotal');
        if (!tbody || !totalEl) return;

        const checked = document.querySelectorAll('.approve-item-chk:checked');
        let total = 0; let rows  = '';

        checked.forEach(chk => {
            const row   = chk.closest('.ph-return-item');
            const qtyEl = row.querySelector('.approve-item-qty');
            const qty   = parseInt(qtyEl?.value) || 0;
            const unit  = parseFloat(chk.dataset.unitPrice) || 0;
            const name  = chk.dataset.name || '—';
            const sub   = qty * unit;
            total      += sub;

            rows += `<tr>
                <td style="padding:4px 0;color:#1e1b4b;">${name}</td>
                <td style="text-align:center;padding:4px 0;color:#6b6b8a;">× ${qty}</td>
                <td style="text-align:right;padding:4px 0;color:#6b6b8a;">RM ${unit.toFixed(2)}</td>
                <td style="text-align:right;padding:4px 0;font-weight:600;color:#1e1b4b;">RM ${sub.toFixed(2)}</td>
            </tr>`;
        });

        tbody.innerHTML = rows || `<tr><td colspan="4" style="color:#ccc;font-size:12px;padding:6px 0">No items selected yet.</td></tr>`;
        totalEl.textContent = `RM ${total.toFixed(2)}`;
    }

    function closeApproveReturnModal() {
        document.getElementById('approveReturnBackdrop').classList.remove('active');
        document.getElementById('approveReturnModal').classList.remove('active');
        document.body.style.overflow = '';
    }

    async function submitApproveReturn() {
        const orderId = document.getElementById('approveReturnOrderId').value;
        const order   = _sellerReturnOrders.find(o => o.orderId === parseInt(orderId));
        const checked = document.querySelectorAll('.approve-item-chk:checked');
        if (checked.length === 0) { alert('Please select at least one item to approve.'); return; }

        const params = new URLSearchParams();
        params.append('orderId', orderId);
        params.append('returnType', order?.returnType ?? '');
        params.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '');

        let i = 0; let valid = true;
        checked.forEach(chk => {
            const row = chk.closest('.ph-return-item');
            const qty = parseInt(row.querySelector('.approve-item-qty').value);
            const max = parseInt(chk.dataset.max);
            if (!qty || qty < 1 || qty > max) { valid = false; return; }
            params.append(`approveItemIds[${i}]`, chk.dataset.orderItemId);
            params.append(`approveQtys[${i}]`, qty);
            i++;
        });
        if (!valid) { alert('Invalid quantity for one or more items.'); return; }

        const btn = document.getElementById('approveReturnBtn');
        btn.disabled = true; btn.textContent = 'Approving…';

        const res = await fetch('/Seller/ApproveReturn', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: params.toString()
        });

        if (res.ok) { location.reload(); } 
        else { btn.disabled = false; btn.textContent = 'Approve \u0026 Process'; alert('Failed to approve return.'); }
    }

    const statusLabels = {
        'PENDING':       { label: 'Pending',       color: '#f57f17', bg: '#fff9c4' },
        'PREPARING':     { label: 'Preparing',      color: '#1565c0', bg: '#e3f2fd' },
        'SHIPPED':       { label: 'Shipped',        color: '#1565c0', bg: '#e3f2fd' },
        'DELIVERED':     { label: 'Delivered',      color: '#2e7d32', bg: '#e8f5e9' },
        'RECEIVED':      { label: 'Received',       color: '#2e7d32', bg: '#e8f5e9' },
        'RETURN_REFUND': { label: 'Return / Refund',color: '#c62828', bg: '#ffebee' },
        'RETURN_REFUND_APPROVED': { label: 'Return / Refund Approved', color: '#2e7d32', bg: '#e8f5e9' },
        'AFTER_SALES_REQUESTED': { label: 'After-Sale Request', color: '#b45309', bg: '#fffbeb' },
        'CANCELED':      { label: 'Canceled',       color: '#c62828', bg: '#ffebee' },
    };

    async function openOrderDetails(orderId) {
        const o = _allOrderDetails.find(x => x.orderId === orderId);
        if (!o) return;

        const st = statusLabels[o.status] || { label: o.status, color: '#555', bg: '#f5f5f5' };

        document.getElementById('od-title').textContent  = `Order #${o.orderId}`;
        document.getElementById('od-time').textContent   = o.orderTime;
        document.getElementById('od-status').textContent = st.label;
        document.getElementById('od-status').style.background = st.bg;
        document.getElementById('od-status').style.color      = st.color;

        document.getElementById('od-cust-name').textContent  = o.customerName.trim() || '—';
        document.getElementById('od-cust-email').textContent = o.customerEmail;
        document.getElementById('od-cust-phone').textContent = o.customerPhone;

        document.getElementById('od-del-name').textContent  = o.deliveryName || '—';
        document.getElementById('od-del-phone').textContent = o.deliveryPhone || '—';
        const addrParts = [o.deliveryLine1, o.deliveryLine2, o.deliveryCity, o.deliveryPostcode, o.deliveryState].filter(Boolean).join(', ');
        document.getElementById('od-del-addr').textContent = addrParts || '—';

        let itemHtml = '';
        o.items.forEach(item => {
            itemHtml += `
            <div class="od-item-row">
                <div class="od-item-img-wrap"><img src="${item.imagePath}" alt="${item.productName}" class="od-item-img" onerror="this.src='/images/placeholder.png'" /></div>
                <div class="od-item-info">
                    <div class="od-item-name">${item.productName}</div>
                    <div class="od-item-meta">
                        <span class="od-meta-chip"><i class="fas fa-barcode"></i> ${item.sku}</span>
                        ${item.selectedVariation ? `<span class="od-meta-chip"><i class="fas fa-tag"></i> ${item.selectedVariation}</span>` : ''}
                    </div>
                </div>
                <div class="od-item-pricing">
                    <div class="od-item-qty">× ${item.quantity}</div>
                    <div class="od-item-unit">RM ${item.unitPrice} each</div>
                    <div class="od-item-subtotal">RM ${item.subtotal}</div>
                </div>
            </div>`;
        });
        document.getElementById('od-items-wrap').innerHTML = itemHtml || '<p style="color:#aaa;font-size:13px">No items found.</p>';

        document.getElementById('od-total').textContent   = `RM ${o.totalAmount}`;
        document.getElementById('od-payment').textContent = o.paymentMethod;

        const notesEl = document.getElementById('od-notes-section');

        // ── After-sale / Return statuses: fetch full request details ──────────
        const isAfterSale = o.status === 'AFTER_SALES_REQUESTED' || o.status === 'RETURN_REFUND';
        if (isAfterSale) {
            notesEl.style.display = 'block';
            notesEl.innerHTML = `
                <div class="od-section-label">Notes &amp; Remarks</div>
                <div style="text-align:center;padding:24px 0;">
                    <i class="fas fa-spinner fa-spin" style="font-size:22px;color:#9a98b6;"></i>
                </div>`;

            // Open modal first so the user sees the spinner immediately
            document.getElementById('od-backdrop').classList.add('active');
            document.getElementById('od-modal').classList.add('active');
            document.body.style.overflow = 'hidden';

            try {
                const res    = await fetch(`/Request/GetRequest?orderId=${orderId}`);
                const result = await res.json();

                if (!result.success) {
                    // Fallback to simple notes if no request record
                    _renderSimpleNotes(notesEl, o);
                    return;
                }

                // Build per-item rows + total
                let totalRefund = 0;
                const itemsHtml = result.orderItems.map(item => {
                    const unitPrice = parseFloat(item.discountedPrice ?? item.price);
                    const reqQty    = item.requestedQty ?? item.quantity;
                    const varLine   = parseVariation(item.selectedVariation);
                    totalRefund    += unitPrice * reqQty;
                    return `
                    <div style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:0.5px solid #ebebf5;">
                        <div style="width:44px;height:44px;border-radius:8px;overflow:hidden;flex-shrink:0;background:#f0f0f8;display:flex;align-items:center;justify-content:center;">
                            ${item.imageUrl
                                ? `<img src="${item.imageUrl}" style="width:100%;height:100%;object-fit:cover;">`
                                : `<i class="fas fa-box" style="font-size:18px;color:#9a98b6;"></i>`}
                        </div>
                        <div style="flex:1;min-width:0;">
                            <p style="margin:0 0 2px;font-size:13px;font-weight:600;color:#1e1b4b;">${item.productName}</p>
                            ${varLine ? `<p style="margin:0 0 2px;font-size:11px;color:#6366f1;"><i class="fas fa-tag" style="margin-right:3px"></i>${varLine}</p>` : ''}
                            <p style="margin:0;font-size:11px;color:#9a98b6;">
                                Qty ordered: <strong style="color:#6b6b8a;">${item.quantity}</strong>
                                &nbsp;·&nbsp;
                                Requested: <strong style="color:#f97316;">${reqQty}</strong>
                                &nbsp;·&nbsp;
                                RM ${unitPrice.toFixed(2)} / unit
                            </p>
                        </div>
                    </div>`;
                }).join('');

                const imagesHtml = result.images?.length
                    ? result.images.map(url => `<img src="${url}" style="width:64px;height:64px;object-fit:cover;border-radius:8px;border:0.5px solid #ebebf5;">`).join('')
                    : '<span style="font-size:13px;color:#9a98b6;">No photos attached</span>';

                const approvalBlock = result.approvedAt ? `
                <div style="background:#f0fdf4;border-radius:10px;padding:10px 14px;display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;border:1px solid #bbf7d0;">
                    <div>
                        <p style="margin:0 0 2px;font-size:11px;font-weight:700;color:#15803d;text-transform:uppercase;letter-spacing:0.06em;">Request Approved</p>
                        <p style="margin:0;font-size:13px;font-weight:500;color:#166534;">${result.approvedAt}</p>
                    </div>
                    <i class="fas fa-check-circle" style="font-size:20px;color:#22c55e;"></i>
                </div>` : `
                <div style="background:#fffbeb;border-radius:10px;padding:10px 14px;display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;border:1px solid #fde68a;">
                    <div>
                        <p style="margin:0 0 2px;font-size:11px;font-weight:700;color:#b45309;text-transform:uppercase;letter-spacing:0.06em;">Request Approval</p>
                        <p style="margin:0;font-size:13px;font-weight:500;color:#92400e;">Pending — awaiting customer service</p>
                    </div>
                    <i class="fas fa-hourglass-half" style="font-size:20px;color:#f59e0b;"></i>
                </div>`;

                // Update the modal header badge to green if approved
                if (result.approvedAt) {
                    const stEl = document.getElementById('od-status');
                    if (stEl) {
                        stEl.textContent = 'Return / Refund Approved';
                        stEl.style.background = '#dcfce7';
                        stEl.style.color = '#15803d';
                    }
                }

                notesEl.innerHTML = `
                <div class="od-section-label">Notes &amp; Remarks</div>
                <div style="display:flex;align-items:center;gap:6px;margin-bottom:6px;">
                    <i class="fas fa-exchange-alt" style="color:#f97316;font-size:13px;"></i>
                    <span style="font-size:11px;font-weight:700;color:#9a98b6;text-transform:uppercase;letter-spacing:0.05em;">Return type</span>
                    <span style="font-size:13px;font-weight:600;color:#1e1b4b;">${result.serviceType ?? '—'}</span>
                </div>

                <div style="background:#ffffff;border:1px solid #ebebf5;border-radius:10px;padding:10px 14px;display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                    <div>
                        <p style="margin:0 0 2px;font-size:11px;font-weight:700;color:#9a98b6;text-transform:uppercase;letter-spacing:0.06em;">Request Submitted</p>
                        <p style="margin:0;font-size:13px;font-weight:500;color:#1e1b4b;">${result.createdAt}</p>
                    </div>
                    <i class="fas fa-clock" style="font-size:20px;color:#9a98b6;"></i>
                </div>

                ${approvalBlock}

                <div style="background:#ffffff;border:1px solid #ebebf5;border-radius:10px;padding:12px 14px;margin-bottom:8px;">
                    <p style="margin:0 0 8px;font-size:11px;font-weight:700;color:#9a98b6;text-transform:uppercase;letter-spacing:0.06em;">Order Items</p>
                    ${itemsHtml}
                    <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0 0;margin-top:4px;border-top:1.5px solid #e8eaf6;">
                        <p style="margin:0;font-size:12px;font-weight:700;color:#6b6b8a;text-transform:uppercase;letter-spacing:0.05em;">Total Refund Amount</p>
                        <p style="margin:0;font-size:16px;font-weight:800;color:#f97316;">RM ${totalRefund.toFixed(2)}</p>
                    </div>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px;">
                    <div style="background:#ffffff;border:1px solid #ebebf5;border-radius:10px;padding:10px 14px;">
                        <p style="margin:0 0 3px;font-size:11px;font-weight:700;color:#9a98b6;text-transform:uppercase;letter-spacing:0.06em;">Requested Amount</p>
                        <p style="margin:0;font-size:13px;font-weight:600;color:#f97316;">RM ${totalRefund.toFixed(2)}</p>
                    </div>
                    <div style="background:#ffffff;border:1px solid #ebebf5;border-radius:10px;padding:10px 14px;">
                        <p style="margin:0 0 3px;font-size:11px;font-weight:700;color:#9a98b6;text-transform:uppercase;letter-spacing:0.06em;">Reason</p>
                        <p style="margin:0;font-size:13px;font-weight:500;color:#1e1b4b;">${result.issueType ?? '—'}</p>
                    </div>
                </div>

                ${result.description ? `
                <div style="background:#ffffff;border:1px solid #ebebf5;border-radius:10px;padding:10px 14px;margin-bottom:8px;">
                    <p style="margin:0 0 3px;font-size:11px;font-weight:700;color:#9a98b6;text-transform:uppercase;letter-spacing:0.06em;">Description</p>
                    <p style="margin:0;font-size:13px;color:#1e1b4b;line-height:1.5;">${result.description}</p>
                </div>` : ''}

                <div style="background:#ffffff;border:1px solid #ebebf5;border-radius:10px;padding:10px 14px;">
                    <p style="margin:0 0 8px;font-size:11px;font-weight:700;color:#9a98b6;text-transform:uppercase;letter-spacing:0.06em;">Photos</p>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;">${imagesHtml}</div>
                </div>`;

            } catch (err) {
                console.error('Failed to load request details:', err);
                _renderSimpleNotes(notesEl, o);
            }

            return; // modal already opened above
        }

        // ── Normal notes (customer message, cancel reason, legacy return) ─────
        _renderSimpleNotes(notesEl, o);

        document.getElementById('od-backdrop').classList.add('active');
        document.getElementById('od-modal').classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function _renderSimpleNotes(notesEl, o) {
        const noteLines = [];
        if (o.customerMessage) noteLines.push({ icon: 'fa-comment-dots', label: 'Customer note', val: o.customerMessage });
        if (o.cancelReason)    noteLines.push({ icon: 'fa-times-circle',  label: 'Cancel reason',   val: o.cancelReason });
        if (o.returnReason)    noteLines.push({ icon: 'fa-undo',          label: 'Return reason',   val: o.returnReason });
        if (o.returnType)      noteLines.push({ icon: 'fa-exchange-alt',  label: 'Return type',     val: o.returnType.replace(/([A-Z])/g, ' $1').trim() });

        if (noteLines.length) {
            let noteHtml = noteLines.map(n => `<div class="od-note-row"><i class="fas ${n.icon} od-note-icon"></i><div><div class="od-note-label">${n.label}</div><div class="od-note-val">${n.val}</div></div></div>`).join('');
            notesEl.innerHTML = `<div class="od-section-label">Notes &amp; Remarks</div>${noteHtml}`;
            notesEl.style.display = 'block';
        } else {
            notesEl.style.display = 'none';
        }
    }

    function closeOrderDetails() {
        document.getElementById('od-backdrop').classList.remove('active');
        document.getElementById('od-modal').classList.remove('active');
        document.body.style.overflow = '';
    }

    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') { closeApproveReturnModal(); closeOrderDetails(); }
    });
    </script>

    <!-- Approve Return Modal -->
    <div id="approveReturnBackdrop" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:1000" onclick="closeApproveReturnModal()" class="approve-return-backdrop"></div>
    <div id="approveReturnModal" style="display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:#fff;border-radius:16px;padding:28px;width:min(600px,96vw);max-height:90vh;overflow-y:auto;z-index:1001;box-shadow:0 8px 40px rgba(0,0,0,.18)" class="approve-return-modal">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px">
            <i class="fas fa-check-circle" style="color:#f97316;font-size:22px"></i>
            <h3 style="margin:0;font-size:17px;font-weight:700;color:#1e1b4b">Approve Return Request</h3>
            <button onclick="closeApproveReturnModal()" style="margin-left:auto;background:none;border:none;cursor:pointer;font-size:18px;color:#9a98b6">✕</button>
        </div>
