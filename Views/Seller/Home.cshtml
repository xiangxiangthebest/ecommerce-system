@{
    ViewData["Title"] = "Seller Dashboard";
    bool isApproved = ViewBag.IsApproved == true;
}

<link rel="stylesheet" href="~/css/seller/dashboard.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<div class="dashboard-wrapper">
    <nav class="sidebar">
        <div class="sidebar-header">
            <h3 class="shop-title">@ViewBag.ShopName</h3>
        </div>
        <ul class="nav-links">
            <li class="@(ViewBag.ActiveTab == "General" ? "active" : "")">
                <a href="@Url.Action("Home", "Seller", new { tab = "General" })">
                    <span class="nav-text">General</span>
                </a>
            </li>
            @if (isApproved)
            {
                <li class="@(ViewBag.ActiveTab == "Product" ? "active" : "")">
                    <a href="@Url.Action("Home", "Seller", new { tab = "Product" })">
                        <span class="nav-text">Product</span>
                    </a>
                </li>
                <li class="@(ViewBag.ActiveTab == "Order" ? "active" : "")">
                    <a href="@Url.Action("Home", "Seller", new { tab = "Order" })">
                        <span class="nav-text">Order</span>
                    </a>
                </li>
            }
            else
            {
                <li class="nav-locked" title="Pending admin approval">
                    <span class="nav-text nav-text-locked">
                        <i class="fas fa-lock nav-lock-icon"></i> Product
                    </span>
                </li>
                <li class="nav-locked" title="Pending admin approval">
                    <span class="nav-text nav-text-locked">
                        <i class="fas fa-lock nav-lock-icon"></i> Order
                    </span>
                </li>
            }
        </ul>
        <div class="sidebar-footer">
            <form asp-controller="Auth" asp-action="Logout" method="post">
                <button type="submit" class="logout-link">Logout</button>
            </form>
        </div>
    </nav>

    <main class="content-area">

        @if (TempData["Error"] != null)
        {
            <div class="alert-banner alert-error">
                <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert-banner alert-success">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
            </div>
        }

        @if (!isApproved)
        {
            <div class="pending-approval-banner">
                <div class="pending-icon-wrap">
                    <i class="fas fa-hourglass-half pending-icon"></i>
                </div>
                <div class="pending-text-wrap">
                    <h2 class="pending-title">Account Pending Approval</h2>
                    <p class="pending-desc">
                        Your seller account is currently under review. Once an admin approves your account,
                        you will be able to list products and manage orders.
                    </p>
                    <p class="pending-desc">Please check back later or contact support if you have any questions.</p>
                </div>
            </div>
            <div class="details-container">
                <h1 class="welcome-text">Welcome, @ViewBag.ShopName!</h1>
                <div class="separator"></div>
                <p class="sub-text">Your shop has been registered. We are currently reviewing your details.</p>
            </div>
        }
        else if (ViewBag.ActiveTab == "Product")
        {
            var allProducts    = ViewBag.Products as List<EcommerceSystem.Models.Product> ?? new List<EcommerceSystem.Models.Product>();
            var activeProducts = allProducts.Where(p => !p.IsDraft).ToList();
            var draftProducts  = allProducts.Where(p => p.IsDraft).ToList();
            var bannedProducts = new List<EcommerceSystem.Models.Product>(); // placeholder for future admin ban feature

            <div class="product-header">
                <h2 class="section-title">Your Products</h2>
                <div class="header-actions">
                    <div class="search-box">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" id="product-search" placeholder="Search Product...." oninput="filterCards()" />
                    </div>
                    <a href="@Url.Action("AddProduct", "Seller")" class="btn-add-product">+ Add New Product</a>
                </div>
            </div>

            <div class="product-sub-tabs">
                <button class="pst-btn active" onclick="switchTab(this,'active')">
                    Active Product <span class="pst-count">@activeProducts.Count</span>
                </button>
                <button class="pst-btn" onclick="switchTab(this,'draft')">
                    Draft Product <span class="pst-count">@draftProducts.Count</span>
                </button>
                <button class="pst-btn" onclick="switchTab(this,'banned')">
                    Banned Product <span class="pst-count">@bannedProducts.Count</span>
                </button>
            </div>

            <div id="tab-active" class="pst-panel">
                @if (activeProducts.Any())
                {
                    <div class="product-grid-large">
                        @foreach (var item in activeProducts)
                        {
                            <div class="product-card-large" data-name="@item.Name.ToLower()">
                                <div class="pcl-image">
                                    <img src="@item.ImagePath" alt="@item.Name" />
                                </div>
                                <div class="pcl-info">
                                    <span class="pcl-category">@(item.Category?.Name ?? "—")</span>
                                    <h3 class="pcl-name">@item.Name</h3>
                                    <div class="pcl-price">RM @item.Price.ToString("F2")</div>
                                    <p class="pcl-desc">@item.Description</p>
                                    <div class="pcl-actions">
                                        <a href="@Url.Action("EditProduct", "Seller", new { id = item.ProductId })" class="btn-pcl-edit">
                                            <i class="fas fa-pen"></i> Edit
                                        </a>
                                        <form asp-action="DeleteProduct" asp-route-id="@item.ProductId" method="post"
                                              onsubmit="return confirm('Delete this product?');" style="margin:0;flex:1;">
                                            <button type="submit" class="btn-pcl-delete">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-panel">
                        <i class="fas fa-box-open empty-icon"></i>
                        <p>No active products yet. Click "+ Add New Product" to get started.</p>
                    </div>
                }
            </div>

            <div id="tab-draft" class="pst-panel" style="display:none;">
                @if (draftProducts.Any())
                {
                    <div class="product-grid-large">
                        @foreach (var item in draftProducts)
                        {
                            <div class="product-card-large" data-name="@item.Name.ToLower()">
                                <div class="pcl-image" style="position:relative;">
                                    <img src="@item.ImagePath" alt="@item.Name" />
                                    <span class="draft-badge">Draft</span>
                                </div>
                                <div class="pcl-info">
                                    <span class="pcl-category">@(item.Category?.Name ?? "—")</span>
                                    <h3 class="pcl-name">@(string.IsNullOrEmpty(item.Name) ? "(Untitled)" : item.Name)</h3>
                                    <div class="pcl-price">@(item.Price > 0 ? "RM " + item.Price.ToString("F2") : "—")</div>
                                    <p class="pcl-desc">@item.Description</p>
                                    <div class="pcl-actions">
                                        <a href="@Url.Action("EditProduct", "Seller", new { id = item.ProductId })" class="btn-pcl-edit">
                                            <i class="fas fa-pen"></i> Edit
                                        </a>
                                        <form asp-action="DeleteProduct" asp-route-id="@item.ProductId" method="post"
                                              onsubmit="return confirm('Delete this draft?');" style="margin:0;flex:1;">
                                            <button type="submit" class="btn-pcl-delete">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-panel">
                        <i class="fas fa-file-alt empty-icon"></i>
                        <p>No draft products. Products saved as draft will appear here.</p>
                    </div>
                }
            </div>

            <div id="tab-banned" class="pst-panel" style="display:none;">
                <div class="empty-state-panel">
                    <i class="fas fa-ban empty-icon"></i>
                    <p>No banned products.</p>
                </div>
            </div>

            <script>
                function switchTab(btn, name) {
                    document.querySelectorAll('.pst-btn').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    document.querySelectorAll('.pst-panel').forEach(p => p.style.display = 'none');
                    document.getElementById('tab-' + name).style.display = 'block';
                    filterCards();
                }

                function filterCards() {
                    const q = (document.getElementById('product-search')?.value || '').toLowerCase();
                    document.querySelectorAll('.product-card-large').forEach(card => {
                        card.style.display = card.getAttribute('data-name').includes(q) ? '' : 'none';
                    });
                }
            </script>
        }
        else if (ViewBag.ActiveTab == "Order")
        {
            <div class="product-header">
                <h2 class="section-title">Your Orders</h2>
            </div>
            @if (ViewBag.Orders != null && ((List<EcommerceSystem.Models.Order>)ViewBag.Orders).Any())
            {
                <table class="orders-table">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Total (RM)</th>
                            <th>Payment</th>
                            <th>Status</th>
                            <th>Return Reason</th>
                            <th>Details</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in (List<EcommerceSystem.Models.Order>)ViewBag.Orders)
                        {
                            <tr>
                                <td>#@order.OrderId</td>
                                <td>@(order.Customer?.Email ?? "—")</td>
                                <td>@order.OrderTime.ToString("dd MMM yyyy")</td>
                                <td>@order.TotalAmount.ToString("F2")</td>
                                <td>@order.PaymentMethod</td>
                                <td>
                                    <span class="status-badge status-@order.CurrentStatus.ToString().ToLower()">
                                        @order.CurrentStatus
                                    </span>
                                </td>
                                <td style="max-width:180px;font-size:12px;color:#6b6b8a;word-break:break-word">
                                    @if (!string.IsNullOrWhiteSpace(order.ReturnReason))
                                    {
                                        @* Strip the "||<json>" suffix so only the human-readable reason is shown *@
                                        var displayReason = order.ReturnReason;
                                        var sepIdx = displayReason.IndexOf("||");
                                        if (sepIdx >= 0) displayReason = displayReason[..sepIdx];
                                        @displayReason
                                    }
                                    else { <span style="color:#ccc">—</span> }
                                </td>
                                <td>
                                    <button class="btn-view-details"
                                            onclick="openOrderDetails(@order.OrderId)">
                                        <i class="fas fa-eye"></i> View
                                    </button>
                                </td>
                                <td>
                                    @{
                                        var sellerNext = EcommerceSystem.Models.Order.SellerAllowedTransitions
                                            .TryGetValue(order.CurrentStatus, out var nx) ? nx
                                            : new List<EcommerceSystem.Models.OrderStatus>();
                                    }
                                    @if (sellerNext.Any())
                                    {
                                        <form asp-action="UpdateOrderStatus" method="post" style="display:flex;gap:6px;align-items:center;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="orderId" value="@order.OrderId" />
                                            <select name="newStatus" class="status-select">
                                                @foreach (var s in sellerNext)
                                                {
                                                    <option value="@s">@s</option>
                                                }
                                            </select>
                                            <button type="submit" class="btn-update-status">Update</button>
                                        </form>
                                    }
                                    else if (order.CurrentStatus == EcommerceSystem.Models.OrderStatus.RETURN_REFUND
                                             && !order.ReturnApprovedAt.HasValue)
                                    {
                                        <!-- Approve Return button — opens a per-order modal to select items/qtys -->
                                        <button class="btn-update-status"
                                                style="background:#f97316"
                                                onclick="openApproveReturnModal(@order.OrderId)">
                                            <i class="fas fa-check-circle"></i> Approve Return
                                        </button>
                                    }
                                    else if (order.CurrentStatus == EcommerceSystem.Models.OrderStatus.RETURN_REFUND
                                             && order.ReturnApprovedAt.HasValue)
                                    {
                                        <span style="color:#22c55e;font-size:13px;font-weight:600;">
                                            <i class="fas fa-check-circle"></i> Return Approved
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color:#9a98b6;font-size:13px;font-style:italic;">No action</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state-panel" style="text-align:center;padding:60px 20px;color:#9a98b6;">
                    <i class="fas fa-shopping-bag" style="font-size:48px;opacity:0.4;display:block;margin-bottom:16px;"></i>
                    <p style="font-size:15px;font-weight:500;">No orders yet.</p>
                </div>
            }
        }
        else
        {
            <div class="details-container">
                <h1 class="welcome-text">Welcome Back, @ViewBag.ShopName!</h1>
                <div class="separator"></div>
                <p class="sub-text">Use the sidebar to manage your products and monitor your orders.</p>
            </div>
        }
    </main>
</div>

@* ── Seller: inject order data for the Approve Return modal ── *@
@if (ViewBag.ActiveTab == "Order" && ViewBag.Orders != null)
{
    // Parse the structured ReturnReason payload written by CustomerController.
    // Format: "[<reason text>]||<json-array>||<returnType>"
    static (string reason, Dictionary<int, int> requestedQtys, string returnType) ParseReturnReason(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return ("", new Dictionary<int, int>(), "");

        var sep = raw.IndexOf("||");
        if (sep < 0)
            return (raw, new Dictionary<int, int>(), "");

        var reasonPart = raw[..sep];
        var rest       = raw[(sep + 2)..];

        // Extract optional return type appended as "||ReturnRefund" etc.
        var returnType = "";
        var sep2 = rest.LastIndexOf("||");
        if (sep2 >= 0) {
            returnType = rest[(sep2 + 2)..];
            rest       = rest[..sep2];
        }

        try
        {
            var items = System.Text.Json.JsonSerializer.Deserialize<
                List<System.Text.Json.JsonElement>>(rest);

            var dict = new Dictionary<int, int>();
            if (items != null)
                foreach (var el in items)
                {
                    var id  = el.GetProperty("orderItemId").GetInt32();
                    var qty = el.GetProperty("qty").GetInt32();
                    dict[id] = qty;
                }
            return (reasonPart, dict, returnType);
        }
        catch
        {
            return (reasonPart, new Dictionary<int, int>(), returnType);
        }
    }

    var ordersForJs = ((List<EcommerceSystem.Models.Order>)ViewBag.Orders)
        .Where(o => o.CurrentStatus == EcommerceSystem.Models.OrderStatus.RETURN_REFUND
                 && !o.ReturnApprovedAt.HasValue)
        .Select(o => {
            var (_, requestedQtys, returnType) = ParseReturnReason(o.ReturnReason);
            return new {
                orderId    = o.OrderId,
                returnType = returnType,
                items      = o.OrderItems
                    .Where(oi => requestedQtys.ContainsKey(oi.OrderItemId))
                    .Select(oi => new {
                        orderItemId  = oi.OrderItemId,
                        name         = oi.Product?.Name ?? $"Item #{oi.OrderItemId}",
                        orderedQty   = oi.Quantity,
                        requestedQty = requestedQtys.GetValueOrDefault(oi.OrderItemId, oi.Quantity)
                    }).ToList()
            };
        }).ToList();

    @* ── All orders data for the View Details modal ── *@
    var allOrdersForDetails = ((List<EcommerceSystem.Models.Order>)ViewBag.Orders)
        .Select(o => {
            var displayReturnReason = o.ReturnReason ?? "";
            var rSep = displayReturnReason.IndexOf("||");
            if (rSep >= 0) displayReturnReason = displayReturnReason[..rSep];
            return new {
                orderId         = o.OrderId,
                orderTime       = o.OrderTime.ToString("dd MMM yyyy, hh:mm tt"),
                status          = o.CurrentStatus.ToString(),
                paymentMethod   = o.PaymentMethod,
                totalAmount     = o.TotalAmount.ToString("F2"),
                customerMessage = o.CustomerMessage ?? "",
                cancelReason    = o.CancelReason ?? "",
                returnReason    = displayReturnReason,
                returnType      = o.ReturnType.HasValue ? o.ReturnType.ToString() : "",
                // Customer info
                customerEmail   = o.Customer?.Email ?? "—",
                customerPhone   = o.Customer?.Phone ?? "—",
                customerName    = (o.Customer?.FullName ?? ""),
                // Delivery address
                deliveryName    = o.DeliveryRecipientName,
                deliveryPhone   = o.DeliveryPhoneNumber,
                deliveryLine1   = o.DeliveryAddressLine1,
                deliveryLine2   = o.DeliveryAddressLine2 ?? "",
                deliveryCity    = o.DeliveryCity,
                deliveryPostcode= o.DeliveryPostcode,
                deliveryState   = o.DeliveryState,
                // Order items
                items = o.OrderItems.Select(oi => new {
                    productName       = oi.Product?.Name ?? $"Product #{oi.ProductId}",
                    sku               = oi.Product?.SKU ?? "—",
                    selectedVariation = oi.SelectedVariation ?? "",
                    quantity          = oi.Quantity,
                    unitPrice         = oi.Price.ToString("F2"),
                    subtotal          = (oi.Price * oi.Quantity).ToString("F2"),
                    imagePath         = oi.Product?.ImagePath ?? "/images/placeholder.png"
                }).ToList()
            };
        }).ToList();

    <script>
    const _sellerReturnOrders = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ordersForJs));
    const _allOrderDetails    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(allOrdersForDetails));

    function openApproveReturnModal(orderId) {
        const order = _sellerReturnOrders.find(o => o.orderId === orderId);
        if (!order) return;
        document.getElementById('approveReturnOrderId').value = orderId;

        // Show the return type the customer chose
        const returnTypeLabel = {
            'ReturnRefund':  '📦 Return &amp; Refund — customer sends item back, receives money refund',
            'ReturnReplace': '🔄 Return &amp; Replace — customer sends item back, gets correct one',
            'RefundOnly':    '💰 Refund Only — item not received / missing, no physical return needed'
        };
        const rtEl = document.getElementById('approveReturnTypeInfo');
        if (rtEl) {
            const label = returnTypeLabel[order.returnType] || order.returnType || 'Not specified';
            rtEl.innerHTML = `<strong>Customer requested:</strong> ${label}`;
        }

        let html = '';
        order.items.forEach(item => {
            html += `
            <div class="ph-return-item" style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid #f0f0f8;">
                <input type="checkbox" class="approve-item-chk"
                       data-order-item-id="${item.orderItemId}" data-max="${item.requestedQty}"
                       onchange="syncApproveQty(this)" style="width:16px;height:16px;cursor:pointer" />
                <label style="flex:1">
                    <div style="font-weight:600;font-size:13px">${item.name}</div>
                    <div style="font-size:12px;color:#9a98b6">Qty in order: ${item.orderedQty} &nbsp;|&nbsp; <span style="color:#f97316;font-weight:600">Customer requested: ${item.requestedQty}</span></div>
                </label>
                <div style="display:flex;align-items:center;gap:6px">
                    <label style="font-size:12px;color:#9a98b6">Approve qty:</label>
                    <input type="number" class="approve-item-qty"
                           min="1" max="${item.requestedQty}" value="${item.requestedQty}" disabled
                           style="width:56px;padding:4px 6px;border:1px solid #e0e0f0;border-radius:6px;font-size:13px;text-align:center" />
                </div>
            </div>`;
        });
        document.getElementById('approveItemsWrap').innerHTML = html;

        document.getElementById('approveReturnBackdrop').classList.add('active');
        document.getElementById('approveReturnModal').classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function syncApproveQty(chk) {
        const row = chk.closest('.ph-return-item');
        const qty = row.querySelector('.approve-item-qty');
        if (qty) qty.disabled = !chk.checked;
    }

    function closeApproveReturnModal() {
        document.getElementById('approveReturnBackdrop').classList.remove('active');
        document.getElementById('approveReturnModal').classList.remove('active');
        document.body.style.overflow = '';
    }

    async function submitApproveReturn() {
        const orderId = document.getElementById('approveReturnOrderId').value;
        const order   = _sellerReturnOrders.find(o => o.orderId === parseInt(orderId));
        const checked = document.querySelectorAll('.approve-item-chk:checked');
        if (checked.length === 0) { alert('Please select at least one item to approve.'); return; }

        const params = new URLSearchParams();
        params.append('orderId', orderId);
        params.append('returnType', order?.returnType ?? '');
        params.append('__RequestVerificationToken',
            document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '');

        let i = 0;
        let valid = true;
        checked.forEach(chk => {
            const row = chk.closest('.ph-return-item');
            const qty = parseInt(row.querySelector('.approve-item-qty').value);
            const max = parseInt(chk.dataset.max);
            if (!qty || qty < 1 || qty > max) { valid = false; return; }
            params.append(`approveItemIds[${i}]`, chk.dataset.orderItemId);
            params.append(`approveQtys[${i}]`, qty);
            i++;
        });
        if (!valid) { alert('Invalid quantity for one or more items.'); return; }

        const btn = document.getElementById('approveReturnBtn');
        btn.disabled = true; btn.textContent = 'Approving…';

        const res = await fetch('/Seller/ApproveReturn', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: params.toString()
        });

        if (res.ok) {
            location.reload();
        } else {
            btn.disabled = false; btn.textContent = 'Approve & Process';
            alert('Failed to approve return. Please try again.');
        }
    }

    // ── Order Details Modal ──────────────────────────────────────────────────
    const statusLabels = {
        'PENDING':       { label: 'Pending',       color: '#f57f17', bg: '#fff9c4' },
        'PREPARING':     { label: 'Preparing',      color: '#1565c0', bg: '#e3f2fd' },
        'SHIPPED':       { label: 'Shipped',        color: '#1565c0', bg: '#e3f2fd' },
        'DELIVERED':     { label: 'Delivered',      color: '#2e7d32', bg: '#e8f5e9' },
        'RECEIVED':      { label: 'Received',       color: '#2e7d32', bg: '#e8f5e9' },
        'RETURN_REFUND': { label: 'Return / Refund',color: '#c62828', bg: '#ffebee' },
        'CANCELED':      { label: 'Canceled',       color: '#c62828', bg: '#ffebee' },
    };

    function openOrderDetails(orderId) {
        const o = _allOrderDetails.find(x => x.orderId === orderId);
        if (!o) return;

        const st = statusLabels[o.status] || { label: o.status, color: '#555', bg: '#f5f5f5' };

        // ── Header ──
        document.getElementById('od-title').textContent  = `Order #${o.orderId}`;
        document.getElementById('od-time').textContent   = o.orderTime;
        document.getElementById('od-status').textContent = st.label;
        document.getElementById('od-status').style.background = st.bg;
        document.getElementById('od-status').style.color      = st.color;

        // ── Customer section ──
        document.getElementById('od-cust-name').textContent  = o.customerName.trim() || '—';
        document.getElementById('od-cust-email').textContent = o.customerEmail;
        document.getElementById('od-cust-phone').textContent = o.customerPhone;

        // ── Delivery section ──
        document.getElementById('od-del-name').textContent  = o.deliveryName || '—';
        document.getElementById('od-del-phone').textContent = o.deliveryPhone || '—';
        const addrParts = [o.deliveryLine1, o.deliveryLine2, o.deliveryCity, o.deliveryPostcode, o.deliveryState]
            .filter(Boolean).join(', ');
        document.getElementById('od-del-addr').textContent = addrParts || '—';

        // ── Items ──
        let itemHtml = '';
        o.items.forEach(item => {
            itemHtml += `
            <div class="od-item-row">
                <div class="od-item-img-wrap">
                    <img src="${item.imagePath}" alt="${item.productName}" class="od-item-img"
                         onerror="this.src='/images/placeholder.png'" />
                </div>
                <div class="od-item-info">
                    <div class="od-item-name">${item.productName}</div>
                    <div class="od-item-meta">
                        <span class="od-meta-chip"><i class="fas fa-barcode"></i> ${item.sku}</span>
                        ${item.selectedVariation ? `<span class="od-meta-chip"><i class="fas fa-tag"></i> ${item.selectedVariation}</span>` : ''}
                    </div>
                </div>
                <div class="od-item-pricing">
                    <div class="od-item-qty">× ${item.quantity}</div>
                    <div class="od-item-unit">RM ${item.unitPrice} each</div>
                    <div class="od-item-subtotal">RM ${item.subtotal}</div>
                </div>
            </div>`;
        });
        document.getElementById('od-items-wrap').innerHTML = itemHtml || '<p style="color:#aaa;font-size:13px">No items found.</p>';

        // ── Total ──
        document.getElementById('od-total').textContent   = `RM ${o.totalAmount}`;
        document.getElementById('od-payment').textContent = o.paymentMethod;

        // ── Notes section ──
        const notesEl = document.getElementById('od-notes-section');
        const noteLines = [];
        if (o.customerMessage) noteLines.push({ icon: 'fa-comment-dots', label: 'Customer note', val: o.customerMessage });
        if (o.cancelReason)    noteLines.push({ icon: 'fa-times-circle',  label: 'Cancel reason',   val: o.cancelReason });
        if (o.returnReason)    noteLines.push({ icon: 'fa-undo',          label: 'Return reason',   val: o.returnReason });
        if (o.returnType)      noteLines.push({ icon: 'fa-exchange-alt',  label: 'Return type',     val: o.returnType.replace(/([A-Z])/g, ' $1').trim() });

        if (noteLines.length) {
            let noteHtml = noteLines.map(n => `
                <div class="od-note-row">
                    <i class="fas ${n.icon} od-note-icon"></i>
                    <div><div class="od-note-label">${n.label}</div><div class="od-note-val">${n.val}</div></div>
                </div>`).join('');
            notesEl.innerHTML = `<div class="od-section-label">Notes & Remarks</div>${noteHtml}`;
            notesEl.style.display = 'block';
        } else {
            notesEl.style.display = 'none';
        }

        document.getElementById('od-backdrop').classList.add('active');
        document.getElementById('od-modal').classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function closeOrderDetails() {
        document.getElementById('od-backdrop').classList.remove('active');
        document.getElementById('od-modal').classList.remove('active');
        document.body.style.overflow = '';
    }

    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') { closeApproveReturnModal(); closeOrderDetails(); }
    });
    </script>

