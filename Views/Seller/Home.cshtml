@using System.Linq

@{
    ViewData["Title"] = "MMU Shop";
    bool isApproved = ViewBag.IsApproved == true;
}

<link rel="stylesheet" href="~/css/seller/dashboard.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<div class="dashboard-wrapper">
    <nav class="sidebar">
        <div class="sidebar-header">
            <h3 class="shop-title">@ViewBag.ShopName</h3>
        </div>
        <ul class="nav-links">
            <li class="@(ViewBag.ActiveTab == "General" ? "active" : "")">
                <a href="@Url.Action("Home", "Seller", new { tab = "General" })">
                    <span class="nav-text">General</span>
                </a>
            </li>

            @if (isApproved)
            {
                <li class="@(ViewBag.ActiveTab == "Product" ? "active" : "")">
                    <a href="@Url.Action("Home", "Seller", new { tab = "Product" })">
                        <span class="nav-text">Product</span>
                    </a>
                </li>
                <li class="@(ViewBag.ActiveTab == "Order" ? "active" : "")">
                            <a href="@Url.Action("Home", "Seller", new { tab = "Order" })">
                                <span class="nav-text">Order</span>
                            </a>
                        </li>

                        <li class="@(ViewBag.ActiveTab == "Profile" ? "active" : "")">
                            <a href="@Url.Action("Home", "Seller", new { tab = "Profile" })">
                                <span class="nav-text">Profile</span>
                            </a>
                        </li>

                        <li class="@(ViewBag.ActiveTab == "Chat" ? "active" : "")">
                            <a href="@Url.Action("Home", "Seller", new { tab = "Chat" })">
                                <span class="nav-text">Chat</span>
                            </a>
                        </li>

                        <li class="@(ViewBag.ActiveTab == "Reviews" ? "active" : "")">
                            <a href="@Url.Action("Home", "Seller", new { tab = "Reviews" })">
                                <span class="nav-text">Reviews</span>
                            </a>
                        </li>
                    }
            else
            {
                <li class="nav-locked" title="Pending admin approval">
                    <span class="nav-text nav-text-locked">
                        <i class="fas fa-lock nav-lock-icon"></i> Product
                    </span>
                </li>
                <li class="nav-locked" title="Pending admin approval">
                    <span class="nav-text nav-text-locked">
                        <i class="fas fa-lock nav-lock-icon"></i> Order
                    </span>
                </li>
                <li class="nav-locked" title="Pending admin approval">
                    <span class="nav-text nav-text-locked">
                        <i class="fas fa-lock nav-lock-icon"></i> Profile
                    </span>
                </li>
                <li class="nav-locked" title="Pending admin approval">
                    <span class="nav-text nav-text-locked">
                        <i class="fas fa-lock nav-lock-icon"></i> Chat
                    </span>
                </li>
                <li class="nav-locked" title="Pending admin approval">
                    <span class="nav-text nav-text-locked">
                        <i class="fas fa-lock nav-lock-icon"></i> Reviews
                    </span>
                </li>
            }
        </ul>
        <div class="sidebar-footer">
            <form asp-controller="Auth" asp-action="Logout" method="post">
                <button type="submit" class="logout-link">Logout</button>
            </form>
        </div>
    </nav>

    <main class="content-area">

        @if (TempData["Error"] != null)
        {
            <div class="alert-banner alert-error">
                <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert-banner alert-success">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
            </div>
        }

        @if (!isApproved)
        {
            <div class="pending-approval-banner">
                <div class="pending-icon-wrap">
                    <i class="fas fa-hourglass-half pending-icon"></i>
                </div>
                <div class="pending-text-wrap">
                    <h2 class="pending-title">Account Pending Approval</h2>
                    <p class="pending-desc">
                        Your seller account is currently under review. Once an admin approves your account,
                        you will be able to list products and manage orders.
                    </p>
                    <p class="pending-desc">Please check back later or contact support if you have any questions.</p>
                </div>
            </div>
            <div class="details-container">
                <h1 class="welcome-text">Welcome, @ViewBag.ShopName!</h1>
                <div class="separator"></div>
                <p class="sub-text">Your shop has been registered. We are currently reviewing your details.</p>
            </div>
        }
        else if (ViewBag.ActiveTab == "Product")
        {
            var allProducts    = ViewBag.Products as List<EcommerceSystem.Models.Product> ?? new List<EcommerceSystem.Models.Product>();
            var activeProducts = allProducts.Where(p => !p.IsDraft && !p.IsDeleted).ToList();
            var draftProducts  = allProducts.Where(p => p.IsDraft && !p.IsDeleted).ToList();
            var bannedProducts = allProducts.Where(p => p.IsDeleted).ToList();

            <div class="product-header">
                <h2 class="section-title">Your Products</h2>
                <div class="header-actions">
                    <div class="search-box">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" id="product-search" placeholder="Search Product...." oninput="filterCards()" />
                    </div>
                    <a href="@Url.Action("AddProduct", "Seller")" class="btn-add-product">+ Add New Product</a>
                </div>
            </div>

            <div class="product-sub-tabs">
                <button class="pst-btn active" onclick="switchTab(this,'active')">
                    Active Product <span class="pst-count">@activeProducts.Count</span>
                </button>
                <button class="pst-btn" onclick="switchTab(this,'draft')">
                    Draft Product <span class="pst-count">@draftProducts.Count</span>
                </button>
                <button class="pst-btn" onclick="switchTab(this,'banned')">
                    Banned Product <span class="pst-count">@bannedProducts.Count</span>
                </button>
            </div>

            <div id="tab-active" class="pst-panel">
                @if (activeProducts.Any())
                {
                    <div class="product-grid-large">
                        @foreach (var item in activeProducts)
                        {
                            <div class="product-card-large" data-name="@item.Name.ToLower()">
                                <div class="pcl-image">
                                    <img src="@item.ImagePath" alt="@item.Name" />
                                </div>
                                <div class="pcl-info">
                                    <span class="pcl-category">@(item.Category?.Name ?? "—")</span>
                                    <h3 class="pcl-name">@item.Name</h3>
                                    <div class="pcl-price">RM @item.Price.ToString("F2")</div>

                                    @* ── Star Rating ── *@
                                    <div class="pcl-rating">
                                        @{
                                            var rating = item.AverageRating;
                                            var reviews = (int)item.ReviewCount;
                                        }
                                        @for (int s = 1; s <= 5; s++)
                                        {
                                            if (s <= Math.Floor(rating))
                                            {
                                                <i class="fas fa-star pcl-star filled"></i>
                                            }
                                            else if (s - rating < 1 && s - rating > 0)
                                            {
                                                <i class="fas fa-star-half-alt pcl-star filled"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-star pcl-star"></i>
                                            }
                                        }
                                        <span class="pcl-rating-count">
                                            @rating.ToString("F1") (@reviews @(reviews == 1 ? "review" : "reviews"))
                                        </span>
                                    </div>

                                    <p class="pcl-desc">@item.Description</p>
                                    <div class="pcl-actions">
                                        <a href="@Url.Action("EditProduct", "Seller", new { id = item.ProductId })" class="btn-pcl-edit">
                                            <i class="fas fa-pen"></i> Edit
                                        </a>
                                        <form asp-action="DeleteProduct" asp-route-id="@item.ProductId" method="post"
                                              onsubmit="return confirm('Delete this product?');" style="margin:0;flex:1;">
                                            <button type="submit" class="btn-pcl-delete">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-panel">
                        <i class="fas fa-box-open empty-icon"></i>
                        <p>No active products yet. Click "+ Add New Product" to get started.</p>
                    </div>
                }
            </div>

            <div id="tab-draft" class="pst-panel" style="display:none;">
                @if (draftProducts.Any())
                {
                    <div class="product-grid-large">
                        @foreach (var item in draftProducts)
                        {
                            <div class="product-card-large" data-name="@item.Name.ToLower()">
                                <div class="pcl-image" style="position:relative;">
                                    <img src="@item.ImagePath" alt="@item.Name" />
                                    <span class="draft-badge">Draft</span>
                                </div>
                                <div class="pcl-info">
                                    <span class="pcl-category">@(item.Category?.Name ?? "—")</span>
                                    <h3 class="pcl-name">@(string.IsNullOrEmpty(item.Name) ? "(Untitled)" : item.Name)</h3>
                                    <div class="pcl-price">@(item.Price > 0 ? "RM " + item.Price.ToString("F2") : "—")</div>
                                    <p class="pcl-desc">@item.Description</p>
                                    <div class="pcl-actions">
                                        <a href="@Url.Action("EditProduct", "Seller", new { id = item.ProductId })" class="btn-pcl-edit">
                                            <i class="fas fa-pen"></i> Edit
                                        </a>
                                        <form asp-action="DeleteProduct" asp-route-id="@item.ProductId" method="post"
                                              onsubmit="return confirm('Delete this draft?');" style="margin:0;flex:1;">
                                            <button type="submit" class="btn-pcl-delete">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-panel">
                        <i class="fas fa-file-alt empty-icon"></i>
                        <p>No draft products. Products saved as draft will appear here.</p>
                    </div>
                }
            </div>

            <div id="tab-banned" class="pst-panel" style="display:none;">
                @if (bannedProducts.Any())
                {
                    <div class="product-grid-large">
                        @foreach (var item in bannedProducts)
                        {
                            <div class="product-card-large" data-name="@item.Name.ToLower()">
                                <div class="pcl-image" style="position:relative;">
                                    <img src="@item.ImagePath" alt="@item.Name" style="filter:grayscale(60%);" />
                                    <span class="draft-badge" style="background:#f8d7da;color:#842029;border-color:#f5c2c7;">
                                        <i class="fas fa-ban" style="margin-right:3px;"></i> Banned
                                    </span>
                                </div>
                                <div class="pcl-info">
                                    <span class="pcl-category">@(item.Category?.Name ?? "—")</span>
                                    <h3 class="pcl-name">@(string.IsNullOrEmpty(item.Name) ? "(Untitled)" : item.Name)</h3>
                                    <div class="pcl-price" style="color:#dc3545;">@(item.Price > 0 ? "RM " + item.Price.ToString("F2") : "—")</div>
                                    <p class="pcl-desc">@item.Description</p>
                                    @if (item.DeletedAt.HasValue)
                                    {
                                        <p style="font-size:11px;color:#9a98b6;margin-bottom:10px;">
                                            <i class="fas fa-clock" style="margin-right:4px;"></i>
                                            Removed on @item.DeletedAt.Value.ToString("dd MMM yyyy")
                                        </p>
                                    }
                                    <div class="pcl-actions" style="border-top:1px solid #ffd6d6;">
                                        <span style="font-size:12px;color:#dc3545;font-weight:600;padding:8px 0;display:flex;align-items:center;gap:6px;">
                                            <i class="fas fa-exclamation-circle"></i>
                                            This product has been removed by admin
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-panel">
                        <i class="fas fa-ban empty-icon"></i>
                        <p>No banned products.</p>
                    </div>
                }
            </div>

            <script>
                function switchTab(btn, name) {
                    document.querySelectorAll('.pst-btn').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    document.querySelectorAll('.pst-panel').forEach(p => p.style.display = 'none');
                    document.getElementById('tab-' + name).style.display = 'block';
                    filterCards();
                }

                function filterCards() {
                    const q = (document.getElementById('product-search')?.value || '').toLowerCase();
                    document.querySelectorAll('.product-card-large').forEach(card => {
                        card.style.display = card.getAttribute('data-name').includes(q) ? '' : 'none';
                    });
                }

                document.addEventListener('DOMContentLoaded', function () {
                    var params = new URLSearchParams(window.location.search);
                    var search = params.get('search');
                    if (search) {
                        var input = document.getElementById('product-search');
                        if (input) {
                            input.value = decodeURIComponent(search);
                            filterCards();
                        }
                    }

                    // Auto-switch to draft or active sub-tab based on URL ?subtab=
                    var subtab = params.get('subtab');
                    if (subtab === 'draft' || subtab === 'active') {
                        var targetBtn = document.querySelector('.pst-btn[onclick*="' + subtab + '"]');
                        if (targetBtn) targetBtn.click();
                    }
                });
            </script>
        }
        else if (ViewBag.ActiveTab == "Order")
        {
            var allOrders = ViewBag.Orders as List<EcommerceSystem.Models.Order> ?? new List<EcommerceSystem.Models.Order>();

            int cntAll          = allOrders.Count;
            int cntPending      = allOrders.Count(o => o.CurrentStatus == EcommerceSystem.Models.OrderStatus.PENDING);
            int cntPreparing    = allOrders.Count(o => o.CurrentStatus == EcommerceSystem.Models.OrderStatus.PREPARING);
            int cntShipped      = allOrders.Count(o => o.CurrentStatus == EcommerceSystem.Models.OrderStatus.SHIPPED);
            int cntDelivered    = allOrders.Count(o => o.CurrentStatus == EcommerceSystem.Models.OrderStatus.DELIVERED);
            int cntReceived     = allOrders.Count(o => o.CurrentStatus == EcommerceSystem.Models.OrderStatus.RECEIVED);
            int cntCanceled     = allOrders.Count(o => o.CurrentStatus == EcommerceSystem.Models.OrderStatus.CANCELED);
            int cntReturnRefund = allOrders.Count(o => o.CurrentStatus == EcommerceSystem.Models.OrderStatus.RETURN_REFUND
                                                 || o.CurrentStatus == EcommerceSystem.Models.OrderStatus.AFTER_SALES_REQUESTED);

            <div class="product-header" style="margin-bottom:20px">
                <h2 class="section-title">Your Orders</h2>
            </div>

            <!-- Bell Icon (moved to fixed overlay so it is never occluded) -->

            <div class="order-tabs" id="orderTabs">
                <button class="order-tab active" data-status="ALL">All <span class="order-tab-badge">@cntAll</span></button>
                <button class="order-tab" data-status="PENDING">Pending <span class="order-tab-badge">@cntPending</span></button>
                <button class="order-tab" data-status="PREPARING">Processing <span class="order-tab-badge">@cntPreparing</span></button>
                <button class="order-tab" data-status="SHIPPED">Shipped <span class="order-tab-badge">@cntShipped</span></button>
                <button class="order-tab" data-status="DELIVERED">Delivered <span class="order-tab-badge">@cntDelivered</span></button>
                <button class="order-tab" data-status="RECEIVED">Completed <span class="order-tab-badge">@cntReceived</span></button>
                <button class="order-tab" data-status="CANCELED">Cancelled <span class="order-tab-badge">@cntCanceled</span></button>
                <button class="order-tab" data-status="RETURN_REFUND">Return/Refund <span class="order-tab-badge">@cntReturnRefund</span></button>
            </div>

            <div class="order-filter-bar">
                <div class="order-search-wrap">
                    <i class="fas fa-search" style="color:#9a98b6;font-size:13px"></i>
                    <input type="text" id="orderSearch" placeholder="Search by Order ID or customer email…" oninput="applyOrderFilters()" />
                </div>
                <div class="order-search-wrap">
                    <i class="fas fa-barcode" style="color:#9a98b6;font-size:13px"></i>
                    <input type="text" id="orderSkuFilter" placeholder="Filter by product SKU…" oninput="applyOrderFilters()" />
                </div>
            </div>

            @if (allOrders.Any())
            {
                <table class="orders-table" id="ordersTable">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Total (RM)</th>
                            <th>Payment</th>
                            <th>Status</th>
                            <th>Details</th>
                            <th>Chat</th> <!-- 已加：独立的 Chat 列标题 -->
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="ordersTableBody">
                        @foreach (var order in allOrders)
                        {
                            // Map AFTER_SALES_REQUESTED → RETURN_REFUND so it appears under the Return/Refund tab
                            var rawStatusKey = order.CurrentStatus.ToString().ToUpper();
                            var statusKey    = rawStatusKey == "AFTER_SALES_REQUESTED" ? "RETURN_REFUND" : rawStatusKey;
                            var skuList    = string.Join(" ", order.OrderItems.Select(oi => oi.Product?.SKU ?? "")).ToLower();
                            var searchHint = ("#" + order.OrderId + " " + (order.Customer?.Email ?? "")).ToLower();
                            
                            <tr data-status="@statusKey" data-search="@searchHint" data-sku="@skuList">
                                <td>#@order.OrderId</td>
                                <td>@(order.Customer?.Email ?? "—")</td>
                                <td>@order.OrderTime.ToString("dd MMM yyyy")</td>
                                <td>@order.TotalAmount.ToString("F2")</td>
                                <td>@order.PaymentMethod</td>
                                <td>
                                    @{
                                        var isReturnApproved  = (order.CurrentStatus == EcommerceSystem.Models.OrderStatus.RETURN_REFUND
                                                               || order.CurrentStatus == EcommerceSystem.Models.OrderStatus.AFTER_SALES_REQUESTED)
                                                               && order.ReturnApprovedAt.HasValue;
                                        var isPendingCS       = order.CurrentStatus == EcommerceSystem.Models.OrderStatus.AFTER_SALES_REQUESTED
                                                               && !order.ReturnApprovedAt.HasValue;
                                    }
                                    @if (isReturnApproved)
                                    {
                                        <span class="status-badge" style="background:#dcfce7;color:#15803d;border:1px solid #86efac;">
                                            RETURN/REFUND APPROVED
                                        </span>
                                    }
                                    else if (isPendingCS)
                                    {
                                        <span class="status-badge" style="background:#fffbeb;color:#b45309;border:1px solid #fcd34d;">
                                            PENDING CS APPROVAL
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-@order.CurrentStatus.ToString().ToLower()">
                                            @order.CurrentStatus
                                        </span>
                                    }
                                </td>
                                <td>
                                    <button class="btn-view-details" onclick="openOrderDetails(@order.OrderId)">
                                        <i class="fas fa-eye"></i> View
                                    </button>
                                </td>
                                <td>
                                   @if (order.Customer != null)
                                        {
                                            <a href="@Url.Action("StartConversationFromOrder", "Chat", new { customerId = order.CustomerUserId })" 
                                            class="btn-order-chat" 
                                            title="Chat with Customer">
                                                <i class="fas fa-comments"></i>
                                            </a>
                                        }
                                    else
                                    {
                                        <span style="color:#ccc">—</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var sellerNext = EcommerceSystem.Models.Order.SellerAllowedTransitions
                                            .TryGetValue(order.CurrentStatus, out var nx) ? nx
                                            : new List<EcommerceSystem.Models.OrderStatus>();
                                    }
                                    @* Seller workflow stops at DELIVERED. Return/Refund approval
                                       is now handled by Customer Service, so anything past the
                                       seller's own transitions simply shows "No action". *@
                                    @if (sellerNext.Any())
                                    {
                                        <form asp-action="UpdateOrderStatus" method="post" style="display:flex;gap:6px;align-items:center;margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="orderId" value="@order.OrderId" />
                                            <select name="newStatus" class="status-select">
                                                @foreach (var s in sellerNext)
                                                {
                                                    <option value="@s">@s</option>
                                                }
                                            </select>
                                            <button type="submit" class="btn-update-status">Update</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span style="color:#9a98b6;font-size:13px;font-style:italic;white-space:nowrap;">No action</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div id="orderNoResults" class="empty-state-panel" style="display:none;">
                    <i class="fas fa-search empty-icon"></i>
                    <p>No orders match your filter.</p>
                </div>
            }
            else
            {
                <div class="empty-state-panel">
                    <i class="fas fa-shopping-bag empty-icon"></i>
                    <p>No orders yet.</p>
                </div>
            }

            <script>
            document.querySelectorAll('.order-tab').forEach(tab => {
                tab.addEventListener('click', () => {
                    document.querySelectorAll('.order-tab').forEach(t => t.classList.remove('active'));
                    tab.classList.add('active');
                    applyOrderFilters();
                });
            });

            function applyOrderFilters() {
                const status = document.querySelector('.order-tab.active')?.dataset.status ?? 'ALL';
                const search = (document.getElementById('orderSearch')?.value ?? '').toLowerCase().trim();
                const sku    = (document.getElementById('orderSkuFilter')?.value ?? '').toLowerCase().trim();

                let visible = 0;
                document.querySelectorAll('#ordersTableBody tr').forEach(row => {
                    const matchStatus = status === 'ALL' || row.dataset.status === status;
                    const matchSearch = !search || row.dataset.search.includes(search);
                    const matchSku    = !sku    || row.dataset.sku.includes(sku);
                    const show = matchStatus && matchSearch && matchSku;
                    row.style.display = show ? '' : 'none';
                    if (show) visible++;
                });

                const noRes = document.getElementById('orderNoResults');
                const table = document.getElementById('ordersTable');
                if (noRes && table) {
                    noRes.style.display = visible === 0 ? 'flex' : 'none';
                    table.style.display = visible === 0 ? 'none' : '';
                }
            }
            </script>
        }
        else if (ViewBag.ActiveTab == "Profile")
        {
            var profileSeller = ViewBag.ProfileSeller as EcommerceSystem.Models.Seller;

            <div class="details-container" style="max-width:620px; margin:0 auto;">
                <h1 class="welcome-text" style="font-size:28px; text-align:center;">My Profile</h1>
                <div class="separator"></div>

                @if (TempData["ProfileError"] != null)
                {
                    <div class="alert-banner alert-error" style="margin-bottom:18px;">
                        <i class="fas fa-exclamation-circle"></i> @TempData["ProfileError"]
                    </div>
                }
                @if (TempData["ProfileSuccess"] != null)
                {
                    <div class="alert-banner alert-success" style="margin-bottom:18px;">
                        <i class="fas fa-check-circle"></i> @TempData["ProfileSuccess"]
                    </div>
                }

                @* ── Read-only fields ── *@
                <div class="profile-field">
                    <label class="profile-label">Full Name</label>
                    <div class="profile-value">@(profileSeller?.FullName ?? "—")</div>
                </div>
                <div class="profile-field">
                    <label class="profile-label">Email</label>
                    <div class="profile-value">@(profileSeller?.Email ?? "—")</div>
                </div>
                <div class="profile-field">
                    <label class="profile-label">Contact Number</label>
                    <div class="profile-value">@(profileSeller?.PhoneNumber ?? "—")</div>
                </div>
                <div class="profile-field">
                    <label class="profile-label">TIN Number</label>
                    <div class="profile-value">@(profileSeller?.TIN ?? "—")</div>
                </div>

                <div class="separator" style="margin:22px 0;"></div>

                @* ── Editable address field only ── *@
                <form asp-action="UpdateAddress" asp-controller="Seller" method="post">
                    @Html.AntiForgeryToken()
                    <div class="profile-field">
                        <label class="profile-label" for="address">
                            Address
                            <span style="color:#6366f1;font-size:11px;font-weight:600;
                                         text-transform:none;letter-spacing:0;margin-left:6px;">
                                (editable)
                            </span>
