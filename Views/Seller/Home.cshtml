        else if (ViewBag.ActiveTab == "ChatRoom")
        {
            <div class="p-1 bg-white rounded shadow-sm border">
                <partial name="~/Views/Seller/ChatRoom.cshtml" model="Model" />
            </div>
        }
        else if (ViewBag.ActiveTab == "Reviews")
        {
            var allProductsRv    = ViewBag.Products as List<EcommerceSystem.Models.Product> ?? new List<EcommerceSystem.Models.Product>();
            var reviewsByProduct = ViewBag.ReviewsByProduct as Dictionary<int, List<EcommerceSystem.Models.Review>>
                                   ?? new Dictionary<int, List<EcommerceSystem.Models.Review>>();

            var productsWithReviews = allProductsRv
                .Where(p => !p.IsDeleted && reviewsByProduct.ContainsKey(p.ProductId) && reviewsByProduct[p.ProductId].Any())
                .OrderByDescending(p => reviewsByProduct[p.ProductId].Count)
                .ToList();

            int totalAllReviews = productsWithReviews.Sum(p => reviewsByProduct[p.ProductId].Count);

            <div class="product-header" style="margin-bottom: 20px;">
                <h2 class="section-title">Customer Reviews</h2>
                @if (totalAllReviews > 0)
                {
                    <span style="font-size:13px;color:#9a98b6;font-weight:600;">@totalAllReviews review@(totalAllReviews == 1 ? "" : "s") across @productsWithReviews.Count product@(productsWithReviews.Count == 1 ? "" : "s")</span>
                }
