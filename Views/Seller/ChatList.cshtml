@model List<EcommerceSystem.ViewModels.ChatBoxListMV>

<link rel="stylesheet" href="~/css/customer/chat-list.css" asp-append-version="true" />

<div class="chat-list-page">
    <div class="page-header">
        <h1 class="page-title">
            <i class="ti ti-message-circle-2"></i>
            Message Center
        </h1>
        <p class="page-subtitle">Your conversations with sellers</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="inbox-search-wrap">
            <i class="ti ti-search"></i>
            <input type="text" class="inbox-search-input" id="inboxSearch"
                   placeholder="Search conversations…" autocomplete="off" />
        </div>
    }

    <div class="inbox-card">

        @if (Model == null || !Model.Any())
        {
            <div class="inbox-empty">
                <i class="ti ti-message-off"></i>
                <p>No conversations yet</p>
                <small>Chat with a seller from any product page to get started.</small>
            </div>
        }
        else
        {
            <div id="conversationList">
                @foreach (var item in Model)
                {
                    var displayName = item.SellerName ?? item.CustomerName ?? "Unknown";
                    var initial     = displayName.Length > 0 ? displayName[0].ToString().ToUpper() : "U";
                    var hasUnread   = item.UnreadCount > 0;

                    // Sanitise preview text
                    var preview = item.LastMessage ?? "";
                    if      (preview.StartsWith("[PRODUCT_CARD]")) preview = "Sent a product";
                    else if (preview.StartsWith("[ORDER_TAG]"))    preview = "Sent an order";
                    else if (preview.StartsWith("[IMAGE_CARD]"))   preview = "Sent an image";

                    // Format time nicely
                    var timeStr = "";
                    if (item.LastMessageTime.HasValue)
                    {
                        var local = item.LastMessageTime.Value.ToLocalTime();
                        var now   = DateTime.Now;
                        timeStr   = local.Date == now.Date
                            ? local.ToString("HH:mm")
                            : local.Date == now.Date.AddDays(-1)
                                ? "Yesterday"
                                : local.ToString("MMM d");
                    }

                    <a href="@Url.Action("SellerConversation", "Chat", new { id = item.ChatRoomId })" 
                       class="conversation-item @(hasUnread ? "has-unread" : "")"
                       data-name="@displayName.ToLower()">

                        <div class="conv-avatar">@initial</div>

                        <div class="conv-body">
                            <h6 class="conv-name">@displayName</h6>
                            <p class="conv-preview">
                                @(string.IsNullOrEmpty(preview) ? "No messages yet" : preview)
                            </p>
                        </div>

                        <div class="conv-meta">
                            <span class="conv-time">@timeStr</span>
                            @if (hasUnread)
                            {
                                <span class="conv-badge">@item.UnreadCount</span>
                            }
                        </div>

                        <i class="ti ti-chevron-right conv-chevron"></i>
                    </a>
                }
            </div>
        }

    </div>
</div>

<script>
    var searchInput = document.getElementById('inboxSearch');
    if (searchInput) {
        searchInput.addEventListener('input', function () {
            var q = this.value.toLowerCase().trim();
            document.querySelectorAll('.conversation-item').forEach(function (item) {
                item.style.display = item.getAttribute('data-name').includes(q) ? '' : 'none';
            });
        });
    }
</script>

