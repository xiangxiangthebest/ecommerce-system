@model EcommerceSystem.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<link rel="stylesheet" href="~/css/seller/dashboard.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<div class="dashboard-wrapper">

    <!-- ── Sidebar ── -->
    <nav class="sidebar">
        <div class="sidebar-header">
            <h3 class="shop-title">@ViewBag.ShopName</h3>
        </div>
        <ul class="nav-links">
            <li><a href="@Url.Action("Home", "Seller", new { tab = "General" })">General</a></li>
            <li class="active">
                <a href="@Url.Action("Home", "Seller", new { tab = "Product" })">Product</a>
                <ul class="sub-nav">
                    <li class="sub-active">Edit Product</li>
                </ul>
            </li>
            <li><a href="@Url.Action("Home", "Seller", new { tab = "Order" })">Order</a></li>
        </ul>
        <div class="sidebar-footer">
            <form asp-controller="Auth" asp-action="Logout" method="post">
                <button type="submit" class="logout-link">Logout</button>
            </form>
        </div>
    </nav>

    <!-- ── Main Content ── -->
    <main class="content-area">
        <div class="add-product-container">
            <h1 class="shop-title">@ViewBag.ShopName - Edit Product</h1>

            <form id="editForm"
                  asp-controller="Seller"
                  asp-action="EditProduct"
                  method="post"
                  enctype="multipart/form-data">

                <!-- Hidden field to pass the ProductId back -->
                <input type="hidden" name="ProductId" value="@Model.ProductId" />

                <div class="form-body">

                    <div class="form-row">
                        <label>Product Price:</label>
                        <input type="number" name="Price" step="0.01" required value="@Model.Price" />
                    </div>

                    <div class="form-row">
                        <label>Product SKU:</label>
                        <input type="text" name="SKU" required value="@Model.SKU" />
                    </div>

                    <div class="form-row">
                        <label>Product Name:</label>
                        <input type="text" name="Name" required value="@Model.Name" />
                    </div>

                    <div class="form-row">
                        <label>Quantity (Stock):</label>
                        <input type="number" name="StockQuantity" min="0" required value="@Model.StockQuantity" />
                    </div>

                    <div class="form-row">
                        <label>Categories:</label>
                        <select name="Category" class="category-select" required>
                            <option value="" disabled>Select a category</option>
                            <option value="Fashion/Apparel">Fashion/Apparel</option>
                            <option value="Consumer Electronics">Consumer Electronics</option>
                            <option value="Food and Beverages">Food and Beverages</option>
                            <option value="Beauty and Personal Care">Beauty and Personal Care</option>
                            <option value="Home Improvement">Home Improvement</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="upload-section">
                        <label>Product Image (leave blank to keep current):</label>
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <div style="margin-bottom: 8px;">
                                <img src="@Model.ImagePath" alt="Current image" style="max-height: 120px; border-radius: 6px;" />
                                <p style="font-size: 12px; color: #666;">Current image</p>
                            </div>
                        }
                        <label for="file-upload" class="upload-box" id="drop-zone">
                            <img src="~/images/cloud-upload-icon.png" alt="Upload" class="upload-icon" id="preview-icon" />
                            <span class="upload-text" id="upload-text">Upload New Image (optional)</span>
                            <input type="file" id="file-upload" name="ImageFile"
                                accept="image/*,video/*" style="display: none;"
                                onchange="handleFileSelect(this)" />
                            <span id="file-name-display" class="file-name-text"></span>
                            <button type="button" id="remove-file-btn" class="btn-remove" style="display: none;" onclick="removeFile(event)">
                                Remove
                            </button>
                        </label>
                    </div>

                    <div class="description-section">
                        <label>Product Description:</label>
                        <textarea name="Description" rows="5">@Model.Description</textarea>
                    </div>

                </div>

                <!-- Action Buttons -->
                <div class="fixed-right-actions">
                    <a href="@Url.Action("Home", "Seller", new { tab = "Product" })" class="btn-navy-side">Cancel</a>
                    <button type="submit" name="actionType" value="Publish" class="btn-navy-side">Save &amp; Publish</button>
                    <button type="submit" name="actionType" value="Draft" class="btn-navy-side">Save as Draft</button>
                </div>

            </form>
        </div>
    </main>

</div>

<script>
    function handleFileSelect(input) {
        const display = document.getElementById('file-name-display');
        const removeBtn = document.getElementById('remove-file-btn');
        const uploadText = document.getElementById('upload-text');
        const icon = document.getElementById('preview-icon');

        if (input.files && input.files[0]) {
            const file = input.files[0];
            display.innerText = "Selected: " + file.name;

            if (file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    icon.src = e.target.result;
                    icon.style.width = "150px";
                    icon.style.height = "auto";
                };
                reader.readAsDataURL(file);
            }

            removeBtn.style.display = "inline-block";
            uploadText.style.display = "none";
        }
    }

    function removeFile(event) {
        event.preventDefault();
        event.stopPropagation();

        const input = document.getElementById('file-upload');
        const display = document.getElementById('file-name-display');
        const removeBtn = document.getElementById('remove-file-btn');
        const uploadText = document.getElementById('upload-text');
        const icon = document.getElementById('preview-icon');

        input.value = "";
        display.innerText = "";
        removeBtn.style.display = "none";
        uploadText.style.display = "block";
        icon.src = "/images/cloud-upload-icon.png";
        icon.style.width = "60px";
    }
</script>
