@model EcommerceSystem.DTOs.RegisterCustomerDto

@{
    Layout = "_AuthLayout";
    var role = ViewBag.Role as string;
}

<link rel="stylesheet" href="~/css/auth.css" />

<div class="auth-container">

    <div class="auth-card">

        <div class="auth-top">
            <div class="auth-badge">Customer Portal</div>
            <h1>Create Account</h1>
            <p>Register as a customer and start using the platform.</p>
        </div>
        
        <form method="post" class="auth-form">

            <div class="form-group">
                <label>Full Name</label>
                <input asp-for="FullName" class="form-control" placeholder="Enter your full name" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Create your password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm your password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="auth-btn">
                Create Account
            </button>

        </form>

        <div class="auth-bottom">
            <span>Already have an account?</span>

            <a href="/Auth/Login?role=@role">
                Login
            </a>
        </div>

    </div>

</div>