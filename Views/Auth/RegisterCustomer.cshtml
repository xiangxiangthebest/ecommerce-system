@model EcommerceSystem.DTOs.RegisterCustomerDto

@{
    Layout = "_AuthLayout";
    var role = ViewBag.Role as string ?? "Customer";
}

<link rel="stylesheet" href="~/css/auth/auth.css" />

<div class="auth-container">

    <div class="auth-brand">
        <div class="auth-brand-icon">
            <svg viewBox="0 0 24 24">
                <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                <line x1="3" y1="6" x2="21" y2="6"/>
                <path d="M16 10a4 4 0 01-8 0"/>
            </svg>
        </div>
        <span class="auth-brand-name">MMU Shop</span>
    </div>

    <div class="auth-card">

        <div class="auth-top">
            <div class="auth-badge">
                <span class="auth-badge-dot"></span>
                Customer Portal
            </div>
            <h1>Create account</h1>
            <p>Register to start shopping on MMU Shop.</p>
        </div>

        <form asp-controller="Auth" asp-action="RegisterCustomer" method="post" class="auth-form">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Full name</label>
                <input asp-for="FullName" placeholder="Your full name" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Email address</label>
                <input asp-for="Email" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Password</label>
                <div class="password-wrapper">
                    <input asp-for="Password" type="password" id="password" placeholder="Create a password" />
                    <span class="toggle-password" onclick="togglePassword('password', this)">
                        <i class="ti ti-eye"></i>
                    </span>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Confirm password</label>
                <div class="password-wrapper">
                    <input asp-for="ConfirmPassword" type="password" id="confirmPassword" placeholder="Confirm your password" />
                    <span class="toggle-password" onclick="togglePassword('confirmPassword', this)">
                        <i class="ti ti-eye"></i>
                    </span>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="auth-btn">Create account</button>
        </form>

        <div class="auth-divider"></div>
        <div class="auth-bottom">
            Already have an account?
            <a href="/Auth/Login?role=@role">Sign in</a>
        </div>

    </div>

    <p class="auth-footer">© 2026 CSE6234 TT5L Group 4. All rights reserved.</p>

</div>

<script>
    function togglePassword(inputId, el) {
        const input = document.getElementById(inputId);
        const icon  = el.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('ti-eye', 'ti-eye-off');
        } else {
            input.type = 'password';
            icon.classList.replace('ti-eye-off', 'ti-eye');
        }
    }
</script>
