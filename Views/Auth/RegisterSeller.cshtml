@{
    Layout = "_AuthLayout";
    var role = ViewBag.Role as string;
}

<link rel="stylesheet" href="~/css/seller-register.css" />

<div class="auth-container">
    <div class="auth-card seller-card">

    @if (ViewBag.Error != null)
    {
        <div id="errorBackdrop" class="modal-backdrop">
            <div id="errorToast" class="modal-window">
                <h2>⚠️ Registration Error</h2>
                @* Use Html.Raw to allow the <br /> tag to work *@
                <p>@Html.Raw(ViewBag.Error)</p>
            </div>
        </div>
    }

        @**Badge + Title*@
        <div class="auth-top">
            <div class="auth-badge">Seller Portal</div>
            <h1>Seller Registration</h1>
            <p>Register your business and start selling on the platform.</p>
        </div>



        @**── Progress Stepper ──*@
        <div class="progress-stepper">

            <div class="step active" id="step-indicator-1">
                <div class="step-circle">
                    <span class="num">1</span>
                    <span class="check">✓</span>
                </div>
                <span class="step-label">Seller Info</span>
            </div>

            <div class="step-connector" id="connector"></div>

            <div class="step" id="step-indicator-2">
                <div class="step-circle">
                    <span class="num">2</span>
                    <span class="check">✓</span>
                </div>
                <span class="step-label">Shop Info</span>
            </div>

        </div>

        @if (ViewBag.Error != null)
        {
            <div class="error-message">
                @ViewBag.Error
            </div>
        }

        <form method="post" id="seller-form">

            <div class="form-step active" id="form-step-1">

                <div class="section-label">Seller Information</div>

                <div class="form-group">
                    <label>Full Name</label>
                    <input type="text"
                           name="FullName"
                           maxlength="50"
                           placeholder="Enter full name"
                           required />
                    <span class="field-reminder"></span>
                </div>

                <div class="form-group">
                    <label>NRIC Number</label>
                    <input type="text"
                           name="NRICNumber"
                           maxlength="12"
                           placeholder="980101012345"
                           inputmode="numeric"
                           pattern="[0-9]*"
                           oninput="this.value = this.value.replace(/[^0-9]/g, '')"
                           required />
                    <span class="field-reminder"></span>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>State</label>
                        <input type="text"
                               name="State"
                               placeholder="Selangor"
                               required />
                        <span class="field-reminder"></span>
                    </div>

                    <div class="form-group">
                        <label>Postal Code</label>
                        <input type="text"
                               name="PostalCode"
                               placeholder="43200"
                               maxlength="5"
                               inputmode="numeric"
                               pattern="[0-9]*"
                               oninput="this.value = this.value.replace(/[^0-9]/g, '')"
                               required />
                        <span class="field-reminder"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label>Detail Address</label>
                    <textarea name="DetailAddress"
                              rows="3"
                              placeholder="Enter detailed address"
                              required></textarea>
                    <span class="field-reminder"></span>
                </div>

                @* ── TIN Field ── *@
                <div class="form-group">
                    <label>Tax Identification Number (TIN)</label>
                    <input type="text"
                        id="tinInput"
                        name="TIN"
                        maxlength="14"
                        placeholder="e.g., IG115002000"
                        required />
                    <span class="field-reminder"></span>
                </div>

                <div class="step-nav">
                    <button type="button" class="btn-next" onclick="goToStep(2)">Next</button>
                </div>

            </div>

            @**════════════════════════════*@
            @**STEP 2 — Shop Information  *@
            @**════════════════════════════*@
            <!-- RegisterSeller.cshtml (Step 2 portion) -->
            <div class="form-step" id="form-step-2">
                <div class="section-label">Shop Information</div>

                <div class="form-group">
                    <label>Shop Name</label>
                    <input type="text" name="ShopName" placeholder="Enter Shop Name" required />
                    <span class="field-reminder"></span> 
                </div>

                <div class="form-group">
                    <label>Pickup Address</label>
                    <textarea name="PickupAddress" rows="3" placeholder="Enter Pickup Address" required></textarea>
                    <span class="field-reminder"></span> 
                </div>

                <div class="form-group">
                    <label>Email Address</label>
                    <input type="email" name="Email" placeholder="Enter Email Address" required />
                    <span class="field-reminder"></span> 
                </div>

                <div class="form-group">
                    <label>Phone Number</label>
                    <div class="phone-input">
                        <span>+60</span>
                        <input type="text" name="PhoneNumber" maxlength="10" placeholder="123456789" required />
                    </div>
                    <span class="field-reminder"></span> 
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <div class="password-wrapper">
                        <input type="password" id="password" name="Password" placeholder="Create a Password" required />
                        <span class="toggle-password" onclick="togglePassword('password', this)">
                            <i class="fa-solid fa-eye"></i>
                        </span>
                    </div>
                    <span class="field-reminder"></span> 
                </div>

                <div class="form-group">
                    <label>Confirm Password</label>
                    <div class="password-wrapper">
                        <input type="password" id="confirmPassword" name="ConfirmPassword" placeholder="Confirm Password" required />
                        <span class="toggle-password" onclick="togglePassword('confirmPassword', this)">
                            <i class="fa-solid fa-eye"></i>
                        </span>
                    </div>
                    <span class="field-reminder"></span> 
                </div>

                <div class="step-nav">
                    <button type="button" class="btn-back" onclick="goToStep(1)">Back</button>
                    <button type="submit" class="btn-submit">Submit</button>
                </div>
            </div>

        </form>

        <div class="auth-bottom">
            <span>Already have an account?</span>
            <a href="/Auth/Login?role=Seller">Login</a>
        </div>

    </div>
</div>

<script>

function togglePassword(inputId, element) {

    const input = document.getElementById(inputId);
    const icon = element.querySelector("i");

    if (input.type === "password") {
        input.type = "text";

        icon.classList.remove("fa-eye");
        icon.classList.add("fa-eye-slash");
    }
    else {
        input.type = "password";

        icon.classList.remove("fa-eye-slash");
        icon.classList.add("fa-eye");
    }
}

// ─── HELPER FUNCTIONS FOR ERRORS ───
function showError(input, message) {
    input.classList.add('invalid-field');

    // For phone input, the field-reminder is on the parent .form-group, not inside .phone-input
    var container = input.closest('.phone-input') ? input.closest('.form-group') : input.parentNode;
    var errorMsg = container.querySelector('.field-reminder');
    if (!errorMsg) {
        errorMsg = document.createElement('span');
        errorMsg.className = 'field-reminder';
        container.appendChild(errorMsg);
    }
    errorMsg.style.color = '#d8000c';
    errorMsg.style.fontSize = '12px';
    errorMsg.style.marginTop = '4px';
    errorMsg.style.fontWeight = '500';
    errorMsg.textContent = message;
    errorMsg.style.display = 'block';
}

function hideError(input) {
    input.classList.remove('invalid-field');
    var container = input.closest('.phone-input') ? input.closest('.form-group') : input.parentNode;
    var errorMsg = container.querySelector('.field-reminder');
    if (errorMsg) {
        errorMsg.style.display = 'none';
    }
}

// ─── NAVIGATION FUNCTION ───
function goToStep(step) {

    if (step === 2) {
        var isValid = true;
        var firstInvalidInput = null;

        // Select all required inputs in Step 1
        var fullName = document.querySelector('input[name="FullName"]');
        var nric     = document.querySelector('input[name="NRICNumber"]');
        var state    = document.querySelector('input[name="State"]');
        var postal   = document.querySelector('input[name="PostalCode"]');
        var address  = document.querySelector('textarea[name="DetailAddress"]');
        var tin      = document.querySelector('input[name="TIN"]');

        // 1. Validate Full Name
        if (!fullName.value.trim()) {
            showError(fullName, "Full Name is required.");
            isValid = false; if(!firstInvalidInput) firstInvalidInput = fullName;
        } else { hideError(fullName); }

        // 2. Validate NRIC (12 digits)
        if (!nric.value.trim() || nric.value.length !== 12) {
            showError(nric, "NRIC must be exactly 12 digits.");
            isValid = false; if(!firstInvalidInput) firstInvalidInput = nric;
        } else { hideError(nric); }

        // 3. Validate State
        if (!state.value.trim()) {
            showError(state, "Please enter your State.");
            isValid = false; if(!firstInvalidInput) firstInvalidInput = state;
        } else { hideError(state); }

        // 4. Validate Postal Code (5 digits)
        if (!postal.value.trim() || postal.value.length !== 5) {
            showError(postal, "Postal Code must be exactly 5 digits.");
            isValid = false; if(!firstInvalidInput) firstInvalidInput = postal;
        } else { hideError(postal); }

        // 5. Validate Detail Address
        if (!address.value.trim()) {
            showError(address, "Detailed Address is required.");
            isValid = false; if(!firstInvalidInput) firstInvalidInput = address;
        } else { hideError(address); }

        // 6. Validate TIN
        var tinPattern = /^[A-Z]{1,2}[0-9]{10,12}$/;
        if (!tin.value.trim()) {
            showError(tin, "Tax Identification Number is required.");
            isValid = false; if(!firstInvalidInput) firstInvalidInput = tin;
        } else if (!tinPattern.test(tin.value.toUpperCase())) {
            showError(tin, "Invalid format (e.g., IG115002000).");
            isValid = false; if(!firstInvalidInput) firstInvalidInput = tin;
        } else { hideError(tin); }

        if (!isValid) {
            if (firstInvalidInput) {
                firstInvalidInput.reportValidity();
                firstInvalidInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            return;   
        }
    }

    // Step Switching Logic
    document.querySelectorAll('.form-step').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.step').forEach(el => el.classList.remove('active'));

    document.getElementById('form-step-' + step).classList.add('active');
    document.getElementById('step-indicator-' + step).classList.add('active');

    if (step === 2) {
        document.getElementById('step-indicator-1').classList.add('completed');
        document.getElementById('connector').classList.add('completed');
    }
    document.querySelector('.seller-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// ─── STEP 2 VALIDATION (when clicking Submit) ───
document.getElementById('seller-form').addEventListener('submit', function (e) {
        var isValid = true;
        var firstInvalidInput = null;

    var shopName = document.querySelector('input[name="ShopName"]');
    var pickupAddress = document.querySelector('textarea[name="PickupAddress"]');
    var email = document.querySelector('input[name="Email"]');
    var phone  = document.querySelector('input[name="PhoneNumber"]');
    var password = document.querySelector('input[name="Password"]');
    var confirmPassword = document.querySelector('input[name="ConfirmPassword"]');

    // 1. Validate Shop Name
    if (!shopName.value.trim()) {
            showError(shopName, "Shop Name is required.");
            isValid = false; if(!firstInvalidInput) firstInvalidInput = shopName;
        } else { hideError(shopName); }

    // 2. Validate Pickup Address
    if (!pickupAddress.value.trim()) {
        showError(pickupAddress, "Pickup Address is required.");
        isValid = false; if(!firstInvalidInput) firstInvalidInput = pickupAddress;
    } else { hideError(pickupAddress); }

    // 3. Validate Email
    var emailPattern = new RegExp('^[^\\s]+' + String.fromCharCode(64) + '[^\\s]+\\.[^\\s]+$');
    if (!email.value.trim()) {
        showError(email, "Email Address is required.");
        isValid = false; if(!firstInvalidInput) firstInvalidInput = email;
    } else if (!emailPattern.test(email.value.trim())) {
        showError(email, "Please enter a valid email address.");
        isValid = false; if(!firstInvalidInput) firstInvalidInput = email;
    } else { hideError(email); }

    // 4. Validate Phone Number
    if (!phone.value.trim()) {
        showError(phone, "Phone Number is required.");
        isValid = false; if(!firstInvalidInput) firstInvalidInput = phone;
    } else if (phone.value.length < 7 || phone.value.length > 10) {
        showError(phone, "Phone Number must be 7-10 digits.");
        isValid = false; if(!firstInvalidInput) firstInvalidInput = phone;
    } else { hideError(phone); }

    // 5. Validate Password
    if (!password.value.trim()) {
        showError(password, "Password is required.");
        isValid = false; if(!firstInvalidInput) firstInvalidInput = password;
    } else if (password.value.length < 8) {
        showError(password, "Password must be at least 8 characters.");
        isValid = false; if(!firstInvalidInput) firstInvalidInput = password;
    } else { hideError(password); }

    // 6. Validate Confirm Password
    if (!confirmPassword.value.trim()) {
        showError(confirmPassword, "Please confirm your password.");
        isValid = false; if(!firstInvalidInput) firstInvalidInput = confirmPassword;
    } else if (confirmPassword.value !== password.value) {
        showError(confirmPassword, "Passwords do not match.");
        isValid = false; if(!firstInvalidInput) firstInvalidInput = confirmPassword;
    } else { hideError(confirmPassword); }

        if (!isValid) {
            e.preventDefault();
            if (firstInvalidInput) {
                firstInvalidInput.reportValidity();
                firstInvalidInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }
});

// ─── TIN INPUT ENFORCEMENT ───
(function () {
    document.addEventListener('DOMContentLoaded', function () {
        // 1. Toast Timer Logic first
        const backdrop = document.getElementById('errorBackdrop');
            if (backdrop) {
                setTimeout(function () {
                    backdrop.style.transition = "opacity 0.4s ease";
                    backdrop.style.opacity = "0";
                    setTimeout(() => backdrop.remove(), 400);
                }, 3000); 
            }

        // 2. Then your TIN Input Enforcement
        var tin = document.getElementById('tinInput');
        if (!tin) return;

        tin.addEventListener('keydown', function (e) {
            if (e.ctrlKey || e.metaKey) return;
            var controlKeys = ['Backspace', 'Delete', 'ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Tab', 'Home', 'End'];
            if (controlKeys.indexOf(e.key) !== -1) return;

            var pos = tin.selectionStart;
            var key = e.key.toUpperCase();

            if (pos === 0) {
                if (!/^[A-Z]$/.test(key)) e.preventDefault();
            } else if (pos === 1) {
                if (!/^[A-Z0-9]$/.test(key)) e.preventDefault();
            } else {
                if (!/^[0-9]$/.test(key)) e.preventDefault();
            }
        });

        tin.addEventListener('paste', function (e) {
            e.preventDefault();
            var pasted = (e.clipboardData || window.clipboardData).getData('text').toUpperCase().replace(/\s/g, '');
            var result = '';
            for (var i = 0; i < pasted.length && result.length < 14; i++) {
                var char = pasted[i];
                if (result.length === 0 && /[A-Z]/.test(char)) result += char;
                else if (result.length === 1 && /[A-Z0-9]/.test(char)) result += char;
                else if (result.length >= 2 && /[0-9]/.test(char)) result += char;
            }
            tin.value = result;
        });
    });
})();

</script>