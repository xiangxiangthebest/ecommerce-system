@{
    Layout = "_AuthLayout";
    var role = ViewBag.Role as string;
}

<link rel="stylesheet" href="~/css/seller-register.css" />

<div class="auth-container">
    <div class="auth-card seller-card">

        @**Badge + Title*@
        <div class="auth-top">
            <div class="auth-badge">Seller Portal</div>
            <h1>Seller Registration</h1>
            <p>Register your business and start selling on the platform.</p>
        </div>

        @**── Progress Stepper ──*@
        <div class="progress-stepper">

            <div class="step active" id="step-indicator-1">
                <div class="step-circle">
                    <span class="num">1</span>
                    <span class="check">✓</span>
                </div>
                <span class="step-label">Seller Info</span>
            </div>

            <div class="step-connector" id="connector"></div>

            <div class="step" id="step-indicator-2">
                <div class="step-circle">
                    <span class="num">2</span>
                    <span class="check">✓</span>
                </div>
                <span class="step-label">Shop Info</span>
            </div>

        </div>

        @**── Form ──*@
        <form method="post" id="seller-form">

            @**════════════════════════════*@
            @**STEP 1 — Seller Information*@
            @**════════════════════════════*@
            <div class="form-step active" id="form-step-1">

                <div class="section-label">Seller Information</div>

                <div class="form-group">
                    <label>Full Name</label>
                    <input type="text"
                           name="FullName"
                           maxlength="50"
                           placeholder="Enter full name"
                           required />
                </div>

                <div class="form-group">
                    <label>NRIC Number</label>
                    <input type="text"
                           name="NRICNumber"
                           maxlength="12"
                           placeholder="980101012345"
                           inputmode="numeric"
                           pattern="[0-9]*"
                           oninput="this.value = this.value.replace(/[^0-9]/g, '')"
                           required />
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>State</label>
                        <input type="text"
                               name="State"
                               placeholder="Selangor"
                               required />
                    </div>

                    <div class="form-group">
                        <label>Postal Code</label>
                        <input type="text"
                               name="PostalCode"
                               placeholder="43200"
                               maxlength="5"
                               inputmode="numeric"
                               pattern="[0-9]*"
                               oninput="this.value = this.value.replace(/[^0-9]/g, '')"
                               required />
                    </div>
                </div>

                <div class="form-group">
                    <label>Detail Address</label>
                    <textarea name="DetailAddress"
                              rows="3"
                              placeholder="Enter detailed address"
                              required></textarea>
                </div>

                <div class="form-group">
                    <label>Tax Identification Number (TIN)</label>
                    <input type="text"
                           name="TIN"
                           maxlength="14"
                           placeholder="Enter TIN"
                           required />
                </div>

                <div class="step-nav">
                    <button type="button" class="btn-next" onclick="goToStep(2)">
                        Next
                    </button>
                </div>

            </div>

            @**════════════════════════════*@
            @**STEP 2 — Shop Information  *@
            @**════════════════════════════*@
            <div class="form-step" id="form-step-2">

                <div class="section-label">Shop Information</div>

                <div class="form-group">
                    <label>Shop Name</label>
                    <input type="text"
                           name="ShopName"
                           placeholder="Enter Shop Name"
                           required />
                </div>

                <div class="form-group">
                    <label>Pickup Address</label>
                    <textarea name="PickupAddress"
                              rows="3"
                              placeholder="Enter Pickup Address"
                              required></textarea>
                </div>

                <div class="form-group">
                    <label>Email Address</label>
                    <input type="email"
                           name="Email"
                           placeholder="Enter Email Address"
                           required />
                </div>

                <div class="form-group">
                    <label>Phone Number</label>
                    <div class="phone-input">
                        <span>+60</span>
                        <input type="text"
                               name="PhoneNumber"
                               maxlength="10"
                               placeholder="123456789"
                               inputmode="numeric"
                               pattern="[0-9]*"
                               oninput="this.value = this.value.replace(/[^0-9]/g, '')"
                               required />
                    </div>
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <input type="password"
                           name="Password"
                           placeholder="Create a Password"
                           required />
                </div>

                <div class="form-group">
                    <label>Confirm Password</label>
                    <input type="password"
                           name="ConfirmPassword"
                           placeholder="Confirm Password"
                           required />
                </div>

                <div class="step-nav">
                    <button type="button" class="btn-back" onclick="goToStep(1)">Back</button>
                    <button type="submit" class="btn-submit">Submit</button>
                </div>

            </div>

        </form>

        <div class="auth-bottom">
            <span>Already have an account?</span>
            <a href="/Auth/Login?role=Seller">Login</a>
        </div>

    </div>
</div>

<script>
    function goToStep(step) {
        // Hide all steps
        document.querySelectorAll('.form-step').forEach(s => s.classList.remove('active'));
        document.querySelectorAll('.step').forEach(s => {
            s.classList.remove('active');
        });

        // Show target step
        document.getElementById('form-step-' + step).classList.add('active');
        document.getElementById('step-indicator-' + step).classList.add('active');

        // Mark step 1 as completed when moving to step 2
        if (step === 2) {
            document.getElementById('step-indicator-1').classList.add('completed');
            document.getElementById('connector').classList.add('completed');
        } else {
            document.getElementById('step-indicator-1').classList.remove('completed');
            document.getElementById('connector').classList.remove('completed');
        }

        // Scroll to top of card
        document.querySelector('.seller-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
</script>
