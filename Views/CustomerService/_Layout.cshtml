@using System.Security.Claims

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] MMU Shop Customer Service</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/customer/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ecommerce_system.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@@3.31.0/dist/tabler-icons.min.css" />
</head>
<body>
    <header>
        <nav class="navbar-shell">
            <div class="navbar-inner">

            <!-- Hamburger (mobile only) -->
            <button class="hamburger-btn" id="hamburgerBtn" aria-label="Toggle menu">
                <i class="ti ti-menu-2"></i>
            </button>

            <div class="nav-divider-v"></div>

            @{
                var controller = ViewContext.RouteData.Values["controller"]?.ToString();
                var action = ViewContext.RouteData.Values["action"]?.ToString();
            }


            <!-- Desktop links -->
            <div class="nav-links">
                <a class="nav-link @(controller == "CustomerService" && action == "Home" ? "active" : "")" 
                asp-controller="CustomerService" asp-action="Home">
                    <i class="ti ti-clipboard-list"></i> Request
                </a>
                <a class="nav-link @(controller == "CustomerService" && action == "Notification" ? "active" : "")" 
                asp-controller="CustomerService" asp-action="Notification">
                    <i class="ti ti-bell"></i> Notification
                </a>
            </div>

            <div class="nav-right">
                <div class="nav-divider-v"></div>
                <div class="profile-dropdown">
                <button class="profile-btn">
                    @{
                        var fullName = User.FindFirst(ClaimTypes.Name)?.Value ?? "User";

                        var names = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

                        var initials = names.Length >= 2
                            ? $"{names[0][0]}{names[^1][0]}".ToUpper()
                            : fullName.Substring(0, 1).ToUpper();
                    }
                    <div class="avatar">@initials</div>
                    <span class="profile-name">@fullName</span>
                    <i class="ti ti-chevron-down"></i>
                </button>
                <div class="dropdown-menu">
                    <a class="dropdown-item" asp-controller="CustomerService" asp-action="Profile">
                    <i class="ti ti-user"></i> My Profile
                    </a>
                    <hr class="dropdown-sep" />
                    <form asp-controller="Auth" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item danger">
                            <i class="ti ti-logout"></i> Sign out
                        </button>
                    </form>
                </div>
                </div>
            </div>

            </div>

        </nav>
    </header>
    <div class="container-fluid p-0">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/customerservice/layout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
