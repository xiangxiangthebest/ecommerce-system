@using System.Linq
@{
    ViewData["Title"] = "Customer Service";
    var allOrders    = ViewBag.Orders       as List<EcommerceSystem.Models.Order> ?? new List<EcommerceSystem.Models.Order>();
    var issueLabel   = ViewBag.IssueLabel   as Dictionary<int, string> ?? new Dictionary<int, string>();
    var serviceLabel = ViewBag.ServiceLabel as Dictionary<int, string> ?? new Dictionary<int, string>();
    var serviceToken    = ViewBag.ServiceToken    as Dictionary<int, string>                          ?? new Dictionary<int, string>();
    var requestedQtyMap = ViewBag.RequestedQtyMap as Dictionary<int, Dictionary<int, int>> ?? new Dictionary<int, Dictionary<int, int>>();
    var requests = ViewBag.Requests as List<Request> ?? new List<Request>();
    var requestImages = ViewBag.RequestImages as List<EcommerceSystem.Models.RequestImage> ?? new List<EcommerceSystem.Models.RequestImage>();

    int cntAll      = allOrders.Count;
    int cntPending = requests.Count(r => r.Status?.ToString() == "Pending");
    int cntApproved = requests.Count(r => r.Status?.ToString() == "Approved");
    int cntRejected = requests.Count(r => r.Status?.ToString() == "Rejected");
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<div class="cs-page">

    @if (TempData["OrderError"] != null)
    {
        <div class="cs-alert cs-alert-error"><i class="fas fa-exclamation-circle"></i> @TempData["OrderError"]</div>
    }
    @if (TempData["OrderSuccess"] != null)
    {
        <div class="cs-alert cs-alert-success"><i class="fas fa-check-circle"></i> @TempData["OrderSuccess"]</div>
    }

    <h1 class="cs-title">Return / Refund Requests</h1>
    <p class="cs-subtitle">Review and approve return &amp; refund requests raised by customers.</p>

    <div class="order-tabs" id="orderTabs">
        <button class="order-tab active" data-status="ALL">All <span class="order-tab-badge">@cntAll</span></button>
        <button class="order-tab" data-status="PENDING">Pending<span class="order-tab-badge">@cntPending</span></button>
        <button class="order-tab" data-status="APPROVED">Approved<span class="order-tab-badge">@cntApproved</span></button>
        <button class="order-tab" data-status="REJECTED">Rejected <span class="order-tab-badge">@cntRejected</span></button>
    </div>

    <div class="order-filter-bar">
        <div class="order-search-wrap">
            <i class="fas fa-search" style="color:#9a98b6;font-size:13px"></i>
            <input type="text" id="orderSearch" placeholder="Search by Order ID or customer email…" oninput="applyOrderFilters()" />
        </div>
        <div class="order-sort-wrap">
            <i class="fas fa-sort" style="color:#9a98b6;font-size:13px"></i>
            <select id="orderSortDir" onchange="applyOrderFilters()">
                <option value="desc">Newest first</option>
                <option value="asc">Oldest first</option>
            </select>
        </div>
    </div>

    @if (allOrders.Any())
    {
        <table class="orders-table" id="ordersTable">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Request</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="ordersTableBody">
                @foreach (var order in allOrders)
                {   
                    var request = requests.FirstOrDefault(r => r.OrderId == order.OrderId);
                    var approvedKey = request?.Status switch
                    {
                        "Approved" => "APPROVED",
                        "Rejected" => "REJECTED",
                        "Pending"  => "PENDING",
                        _          => "ALL"
                    };
                    var searchHint  = ("#" + order.OrderId + " " + (order.Customer?.Email ?? "")).ToLower();
                    var svc         = serviceLabel.GetValueOrDefault(order.OrderId, "—");
                    var reason      = issueLabel.GetValueOrDefault(order.OrderId, "—");

                    <tr data-status="@approvedKey" data-search="@searchHint" data-order-id="@order.OrderId">
                        <td>#@order.OrderId</td>
                        <td>@(order.Customer?.Email ?? "—")</td>
                        <td>@order.OrderTime.ToString("dd MMM yyyy")</td>
                        <td>@svc</td>
                        <td style="max-width:240px;font-size:0.85rem;">@reason</td>
                        <td>
                            @if (request.Status == "Approved")
                            {
                                <span style="color:#22c55e;font-size:13px;font-weight:600;white-space:nowrap;">
                                    <i class="fas fa-check-circle"></i> Approved 
                                    (RM@((request.ApprovedRefundAmount ?? 0m).ToString("F2")))
                                </span>
                            }
                            else if (request.Status == "Rejected")
                            {
                                <span style="color:#c52222;font-size:13px;font-weight:600;white-space:nowrap;">
                                    <i class="fas fa-times-circle"></i> Rejected
                                </span>
                            }
                            else
                            {
                                <span style="color:#f59e0b;font-size:13px;font-weight:600;white-space:nowrap;">
                                    <i class="fas fa-clock"></i> Pending
                                </span>
                            }
                        </td>
                        <td>
                            <button class="btn-approve-return" onclick="openApproveReturnModal(@order.OrderId,@request.RequestId)">
                            View
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div id="orderNoResults" class="cs-empty" style="display:none;">
            <i class="fas fa-search"></i><p>No requests match your filter.</p>
        </div>
    }
    else
    {
        <div class="cs-empty">
            <i class="fas fa-inbox"></i>
            <p>No return / refund requests right now.</p>
        </div>
    }
</div>


@* Hidden anti-forgery token for the JS fetch POSTs *@
<form id="csAntiForgeryForm" style="display:none">@Html.AntiForgeryToken()</form>

<!-- ── Approve Return Modal ── -->
<div id="approveReturnBackdrop" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:1000" onclick="closeApproveReturnModal()" class="approve-return-backdrop"></div>
<div id="approveReturnModal" style="display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:#fff;border-radius:16px;padding:28px;width:min(600px,96vw);max-height:90vh;overflow-y:auto;z-index:1001;box-shadow:0 8px 40px rgba(0,0,0,.18)" class="approve-return-modal">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px">
        <h3 style="margin:0;font-size:17px;font-weight:700;color:#1e1b4b">Request</h3>
        <button onclick="closeApproveReturnModal()" style="margin-left:auto;background:none;border:none;cursor:pointer;font-size:18px;color:#9a98b6">✕</button>
    </div>
    <div style="font-size:10px;color:#a16207;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:6px"><i class="fas fa-clipboard-list" style="margin-right:4px"></i>Customer Request Summary</div>
    <div id="approveReturnTypeInfo" style="background:#fff8e1;border:1.5px solid #ffe082;border-radius:10px;padding:12px 14px;font-size:13px;color:#6d4c41;margin-bottom:14px;line-height:1.5"></div>
    <p id="approveTickHint" style="font-size:13px;color:#6b6b8a;margin:0 0 16px">Tick the items you are approving and confirm the quantity.</p>
    <div id="approveItemsWrap"></div>
    <div style="background:#f8f8ff;border:1.5px solid #e8eaf6;border-radius:10px;padding:12px 16px;margin-top:14px;font-size:13px;">
        <div style="font-weight:700;color:#1e1b4b;margin-bottom:8px;font-size:11px;letter-spacing:0.03em;text-transform:uppercase">Refund Breakdown</div>
        <table style="width:100%;border-collapse:collapse;">
            <thead>
                <tr style="font-size:11px;color:#9a98b6;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;">
                    <th style="text-align:left;padding-bottom:6px;">Product</th>
                    <th style="text-align:center;padding-bottom:6px;">Qty</th>
                    <th style="text-align:right;padding-bottom:6px;">Unit Price</th>
                    <th style="text-align:right;padding-bottom:6px;">Subtotal</th>
                </tr>
            </thead>
            <tbody id="approveBreakdownBody"></tbody>
            <tfoot>
                <tr style="border-top:1.5px solid #e8eaf6;">
                    <td colspan="3" style="padding-top:8px;font-weight:700;color:#1e1b4b;font-size:13px;">Total Refund Amount</td>
                    <td style="padding-top:8px;font-weight:800;color:#f97316;font-size:15px;text-align:right;" id="approveRefundTotal">RM 0.00</td>
                </tr>
            </tfoot>
        </table>
    </div>
    <input type="hidden" id="approveReturnOrderId" />
    <input type="hidden" id="approveRequestId" />
    <!-- Error message area inside modal -->
    <div id="approveReturnError" style="display:none;margin-top:12px;padding:10px 14px;background:#ffebee;border-radius:8px;color:#c62828;font-size:13px;font-weight:600;">
        <i class="fas fa-exclamation-circle"></i> <span id="approveReturnErrorMsg"></span>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:18px">
        <button onclick="closeApproveReturnModal()" style="padding:9px 20px;border-radius:8px;border:1px solid #e0e0f0;background:#fff;font-size:13px;font-weight:600;cursor:pointer">Cancel</button>
        <button id="approveReturnBtn" onclick="submitApproveReturn()" style="padding:9px 20px;border-radius:8px;border:none;background:#f97316;color:#fff;font-size:13px;font-weight:700;cursor:pointer"><i class="fas fa-check"></i>Approve</button>
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px">
            <button id="rejectReturnBtn" onclick="submitRejectRequest()" style="padding:9px 20px;border-radius:8px;border:none;background:#dc2626;color:#fff;font-size:13px;font-weight:700;cursor:pointer"><i class="fas fa-times"></i> Reject</button>
            <span id="rejectHint" style="display:none;font-size:11px;color:#dc2626;font-weight:600"><i class="fas fa-exclamation-circle"></i> Uncheck all items to reject</span>
        </div>
    </div>
</div>

@{
var ordersForJs = allOrders
    .Select(o =>
    {
        var rawSubtotal = o.OrderItems.Sum(oi => oi.Price * oi.Quantity);
        var vDiscount = Math.Max(0m, rawSubtotal - o.TotalAmount);
        var discRatio = rawSubtotal > 0 ? vDiscount / rawSubtotal : 0m;

        requestedQtyMap.TryGetValue(o.OrderId, out var itemQtyMap);

        var req = requests.FirstOrDefault(r => r.OrderId == o.OrderId);

        // RequestedItemsJson: [{"orderItemId":9,"qty":3}, {"orderItemId":10,"qty":2}]
        // ApproveItemsJson:   [2, 2]  — approved qtys in the SAME order as RequestedItemsJson
        // So we zip them together: orderItemId[i] -> approvedQty[i]
        var approvedItemIds  = new List<int>();
        var approvedItemQtys = new Dictionary<int, int>(); // orderItemId -> approved qty
        if (!string.IsNullOrWhiteSpace(req?.ApproveItemsJson) && !string.IsNullOrWhiteSpace(req?.RequestedItemsJson))
        {
            try
            {
                var approveQtys = System.Text.Json.JsonSerializer.Deserialize<List<int>>(req.ApproveItemsJson)
                    ?? new List<int>();
                var requestedItems = System.Text.Json.JsonSerializer
                    .Deserialize<List<System.Text.Json.JsonElement>>(req.RequestedItemsJson)
                    ?? new List<System.Text.Json.JsonElement>();

                for (int idx = 0; idx < Math.Min(approveQtys.Count, requestedItems.Count); idx++)
                {
                    if (requestedItems[idx].TryGetProperty("orderItemId", out var idEl))
                    {
                        var oid = idEl.GetInt32();
                        approvedItemIds.Add(oid);
                        approvedItemQtys[oid] = approveQtys[idx];
                    }
                }
            }
            catch { }
        }

        return new
        {
            orderId = o.OrderId,
            returnToken = serviceToken.GetValueOrDefault(o.OrderId, "RefundOnly"),
            serviceLabel = serviceLabel.GetValueOrDefault(o.OrderId, "Refund Only"),
            issueLabel = issueLabel.GetValueOrDefault(o.OrderId, "—"),
            returnImages = new List<string>(),
            customerEmail = o.Customer?.Email ?? "—",
            customerName = o.Customer?.FullName ?? "",

            request = req == null ? (object?)null : new
            {
                status = req.Status,
                reviewByCsId = req.ReviewByCsId,
                solvedAt = req.SolvedAt.HasValue
                    ? req.SolvedAt.Value.ToString("dd MMM yyyy, hh:mm tt")
                    : (string?)null,
                approvedRefundAmount = req.ApprovedRefundAmount,
                approvedItemIds,
                approvedItemQtys, // id -> approved qty
                description = req.Description ?? "",
                imagePaths = requestImages
                    .Where(img => img.RequestId == req.RequestId)
                    .Select(img => "/uploads/" + System.IO.Path.GetFileName(img.ImagePath))
                    .ToList()
            },

            items = o.OrderItems
                .Where(oi => itemQtyMap != null && itemQtyMap.ContainsKey(oi.OrderItemId))
                .Select(oi =>
                {
                    var reqQty = itemQtyMap != null && itemQtyMap.TryGetValue(oi.OrderItemId, out var q) ? q : 0;
                    return new
                    {
                        orderItemId = oi.OrderItemId,
                        name = (!string.IsNullOrWhiteSpace(oi.Product?.SKU)
                            ? $"[{oi.Product!.SKU}] "
                            : "") + (oi.Product?.Name ?? $"Item #{oi.OrderItemId}"),
                        orderedQty = oi.Quantity,
                        requestedQty = reqQty,
                        unitPrice = Math.Round(oi.Price * (1 - discRatio), 2).ToString("F2"),
                        selectedVariation = oi.SelectedVariation ?? ""
                    };
                })
                .ToList()
        };
    })
    .ToList();
}

<script>
    const _csReturnOrders = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ordersForJs));

    function getAntiForgeryToken() {
        return document.querySelector('#csAntiForgeryForm input[name="__RequestVerificationToken"]')?.value ?? '';
    }

    // ── Filter tabs ──────────────────────────────────────────────────────
    document.querySelectorAll('.order-tab').forEach(tab => {
        tab.addEventListener('click', () => {
            document.querySelectorAll('.order-tab').forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            applyOrderFilters();
        });
    });

    function applyOrderFilters() {
        const status = document.querySelector('.order-tab.active')?.dataset.status ?? 'ALL';
        const search = (document.getElementById('orderSearch')?.value ?? '').toLowerCase().trim();
        const sortDir = document.getElementById('orderSortDir')?.value ?? 'desc';
        let visible = 0;

        // Sort rows by Order ID based on the user-selected direction
        const tbody = document.getElementById('ordersTableBody');
        const rows = Array.from(tbody.querySelectorAll('tr'));
        const ascending = sortDir === 'asc';
        rows.sort((a, b) => {
            const idA = Number(a.dataset.orderId) || 0;
            const idB = Number(b.dataset.orderId) || 0;
            return ascending ? idA - idB : idB - idA;
        });
        rows.forEach(row => tbody.appendChild(row));

        rows.forEach(row => {
            const matchStatus = status === 'ALL' || row.dataset.status === status;
            const matchSearch = !search || row.dataset.search.includes(search);
            const show = matchStatus && matchSearch;
            row.style.display = show ? '' : 'none';
            if (show) visible++;
        });
        const noRes = document.getElementById('orderNoResults');
        const table = document.getElementById('ordersTable');
        if (noRes && table) {
            noRes.style.display = visible === 0 ? 'flex' : 'none';
            table.style.display = visible === 0 ? 'none' : '';
        }
    }

    // ── Variation JSON → readable tag line ──────────────────────────────────
    function parseVariation(json) {
        if (!json || json === '{}' || json === '[]' || json === '') return '';
        try {
            const obj = typeof json === 'string' ? JSON.parse(json) : json;
            return Object.entries(obj).map(([k, v]) => `${k}: ${v}`).join(' · ');
        } catch { return ''; }
    }

function openApproveReturnModal(orderId, requestId) {

    const order = _csReturnOrders.find(o => o.orderId === orderId);
    if (!order) return;

    const request = order.request ?? null;

    const isPending  = !request || request.status === "Pending";
    const isApproved = request?.status === "Approved";
    const isRejected = request?.status === "Rejected";

    // Reset hidden fields
    document.getElementById('approveReturnOrderId').value = orderId;
    document.getElementById('approveRequestId').value = requestId;
    document.getElementById('approveReturnError').style.display = 'none';

    // Reset stale reject-hint state from any previous modal session
    const rejectHintEl = document.getElementById('rejectHint');
    if (rejectHintEl) rejectHintEl.style.display = 'none';

    // Hide/show the tick hint — only for pending
    const tickHint = document.getElementById('approveTickHint');
    if (tickHint) tickHint.style.display = isPending ? '' : 'none';

    // ── CUSTOMER + REQUEST INFO ──────────────────────────────────────────
    const icon = (order.returnToken === 'ReturnRefund') ? '📦' : '💰';
    const custName = order.customerName
        ? `${order.customerName} (${order.customerEmail})`
        : order.customerEmail;

    let headerHtml = `
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid #ffe0b2;">
            <i class="fas fa-user-circle" style="color:#f97316;font-size:16px;flex-shrink:0"></i>
            <div>
                <div style="font-size:11px;color:#a16207;font-weight:600;text-transform:uppercase;letter-spacing:0.05em">Customer</div>
                <div style="font-size:13px;color:#1e1b4b;font-weight:600">${custName}</div>
            </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
            <div style="background:#fff;border-radius:8px;padding:8px 10px;border:1px solid #ffe0b2;">
                <div style="font-size:10px;color:#a16207;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:2px">Return Type</div>
                <div style="font-size:13px;font-weight:700;color:#1e1b4b">${icon} ${order.serviceLabel}</div>
            </div>
            <div style="background:#fff;border-radius:8px;padding:8px 10px;border:1px solid #ffe0b2;">
                <div style="font-size:10px;color:#a16207;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:2px">Reason</div>
                <div style="font-size:13px;font-weight:700;color:#1e1b4b">${order.issueLabel || '—'}</div>
            </div>
        </div>
    `;

    // Description
    if (request?.description) {
        headerHtml += `
        <div style="margin-top:8px;padding:8px 10px;background:#fff;border-radius:8px;border:1px solid #ffe0b2;">
            <div style="font-size:10px;color:#a16207;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:2px">Customer Note</div>
            <div style="font-size:13px;color:#1e1b4b;">${request.description}</div>
        </div>`;
    }

    // Images
    if (request?.imagePaths?.length) {
        headerHtml += `<div style="margin-top:8px;display:flex;gap:8px;flex-wrap:wrap;">`;
        request.imagePaths.forEach(p => {
            headerHtml += `<img src="${p}" style="width:80px;height:80px;object-fit:cover;border-radius:8px;border:1px solid #ffe0b2;cursor:pointer" onclick="window.open('${p}','_blank')" />`;
        });
        headerHtml += `</div>`;
    }

    // CS Review block (Approved / Rejected only)
    if (!isPending && request) {
        const statusColor  = isApproved ? '#16a34a' : '#dc2626';
        const statusBg     = isApproved ? '#f0fdf4' : '#fef2f2';
        const statusBorder = isApproved ? '#bbf7d0' : '#fecaca';

        headerHtml += `
        <div style="margin-top:12px;padding:12px 14px;border-radius:10px;background:${statusBg};border:1.5px solid ${statusBorder};">
            <div style="font-size:11px;font-weight:700;color:${statusColor};text-transform:uppercase;letter-spacing:0.06em;margin-bottom:8px;">
                <i class="fas fa-${isApproved ? 'check-circle' : 'times-circle'}"></i>
                CS Review — ${request.status}
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:13px;">
                <div>
                    <div style="font-size:11px;color:#64748b;">Reviewed By</div>
                    <div style="font-weight:600;color:#1e1b4b;">${request.reviewByCsId || '—'}</div>
                </div>
                <div>
                    <div style="font-size:11px;color:#64748b;">Solved At</div>
                    <div style="font-weight:600;color:#1e1b4b;">${request.solvedAt || '—'}</div>
                </div>
            </div>
            ${isApproved ? `
                <div style="margin-top:8px;padding-top:8px;border-top:1px solid ${statusBorder};font-size:13px;">
                    <span style="color:#64748b;">Approved Refund Amount:</span>
                    <span style="font-weight:800;color:#16a34a;margin-left:6px;">RM ${parseFloat(request.approvedRefundAmount ?? 0).toFixed(2)}</span>
                </div>
            ` : ''}
        </div>`;
    }

    document.getElementById('approveReturnTypeInfo').innerHTML = headerHtml;

    // ── ITEMS ────────────────────────────────────────────────────────────
    const approvedSet  = new Set(request?.approvedItemIds ?? []);
    const approvedQtys = request?.approvedItemQtys ?? {}; // {id: qty}
    let html = '';

    if (!order.items || order.items.length === 0) {
        html = `<div style="color:#9a98b6;font-size:13px;padding:12px 0">No items found on this order.</div>`;
    } else if (isPending) {
        // Pending: checkbox + always-editable qty input
        order.items.forEach(item => {
            const varLine = parseVariation(item.selectedVariation);
            html += `
            <div class="ph-return-item" style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid #f0f0f8;">
                <input type="checkbox" class="approve-item-chk"
                    data-order-item-id="${item.orderItemId}"
                    data-max="${item.orderedQty}"
                    data-unit-price="${item.unitPrice}"
                    data-name="${item.name}"
                    onchange="updateRefundBreakdown()"
                    style="width:16px;height:16px;cursor:pointer" />
                <label style="flex:1">
                    <div style="font-weight:600;font-size:13px">${item.name}</div>
                    ${varLine ? `<div style="font-size:11px;color:#6366f1;margin-bottom:2px"><i class="fas fa-tag" style="margin-right:3px"></i>${varLine}</div>` : ''}
                    <div style="font-size:12px;color:#9a98b6">Requested qty: ${item.requestedQty} &nbsp;|&nbsp; <span style="color:#1e1b4b;font-weight:600">RM ${item.unitPrice} each</span></div>
                </label>
                <div style="display:flex;align-items:center;gap:6px">
                    <label style="font-size:12px;color:#9a98b6">Approve qty:</label>
                    <input type="number" class="approve-item-qty"
                        min="1" max="${item.requestedQty}" value="${item.requestedQty}"
                        oninput="updateRefundBreakdown()"
                        style="width:56px;padding:4px 6px;border:1px solid #e0e0f0;border-radius:6px;font-size:13px;text-align:center" />
                </div>
            </div>`;
        });
    } else {
        // Approved / Rejected: read-only view
        order.items.forEach(item => {
            const varLine      = parseVariation(item.selectedVariation);
            const itemApproved = approvedSet.has(item.orderItemId);
            const approvedQty  = approvedQtys[item.orderItemId] ?? 0;

            let badgeColor, badgeIcon, badgeText;
            if (isApproved) {
                if (itemApproved) {
                    badgeColor = '#16a34a'; badgeIcon = 'fa-check-circle';
                    badgeText  = `Approved qty: ${approvedQty}`;
                } else {
                    badgeColor = '#94a3b8'; badgeIcon = 'fa-minus-circle';
                    badgeText  = 'Not approved';
                }
            } else {
                badgeColor = '#dc2626'; badgeIcon = 'fa-times-circle'; badgeText = 'Rejected';
            }

            html += `
            <div style="display:flex;align-items:center;gap:10px;padding:10px 4px;border-bottom:1px solid #f1f5f9;opacity:${itemApproved || isRejected ? '1' : '0.55'}">
                <div style="flex:1">
                    <div style="font-weight:600;font-size:13px">${item.name}</div>
                    ${varLine ? `<div style="font-size:11px;color:#6366f1;margin-bottom:2px"><i class="fas fa-tag" style="margin-right:3px"></i>${varLine}</div>` : ''}
                    <div style="font-size:12px;color:#9a98b6">
                        Requested qty: <b>${item.requestedQty}</b>
                        &nbsp;|&nbsp; RM ${item.unitPrice} each
                    </div>
                </div>
                <div style="text-align:right;white-space:nowrap;">
                    <span style="font-size:12px;font-weight:700;color:${badgeColor}">
                        <i class="fas ${badgeIcon}"></i> ${badgeText}
                    </span>
                </div>
            </div>`;
        });
    }

    document.getElementById('approveItemsWrap').innerHTML = html;

    // ── BUTTONS ──────────────────────────────────────────────────────────
    document.getElementById("approveReturnBtn").style.display = isPending ? "inline-block" : "none";
    document.getElementById("rejectReturnBtn").style.display  = isPending ? "inline-block" : "none";

    // ── BREAKDOWN ────────────────────────────────────────────────────────
    // Pending: driven by checkboxes; Approved: show approved items; Rejected: hide
    if (isPending) {
        updateRefundBreakdown();
    } else if (isApproved) {
        renderApprovedBreakdown(order, approvedSet, approvedQtys);
    } else {
        // Rejected — clear breakdown
        const tbody = document.getElementById('approveBreakdownBody');
        if (tbody) tbody.innerHTML = `<tr><td colspan="4" style="color:#ccc;font-size:12px;padding:6px 0">No refund issued.</td></tr>`;
        const totalEl = document.getElementById('approveRefundTotal');
        if (totalEl) totalEl.textContent = 'RM 0.00';
    }

    // Show modal
    document.getElementById('approveReturnBackdrop').style.display = 'block';
    document.getElementById('approveReturnModal').style.display = 'block';
    document.body.style.overflow = 'hidden';
}

    function updateRefundBreakdown() {
        // Pending mode: reads ALL items with checkboxes checked, using their qty input
        const tbody   = document.getElementById('approveBreakdownBody');
        const totalEl = document.getElementById('approveRefundTotal');
        if (!tbody || !totalEl) return;

        const checked = document.querySelectorAll('.approve-item-chk:checked');
        let total = 0; let rows = '';

        checked.forEach(chk => {
            const row   = chk.closest('.ph-return-item');
            const qtyEl = row.querySelector('.approve-item-qty');
            const qty   = parseInt(qtyEl?.value) || 0;
            const unit  = parseFloat(chk.dataset.unitPrice) || 0;
            const name  = chk.dataset.name || '—';
            const sub   = qty * unit;
            total      += sub;

            rows += `<tr>
                <td style="padding:4px 0;color:#1e1b4b;">${name}</td>
                <td style="text-align:center;padding:4px 0;color:#6b6b8a;">× ${qty}</td>
                <td style="text-align:right;padding:4px 0;color:#6b6b8a;">RM ${unit.toFixed(2)}</td>
                <td style="text-align:right;padding:4px 0;font-weight:600;color:#1e1b4b;">RM ${sub.toFixed(2)}</td>
            </tr>`;
        });

        tbody.innerHTML = rows || `<tr><td colspan="4" style="color:#ccc;font-size:12px;padding:6px 0">No items selected yet.</td></tr>`;
        totalEl.textContent = `RM ${total.toFixed(2)}`;

        // Reject button: only enabled when NO items are ticked
        const rejectBtn  = document.getElementById('rejectReturnBtn');
        const rejectHint = document.getElementById('rejectHint');
        if (rejectBtn && rejectBtn.style.display !== 'none') {
            const blocked = checked.length > 0;
            rejectBtn.disabled = blocked;
            rejectBtn.style.opacity = blocked ? '0.45' : '1';
            rejectBtn.style.cursor  = blocked ? 'not-allowed' : 'pointer';
            if (rejectHint) rejectHint.style.display = blocked ? 'inline' : 'none';
        }
    }

    function renderApprovedBreakdown(order, approvedSet, approvedQtys) {
        const tbody   = document.getElementById('approveBreakdownBody');
        const totalEl = document.getElementById('approveRefundTotal');
        if (!tbody || !totalEl) return;

        let total = 0; let rows = '';
        order.items.forEach(item => {
            if (!approvedSet.has(item.orderItemId)) return;
            // Use the actual approved qty; fall back to requestedQty if unknown (qty=0)
            const qty  = approvedQtys[item.orderItemId] || item.requestedQty;
            const unit = parseFloat(item.unitPrice) || 0;
            const sub  = qty * unit;
            total += sub;
            rows += `<tr>
                <td style="padding:4px 0;color:#1e1b4b;">${item.name}</td>
                <td style="text-align:center;padding:4px 0;color:#6b6b8a;">× ${qty}</td>
                <td style="text-align:right;padding:4px 0;color:#6b6b8a;">RM ${unit.toFixed(2)}</td>
                <td style="text-align:right;padding:4px 0;font-weight:600;color:#1e1b4b;">RM ${sub.toFixed(2)}</td>
            </tr>`;
        });

        tbody.innerHTML = rows || `<tr><td colspan="4" style="color:#ccc;font-size:12px;padding:6px 0">No approved items.</td></tr>`;
        totalEl.textContent = `RM ${total.toFixed(2)}`;
    }

    function closeApproveReturnModal() {
        document.getElementById('approveReturnBackdrop').style.display = 'none';
        document.getElementById('approveReturnModal').style.display = 'none';
        document.body.style.overflow = '';
    }


    async function submitRejectRequest() {
        const requestId = document.getElementById("approveRequestId").value;

        const params = new URLSearchParams();
        params.append("requestId", requestId);
        params.append("__RequestVerificationToken", getAntiForgeryToken());

        const res = await fetch('/CustomerService/RejectRequest', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: params.toString()
        });

        if(res.ok){
            location.reload();
        }
    }

    async function submitApproveReturn() {
        const orderId = document.getElementById('approveReturnOrderId').value;
        const order   = _csReturnOrders.find(o => o.orderId === parseInt(orderId));
        const checked = document.querySelectorAll('.approve-item-chk:checked');
        if (checked.length === 0) { alert('Please select at least one item to approve.'); return; }

        const params = new URLSearchParams();
        params.append('orderId', orderId);
        params.append('returnType', order?.returnToken ?? '');
        params.append('__RequestVerificationToken', getAntiForgeryToken());

        let i = 0; let valid = true;
        checked.forEach(chk => {
            const row = chk.closest('.ph-return-item');
            const qtyEl = row.querySelector('.approve-item-qty');
            const qty = parseInt(qtyEl?.value);
            const max = parseInt(chk.dataset.max);
            if (!qty || qty < 1 || qty > max) { valid = false; return; }
            params.append(`approveItemIds[${i}]`, chk.dataset.orderItemId);
            params.append(`approveQtys[${i}]`, qty);
            i++;
        });
        if (!valid) { alert('Invalid quantity for one or more items.'); return; }

        const btn = document.getElementById('approveReturnBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Approving…';

        // Hide any previous error
        document.getElementById('approveReturnError').style.display = 'none';

        try {
            const res = await fetch('/CustomerService/ApproveReturn', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: params.toString()
            });

            if (res.status === 403) {
                showModalError('Session expired. Please refresh the page and try again.');
                resetApproveBtn();
                return;
            }

            const data = await res.json();
            if (data.success) {
                closeApproveReturnModal();
                location.reload();
            } else {
                showModalError(data.message || 'Approval failed. Please try again.');
                resetApproveBtn();
            }
        } catch (err) {
            console.error('ApproveReturn fetch error:', err);
            showModalError('Network error. Please check your connection and try again.');
            resetApproveBtn();
        }
    }

    function showModalError(msg) {
        const errDiv = document.getElementById('approveReturnError');
        document.getElementById('approveReturnErrorMsg').textContent = msg;
        errDiv.style.display = 'block';
    }

    function resetApproveBtn() {
        const btn = document.getElementById('approveReturnBtn');
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-check"></i> Approve &amp; Process';
    }

    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeApproveReturnModal(); });

    // ── Notification bell ────────────────────────────────────────────────
    function toggleNotifDropdown() {
        const dd = document.getElementById('notifDropdown');
        dd.style.display = dd.style.display === 'none' ? 'block' : 'none';
        if (dd.style.display === 'block') loadNotifications();
    }

    document.addEventListener('click', function(e) {
        const wrapper = document.getElementById('notifWrapper');
        if (wrapper && !wrapper.contains(e.target))
            document.getElementById('notifDropdown').style.display = 'none';
    });

    async function loadNotifications() {
        const res = await fetch('/Notifications/GetDropdown');
        const data = await res.json();
        const badge = document.getElementById('notifBadge');
        badge.textContent = data.unreadCount;
        badge.style.display = data.unreadCount > 0 ? 'flex' : 'none';
        const list = document.getElementById('notifList');
        if (data.items.length === 0) {
            list.innerHTML = '<p class="notif-empty" style="color:#9a98b6;font-size:13px;text-align:center;padding:24px;">No notifications yet.</p>';
            return;
        }
        list.innerHTML = data.items.map(n => `
            <div class="notif-item ${n.isRead ? '' : 'unread'}" onclick="markRead(${n.notificationId}, this)"
                 style="padding:10px 16px;border-bottom:1px solid #f5f5fb;cursor:pointer;">
                <div style="font-weight:600;font-size:13px;color:#1e1b4b;">${n.title}</div>
                <div style="font-size:12px;color:#6b6b8a;margin-top:2px;">${n.message}</div>
                <div style="font-size:11px;color:#b0aec8;margin-top:3px;">${n.createdAt}</div>
            </div>
        `).join('');
    }

    async function markRead(id, el) {
        await fetch(`/Notifications/MarkRead?id=${id}`, {
            method: 'POST',
            headers: { 'RequestVerificationToken': getAntiForgeryToken() }
        });
        el.classList.remove('unread');
        refreshBadge();
    }

    async function markAllRead() {
        await fetch('/Notifications/MarkAllRead', {
            method: 'POST',
            headers: { 'RequestVerificationToken': getAntiForgeryToken() }
        });
        document.querySelectorAll('.notif-item.unread').forEach(el => el.classList.remove('unread'));
        const badge = document.getElementById('notifBadge');
        if (badge) badge.style.display = 'none';
    }

    async function refreshBadge() {
        try {
            const res = await fetch('/Notifications/GetDropdown');
            if (!res.ok) return;
            const data = await res.json();
            const badge = document.getElementById('notifBadge');
            if (badge && data && typeof data.unreadCount !== 'undefined') {
                badge.textContent = data.unreadCount;
                badge.style.display = data.unreadCount > 0 ? 'flex' : 'none';
            }
        } catch (err) { console.error("Error refreshing notifications:", err); }
    }

    document.addEventListener('DOMContentLoaded', () => {
        refreshBadge();
        setInterval(refreshBadge, 20000);
        applyOrderFilters();
    });
</script>

<style>
    .cs-page { max-width: 1180px; margin: 0 auto; padding: 28px 32px 60px; font-family: 'Syne', sans-serif; }
    .cs-title { font-size: 32px; font-weight: 800; color: #1e1b4b; margin: 0 0 4px; }
    .cs-subtitle { font-size: 14px; color: #6b6b8a; margin: 0 0 22px; }

    .cs-alert { padding: 12px 16px; border-radius: 10px; font-size: 14px; font-weight: 600; margin-bottom: 18px; display: flex; align-items: center; gap: 8px; }
    .cs-alert-error   { background: #ffebee; color: #c62828; }
    .cs-alert-success { background: #e8f5e9; color: #2e7d32; }

    .order-tabs { display: flex; flex-wrap: wrap; gap: 0; border-bottom: 2px solid #e8eaf6; margin-bottom: 0; }
    .order-tab { background: none; border: none; padding: 10px 18px; font-size: 13px; font-weight: 600; color: #9a98b6; cursor: pointer; position: relative; transition: color .18s; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
    .order-tab:hover, .order-tab.active { color: #1e1b4b; }
    .order-tab.active::after { content: ''; position: absolute; bottom: -2px; left: 0; right: 0; height: 2px; background: #1e1b4b; border-radius: 2px 2px 0 0; }
    .order-tab-badge { background: #e8eaf6; color: #5b587d; border-radius: 10px; padding: 1px 7px; font-size: 11px; font-weight: 700; }
    .order-tab.active .order-tab-badge { background: #1e1b4b; color: #fff; }

    .order-filter-bar { display: flex; gap: 12px; align-items: center; padding: 14px 0 16px; flex-wrap: wrap; }
    .order-search-wrap { display: flex; align-items: center; gap: 8px; background: #fff; border: 1.5px solid #e8eaf6; border-radius: 10px; padding: 8px 14px; min-width: 260px; flex: 1; transition: border-color .18s; }
    .order-search-wrap:focus-within { border-color: #1e1b4b; }
    .order-search-wrap input { border: none; outline: none; background: transparent; font-size: 13px; color: #1e1b4b; width: 100%; }
    .order-search-wrap input::placeholder { color: #b0aec8; }

    .order-sort-wrap { display: flex; align-items: center; gap: 8px; background: #fff; border: 1.5px solid #e8eaf6; border-radius: 10px; padding: 8px 14px; transition: border-color .18s; }
    .order-sort-wrap:focus-within { border-color: #1e1b4b; }
    .order-sort-wrap select { border: none; outline: none; background: transparent; font-size: 13px; color: #1e1b4b; cursor: pointer; }

    .orders-table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); margin-top: 1rem; }
    .orders-table thead { background: #1a237e; color: #fff; }
    .orders-table th, .orders-table td { padding: 12px 14px; text-align: left; font-size: 0.88rem; border-bottom: 1px solid #e8eaf6; }
    .orders-table tbody tr:last-child td { border-bottom: none; }
    .orders-table tbody tr:hover { background: #f5f5f5; }

    .status-badge { display: inline-block; padding: 4px 10px; border-radius: 12px; font-size: 0.78rem; font-weight: 700; }

    .btn-approve-return { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; background: #f97316; color: #fff; border: none; border-radius: 6px; font-size: 0.85rem; font-weight: 700; cursor: pointer; transition: background .18s; white-space: nowrap; }
    .btn-approve-return:hover { background: #ea580c; }

    .cs-empty { text-align: center; padding: 60px 20px; color: #9a98b6; }
    .cs-empty i { font-size: 46px; opacity: 0.4; display: block; margin-bottom: 14px; }
    .cs-empty p { font-size: 15px; font-weight: 500; }

    .approve-return-backdrop.active { display: block !important; }
    .approve-return-modal.active    { display: block !important; }
    .notif-item.unread { background: #f4f3ff; }
</style>
