@model IEnumerable<EcommerceSystem.Models.Request>
@using EcommerceSystem.DTOs

<link rel="stylesheet" href="~/css/customer/home.css" asp-append-version="true" />

<div class="home-page">

    <!-- Hero bar -->
    <div class="home-hero">
        <div class="home-hero-text">
            <h1 class="home-title">Incoming Requests</h1>
            <span class="home-eyebrow">Review and resolve requests raised by customers.</span>
        </div>
        <div class="home-hero-count">
            <span class="hero-count-number">@Model.Count(r => r.SolvedAt == null)</span>
            <span class="hero-count-label">Requests awaiting action</span>
        </div>
    </div>

    <!-- Tabs -->
    <div class="tab-bar">
        <a class="tab-link @(ViewBag.Tab == "all" || ViewBag.Tab == null ? "active" : "")"
           asp-action="Home" asp-route-tab="all" asp-route-search="@ViewBag.Search"
           asp-route-serviceType="@ViewBag.SelectedServiceType" asp-route-issueType="@ViewBag.SelectedIssueType">
            All
        </a>
        <a class="tab-link @(ViewBag.Tab == "resolved" ? "active" : "")"
           asp-action="Home" asp-route-tab="resolved" asp-route-search="@ViewBag.Search"
           asp-route-serviceType="@ViewBag.SelectedServiceType" asp-route-issueType="@ViewBag.SelectedIssueType">
            Resolved
        </a>
    </div>

    <!-- Filter bar -->
    <form method="get" class="filter-bar">
        <input type="hidden" name="tab" value="@ViewBag.Tab" />

        <div class="filter-search">
            <i class="ti ti-search"></i>
            <input type="text"
                   name="search"
                   placeholder="Search requests…"
                   class="filter-input"
                   value="@ViewBag.Search" />
        </div>

        <div class="filter-sep"></div>

        <div class="filter-select-wrap">
            <i class="ti ti-category"></i>
            <select name="serviceType" class="filter-select">
                <option value="">All Service Types</option>
                @foreach (var s in ViewBag.RequestServiceType)
                {
                    <option value="@s.Value" selected="@(ViewBag.SelectedServiceType == s.Value)">
                        @s.Text
                    </option>
                }
            </select>
            <i class="ti ti-chevron-down filter-chevron"></i>
        </div>

        <div class="filter-select-wrap">
            <i class="ti ti-layout-grid"></i>
            <select name="issueType" class="filter-select">
                <option value="">All Issue Types</option>
                @foreach (var i in ViewBag.RequestIssueType)
                {
                    <option value="@i.Value" selected="@(ViewBag.SelectedIssueType == i.Value)">
                        @i.Text
                    </option>
                }
            </select>
            <i class="ti ti-chevron-down filter-chevron"></i>
        </div>

        <button type="submit" class="filter-btn">
            <i class="ti ti-adjustments-horizontal"></i>
            Filter
        </button>
    </form>

    <!-- Request list -->
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="ti ti-mood-empty"></i></div>
            <p class="empty-title">No requests found</p>
            <p class="empty-sub">Try adjusting your search or filters.</p>
        </div>
    }
    else
    {
        <div class="request-list">
            @foreach (var item in Model)
            {
                <div class="request-card @(item.SolvedAt != null ? "resolved" : "")">

                    <div class="request-card-body">

                        <div class="request-meta">
                            <span class="request-id">#@item.RequestId</span>
                            <span class="request-date">
                                <i class="ti ti-clock"></i>
                                @item.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                            </span>
                        </div>

                        <div class="badges">
                            <span class="badge badge-service">@item.RequestServiceType</span>
                            <span class="badge badge-issue">@item.RequestIssueType</span>
                        </div>

                        <div class="request-customer">
                            <i class="ti ti-user"></i>
                            <span>@(item.RequestUser?.FullName ?? "Unknown Customer")</span>
                        </div>

                        @if (item.OrderId != null)
                        {
                            <div class="request-order">
                                <i class="ti ti-receipt"></i>
                                <span>Order #@item.OrderId</span>
                            </div>
                        }

                        @if (item.ReportedUser != null)
                        {
                            <div class="request-reported">
                                <i class="ti ti-flag"></i>
                                <span>Reported user: @item.ReportedUser.FullName</span>
                            </div>
                        }

                        <p class="request-desc">@item.Description</p>

                @if (!string.IsNullOrEmpty(item.RequestedItemsJson) && item.Order != null)
                        {
                            var requestedItems = System.Text.Json.JsonSerializer.Deserialize<List<RequestedItemDto>>(
                                item.RequestedItemsJson,
                                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                            ) ?? new();

                            <div class="requested-items">
                                <p class="requested-items-label">
                                    <i class="ti ti-package"></i> Requested items
                                </p>
                                <ul class="requested-items-list">
                                    @foreach (var reqItem in requestedItems)
                                    {
                                        var orderItem = item.Order.OrderItems
                                            .FirstOrDefault(oi => oi.OrderItemId == reqItem.OrderItemId);

                                        if (orderItem != null)
                                        {
                                            <li class="ri-row">
                                                @if (item.SolvedAt == null)
                                                {
                                                    <input type="checkbox"
                                                        class="ri-check"
                                                        data-order-item-id="@reqItem.OrderItemId"
                                                        data-max-qty="@reqItem.Qty"
                                                        form="approve-form-@item.RequestId"
                                                        checked />
                                                }
                                                <span class="ri-name">@orderItem.Product?.Name</span>
                                                @if (item.SolvedAt == null)
                                                {
                                                    <input type="number"
                                                        class="ri-qty-input"
                                                        min="0"
                                                        max="@reqItem.Qty"
                                                        value="@reqItem.Qty"
                                                        form="approve-form-@item.RequestId" />
                                                }
                                                else
                                                {
                                                    <span class="ri-qty">x@reqItem.Qty</span>
                                                }
                                            </li>
                                        }
                                    }
                                </ul>
                            </div>
                        }

                        @if (item.Images.Any())
                        {
                            <div class="request-images">
                                @foreach (var img in item.Images)
                                {
                                    <a href="@img.ImagePath" target="_blank" class="request-img-link">
                                        <img src="@img.ImagePath" alt="Request image" class="request-img" />
                                    </a>
                                }
                            </div>
                        }

                    </div>

                    <div class="request-card-footer">
                        @if (item.SolvedAt == null)
                        {
                            <form id="approve-form-@item.RequestId"
                                asp-controller="CustomerService" asp-action="ApproveRequest" method="post" class="action-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="requestId" value="@item.RequestId" />
                                <input type="hidden" name="approveItemsJson" class="approve-items-json" />
                                <button type="submit" class="action-btn approve-btn">
                                    <i class="ti ti-check"></i> Approve
                                </button>
                            </form>
                            <form asp-controller="CustomerService" asp-action="RejectRequest" method="post" class="action-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="requestId" value="@item.RequestId" />
                                <button type="submit" class="action-btn reject-btn">
                                    <i class="ti ti-x"></i> Reject
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="resolved-badge">
                                <i class="ti ti-check"></i> Resolved
                                @if (item.ReviewByCS != null)
                                {
                                    <span class="resolved-by">by @item.ReviewByCS.FullName</span>
                                }
                            </span>
                        }
                    </div>

                </div>
            }
        </div>
    }
</div>


<script src="~/js/customerservice/home.js" asp-append-version="true"></script>