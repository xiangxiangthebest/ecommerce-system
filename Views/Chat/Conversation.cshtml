@model EcommerceSystem.ViewModels.ChatConversationViewModel

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=Syne:wght@600&display=swap" rel="stylesheet">

<style>
    .chat-wrap {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 2rem 1rem;
        min-height: 100vh;
        background: #f4f3f0;
        font-family: 'DM Sans', sans-serif;
    }

    .chat-container {
        width: 100%;
        max-width: 420px;
        background: #ffffff;
        border-radius: 20px;
        border: 1px solid #e8e6e1;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 620px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    }

    /* ── HEADER ── */
    .chat-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px;
        border-bottom: 1px solid #eeece8;
        background: #ffffff;
        flex-shrink: 0;
    }

    .chat-header-back {
        background: none;
        border: none;
        color: #888;
        font-size: 20px;
        cursor: pointer;
        padding: 4px 6px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        line-height: 1;
        transition: background 0.15s;
        text-decoration: none;
    }

    .chat-header-back:hover {
        background: #f4f3f0;
        color: #333;
    }

    .chat-product-img {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        object-fit: cover;
        border: 1px solid #e8e6e1;
        flex-shrink: 0;
    }

    .chat-product-info {
        flex: 1;
        min-width: 0;
    }

    .chat-product-info h3 {
        font-family: 'Syne', sans-serif;
        font-size: 14px;
        font-weight: 600;
        color: #1a1a2e;
        margin: 0 0 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .chat-product-info small {
        font-size: 12px;
        color: #888;
        display: block;
    }

    /* ── MESSAGE LIST ── */
    .chat-box {
        flex: 1;
        overflow-y: auto;
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        scroll-behavior: smooth;
    }

    .chat-box::-webkit-scrollbar {
        width: 4px;
    }

    .chat-box::-webkit-scrollbar-thumb {
        background: #ddd;
        border-radius: 4px;
    }

    .chat-date-divider {
        text-align: center;
        font-size: 11px;
        color: #aaa;
        margin: 8px 0;
        position: relative;
    }

    .chat-date-divider::before,
    .chat-date-divider::after {
        content: '';
        position: absolute;
        top: 50%;
        width: 36%;
        height: 1px;
        background: #eeece8;
    }

    .chat-date-divider::before { left: 0; }
    .chat-date-divider::after  { right: 0; }

    .chat-msg {
        display: flex;
        flex-direction: column;
        max-width: 78%;
        gap: 3px;
    }

    .chat-msg.me {
        align-self: flex-end;
        align-items: flex-end;
    }

    .chat-msg.other {
        align-self: flex-start;
        align-items: flex-start;
    }

    .bubble {
        padding: 9px 13px;
        border-radius: 16px;
        font-size: 14px;
        line-height: 1.55;
        word-break: break-word;
    }

    .chat-msg.me .bubble {
        background: #1a1a2e;
        color: #e8e8f0;
        border-bottom-right-radius: 4px;
    }

    .chat-msg.other .bubble {
        background: #f4f3f0;
        color: #1a1a2e;
        border: 1px solid #e8e6e1;
        border-bottom-left-radius: 4px;
    }

    .chat-msg small {
        font-size: 11px;
        color: #bbb;
        padding: 0 4px;
    }

    .chat-msg-status {
        display: flex;
        align-items: center;
        gap: 3px;
        font-size: 11px;
        color: #bbb;
        padding: 0 4px;
    }

    .chat-msg-status .bi {
        font-size: 13px;
    }

    .chat-empty {
        text-align: center;
        color: #aaa;
        font-size: 13px;
        margin: auto;
    }

    /* ── INPUT ── */
    .chat-input-area {
        padding: 12px 14px;
        border-top: 1px solid #eeece8;
        background: #ffffff;
        flex-shrink: 0;
    }

    .chat-input {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #f4f3f0;
        border: 1px solid #e0ded9;
        border-radius: 50px;
        padding: 6px 6px 6px 14px;
        transition: border-color 0.15s;
    }

    .chat-input:focus-within {
        border-color: #aaa;
    }

    .chat-input input[type="text"] {
        flex: 1;
        border: none;
        background: transparent;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        color: #1a1a2e;
        outline: none;
        min-width: 0;
    }

    .chat-input input[type="text"]::placeholder {
        color: #bbb;
    }

    .chat-attach-btn {
        background: none;
        border: none;
        color: #aaa;
        font-size: 18px;
        cursor: pointer;
        padding: 4px;
        display: flex;
        align-items: center;
        border-radius: 50%;
        transition: background 0.15s, color 0.15s;
    }

    .chat-attach-btn:hover {
        background: #e8e6e1;
        color: #555;
    }

    .chat-send-btn {
        width: 36px;
        height: 36px;
        background: #1a1a2e;
        border: none;
        border-radius: 50%;
        color: #e8e8f0;
        font-size: 15px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: opacity 0.15s, transform 0.1s;
    }

    .chat-send-btn:hover  { opacity: 0.85; }
    .chat-send-btn:active { transform: scale(0.93); }

    /* ── TYPING INDICATOR ── */
    .typing-indicator {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 9px 13px;
        background: #f4f3f0;
        border: 1px solid #e8e6e1;
        border-radius: 16px;
        border-bottom-left-radius: 4px;
        width: fit-content;
    }

    .typing-dot {
        width: 6px;
        height: 6px;
        background: #bbb;
        border-radius: 50%;
        animation: chatBounce 1.2s infinite;
    }

    .typing-dot:nth-child(2) { animation-delay: 0.2s; }
    .typing-dot:nth-child(3) { animation-delay: 0.4s; }

    @@keyframes chatBounce {
        0%, 60%, 100% { transform: translateY(0); }
        30%            { transform: translateY(-5px); }
    }
</style>

<div class="chat-wrap">
    <div class="chat-container">

        <!-- HEADER -->
        <div class="chat-header">
            <a href="javascript:history.back()" class="chat-header-back" aria-label="Back">
                <i class="bi bi-chevron-left"></i>
            </a>
            <img src="@Model.ProductImage" class="chat-product-img" alt="@Model.ProductName" />
            <div class="chat-product-info">
                <h3>@Model.ProductName</h3>
                <small>@Model.VariationText</small>
            </div>
        </div>

        <!-- MESSAGES -->
        <div id="chatBox" class="chat-box">

            @if (Model.Messages != null && Model.Messages.Any())
            {
                string? lastDate = null;

                foreach (var msg in Model.Messages)
                {
                    string msgDate = msg.SentAt.ToString("dd MMM yyyy");

                    if (msgDate != lastDate)
                    {
                        lastDate = msgDate;
                        <div class="chat-date-divider">@msgDate</div>
                    }

                    bool isMe = msg.SenderId == Model.BuyerId;

                    <div class="chat-msg @(isMe ? "me" : "other")">
                        <div class="bubble">@msg.MessageText</div>
                        @if (isMe)
                        {
                            <div class="chat-msg-status">
                                <span>@msg.SentAt.ToString("HH:mm")</span>
                                <i class="bi bi-check2-all" style="color: #3a86ff;"></i>
                            </div>
                        }
                        else
                        {
                            <small>@msg.SentAt.ToString("HH:mm")</small>
                        }
                    </div>
                }
            }
            else
            {
                <p class="chat-empty">No messages yet. Start the conversation!</p>
            }

            <!-- Typing indicator (hidden by default, shown via JS) -->
            <div class="chat-msg other" id="typingRow" style="display:none;">
                <div class="typing-indicator">
                    <div class="typing-dot"></div>
                    <div class="typing-dot"></div>
                    <div class="typing-dot"></div>
                </div>
            </div>

        </div>

        <!-- INPUT -->
        <div class="chat-input-area">
            <form id="chatForm" method="post" action="/Chat/SendMessage">
                <input type="hidden" name="conversationId" value="@Model.ConversationId" />

                <div class="chat-input">
                    <button type="button" class="chat-attach-btn" aria-label="Attach file">
                        <i class="bi bi-paperclip"></i>
                    </button>
                    <input type="text" name="message" id="msgInput" placeholder="Type a message..." required autocomplete="off" />
                    <button type="submit" class="chat-send-btn" aria-label="Send message">
                        <i class="bi bi-send-fill" style="margin-left:1px;"></i>
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>

<script>
    const chatBox = document.getElementById('chatBox');
    const chatForm = document.getElementById('chatForm');
    const msgInput = document.getElementById('msgInput');
    const typingRow = document.getElementById('typingRow');

    // Auto-scroll to latest message on load
    chatBox.scrollTop = chatBox.scrollHeight;

    // Show typing indicator briefly after sending, then submit
    chatForm.addEventListener('submit', function (e) {
        const text = msgInput.value.trim();
        if (!text) return;

        // Optionally show typing indicator for seller reply simulation
        // Remove this block if you don't want the effect:
        typingRow.style.display = 'flex';
        chatBox.scrollTop = chatBox.scrollHeight;

        // Short delay so user sees the indicator, then let form submit
        // Remove timeout and just submit if you prefer instant navigation:
        e.preventDefault();
        setTimeout(() => {
            typingRow.style.display = 'none';
            chatForm.submit();
        }, 600);
    });
</script>
