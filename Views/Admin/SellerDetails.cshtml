@model EcommerceSystem.Models.Seller

@section Styles {
    <link rel="stylesheet" href="~/css/admin/seller-details.css" />
}

<div class="seller-modal-header">
    <div style="display: flex; align-items: center; justify-content: space-between;">
        <div style="display: flex; align-items: center;">
            <div class="shop-avatar-circle">@Model.ShopName[0]</div>
            <div>
                <h5 class="gradient-text fw-bold mb-1" style="margin: 0; font-size: 1.5rem;">@Model.ShopName</h5>
                <small class="text-muted"><i class="fas fa-store me-1"></i>Store #@Model.UserId</small>
            </div>
        </div>
        @{
            var statusClass = !Model.IsActive ? "bg-danger" : (Model.IsApproved ? "bg-success" : "bg-warning");
            var statusIcon = !Model.IsActive ? "fa-ban" : (Model.IsApproved ? "fa-check-circle" : "fa-clock");
            var statusText = !Model.IsActive ? "Banned" : (Model.IsApproved ? "Active" : "Pending");
        }
        <span class="badge badge-custom @statusClass">
            <i class="fas @statusIcon"></i> @statusText
        </span>
    </div>
</div>

<div class="modal-body" style="background: #ffffff; color: #1f2937; max-height: 70vh; overflow-y: auto; padding: 2rem;">
    <!-- Account Information Section -->
    <div class="section-header">
        <i class="fas fa-user-circle"></i>
        <h6>Account Information</h6>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="info-card">
                <span class="info-label"><i class="fas fa-envelope stat-icon"></i>Email Address</span>
                <span class="info-value">@Model.Email</span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="info-card">
                <span class="info-label"><i class="fas fa-phone stat-icon"></i>Phone Number</span>
                <span class="info-value">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</span>
            </div>
        </div>
    </div>

    <hr class="section-divider" />

    <!-- Business Information Section -->
    <div class="section-header">
        <i class="fas fa-briefcase"></i>
        <h6>Business Information</h6>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="stat-box">
                <span class="info-label">Tax Identification Number (TIN)</span>
                <span class="info-value">@(string.IsNullOrEmpty(Model.TIN) ? "⚠️ Not provided" : Model.TIN)</span>
            </div>
        </div>
        <div class="col-12">
            <div class="stat-box">
                <span class="info-label">NRIC Number</span>
                <span class="info-value">@(string.IsNullOrEmpty(Model.NRICNumber) ? "⚠️ Not provided" : Model.NRICNumber)</span>
            </div>
        </div>
        <div class="col-12">
            <div class="stat-box">
                <span class="info-label">Products Sold</span>
                <span class="info-value">
                    <i class="fas fa-box stat-icon"></i>
                    <strong>@Model.SoldItemCount</strong> items
                </span>
            </div>
        </div>
    </div>

    <hr class="section-divider" />

    <!-- Address Information Section -->
    <div class="section-header">
        <i class="fas fa-map-marker-alt"></i>
        <h6>Address Information</h6>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="info-card">
                <span class="info-label"><i class="fas fa-globe stat-icon"></i>State</span>
                <span class="info-value">@(string.IsNullOrEmpty(Model.State) ? "Not provided" : Model.State)</span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="info-card">
                <span class="info-label"><i class="fas fa-mailbox stat-icon"></i>Postal Code</span>
                <span class="info-value">@(string.IsNullOrEmpty(Model.PostalCode) ? "Not provided" : Model.PostalCode)</span>
            </div>
        </div>
        <div class="col-12">
            <div class="info-card">
                <span class="info-label"><i class="fas fa-address-card stat-icon"></i>Detailed Address</span>
                <span class="info-value">@(string.IsNullOrEmpty(Model.DetailAddress) ? "Not provided" : Model.DetailAddress)</span>
            </div>
        </div>
        <div class="col-12">
            <div class="info-card">
                <span class="info-label"><i class="fas fa-truck stat-icon"></i>Pickup Address</span>
                <span class="info-value">@(string.IsNullOrEmpty(Model.PickupAddress) ? "Not provided" : Model.PickupAddress)</span>
            </div>
        </div>
    </div>
</div>

<div class="modal-footer" style="background: #f9fafb; border-top: 1px solid rgba(100,200,255,0.15); padding: 1.5rem;">
    <button type="button" class="glass-btn secondary btn-sm" data-bs-dismiss="modal">
        <i class="fas fa-times me-1"></i> Close
    </button>
</div>