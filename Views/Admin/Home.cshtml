@{
    ViewData["Title"] = "Admin Overview";
    Layout = "~/Views/Admin/Layout.cshtml";
}

<link rel="stylesheet" href="~/css/admin/dashboard.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="dashboard-wrapper">
    <main class="content-area">
        <div class="admin-header">
            <div class="header-content">
                <h1 class="main-title">Admin Dashboard</h1>
                <h2 class="subtitle">Command Center</h2>
                <p class="header-description">Welcome back, Administrator. Manage your platform efficiently.</p>
            </div>
                        <!-- Bell Icon -->
            <div class="notif-wrapper" id="notifWrapper">
                <button class="notif-bell" id="notifBell" onclick="toggleNotifDropdown()">
                    <i class="fas fa-bell"></i>
                    <span class="notif-badge" id="notifBadge" style="display:none;">0</span>
                </button>

                <div class="notif-dropdown" id="notifDropdown" style="display:none;">
                    <div class="notif-header">
                        <span>Notifications</span>
                        <button onclick="markAllRead()" class="notif-mark-all">Mark all read</button>
                    </div>
                    <div class="notif-list" id="notifList">
                        <p class="notif-empty">Loading...</p>
                    </div>
                </div>
            </div>
            <form asp-controller="Auth" asp-action="Logout" method="post" style="align-self: flex-start;">
                <button type="submit" class="logout-btn">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </button>
            </form>
        </div>

        <div class="stats-section">
            <div class="card stat-card primary">
                <div class="card-body d-flex align-items-center p-4">
                    <div class="icon-shape"><i class="fas fa-shopping-cart"></i></div>
                    <div>
                        <div class="stat-label">Total Orders</div>
                        <div class="stat-value">@ViewBag.TotalOrders</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="cards-section">
            <div class="feature-card info">
                <div class="feature-icon">
                    <i class="fas fa-headset"></i>
                </div>
                <h3 class="feature-title">Support Staff</h3>
                <p class="feature-description">Monitor support activity, update account permissions, and manage your customer service team.</p>
                
                <a href="@Url.Action("ManageCustomerService", "Admin")" class="btn btn-manage btn-info">
                    <i class="fas fa-users-gear me-2"></i> Manage Staff
                </a>
            </div>

            <div class="feature-card primary">
                <div class="feature-icon">
                    <i class="fas fa-users-cog"></i>
                </div>
                <h3 class="feature-title">User Access</h3>
                <p class="feature-description">Review seller applications, manage accounts, and control permissions across the platform.</p>
                
                <a href="@Url.Action("ManageUsers", "Admin")" class="btn btn-manage btn-primary">
                    <i class="fas fa-arrow-right me-2"></i> Manage Users
                </a>
            </div>

            <div class="feature-card warning">
                <div class="feature-icon">
                    <i class="fas fa-boxes-stacked"></i>
                </div>
                <h3 class="feature-title">Inventory Review</h3>
                <p class="feature-description">Validate product listings, review violations, and maintain catalog quality standards.</p>
                <a href="@Url.Action("InventoryReview", "Admin")" class="btn btn-manage btn-warning">
                    <i class="fas fa-arrow-right me-2"></i> Review Queue
                </a>
            </div>

            <div class="feature-card success">
                <div class="feature-icon">
                    <i class="fas fa-flag"></i>
                </div>
                <h3 class="feature-title">Customer Reports</h3>
                <p class="feature-description">Monitor product and review reports submitted by customers. Review violations and take action.</p>
                <a href="@Url.Action("ViewCustomerReports", "Admin")" class="btn btn-manage btn-success">
                    <i class="fas fa-arrow-right me-2"></i> View Reports
                </a>
            </div>

            <div class="feature-card success">
                <div class="feature-icon">
                    <i class="fas fa-ticket-alt"></i>
                </div>
                <h3 class="feature-title">Voucher Management</h3>
                <p class="feature-description">Create discount vouchers, monitor redemption activity, and manage promotional campaigns across the platform.</p>
                <a href="@Url.Action("VoucherManagement", "Admin")" class="btn btn-manage btn-success">
                    <i class="fas fa-ticket me-2"></i> Manage Vouchers
                </a>
            </div>
        </div>
    </main>
</div>