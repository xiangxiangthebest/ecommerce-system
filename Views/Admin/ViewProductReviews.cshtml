@model List<EcommerceSystem.Models.Review>

@if (Model == null || Model.Count == 0)
{
    <div class="text-center py-4 text-muted">
        <i class="fas fa-comment-slash fa-2x mb-2 d-block"></i>
        <span>No reviews yet for this product.</span>
    </div>
}
else
{
    @* ── Rating Summary Bar ── *@
    var avg = Model.Average(r => r.Rating);
    var totalReviews = Model.Count;

    <div class="review-summary mb-3 p-3 rounded" style="background: var(--bs-light, #f8f9fa);">
        <div class="d-flex align-items-center gap-3">
            <div class="text-center">
                <div style="font-size: 2rem; font-weight: 700; line-height: 1;">@avg.ToString("0.0")</div>
                <div class="text-warning" style="font-size: 1.1rem;">
                    @for (int s = 1; s <= 5; s++)
                    {
                        <span>@(s <= Math.Round(avg) ? "★" : "☆")</span>
                    }
                </div>
                <small class="text-muted">@totalReviews review@(totalReviews == 1 ? "" : "s")</small>
            </div>
            <div class="flex-grow-1">
                @for (int star = 5; star >= 1; star--)
                {
                    var count = Model.Count(r => r.Rating == star);
                    var pct = totalReviews > 0 ? (double)count / totalReviews * 100 : 0;
                    <div class="d-flex align-items-center gap-2 mb-1" style="font-size: 0.8rem;">
                        <span style="width: 40px;">@star ★</span>
                        <div class="progress flex-grow-1" style="height: 8px;">
                            <div class="progress-bar bg-warning" style="width: @pct.ToString("0")%;"></div>
                        </div>
                        <span class="text-muted" style="width: 24px;">@count</span>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── Individual Reviews ── *@
    <div class="review-list" style="max-height: 420px; overflow-y: auto;">
        @foreach (var review in Model)
        {
            var customer = review.OrderItem?.Order?.Customer;
            var customerName = customer?.FullName ?? "Anonymous";
            var initial = customerName.Length > 0 ? customerName[0].ToString().ToUpper() : "?";
            @* NOTE: Replace "ReviewText" below with your actual Review model text property name *@
            var commentText = review.ReviewText;
            <div class="review-card p-3 mb-2 rounded border" data-review-id="@review.ReviewId">
                <div class="d-flex justify-content-between align-items-start">
                    <small class="text-muted">@review.CreatedAt.ToString("dd MMM yyyy")</small>
                    <form method="post" action="/Admin/DeleteReview"
                        onsubmit="return confirm('Are you sure you want to permanently delete this review?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@review.ReviewId" />
                        <input type="hidden" name="productId" value="@review.OrderItem.ProductId" />
                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                style="padding: 0.15rem 0.45rem; font-size: 0.75rem; line-height: 1.4;">
                            <i class="fas fa-trash"></i>
                        </button>
                    </form>
                </div>
                @if (!string.IsNullOrWhiteSpace(commentText))
                {
                    <p class="mt-2 mb-0" style="font-size: 0.88rem; color: #444;">@commentText</p>
                }
                else
                {
                    <p class="mt-2 mb-0 text-muted fst-italic" style="font-size: 0.85rem;">No written comment.</p>
                }
            </div>
        }
    </div>
}
