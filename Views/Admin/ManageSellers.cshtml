@model List<EcommerceSystem.Models.Seller>

@{
    ViewData["Title"] = "Seller Directory";
    Layout = "~/Views/Admin/Layout.cshtml";
}

<link rel="stylesheet" href="~/css/admin/manage-users.css" />

<div class="glass-container">
   <div class="dashboard-header">
        <div class="header-text">
            <h1 class="gradient-text">Seller Directory</h1>
            <p class="subtitle">Manage seller partnerships</p>
        </div>
        
        <div class="header-actions">
            <a href="@Url.Action("Home", "Admin")" class="glass-btn secondary">
                <i class="fas fa-arrow-left"></i> <span>Dashboard</span>
            </a>

            <form asp-action="ManageSellers" method="get" class="filter-form">
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" 
                    placeholder="Search keywords..." class="filter-input" />

                <select name="statusFilter" class="filter-select" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="Active" selected="@(ViewBag.StatusFilter == "Active")">Active</option>
                    <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending")">Pending Review</option>
                    <option value="Banned" selected="@(ViewBag.StatusFilter == "Banned")">Banned</option>
                </select>

                <button type="submit" class="filter-btn">
                    <i class="fas fa-filter"></i> Filter
                </button>
            </form>
        </div>
    </div>

    <div class="table-wrapper">
        <table class="fancy-table">
            <thead>
                <tr>
                    <th>Shop Detail</th>
                    <th>Email</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var seller in Model)
                {
                    <tr class="@(!seller.IsActive ? "banned-row" : "")">
                        <td>
                            <div class="shop-cell">
                                <div class="shop-avatar">@seller.ShopName[0]</div>
                                <div>
                                    <div class="shop-name">@seller.ShopName</div>
                                    <div class="shop-id">ID: @seller.UserId</div>
                                </div>
                            </div>
                        </td>
                        <td>@seller.Email</td>
                        <td>@seller.State</td>
                        <td>
                            @if (!seller.IsActive)
                            {
                                <span class="pill pill-danger">Banned</span>
                            }
                            else if (seller.IsApproved)
                            {
                                <span class="pill pill-success">Active</span>
                            }
                            else
                            {
                                <span class="pill pill-warning">Pending Review</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2 justify-content-center">
                                @* 1. Brand New View Details Button Trigger *@
                                <button type="button" class="btn btn-sm btn-info btn-view-details" data-id="@seller.UserId">
                                    <i class="fas fa-eye"></i> View Details
                                </button>

                                @if (seller.IsActive)
                                {
                                    @if (!seller.IsApproved)
                                    {
                                        <form asp-action="ApproveSeller" asp-route-id="@seller.UserId" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="fas fa-check"></i> Approve
                                            </button>
                                        </form>
                                    }

                                    <form asp-action="BanSeller" asp-route-id="@seller.UserId" method="post" class="m-0"
                                        onsubmit="return confirm('Permanently ban @seller.ShopName? This action cannot be undone.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-ban"></i> Ban
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted"><i class="fas fa-user-lock"></i> Account Locked</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="sellerDetailsModal" tabindex="-1" aria-labelledby="sellerDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" id="sellerModalContainer" style="background: #1a1a2e; border: 1px solid rgba(255,255,255,0.15); border-radius: 12px; box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);">
            </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.btn-view-details').on('click', function () {
                var sellerId = $(this).data('id');
                
                // Show standard loading indicator in modal container
                $('#sellerModalContainer').html('<div class="modal-body text-center py-5 text-white"><div class="spinner-border text-info mb-3" role="status"></div><p class="m-0 subtitle">Loading profile details...</p></div>');
                $('#sellerDetailsModal').modal('show');

                // Async dynamic content partial fetch
                $.get('/Admin/GetSellerDetails/' + sellerId, function (htmlResponse) {
                    $('#sellerModalContainer').html(htmlResponse);
                }).fail(function () {
                    $('#sellerModalContainer').html('<div class="modal-body text-center py-4 text-danger"><i class="fas fa-exclamation-triangle fa-2x mb-2"></i><p class="m-0">Failed to load seller profile details.</p></div>');
                });
            });
        });
    </script>
}