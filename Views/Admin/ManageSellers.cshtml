@model List<EcommerceSystem.Models.Seller>

@{
    ViewData["Title"] = "Manage Sellers";
}

<link rel="stylesheet" href="~/css/seller-dashboard.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<div class="admin-manage-sellers">
    <div class="manage-header">
        <h1 class="section-title">Manage Sellers</h1>
        <a href="@Url.Action("Home", "Admin")" class="btn-back">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    @* Flash messages *@
    @if (TempData["Success"] != null)
    {
        <div class="alert-banner alert-success">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-banner alert-error">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        </div>
    }

    @* Pending section *@
    <h2 class="manage-section-label">
        <i class="fas fa-hourglass-half"></i> Pending Approval
        <span class="badge-count">@Model.Count(s => !s.IsApproved)</span>
    </h2>

    @{
        var pendingSellers = Model.Where(s => !s.IsApproved).ToList();
    }

    @if (pendingSellers.Any())
    {
        <table class="sellers-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Shop Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>State</th>
                    <th>Registered</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var seller in pendingSellers)
                {
                    <tr>
                        <td>#@seller.UserId</td>
                        <td><strong>@seller.ShopName</strong></td>
                        <td>@seller.Email</td>
                        <td>@seller.PhoneNumber</td>
                        <td>@seller.State</td>
                        <td>@seller.DateJoin.ToString("dd MMM yyyy")</td>
                        <td>
                            <form asp-action="ApproveSeller" asp-route-id="@seller.UserId" method="post"
                                  onsubmit="return confirm('Approve @seller.ShopName?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-approve">
                                    <i class="fas fa-check"></i> Approve
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state-inline">
            <p>No sellers pending approval.</p>
        </div>
    }

    @* Approved section *@
    <h2 class="manage-section-label" style="margin-top: 2.5rem;">
        <i class="fas fa-check-circle"></i> Approved Sellers
        <span class="badge-count badge-approved">@Model.Count(s => s.IsApproved)</span>
    </h2>

    @{
        var approvedSellers = Model.Where(s => s.IsApproved).ToList();
    }

    @if (approvedSellers.Any())
    {
        <table class="sellers-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Shop Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>State</th>
                    <th>Registered</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var seller in approvedSellers)
                {
                    <tr>
                        <td>#@seller.UserId</td>
                        <td><strong>@seller.ShopName</strong></td>
                        <td>@seller.Email</td>
                        <td>@seller.PhoneNumber</td>
                        <td>@seller.State</td>
                        <td>@seller.DateJoin.ToString("dd MMM yyyy")</td>
                        <td>
                            <form asp-action="RevokeSeller" asp-route-id="@seller.UserId" method="post"
                                  onsubmit="return confirm('Revoke approval for @seller.ShopName? They will lose access to Product and Order pages.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-revoke">
                                    <i class="fas fa-ban"></i> Revoke
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state-inline">
            <p>No approved sellers yet.</p>
        </div>
    }
</div>

<style>
    /* ── Page layout ── */
    .admin-manage-sellers {
        max-width: 1100px;
        margin: 2rem auto;
        padding: 0 1.5rem 3rem;
        font-family: 'Segoe UI', sans-serif;
    }

    .manage-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }

    .section-title {
        font-size: 1.7rem;
        font-weight: 700;
        color: #1a237e;
        margin: 0;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #1a237e;
        color: #fff;
        padding: 8px 16px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.9rem;
        transition: background 0.2s;
    }
    .btn-back:hover { background: #283593; color: #fff; }

    /* ── Alert banners ── */
    .alert-banner {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 1.2rem;
        font-size: 0.95rem;
        font-weight: 500;
    }
    .alert-success { background: #e8f5e9; color: #2e7d32; border: 1px solid #a5d6a7; }
    .alert-error   { background: #ffebee; color: #c62828; border: 1px solid #ef9a9a; }

    /* ── Section labels ── */
    .manage-section-label {
        font-size: 1.1rem;
        font-weight: 600;
        color: #37474f;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .badge-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #ff7043;
        color: #fff;
        border-radius: 12px;
        padding: 2px 10px;
        font-size: 0.8rem;
        font-weight: 700;
        min-width: 28px;
    }
    .badge-approved { background: #43a047; }

    /* ── Sellers table ── */
    .sellers-table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .sellers-table thead {
        background: #1a237e;
        color: #fff;
    }
    .sellers-table th,
    .sellers-table td {
        padding: 12px 14px;
        text-align: left;
        font-size: 0.88rem;
        border-bottom: 1px solid #e8eaf6;
    }
    .sellers-table tbody tr:last-child td { border-bottom: none; }
    .sellers-table tbody tr:hover { background: #f5f5f5; }

    /* ── Action buttons ── */
    .btn-approve,
    .btn-revoke {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 14px;
        border: none;
        border-radius: 5px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s;
    }
    .btn-approve { background: #43a047; color: #fff; }
    .btn-approve:hover { opacity: 0.85; }
    .btn-revoke  { background: #e53935; color: #fff; }
    .btn-revoke:hover  { opacity: 0.85; }

    /* ── Empty state ── */
    .empty-state-inline {
        padding: 1rem 1.5rem;
        background: #fafafa;
        border: 1px dashed #cfd8dc;
        border-radius: 8px;
        color: #78909c;
        font-size: 0.9rem;
    }
</style>
