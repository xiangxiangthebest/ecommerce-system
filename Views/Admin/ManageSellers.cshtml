@model List<EcommerceSystem.Models.Seller>

@{
    ViewData["Title"] = "Seller Directory";
    Layout = "~/Views/Admin/Layout.cshtml";
}

<link rel="stylesheet" href="~/css/admin/manage-users.css" />

<div class="glass-container">
   <div class="dashboard-header">
        <div class="header-text">
            <h1 class="gradient-text">Seller Directory</h1>
            <p class="subtitle">Manage seller partnerships</p>
        </div>
        
        <div class="header-actions">
            <a href="@Url.Action("Home", "Admin")" class="glass-btn secondary">
                <i class="fas fa-arrow-left"></i> <span>Dashboard</span>
            </a>

            <form asp-action="ManageSellers" method="get" class="filter-form">
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" 
                    placeholder="Search keywords..." class="filter-input" />

                <select name="statusFilter" class="filter-select" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="Active" selected="@(ViewBag.StatusFilter == "Active")">Active</option>
                    <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending")">Pending Review</option>
                    <option value="Banned" selected="@(ViewBag.StatusFilter == "Banned")">Banned</option>
                </select>

                <button type="submit" class="filter-btn">
                    <i class="fas fa-filter"></i> Filter
                </button>
            </form>
        </div>
    </div>

    <div class="table-wrapper">
        <table class="fancy-table">
            <thead>
                <tr>
                    <th>Shop Detail</th>
                    <th>Email</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var seller in Model)
                {
                    <tr class="@(!seller.IsActive ? "banned-row" : "")">
                        <td>
                            <div class="shop-cell">
                                <div class="shop-avatar">@seller.ShopName[0]</div>
                                <div>
                                    <div class="shop-name">@seller.ShopName</div>
                                    <div class="shop-id">ID: @seller.UserId</div>
                                </div>
                            </div>
                        </td>
                        <td>@seller.Email</td>
                        <td>@seller.State</td>
                        <td>
                            @if (!seller.IsActive)
                            {
                                <span class="pill pill-danger">Banned</span>
                            }
                            else if (seller.IsApproved)
                            {
                                <span class="pill pill-success">Active</span>
                            }
                            else
                            {
                                <span class="pill pill-warning">Pending Review</span>
                            }
                        </td>
                        <td class="action-column">
                            <div class="actions-wrapper">
                                @if (seller.IsActive)
                                {
                                    @if (!seller.IsApproved)
                                    {
                                        @* Approve Action: Only shows for Active + Unapproved sellers *@
                                        <form asp-action="ApproveSeller" asp-route-id="@seller.UserId" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="fas fa-check"></i> Approve
                                            </button>
                                        </form>
                                    }

                                    @* Ban Action: Sets IsActive to false permanently *@
                                    <form asp-action="BanSeller" asp-route-id="@seller.UserId" method="post" 
                                        onsubmit="return confirm('Permanently ban @seller.ShopName? This action cannot be undone.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-ban"></i> Ban
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    @* When Banned, no buttons are shown, or just a lock icon *@
                                    <span class="text-muted"><i class="fas fa-user-lock"></i> Account Locked</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>