@model List<EcommerceSystem.Models.Product>

@{
    ViewData["Title"] = "Inventory Review";
    Layout = "~/Views/Admin/Layout.cshtml";
}

<link rel="stylesheet" href="~/css/admin/manage-users.css" />
<link rel="stylesheet" href="~/css/admin/inventory-review.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="glass-container">
    <div class="dashboard-header mb-4 d-flex justify-content-between align-items-center">
        <div class="header-text">
            <h1><i class="fas fa-boxes-stacked me-3"></i>Inventory Review</h1>
            <p class="subtitle">
                <i class="fas fa-chart-bar me-1"></i>
                Monitor all products and stock levels across the platform
            </p>
        </div>
        
        <div class="header-actions">
            <a href="@Url.Action("Home", "Admin")" class="glass-btn secondary">
                <i class="fas fa-arrow-left me-2"></i> <span>Dashboard</span>
            </a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-lg-12">
            <div class="card card-summary-wrapper">
                <div class="card-body p-4">
                    <div class="stat-grid-container">
                        <div class="stat-item">
                            <div class="stat-content">
                                <span class="stat-label">Total Products</span>
                                <span class="stat-value">@ViewBag.TotalProducts</span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-item">
                                <div class="stat-content">
                                    <span class="stat-label">Published</span>
                                    <span class="stat-value">@ViewBag.PublishedCount</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-item">
                                <div class="stat-content">
                                    <span class="stat-label">Out of Stock</span>
                                    <span class="stat-value">@ViewBag.OutOfStockCount</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-item">
                                <div class="stat-content">
                                    <span class="stat-label">Low Stock</span>
                                    <span class="stat-value">@ViewBag.LowStockCount</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-item">
                                <div class="stat-content">
                                    <span class="stat-label">Deleted</span>
                                    <span class="stat-value" style="color: #dc3545;">@ViewBag.DeletedCount</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-summary-wrapper mb-4">
        <div class="card-body p-3">
            <form method="get" action="@Url.Action("InventoryReview", "Admin")" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label text-dark fw-bold mb-1" style="font-size: 0.85rem;"><i class="fas fa-search me-1 text-muted"></i> Search Product</label>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search by product name or SKU..." value="@ViewBag.SearchTerm" style="border-radius: 8px; border: 1px solid #cbd5e1; height: 42px;" />
                </div>
                
                <div class="col-md-2">
                    <label class="form-label text-dark fw-bold mb-1" style="font-size: 0.85rem;"><i class="fas fa-tag me-1 text-muted"></i> Status</label>
                    <select name="statusFilter" class="form-select" style="border-radius: 8px; border: 1px solid #cbd5e1; height: 42px; color: #0f172a; font-weight: 500;">
                        <option value="" selected="@(string.IsNullOrEmpty(ViewBag.StatusFilter))">All Status</option>
                        <option value="Published" selected="@(ViewBag.StatusFilter == "Published")">Published</option>
                        <option value="Draft" selected="@(ViewBag.StatusFilter == "Draft")">Draft</option>
                    </select>
                </div>
                
                <div class="col-md-2">
                    <label class="form-label text-dark fw-bold mb-1" style="font-size: 0.85rem;"><i class="fas fa-cubes me-1 text-muted"></i> Stock Level</label>
                    <select name="stockFilter" class="form-select" style="border-radius: 8px; border: 1px solid #cbd5e1; height: 42px; color: #0f172a; font-weight: 500;">
                        <option value="" selected="@(string.IsNullOrEmpty(ViewBag.StockFilter))">All Stock Levels</option>
                        <option value="InStock" selected="@(ViewBag.StockFilter == "InStock")">In Stock (≥10)</option>
                        <option value="LowStock" selected="@(ViewBag.StockFilter == "LowStock")">Low Stock (1-9)</option>
                        <option value="OutOfStock" selected="@(ViewBag.StockFilter == "OutOfStock")">Out of Stock</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label text-dark fw-bold mb-1" style="font-size: 0.85rem;"><i class="fas fa-trash me-1 text-muted"></i> Product Status</label>
                    <select name="deleteFilter" class="form-select" style="border-radius: 8px; border: 1px solid #cbd5e1; height: 42px; color: #0f172a; font-weight: 500;">
                        <option value="Active" selected="@(ViewBag.DeleteFilter == "Active" || string.IsNullOrEmpty(ViewBag.DeleteFilter))">Active</option>
                        <option value="Deleted" selected="@(ViewBag.DeleteFilter == "Deleted")">Deleted</option>
                        <option value="All" selected="@(ViewBag.DeleteFilter == "All")">All Products</option>
                    </select>
                </div>
                
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1 fw-bold" style="border-radius: 8px; height: 42px; background: #4f46e5; border: none;">
                        Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning text-center shadow-sm alert-empty-state" role="alert">
            <i class="fas fa-info-circle me-2"></i>
            <strong>No Products Found</strong> - Try adjustments to your filtering settings or constraints.
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="fancy-table table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 20%;">Product Name</th>
                        <th style="width: 12%;">SKU</th>
                        <th style="width: 12%;">Category</th>
                        <th style="width: 12%;">Price</th>
                        <th style="width: 15%;">Stock</th>
                        <th style="width: 12%;">Status</th>
                        <th style="width: 10%;">Image</th>
                        <th class="text-center" style="width: 12%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr @(product.IsDeleted ? "style=\"opacity: 0.6; background-color: #f8d7da;\"" : "")>
                            <td>
                                <div class="product-name-cell">
                                    <strong>@product.Name</strong>
                                    @if (product.IsDeleted)
                                    {
                                        <span class="badge bg-danger ms-2"><i class="fas fa-trash me-1"></i> Deleted</span>
                                    }
                                    else if (product.StockQuantity == 0 && !product.IsDraft)
                                    {
                                        <span class="badge bg-danger ms-2">Out of Stock</span>
                                    }
                                    else if (product.StockQuantity < 10 && !product.IsDraft)
                                    {
                                        <span class="badge bg-warning text-dark ms-2">Low Stock</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <code class="sku-code-block">@product.SKU</code>
                            </td>
                            <td>
                                @(product.Category?.Name ?? "Uncategorized")
                            </td>
                            <td>
                                <span class="product-price-span">RM @product.Price.ToString("F2")</span>
                            </td>
                            <td>
                                <div class="stock-indicator">
                                    <span class="stock-number">@product.StockQuantity</span>
                                    <div class="stock-bar">
                                        @{
                                            var stockPercentage = Math.Min((double)product.StockQuantity / 100 * 100, 100);
                                            var barColor = product.StockQuantity == 0 ? "bg-danger"
                                                           : product.StockQuantity < 10 ? "bg-warning"
                                                           : "bg-success";
                                        }
                                        <div class="stock-fill @barColor" style="width: @stockPercentage%"></div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (product.IsDeleted)
                                {
                                    <span class=\"pill\" style=\"background-color: #dc3545; color: white;\">
                                        <i class=\"fas fa-ban me-1\"></i> Deleted
                                    </span>
                                }
                                else if (product.IsDraft)
                                {
                                    <span class="pill pill-warning">
                                        <i class="fas fa-edit me-1"></i> Draft
                                    </span>
                                }
                                else
                                {
                                    <span class="pill pill-success">
                                        <i class="fas fa-check-circle me-1"></i> Published
                                    </span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(product.ImagePath))
                                {
                                    <img src="@product.ImagePath" alt="@product.Name" class="product-thumbnail" data-bs-toggle="modal" data-bs-target="#productDetailsModal@(product.ProductId)" />
                                }
                                else
                                {
                                    <span class="text-muted" style="font-size: 0.85rem;"><i class="fas fa-image me-1"></i> None</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-2 justify-content-center">
                                    <button type="button" class="btn btn-sm btn-light btn-details-trigger" data-bs-toggle="modal" data-bs-target="#productDetailsModal@(product.ProductId)">
                                        <i class="fas fa-eye text-primary me-1"></i> Details
                                    </button>
                                    @if (product.IsDeleted)
                                    {
                                        <form method="post" action="@Url.Action("RestoreProduct", "Admin")" style="display:inline;" onsubmit="return confirm('Restore this product?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@product.ProductId" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                <i class="fas fa-undo me-1"></i> Restore
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" action="@Url.Action("DeleteProduct", "Admin")" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@product.ProductId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash me-1"></i> Delete
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@for (int i = 0; i < Model.Count; i++)
{
    var p = Model[i];
    <div class="modal fade" id="productDetailsModal@(p.ProductId)" tabindex="-1" aria-labelledby="productDetailsLabel@(p.ProductId)" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content product-details-modal-content">
                <div class="modal-header product-details-modal-header">
                    <h5 class="modal-title" id="productDetailsLabel@(p.ProductId)">
                        <i class="fas fa-info-circle text-primary me-2"></i> @p.Name
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body product-details-modal-body">
                    <div class="row">
                        <div class="col-md-4 mb-3 text-center">
                            @if (!string.IsNullOrEmpty(p.ImagePath))
                            {
                                <img src="@p.ImagePath" alt="@p.Name" class="img-fluid rounded shadow-sm product-modal-img" />
                            }
                            else
                            {
                                <div class="bg-light rounded d-flex align-items-center justify-content-center product-modal-img-none">
                                    <span class="text-muted"><i class="fas fa-image fa-3x mb-2 d-block"></i>No Image Available</span>
                                </div>
                            }
                        </div>
                        <div class="col-md-8">
                            <h6 class="modal-section-title">Product Information</h6>
                            
                            <div class="mb-3">
                                <label class="form-label modal-info-label">Product Name</label>
                                <p class="modal-info-value-title">@p.Name</p>
                            </div>

                            <div class="mb-3">
                                <label class="form-label modal-info-label">SKU</label>
                                <p style="margin: 0;"><code class="sku-code-block">@p.SKU</code></p>
                            </div>

                            <div class="mb-3">
                                <label class="form-label modal-info-label">Category</label>
                                <p class="modal-info-value-text">@(p.Category?.Name ?? "Uncategorized")</p>
                            </div>

                            <div class="mb-3">
                                <label class="form-label modal-info-label">Price</label>
                                <p class="modal-info-value-price">RM @p.Price.ToString("F2")</p>
                            </div>

                            <div class="mb-3">
                                <label class="form-label modal-info-label">Stock Quantity</label>
                                <p class="modal-info-value-stock">
                                    <strong>@p.StockQuantity</strong> units
                                    @if (p.StockQuantity == 0)
                                    {
                                        <span class="badge bg-danger ms-2">Out of Stock</span>
                                    }
                                    else if (p.StockQuantity < 10)
                                    {
                                        <span class="badge bg-warning text-dark ms-2">Low Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success ms-2">In Stock</span>
                                    }
                                </p>
                            </div>

                            <div class="mb-3">
                                <label class="form-label modal-info-label">Status</label>
                                <p style="margin: 0;">
                                    @if (p.IsDeleted)
                                    {
                                        <span class="badge" style="background-color: #dc3545; font-size: 0.8rem; font-weight: 700; padding: 0.4rem 0.75rem;"><i class="fas fa-ban me-1"></i> Deleted</span>
                                        @if (p.DeletedAt.HasValue)
                                        {
                                            <small class="text-muted d-block mt-2">Deleted: @p.DeletedAt.Value.ToString("dd MMM yyyy HH:mm")</small>
                                        }
                                    }
                                    else if (p.IsDraft)
                                    {
                                        <span class="badge bg-warning text-dark" style="font-size: 0.8rem; font-weight: 700; padding: 0.4rem 0.75rem;"><i class="fas fa-edit me-1"></i> Draft</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success" style="font-size: 0.8rem; font-weight: 700; padding: 0.4rem 0.75rem;"><i class="fas fa-check-circle me-1"></i> Published</span>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>

                    <hr>

                    <h6 class="modal-section-title" style="margin-bottom: 0.75rem;">Description</h6>
                    <p class="modal-description-paragraph">@p.Description</p>
                </div>
                <div class="modal-footer product-details-modal-footer">
                    @if (p.IsDeleted)
                    {
                        <form method="post" action="@Url.Action("RestoreProduct", "Admin")" style="display:inline;" onsubmit="return confirm('Restore this product?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@p.ProductId" />
                            <button type="submit" class="btn btn-success px-4">
                                <i class="fas fa-undo me-2"></i> Restore Product
                            </button>
                        </form>
                    }
                    else
                    {
                        <form method="post" action="@Url.Action("DeleteProduct", "Admin")" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this product? This action cannot be undone.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@p.ProductId" />
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="fas fa-trash me-2"></i> Delete Product
                            </button>
                        </form>
                    }
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}
}