@model List<EcommerceSystem.Models.Product>

@{
    ViewData["Title"] = "Seller Products";
    Layout = "~/Views/Admin/Layout.cshtml";
}

<link rel="stylesheet" href="~/css/admin/manage-users.css" />
<link rel="stylesheet" href="~/css/admin/inventory-review.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="glass-container">
    <div class="dashboard-header mb-4 d-flex justify-content-between align-items-center">
        <div class="header-text">
            <h1>@(ViewBag.Seller?.ShopName ?? "Seller") - Products & Stock</h1>
            <p class="subtitle mb-0">
                <i class="fas fa-store me-1"></i>
                @(ViewBag.Seller?.ShopName ?? "Seller Profile") |
                <i class="fas fa-box me-1"></i>
                @(ViewBag.ProductCount ?? Model?.Count ?? 0) product(s)
            </p>
        </div>
        
        <div class="header-actions">
            <a href="@Url.Action("ManageSellers", "Admin")" class="glass-btn secondary">
                <i class="fas fa-arrow-left me-2"></i> <span>Back to Sellers</span>
            </a>
        </div>
    </div>

    <div class="card card-summary-wrapper mb-4">
        <div class="card-body p-3">
            <div class="stat-grid-container">
                <div class="stat-item">
                    <div class="stat-icon stat-icon-total">
                        <i class="fas fa-box"></i>
                    </div>
                    <div class="stat-content">
                        <span class="stat-label">Total Products</span>
                        <span class="stat-value">@(ViewBag.ProductCount ?? Model?.Count ?? 0)</span>
                    </div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon stat-icon-published">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="stat-content">
                        <span class="stat-label">Published</span>
                        <span class="stat-value">@(Model != null ? Model.Count(p => !p.IsDraft) : 0)</span>
                    </div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon stat-icon-draft">
                        <i class="fas fa-edit"></i>
                    </div>
                    <div class="stat-content">
                        <span class="stat-label">Draft</span>
                        <span class="stat-value">@(Model != null ? Model.Count(p => p.IsDraft) : 0)</span>
                    </div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon stat-icon-lowstock">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="stat-content">
                        <span class="stat-label">Low Stock</span>
                        <span class="stat-value">@(Model != null ? Model.Count(p => p.StockQuantity < 10 && !p.IsDraft) : 0)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-warning text-center alert-empty-state py-4" role="alert">
            <i class="fas fa-info-circle me-2"></i>
            <strong>No Products Found</strong> - This seller has not uploaded any products yet.
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="fancy-table table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 18%;">Product Name</th>
                        <th style="width: 10%;">SKU</th>
                        <th style="width: 10%;">Category</th>
                        <th style="width: 10%;">Price</th>
                        <th style="width: 12%;">Stock</th>
                        <th style="width: 10%;">Status</th>
                        <th style="width: 18%;">Image</th>
                        <th class="text-center" style="width: 22%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr class="@(product.IsDraft ? "draft-row" : "") @(product.StockQuantity < 10 && !product.IsDraft ? "low-stock-row" : "")">
                            <td>
                                <div class="product-name-cell">
                                    <strong>@product.Name</strong>
                                    @if (product.StockQuantity == 0 && !product.IsDraft)
                                    {
                                        <span class="badge bg-danger">Out of Stock</span>
                                    }
                                    else if (product.StockQuantity < 10 && !product.IsDraft)
                                    {
                                        <span class="badge bg-warning text-dark">Low Stock</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="sku-code-block">@product.SKU</span>
                            </td>
                            <td>
                                @(product.Category?.Name ?? "Uncategorized")
                            </td>
                            <td>
                                <span class="product-price-span">RM @product.Price.ToString("F2")</span>
                            </td>
                            <td>
                                <div class="stock-indicator">
                                    <span class="stock-number">@product.StockQuantity</span>
                                    <div class="stock-bar">
                                        @{
                                            var stockPercentage = Math.Min((double)product.StockQuantity / 100 * 100, 100);
                                            var barColor = product.StockQuantity == 0 ? "bg-danger"
                                                           : product.StockQuantity < 10 ? "bg-warning"
                                                           : "bg-success";
                                        }
                                        <div class="stock-fill @barColor" style="width: @stockPercentage%"></div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (product.IsDraft)
                                {
                                    <span class="pill pill-warning">
                                        <i class="fas fa-edit me-1"></i> Draft
                                    </span>
                                }
                                else
                                {
                                    <span class="pill pill-success">
                                        <i class="fas fa-check-circle me-1"></i> Published
                                    </span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(product.ImagePath))
                                {
                                    <img src="@product.ImagePath" alt="@product.Name" class="product-thumbnail" data-bs-toggle="modal" data-bs-target="#productModal-@product.ProductId" />
                                }
                                else
                                {
                                    <span class="text-muted" style="font-size: 0.85rem;"><i class="fas fa-image me-1"></i> None</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex justify-content-center gap-1">
                                    <button type="button" class="btn btn-sm btn-details-trigger" data-bs-toggle="modal" data-bs-target="#productModal-@product.ProductId">
                                        <i class="fas fa-eye text-primary me-1"></i> Details
                                    </button>
                                    <button type="button" class="btn btn-sm btn-review-trigger"
                                            data-product-id="@product.ProductId"
                                            data-product-name="@product.Name"
                                            data-bs-toggle="modal" data-bs-target="#reviewsModal">
                                        <i class="fas fa-star text-warning me-1"></i> Reviews
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ── Shared Reviews Modal (loaded via AJAX) ── *@
<div class="modal fade" id="reviewsModal" tabindex="-1" aria-labelledby="reviewsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="reviewsModalLabel">
                    <i class="fas fa-star text-warning me-2"></i>
                    <span id="reviewsModalProductName">Product Reviews</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="reviewsModalBody">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Loading reviews...</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const antiforgeryToken = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)?.[1] ?? '';
    const reviewsModal = document.getElementById('reviewsModal');
    const reviewsModalBody = document.getElementById('reviewsModalBody');
    const reviewsModalProductName = document.getElementById('reviewsModalProductName');

    let currentProductId = null;

    function loadReviews(productId) {
        currentProductId = productId;
        reviewsModalBody.innerHTML = `
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2 text-muted">Loading reviews...</p>
            </div>`;

        fetch('/Admin/GetProductReviews?productId=' + productId)
            .then(function (response) {
                if (!response.ok) throw new Error('Network error: ' + response.status);
                return response.text();
            })
            .then(function (html) {
                reviewsModalBody.innerHTML = html;
                reviewsModalBody.querySelectorAll('.btn-delete-review').forEach(function (delBtn) {
                    delBtn.addEventListener('click', function () {
                        if (!confirm('Are you sure you want to permanently delete this review?')) return;
                        const reviewId = delBtn.getAttribute('data-review-id');
                        fetch('/Admin/DeleteReview', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': antiforgeryToken },
                            body: 'id=' + reviewId + '&__RequestVerificationToken=' + encodeURIComponent(antiforgeryToken)
                        })
                        .then(r => r.json())
                        .then(result => {
                            if (result.success) {
                                loadReviews(currentProductId);
                            } else {
                                alert('Failed to delete review: ' + result.message);
                            }
                        })
                        .catch(() => alert('An error occurred while deleting the review.'));
                    });
                });
            })
            .catch(function (err) {
                reviewsModalBody.innerHTML = `
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        Failed to load reviews. Please try again.
                    </div>`;
            });
    }

    const reviewButtons = document.querySelectorAll('.btn-review-trigger');
    reviewButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
            const productId = btn.getAttribute('data-product-id');
            const productName = btn.getAttribute('data-product-name');
            reviewsModalProductName.textContent = productName + ' — Reviews';
            loadReviews(productId);
        });
    });
});
</script>

@if (Model != null)
{
    @foreach (var product in Model)
    {
        <div class="modal fade" id="productModal-@product.ProductId" tabindex="-1" aria-labelledby="productDetailsLabel@product.ProductId" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content product-details-modal-content">
                    <div class="modal-header product-details-modal-header">
                        <h5 class="modal-title" id="productDetailsLabel@product.ProductId">
                            <i class="fas fa-info-circle text-primary me-2"></i> @product.Name
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body product-details-modal-body">
                        <div class="row g-3">
                            <div class="col-md-5 text-center">
                                @if (!string.IsNullOrEmpty(product.ImagePath))
                                {
                                    <img src="@product.ImagePath" alt="@product.Name" class="img-fluid product-modal-img" />
                                }
                                else
                                {
                                    <div class="rounded bg-light d-flex flex-column align-items-center justify-content-center product-modal-img-none">
                                        <i class="fas fa-image fa-2x mb-1"></i>
                                        <span>No Image</span>
                                    </div>
                                }
                            </div>
                            <div class="col-md-7">
                                <h6 class="modal-section-title mb-3">Product Details</h6>
                                
                                <div class="mb-2">
                                    <div class="modal-info-label">Product Name</div>
                                    <p class="modal-info-value-title">@product.Name</p>
                                </div>

                                <div class="mb-2">
                                    <div class="modal-info-label">SKU</div>
                                    <p class="m-0"><span class="sku-code-block">@product.SKU</span></p>
                                </div>

                                <div class="mb-2">
                                    <div class="modal-info-label">Category</div>
                                    <p class="m-0 fw-bold">@(product.Category?.Name ?? "Uncategorized")</p>
                                </div>

                                <div class="mb-2">
                                    <div class="modal-info-label">Price</div>
                                    <p class="modal-info-value-price">RM @product.Price.ToString("F2")</p>
                                </div>

                                <div class="mb-2">
                                    <div class="modal-info-label">Stock Status</div>
                                    <p class="m-0 text-dark">
                                        <strong class="fw-bold">@product.StockQuantity</strong> units
                                        @if (product.StockQuantity == 0)
                                        {
                                            <span class="badge bg-danger ms-1">Out of Stock</span>
                                        }
                                        else if (product.StockQuantity < 10)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">Low Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success ms-1">In Stock</span>
                                        }
                                    </p>
                                </div>

                                <div class="mb-2">
                                    <div class="modal-info-label">Status</div>
                                    <p class="m-0">
                                        @if (product.IsDraft)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="fas fa-edit me-1"></i> Draft</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i> Published</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>

                        <hr />

                        <h6 class="modal-section-title mb-2">Description</h6>
                        <p class="modal-description-paragraph">@product.Description</p>
                    </div>
                    <div class="modal-footer product-details-modal-footer">
                        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }
}