@model List<EcommerceSystem.Models.Order>

<link rel="stylesheet" href="~/css/customer/purchase-history.css" asp-append-version="true" />

@using System.Text.Json
@using System.Text.Json.Serialization

@{
    var totalSpent   = Model.Sum(o => o.TotalAmount);
    var pendingCnt   = Model.Count(o => o.CurrentStatus == EcommerceSystem.Models.OrderStatus.PENDING);
    var shippedCnt   = Model.Count(o => o.CurrentStatus == EcommerceSystem.Models.OrderStatus.SHIPPED);
    var deliveredCnt = Model.Count(o => o.CurrentStatus == EcommerceSystem.Models.OrderStatus.DELIVERED);
    var canceledCnt  = Model.Count(o => o.CurrentStatus == EcommerceSystem.Models.OrderStatus.CANCELED);

    // ── Build serializable order data for the modal ──────
    var jsonOpts = new JsonSerializerOptions { WriteIndented = false };

    var orderData = Model.Select(o => new {
        orderId       = o.OrderId,
        orderTime     = o.OrderTime.ToString("dd MMM yyyy, hh:mm tt"),
        status        = o.CurrentStatus.ToString().ToUpper(),
        statusLabel   = o.CurrentStatus.ToString(),
        paymentMethod = o.PaymentMethod,
        totalAmount   = o.TotalAmount.ToString("N2"),
        shopName      = o.OrderItems.FirstOrDefault()?.Product?.Seller?.ShopName ?? "Unknown Shop",
        shopInitial   = (o.OrderItems.FirstOrDefault()?.Product?.Seller?.ShopName ?? "S").Substring(0,1).ToUpper(),
        address       = o.Address == null ? null : new {
            recipientName = o.Address.RecipientName,
            phoneNumber   = o.Address.PhoneNumber,
            line1         = o.Address.AddressLine1,
            line2         = o.Address.AddressLine2 ?? "",
            city          = o.Address.City,
            postcode      = o.Address.Postcode,
            state         = o.Address.State
        },
        items = o.OrderItems.Select(item => new {
            name        = item.Product?.Name ?? "",
            image       = item.Product?.ImagePath ?? "",
            price       = item.Price.ToString("0.00"),
            qty         = item.Quantity,
            subtotal    = (item.Price * item.Quantity).ToString("0.00"),
            category    = item.Product?.Category?.Name ?? "",
            description = item.Product?.Description ?? "",
            sku         = item.Product?.SKU ?? "",
            rating      = item.Product?.AverageRating ?? 0,
            variation   = ParseVariationToString(item.SelectedVariation)
        }).ToList()
    }).ToList();

    var orderDataJson = JsonSerializer.Serialize(orderData, jsonOpts);
}

@functions {
    // Parse {"Size":"S","Colour":"Black"} → "Size: S · Colour: Black"
    string ParseVariationToString(string? json)
    {
        if (string.IsNullOrWhiteSpace(json) || json == "{}" || json == "[]") return "";
        try
        {
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind == JsonValueKind.Object)
            {
                var parts = new List<string>();
                foreach (var prop in doc.RootElement.EnumerateObject())
                    parts.Add($"{prop.Name}: {prop.Value}");
                return string.Join(" · ", parts);
            }
        }
        catch { }
        return "";
    }

    // Same helper for display tags in the card
    List<string> ParseVariationTags(string? json)
    {
        var tags = new List<string>();
        if (string.IsNullOrWhiteSpace(json) || json == "{}" || json == "[]") return tags;
        try
        {
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind == JsonValueKind.Object)
                foreach (var prop in doc.RootElement.EnumerateObject())
                    tags.Add($"{prop.Name}: {prop.Value}");
        }
        catch { }
        return tags;
    }
}

<div class="purchase-history-page">

    @if (TempData["OrderSuccess"] != null)
    {
        <div class="floating-alert" id="successAlert">
            <i class="ti ti-circle-check"></i>
            @TempData["OrderSuccess"]
        </div>
    }

    <!-- ─── Page Header ─── -->
    <div class="ph-header">
        <h1 class="ph-title">My Orders</h1>
        <span class="ph-subtitle">@Model.Count order@(Model.Count != 1 ? "s" : "") placed</span>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="ti ti-shopping-bag"></i></div>
            <h2 class="empty-title">No orders yet</h2>
            <p class="empty-sub">Looks like you haven't placed any orders.<br>Start shopping to see them here.</p>
            <a href="/Home" class="btn-shop">
                <i class="ti ti-arrow-right"></i> Start Shopping
            </a>
        </div>
    }
    else
    {
        <!-- ─── Summary Banner ─── -->
        <div class="summary-banner">
            <div class="summary-cell">
                <span class="summary-cell-label">Total Spent</span>
                <span class="summary-cell-value accent">RM @totalSpent.ToString("N2")</span>
            </div>
            <div class="summary-cell">
                <span class="summary-cell-label">Delivered</span>
                <span class="summary-cell-value green">@deliveredCnt</span>
            </div>
            <div class="summary-cell">
                <span class="summary-cell-label">In Transit</span>
                <span class="summary-cell-value yellow">@shippedCnt</span>
            </div>
            <div class="summary-cell">
                <span class="summary-cell-label">Pending</span>
                <span class="summary-cell-value">@pendingCnt</span>
            </div>
            <div class="summary-cell">
                <span class="summary-cell-label">Cancelled</span>
                <span class="summary-cell-value red">@canceledCnt</span>
            </div>
        </div>

        <!-- ─── Toolbar ─── -->
        <div class="ph-toolbar">
            <div class="ph-tabs">
                <button class="ph-tab active" onclick="filterOrders('ALL', this)">
                    All <span class="ph-tab-count">@Model.Count</span>
                </button>
                <button class="ph-tab" onclick="filterOrders('PENDING', this)">
                    Pending <span class="ph-tab-count">@pendingCnt</span>
                </button>
                <button class="ph-tab" onclick="filterOrders('SHIPPED', this)">
                    Shipped <span class="ph-tab-count">@shippedCnt</span>
                </button>
                <button class="ph-tab" onclick="filterOrders('DELIVERED', this)">
                    Delivered <span class="ph-tab-count">@deliveredCnt</span>
                </button>
                <button class="ph-tab" onclick="filterOrders('CANCELED', this)">
                    Cancelled <span class="ph-tab-count">@canceledCnt</span>
                </button>
            </div>
            <div class="ph-search">
                <i class="ti ti-search"></i>
                <input type="text" id="searchInput" placeholder="Search orders…" oninput="searchOrders()" />
            </div>
        </div>

        <!-- ─── Order Cards ─── -->
        <div id="orderList">
            @foreach (var order in Model)
            {
                var statusKey     = order.CurrentStatus.ToString().ToUpper();
                var itemCount     = order.OrderItems.Count;
                var sellerName    = order.OrderItems.FirstOrDefault()?.Product?.Seller?.ShopName ?? "Unknown Shop";
                var sellerInitial = sellerName.Length > 0 ? sellerName[0].ToString().ToUpper() : "S";
                var searchHint    = order.OrderId + " " + string.Join(" ", order.OrderItems.Select(i => i.Product?.Name ?? ""));

                <div class="order-card"
                     data-status="@statusKey"
                     data-search="@searchHint">

                    <!-- Card Header -->
                    <div class="order-card-header">
                        <div class="order-meta">
                            <span class="order-id">Order #@order.OrderId</span>
                            <span class="order-date">
                                <i class="ti ti-calendar"></i>
                                @order.OrderTime.ToString("dd MMM yyyy")
                                &nbsp;·&nbsp;
                                @order.OrderTime.ToString("hh:mm tt")
                            </span>
                        </div>
                        <span class="status-badge status-@statusKey">
                            <span class="status-dot"></span>
                            @order.CurrentStatus
                        </span>
                    </div>

                    <!-- Seller Strip -->
                    <div class="order-seller-strip">
                        <div class="seller-avatar">@sellerInitial</div>
                        Sold by <strong>@sellerName</strong>
                    </div>

                    <!-- Items Toggle -->
                    <button class="items-toggle" onclick="toggleItems(this)">
                        <span><i class="ti ti-package"></i> @itemCount item@(itemCount != 1 ? "s" : "")</span>
                        <i class="ti ti-chevron-down chevron"></i>
                    </button>

                    <!-- Collapsible Items -->
                    <div class="items-collapse" style="max-height:0; transition: max-height .3s ease;">
                        @foreach (var item in order.OrderItems)
                        {
                            var variationTags = ParseVariationTags(item.SelectedVariation);
                            <div class="order-item">
                                <div class="item-img-wrap">
                                    <img src="@item.Product?.ImagePath"
                                         alt="@item.Product?.Name"
                                         onerror="this.src='/images/placeholder.png'" />
                                    @if (item.Quantity > 1)
                                    {
                                        <span class="item-qty-badge">×@item.Quantity</span>
                                    }
                                </div>
                                <div class="item-info">
                                    <div class="item-name">@item.Product?.Name</div>
                                    @if (variationTags.Any())
                                    {
                                        <div class="item-variations">
                                            @foreach (var tag in variationTags)
                                            {
                                                <span class="item-variation">@tag</span>
                                            }
                                        </div>
                                    }
                                    <div class="item-qty-text">Qty: @item.Quantity &nbsp;·&nbsp; RM @item.Price.ToString("0.00") each</div>
                                </div>
                                <div class="item-price">RM @((item.Price * item.Quantity).ToString("0.00"))</div>
                            </div>
                        }
                    </div>

                    <!-- Delivery Toggle -->
                    <button class="items-toggle" onclick="toggleItems(this)">
                        <span><i class="ti ti-map-pin"></i> Delivery Information</span>
                        <i class="ti ti-chevron-down chevron"></i>
                    </button>

                    <!-- Collapsible Delivery Info -->
                    <div class="items-collapse" style="max-height:0; transition: max-height .3s ease;">
                        <div class="delivery-panel">
                            @if (order.Address != null)
                            {
                                <div class="delivery-row">
                                    <span class="delivery-label"><i class="ti ti-user"></i> Recipient</span>
                                    <span class="delivery-value">@order.Address.RecipientName</span>
                                </div>
                                <div class="delivery-row">
                                    <span class="delivery-label"><i class="ti ti-phone"></i> Phone</span>
                                    <span class="delivery-value">@order.Address.PhoneNumber</span>
                                </div>
                                <div class="delivery-row">
                                    <span class="delivery-label"><i class="ti ti-map-pin"></i> Address</span>
                                    <span class="delivery-value">
                                        @order.Address.AddressLine1
                                        @if (!string.IsNullOrWhiteSpace(order.Address.AddressLine2))
                                        {
                                            <br />@order.Address.AddressLine2
                                        }
                                        <br />@order.Address.City, @order.Address.Postcode
                                        <br />@order.Address.State
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div class="delivery-row">
                                    <span class="delivery-label"><i class="ti ti-map-pin"></i> Address</span>
                                    <span class="delivery-value muted">Address #@order.AddressId</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Card Footer -->
                    <div class="order-card-footer">
                        <div class="footer-left">
                            <div class="footer-meta-item">
                                <i class="ti ti-credit-card"></i>
                                <span>@order.PaymentMethod</span>
                            </div>
                        </div>
                        <div class="footer-right">
                            <div>
                                <div class="order-total-label">Order Total</div>
                                <div class="order-total-amount">RM @order.TotalAmount.ToString("N2")</div>
                            </div>
                            @if (order.CurrentStatus == EcommerceSystem.Models.OrderStatus.DELIVERED)
                            {
                                <a href="#" class="btn-action btn-action-primary">
                                    <i class="ti ti-star"></i> Review
                                </a>
                            }
                            @if (order.CurrentStatus == EcommerceSystem.Models.OrderStatus.PENDING)
                            {
                                <button class="btn-action btn-action-danger">
                                    <i class="ti ti-x"></i> Cancel
                                </button>
                            }
                            <button class="btn-action btn-action-outline"
                                    onclick="openOrderDetail(@order.OrderId)">
                                <i class="ti ti-file-text"></i> Details
                            </button>
                        </div>
                    </div>

                </div>
            }
        </div>
    }

</div>

<!-- ─── Order Detail Drawer ─── -->
<div class="od-backdrop" id="odBackdrop" onclick="closeOrderDetail()"></div>
<div class="od-modal" id="odModal" role="dialog" aria-modal="true">

    <div class="od-modal-header">
        <div>
            <div class="od-modal-order-id" id="odOrderId"></div>
            <div class="od-modal-date"     id="odOrderDate"></div>
        </div>
        <div class="od-modal-header-right">
            <span class="status-badge" id="odStatusBadge">
                <span class="status-dot"></span>
                <span id="odStatusLabel"></span>
            </span>
            <button class="od-close" onclick="closeOrderDetail()" aria-label="Close">
                <i class="ti ti-x"></i>
            </button>
        </div>
    </div>

    <div class="od-modal-body" id="odModalBody"></div>

</div>

<script>
    // ── Alert auto-hide ───────────────────────────────────
    const successAlert = document.getElementById('successAlert');
    if (successAlert) setTimeout(() => successAlert.classList.add('hide'), 3500);

    // ── Tab filter ────────────────────────────────────────
    function filterOrders(status, btn) {
        document.querySelectorAll('.ph-tab').forEach(t => t.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('.order-card').forEach(card => {
            card.style.display = (status === 'ALL' || card.dataset.status === status) ? '' : 'none';
        });
    }

    // ── Search ────────────────────────────────────────────
    function searchOrders() {
        const q = document.getElementById('searchInput').value.toLowerCase();
        document.querySelectorAll('.order-card').forEach(card => {
            card.style.display = card.dataset.search.toLowerCase().includes(q) ? '' : 'none';
        });
    }

    // ── Collapse toggles ──────────────────────────────────
    function toggleItems(btn) {
        btn.classList.toggle('open');
        const collapse = btn.nextElementSibling;
        collapse.style.maxHeight = btn.classList.contains('open')
            ? collapse.scrollHeight + 'px' : '0';
    }

    // ── Order data (safely serialized by JsonSerializer) ──
    const _orders = @Html.Raw(orderDataJson);

    // ── Modal open/close ──────────────────────────────────
    function openOrderDetail(orderId) {
        const order = _orders.find(o => o.orderId === orderId);
        if (!order) return;

        // Populate header
        document.getElementById('odOrderId').textContent   = 'Order #' + order.orderId;
        document.getElementById('odOrderDate').textContent = order.orderTime;
        const badge = document.getElementById('odStatusBadge');
        badge.className = 'status-badge status-' + order.status;
        document.getElementById('odStatusLabel').textContent = order.statusLabel;

        // Build body HTML
        let html = '';

        // Shop strip
        html += `<div class="od-shop-strip">
            <div class="od-shop-avatar">${esc(order.shopInitial)}</div>
            <span>Sold by <strong>${esc(order.shopName)}</strong></span>
        </div>`;

        // Items
        order.items.forEach(item => {
            const fullStars  = Math.floor(item.rating);
            const emptyStars = 5 - fullStars;
            const stars = '★'.repeat(fullStars).split('').map(() => `<span class="star">★</span>`).join('')
                        + '★'.repeat(emptyStars).split('').map(() => `<span class="star empty">★</span>`).join('');

            const variation = item.variation
                ? `<div class="od-item-variation"><i class="ti ti-tag"></i> ${esc(item.variation)}</div>` : '';
            const desc = item.description
                ? `<div class="od-item-desc">${esc(item.description)}</div>` : '';
            const sku = item.sku
                ? `<div class="od-item-sku">SKU: ${esc(item.sku)}</div>` : '';

            html += `<div class="od-item-detail">
                <div class="od-item-img-wrap">
                    <img src="${esc(item.image)}" alt="${esc(item.name)}"
                         onerror="this.src='/images/placeholder.png'" />
                </div>
                <div class="od-item-body">
                    ${item.category ? `<div class="od-item-category">${esc(item.category)}</div>` : ''}
                    <div class="od-item-name">${esc(item.name)}</div>
                    <div class="od-item-rating">
                        <span class="od-stars">${stars}</span>
                        <span class="od-item-rating-val">${item.rating}</span>
                    </div>
                    ${variation}${desc}${sku}
                    <div class="od-item-price-row">
                        <span class="od-item-unit">RM ${esc(item.price)} × ${item.qty}</span>
                        <span class="od-item-subtotal">RM ${esc(item.subtotal)}</span>
                    </div>
                </div>
            </div>`;
        });

        // Delivery
        if (order.address) {
            const a = order.address;
            const line2 = a.line2 ? `<br>${esc(a.line2)}` : '';
            html += `<div class="od-section-label">Delivery Information</div>
            <div class="od-info-grid">
                <div class="od-info-row">
                    <span class="od-info-label"><i class="ti ti-user"></i> Recipient</span>
                    <span class="od-info-value">${esc(a.recipientName)}</span>
                </div>
                <div class="od-info-row">
                    <span class="od-info-label"><i class="ti ti-phone"></i> Phone</span>
                    <span class="od-info-value">${esc(a.phoneNumber)}</span>
                </div>
                <div class="od-info-row">
                    <span class="od-info-label"><i class="ti ti-map-pin"></i> Address</span>
                    <span class="od-info-value">${esc(a.line1)}${line2},<br>${esc(a.city)}, ${esc(a.postcode)},<br>${esc(a.state)}</span>
                </div>
            </div>`;
        }

        // Payment summary
        html += `<div class="od-section-label">Payment Summary</div>
        <div class="od-info-grid">
            <div class="od-info-row">
                <span class="od-info-label"><i class="ti ti-credit-card"></i> Method</span>
                <span class="od-info-value">${esc(order.paymentMethod)}</span>
            </div>
            <div class="od-info-row od-total-row">
                <span class="od-info-label">Order Total</span>
                <span class="od-total-amount">RM ${esc(order.totalAmount)}</span>
            </div>
        </div>`;

        document.getElementById('odModalBody').innerHTML = html;
        document.getElementById('odBackdrop').classList.add('active');
        document.getElementById('odModal').classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function closeOrderDetail() {
        document.getElementById('odBackdrop').classList.remove('active');
        document.getElementById('odModal').classList.remove('active');
        document.body.style.overflow = '';
    }

    // XSS-safe text escaping for innerHTML
    function esc(str) {
        const d = document.createElement('div');
        d.textContent = str ?? '';
        return d.innerHTML;
    }

    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') closeOrderDetail();
    });
</script>
