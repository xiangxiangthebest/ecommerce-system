<!-- ═══════════════════════════════════════════════════════════
     SCRIPTS
═══════════════════════════════════════════════════════════ -->
<script>
// ── Toast auto-hide ────────────────────────────────────────
const _toast = document.getElementById('phToast');
if (_toast) setTimeout(() => _toast.classList.add('ph-toast-hide'), 3500);

// ── Order data ─────────────────────────────────────────────
const _orders = @Html.Raw(orderDataJson);

// ── Tab filter ─────────────────────────────────────────────
document.querySelectorAll('.ph-tab').forEach(tab => {
    tab.addEventListener('click', () => {
        document.querySelectorAll('.ph-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        applyFilters();
    });
});

// ── Search ─────────────────────────────────────────────────
document.getElementById('phSearch').addEventListener('input', applyFilters);

function applyFilters() {
    const status = document.querySelector('.ph-tab.active')?.dataset.status ?? 'ALL';
    const query  = document.getElementById('phSearch').value.toLowerCase().trim();
    let visible  = 0;
    document.querySelectorAll('.ph-card').forEach(card => {
        const matchStatus = status === 'ALL' || card.dataset.status === status;
        const matchSearch = !query || card.dataset.search.includes(query);
        const show = matchStatus && matchSearch;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
    });
    document.getElementById('phNoResults').style.display = visible === 0 ? 'flex' : 'none';
}

// ── Collapsible sections ───────────────────────────────────
function toggleCollapse(btn) {
    btn.classList.toggle('open');
    const collapse = btn.closest('.ph-card-seller, .ph-card-delivery-toggle')
                        .nextElementSibling;
    collapse.style.maxHeight = btn.classList.contains('open')
        ? collapse.scrollHeight + 'px' : '0';
}

// ═══════════════════════════════════════════════════════════
// DRAWER  –  Order Detail
// ═══════════════════════════════════════════════════════════
function openDrawer(orderId) {
    const order = _orders.find(o => o.orderId === orderId);
    if (!order) return;

    document.getElementById('odTitle').textContent = 'Order #' + order.orderId;
    document.getElementById('odDate').textContent  = order.orderTime;

    const badge = document.getElementById('odBadge');
    badge.className = 'ph-status-pill ph-s-' + order.status;
    document.getElementById('odBadgeLabel').textContent = order.statusLabel;

    let html = '';

    // Render / Refund notice inside drawer
    if (order.status === 'RETURN_REFUND' && order.returnReason) {
        html += `<div class="od-notice od-notice-return">
            <i class="ti ti-refresh-alert"></i>
            <div><strong>Return / Refund Reason from Seller</strong><span>${esc(order.returnReason)}</span></div>
        </div>`;
    }
    if (order.status === 'CANCELED' && order.cancelReason) {
        html += `<div class="od-notice od-notice-canceled">
            <i class="ti ti-ban"></i>
            <div><strong>Cancellation Reason</strong><span>${esc(order.cancelReason)}</span></div>
        </div>`;
    }

    // Complaint status in drawer
    if (order.complaintSubmitted && order.complaintText) {
        html += `<div class="od-complaint-sent">
            <i class="ti ti-check-circle"></i>
            <div><strong>Complaint Submitted</strong><span>${esc(order.complaintText)}</span></div>
        </div>`;
    }

    // Review status in drawer
    if (order.reviewSubmitted) {
        html += `
        <div class="od-reviewed-sent">
            <i class="ti ti-star"></i>
            <div>
                <strong>Review Submitted</strong><span>You have reviewed this order.</span>
            </div>
        </div>`;
    }

    // Items
    order.items.forEach((item, idx) => {
        const imgs    = (item.images && item.images.length > 0) ? item.images : [item.image];
        const mainImg = imgs[0] || item.image;
        const thumbsHtml = imgs.length > 1
            ? `<div class="od-thumbs">${imgs.map((src, i) =>
                `<div class="od-thumb ${i===0?'active':''}" onclick="odSwitch(this,'${src.replace(/'/g,"\\'")}')">
                    <img src="${esc(src)}" onerror="this.src='/images/placeholder.png'" /></div>`
               ).join('')}</div>` : '';

        const fullStars  = Math.floor(item.rating);
        const stars = Array(fullStars).fill('★').join('') + Array(5-fullStars).fill('☆').join('');

        const selectedMap = {};
        if (item.selectedVariation) {
            item.selectedVariation.split(' · ').forEach(pair => {
                const ci = pair.indexOf(': ');
                if (ci > -1) selectedMap[pair.substring(0, ci).trim()] = pair.substring(ci+2).trim();
            });
        }

        let varHtml = '';
        if (item.allVariations && item.allVariations.length > 0) {
            varHtml = item.allVariations.map(g => {
                const btns = g.values.map(v => {
                    const sel = selectedMap[g.name] === v.label;
                    const oos = v.stock <= 0;
                    const cls = sel ? 'od-var-btn sel' : oos ? 'od-var-btn oos' : 'od-var-btn';
                    return `<button class="${cls}" disabled>${esc(v.label)}</button>`;
                }).join('');
                return `<div class="od-var-group"><div class="od-var-name">${esc(g.name)}</div><div class="od-var-opts">${btns}</div></div>`;
            }).join('');
        }

        const sep = idx > 0 ? `<div class="od-sep"></div>` : '';
        html += `${sep}
        <div class="od-item-wrap">
            <div class="od-gallery">
                <div class="od-main-img-wrap">
                    <img src="${esc(mainImg)}" alt="${esc(item.name)}" onerror="this.src='/images/placeholder.png'" />
                </div>
                ${thumbsHtml}
            </div>
            <div class="od-info">
                ${item.category ? `<div class="od-category">${esc(item.category)}</div>` : ''}
                <div class="od-name">${esc(item.name)}</div>
                <div class="od-stars-row">
                    <span class="od-stars">${stars}</span>
                    <span class="od-rating-num">${item.rating.toFixed(1)}</span>
                </div>
                <div class="od-divider"></div>
                <div class="od-shop-row">
                    <div class="od-shop-ava">${esc(order.shopInitial)}</div>
                    <span>Sold by <strong>${esc(order.shopName)}</strong></span>
                </div>
                <div class="od-price">RM ${esc(item.price)}</div>
                <div class="od-price-note">× ${item.qty} unit${item.qty>1?'s':''} = <strong>RM ${esc(item.subtotal)}</strong></div>
                ${item.sku ? `<div class="od-sku">SKU: ${esc(item.sku)}</div>` : ''}
                <div class="od-divider"></div>
                ${item.description ? `<p class="od-desc">${esc(item.description)}</p>` : ''}
                ${varHtml}
            </div>
        </div>`;
    });

    // Customer note
    if (order.customerMessage) {
        html += `<div class="od-customer-msg">
            <div class="od-customer-msg-label"><i class="ti ti-message-circle"></i> Note to Seller</div>
            <div class="od-customer-msg-text">${esc(order.customerMessage)}</div>
        </div>`;
    }

    // Address block
    if (order.address) {
        const a = order.address;
        html += `<div class="od-address-block">
            <div class="od-address-title"><i class="ti ti-map-pin"></i> Delivery Address</div>
            <div class="od-address-grid">
                <div class="od-address-row"><span>Recipient</span>${esc(a.recipientName)}</div>
                <div class="od-address-row"><span>Phone</span>${esc(a.phoneNumber)}</div>
                <div class="od-address-row"><span>Address</span>${esc(a.line1)}${a.line2?', '+esc(a.line2):''}, ${esc(a.city)}, ${esc(a.postcode)}, ${esc(a.state)}</div>
                <div class="od-address-row"><span>Payment</span>${esc(order.paymentMethod)}</div>
            </div>
        </div>`;
    }

    // Order total summary
    html += `<div class="od-total-bar">
        <span>Order Total</span>
        <strong>RM ${esc(order.totalAmount)}</strong>
    </div>`;

    document.getElementById('odDrawerBody').innerHTML = html;
    document.getElementById('odBackdrop').classList.add('active');
    document.getElementById('odDrawer').classList.add('active');
    document.body.style.overflow = 'hidden';
}

function odSwitch(thumbEl, src) {
    const gallery = thumbEl.closest('.od-gallery');
    gallery.querySelector('.od-main-img-wrap img').src = src;
    gallery.querySelectorAll('.od-thumb').forEach(t => t.classList.remove('active'));
    thumbEl.classList.add('active');
}

function closeDrawer() {
    document.getElementById('odBackdrop').classList.remove('active');
    document.getElementById('odDrawer').classList.remove('active');
    document.body.style.overflow = '';
}

// ═══════════════════════════════════════════════════════════
// CANCEL ORDER
// ═══════════════════════════════════════════════════════════
let _cancelSelectedReason = '';

function openCancelModal(orderId) {
    document.getElementById('cancelOrderId').value = orderId;
    document.getElementById('cancelCustom').value  = '';
    _cancelSelectedReason = '';
    document.querySelectorAll('#cancelReasonGrid .ph-reason-chip')
            .forEach(c => c.classList.remove('selected'));
    showModal('cancelBackdrop', 'cancelModal');
}

function closeCancelModal() { hideModal('cancelBackdrop', 'cancelModal'); }

function selectReason(chip, textareaId) {
    const grid = chip.parentElement;
    grid.querySelectorAll('.ph-reason-chip').forEach(c => c.classList.remove('selected'));
    chip.classList.add('selected');
    _cancelSelectedReason = chip.textContent.trim();
    // Pre-fill textarea with selected reason if it's still empty
    const ta = document.getElementById(textareaId);
    if (!ta.value.trim()) ta.value = _cancelSelectedReason === 'Other' ? '' : _cancelSelectedReason;
}

async function submitCancel() {
    const orderId = document.getElementById('cancelOrderId').value;
    const reason  = document.getElementById('cancelCustom').value.trim()
                 || _cancelSelectedReason;

    if (!reason) { showInlineError('cancelModal', 'Please select or enter a cancellation reason.'); return; }

    const btn = document.querySelector('#cancelModal .ph-btn-danger');
    btn.disabled = true; btn.innerHTML = '<i class="ti ti-loader-2 spin"></i> Canceling…';

    try {
        const res  = await postJson('/Customer/CancelOrder', { orderId, cancelReason: reason });
        if (res.success) {
            closeCancelModal();
            showToast('Order canceled successfully.', 'success');
            setTimeout(() => location.reload(), 1200);
        } else {
            btn.disabled = false; btn.innerHTML = '<i class="ti ti-x"></i> Confirm Cancel';
            showInlineError('cancelModal', res.message || 'Could not cancel order.');
        }
    } catch (err) {
        btn.disabled = false; btn.innerHTML = '<i class="ti ti-x"></i> Confirm Cancel';
        showInlineError('cancelModal', 'Network error — please try again.');
        console.error('CancelOrder error:', err);
    }
}

// ═══════════════════════════════════════════════════════════
// CONFIRM RECEIVED
// ═══════════════════════════════════════════════════════════
async function confirmReceived(orderId, btn) {
    if (!confirm('Confirm that you have received this order?')) return;
    btn.disabled = true; btn.innerHTML = '<i class="ti ti-loader-2 spin"></i> Confirming…';

    try {
        const res = await postJson('/Customer/ConfirmReceived', { orderId });
        if (res.success) {
            showToast('Order marked as received!', 'success');
            setTimeout(() => location.reload(), 1200);
        } else {
            btn.disabled = false; btn.innerHTML = '<i class="ti ti-circle-check"></i> Order Received';
            showToast(res.message || 'Failed to confirm.', 'error');
        }
    } catch (err) {
        btn.disabled = false; btn.innerHTML = '<i class="ti ti-circle-check"></i> Order Received';
        console.error('ConfirmReceived error:', err);
    }
}

function updateProgressToReceived(card) {
    const steps = ['PENDING','PREPARING','SHIPPED','DELIVERED','RECEIVED'];
    const currentStep = 4; // RECEIVED

    const stepEls = card.querySelectorAll('.ph-progress-step');
    stepEls.forEach((el, idx) => {
        el.classList.remove('done', 'active', 'upcoming');
        if (idx < currentStep) el.classList.add('done');
        else if (idx === currentStep) el.classList.add('active');
        else el.classList.add('upcoming');
    });

    const lineEls = card.querySelectorAll('.ph-progress-line');
    lineEls.forEach((line, idx) => {
        line.classList.toggle('done', idx < currentStep);
    });
}

// ═══════════════════════════════════════════════════════════
// RATING
// ═══════════════════════════════════════════════════════════
function openRatingModal(orderId) {
    const order = _orders.find(o => o.orderId === orderId);
    if (!order) return;
    document.getElementById('ratingOrderId').value = orderId;

    let html = '';
    order.items.forEach((item, idx) => {
        html += `
        <div class="ph-rating-item" data-item-idx="${idx}" data-product-id="${item.productId}" data-order-item-id="${item.orderItemId}">
            <div class="ph-rating-item-top">
                <img src="${esc(item.image)}" onerror="this.src='/images/placeholder.png'" />
                <span>${esc(item.name)}</span>
            </div>
            <div class="ph-star-picker" data-selected="0">
                ${[1,2,3,4,5].map(n =>
                    `<button class="ph-star-btn" data-val="${n}" onclick="pickStar(this)">★</button>`
                ).join('')}
                <span class="ph-star-hint">Tap to rate</span>
            </div>
            <div class="ph-textarea-wrap" style="margin-top:10px">
                <textarea class="ph-review-text" placeholder="Share your experience (optional)…" rows="2"></textarea>
            </div>
        </div>
        ${idx < order.items.length - 1 ? '<div class="od-sep"></div>' : ''}`;
    });

    document.getElementById('ratingItemsWrap').innerHTML = html;
    showModal('ratingBackdrop', 'ratingModal');
}

function closeRatingModal() { hideModal('ratingBackdrop', 'ratingModal'); }

function pickStar(btn) {
    const picker = btn.closest('.ph-star-picker');
    const val    = parseInt(btn.dataset.val);
    picker.dataset.selected = val;
    picker.querySelectorAll('.ph-star-btn').forEach((b, i) => {
        b.classList.toggle('filled', i < val);
    });
    const labels = ['','Poor','Fair','Good','Very Good','Excellent'];
    picker.querySelector('.ph-star-hint').textContent = labels[val] || '';
}

async function submitRating() {
    const orderId = document.getElementById('ratingOrderId').value;
    const items   = document.querySelectorAll('.ph-rating-item');
    let hasError  = false;
    let allOk     = true;

    for (const item of items) {
        const rating     = parseInt(item.querySelector('.ph-star-picker').dataset.selected);
        const reviewText = item.querySelector('.ph-review-text').value.trim();
        const orderItemId = parseInt(item.dataset.orderItemId);
        if (!rating) { hasError = true; continue; }

        try {
            const res = await postJson('/Customer/SubmitRating', { orderItemId, rating, reviewText });
            if (!res.success) allOk = false;
        } catch { allOk = false; }
    }

    if (hasError) { showInlineError('ratingModal', 'Please give at least 1 star for each item.'); return; }

    closeRatingModal();
    if (allOk) {
        markReviewWritten(orderId);
        showToast('Review submitted, thank you!', 'success');
    } else {
        showToast('Some reviews could not be saved.', 'error');
    }
}

function markReviewWritten(orderId) {
    const order = _orders.find(o => o.orderId === orderId);
    if (order) order.reviewSubmitted = true;

    const card = document.querySelector(`.ph-card[data-order-id="${orderId}"]`);
    if (!card) return;

    const btn = card.querySelector('.js-write-review');
    if (btn) {
        btn.outerHTML = `
          <span class="ph-btn ph-btn-done">
            <i class="ti ti-check"></i> Review Submitted
          </span>`;
    }
}

// ═══════════════════════════════════════════════════════════
// REQUEST RETURN / REFUND
// ═══════════════════════════════════════════════════════════
let _returnSelectedReason = '';
let _returnSelectedType   = '';

function selectReturnType(chip, type) {
    document.querySelectorAll('#returnTypeGrid .ph-return-type-chip').forEach(c => c.classList.remove('selected'));
    chip.classList.add('selected');
    _returnSelectedType = type;
    document.getElementById('returnTypeValue').value = type;
}

function openReturnModal(orderId) {
    const order = _orders.find(o => o.orderId === orderId);
    if (!order) return;

    document.getElementById('returnOrderId').value = orderId;
    document.getElementById('returnCustom').value = '';
    _returnSelectedReason = '';
    _returnSelectedType   = '';
    document.getElementById('returnTypeValue').value = '';
    document.querySelectorAll('#returnTypeGrid .ph-return-type-chip').forEach(c => c.classList.remove('selected'));
    document.querySelectorAll('#returnReasonGrid .ph-reason-chip').forEach(c => c.classList.remove('selected'));

    // Build item checkboxes with qty selectors
    let html = '';
    order.items.forEach(item => {
        html += `
        <div class="ph-return-item" style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid #f0f0f8;">
            <input type="checkbox" class="return-item-chk" id="retChk_${item.orderItemId}"
                   data-order-item-id="${item.orderItemId}" data-max="${item.maxReturnQty}"
                   onchange="syncReturnQty(this)" style="width:16px;height:16px;cursor:pointer" />
            <img src="${esc(item.image)}" onerror="this.src='/images/placeholder.png'"
                 style="width:40px;height:40px;object-fit:cover;border-radius:6px;flex-shrink:0" />
            <label for="retChk_${item.orderItemId}" style="flex:1;cursor:pointer">
                <div style="font-weight:600;font-size:13px">${esc(item.name)}</div>
                <div style="font-size:12px;color:#9a98b6">Qty ordered: ${item.maxReturnQty}</div>
            </label>
            <div style="display:flex;align-items:center;gap:6px">
                <label style="font-size:12px;color:#9a98b6">Return qty:</label>
                <input type="number" class="return-item-qty" id="retQty_${item.orderItemId}"
                       min="1" max="${item.maxReturnQty}" value="${item.maxReturnQty}"
                       disabled
                       style="width:56px;padding:4px 6px;border:1px solid #e0e0f0;border-radius:6px;font-size:13px;text-align:center" />
            </div>
        </div>`;
    });
    document.getElementById('returnItemsWrap').innerHTML = html || '<p style="color:#aaa;font-size:13px">No items found.</p>';

    showModal('returnBackdrop', 'returnModal');
}

function syncReturnQty(chk) {
    const qtyInput = document.getElementById('retQty_' + chk.dataset.orderItemId.replace ? chk.dataset.orderItemId : chk.dataset.orderItemId);
    // find the corresponding qty input in the same row
    const row = chk.closest('.ph-return-item');
    const qty = row.querySelector('.return-item-qty');
    if (qty) qty.disabled = !chk.checked;
}

function selectReturnReason(chip) {
    document.querySelectorAll('#returnReasonGrid .ph-reason-chip').forEach(c => c.classList.remove('selected'));
    chip.classList.add('selected');
    _returnSelectedReason = chip.textContent.trim();
    const ta = document.getElementById('returnCustom');
    if (!ta.value.trim() && _returnSelectedReason !== 'Other') ta.value = _returnSelectedReason;
}

function closeReturnModal() { hideModal('returnBackdrop', 'returnModal'); }

async function submitReturn() {
    const orderId      = document.getElementById('returnOrderId').value;
    const returnReason = document.getElementById('returnCustom').value.trim() || _returnSelectedReason;
    const returnType   = document.getElementById('returnTypeValue').value;

    if (!returnType)   { showInlineError('returnModal', 'Please select a return type (Return & Refund, Return & Replace, or Refund Only).'); return; }
    if (!returnReason) { showInlineError('returnModal', 'Please describe the reason for your return.'); return; }

    const checked = document.querySelectorAll('.return-item-chk:checked');
    if (checked.length === 0) { showInlineError('returnModal', 'Please select at least one item to return.'); return; }

    const returnItemIds = [];
    const returnQtys    = [];
    let valid = true;

    checked.forEach(chk => {
        const row = chk.closest('.ph-return-item');
        const qtyInput = row.querySelector('.return-item-qty');
        const max = parseInt(chk.dataset.max);
        const qty = parseInt(qtyInput.value);
        if (!qty || qty < 1 || qty > max) { valid = false; return; }
        returnItemIds.push(parseInt(chk.dataset.orderItemId));
        returnQtys.push(qty);
    });

    if (!valid) { showInlineError('returnModal', 'Invalid quantity for one or more items.'); return; }

    const btn = document.getElementById('returnSubmitBtn');
    btn.disabled = true; btn.innerHTML = '<i class="ti ti-loader-2 spin"></i> Submitting…';

    try {
        const res = await postJson('/Customer/RequestReturnRefund', {
            orderId,
            returnReason,
            returnType,
            ...Object.fromEntries(returnItemIds.map((id, i) => [`returnItemIds[${i}]`, id])),
            ...Object.fromEntries(returnQtys.map((q, i)    => [`returnQtys[${i}]`, q]))
        });
        if (res.success) {
            closeReturnModal();
            showToast('Return / Refund request submitted. The seller will review it shortly.', 'success');
            setTimeout(() => location.reload(), 1500);
        } else {
            btn.disabled = false; btn.innerHTML = '<i class="ti ti-send"></i> Submit Request';
            showInlineError('returnModal', res.message || 'Could not submit request.');
        }
    } catch (err) {
        btn.disabled = false; btn.innerHTML = '<i class="ti ti-send"></i> Submit Request';
        showInlineError('returnModal', 'Network error — please try again.');
        console.error('RequestReturnRefund error:', err);
    }
}

// ═══════════════════════════════════════════════════════════
// COMPLAINT
// ═══════════════════════════════════════════════════════════
let _complaintSelectedReason = '';

function openComplaintModal(orderId) {
    document.getElementById('complaintOrderId').value = orderId;
    document.getElementById('complaintCustom').value  = '';
    _complaintSelectedReason = '';
    document.querySelectorAll('#complaintReasonGrid .ph-reason-chip')
            .forEach(c => c.classList.remove('selected'));
    showModal('complaintBackdrop', 'complaintModal');
}

function closeComplaintModal() { hideModal('complaintBackdrop', 'complaintModal'); }

async function submitComplaint() {
    const orderId       = document.getElementById('complaintOrderId').value;
    const complaintText = document.getElementById('complaintCustom').value.trim()
                       || _complaintSelectedReason;

    if (!complaintText) { showInlineError('complaintModal', 'Please describe your complaint.'); return; }

    const btn = document.querySelector('#complaintModal .ph-btn-warning');
    btn.disabled = true; btn.innerHTML = '<i class="ti ti-loader-2 spin"></i> Submitting…';

    try {
        const res = await postJson('/Customer/SubmitComplaint', { orderId, complaintText });
        if (res.success) {
            closeComplaintModal();
            showToast('Complaint submitted. We\'ll review it soon.', 'success');
            setTimeout(() => location.reload(), 1200);
        } else {
            btn.disabled = false; btn.innerHTML = '<i class="ti ti-send"></i> Submit Complaint';
            showInlineError('complaintModal', res.message || 'Could not submit complaint.');
        }
    } catch (err) {
        btn.disabled = false; btn.innerHTML = '<i class="ti ti-send"></i> Submit Complaint';
        console.error('SubmitComplaint error:', err);
    }
}

// ═══════════════════════════════════════════════════════════
// SHARED HELPERS
// ═══════════════════════════════════════════════════════════
function esc(str) {
    const d = document.createElement('div');
    d.textContent = str ?? '';
    return d.innerHTML;
}

async function postJson(url, data) {
    // ASP.NET MVC [HttpPost] actions bind from the form body, not JSON.
    // Send as application/x-www-form-urlencoded with the anti-forgery token as a field.
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    const body  = new URLSearchParams({ ...data, __RequestVerificationToken: token });
    const res   = await fetch(url, {
        method:  'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body:    body.toString()
    });
    return res.json();
}

function showModal(backdropId, modalId) {
    document.getElementById(backdropId).classList.add('active');
    document.getElementById(modalId).classList.add('active');
    document.body.style.overflow = 'hidden';
}

function hideModal(backdropId, modalId) {
    document.getElementById(backdropId).classList.remove('active');
    document.getElementById(modalId).classList.remove('active');
    document.body.style.overflow = '';
    // Clear any inline errors
    document.querySelectorAll(`#${modalId} .ph-inline-err`).forEach(el => el.remove());
}

function showInlineError(modalId, msg) {
    const modal = document.getElementById(modalId);
    let err = modal.querySelector('.ph-inline-err');
    if (!err) {
        err = document.createElement('div');
        err.className = 'ph-inline-err';
        modal.querySelector('.ph-modal-footer').before(err);
    }
    err.innerHTML = `<i class="ti ti-alert-circle"></i> ${msg}`;
}

function showToast(msg, type='success') {
    const t = document.createElement('div');
    t.className = 'ph-toast ' + (type === 'error' ? 'ph-toast-err' : '');
    t.innerHTML = `<i class="ti ${type==='success'?'ti-circle-check':'ti-alert-circle'}"></i> ${msg}`;
    document.body.appendChild(t);
    setTimeout(() => t.classList.add('ph-toast-hide'), 3500);
    setTimeout(() => t.remove(), 4200);
}

// Keyboard close
document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
        closeDrawer();
        closeCancelModal();
        closeReturnModal();
        closeRatingModal();
        closeComplaintModal();
    }
});

// CSRF token for form (anti-forgery)
</script>
@Html.AntiForgeryToken()
