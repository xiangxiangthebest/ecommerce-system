@model List<EcommerceSystem.Models.Order>

<link rel="stylesheet" href="~/css/customer/purchase-history.css" asp-append-version="true" />

@using System.Text.Json
@using System.Text.Json.Serialization

@{
    var pendingCnt    = Model.Count(o => o.CurrentStatus == EcommerceSystem.Models.OrderStatus.PENDING);
    var preparingCnt  = Model.Count(o => o.CurrentStatus == EcommerceSystem.Models.OrderStatus.PREPARING);
    var shippedCnt    = Model.Count(o => o.CurrentStatus == EcommerceSystem.Models.OrderStatus.SHIPPED);
    var deliveredCnt  = Model.Count(o => o.CurrentStatus == EcommerceSystem.Models.OrderStatus.DELIVERED);
    var receivedCnt   = Model.Count(o => o.CurrentStatus == EcommerceSystem.Models.OrderStatus.RECEIVED);
    var returnCnt     = Model.Count(o => o.CurrentStatus == EcommerceSystem.Models.OrderStatus.RETURN_REFUND);
    var canceledCnt   = Model.Count(o => o.CurrentStatus == EcommerceSystem.Models.OrderStatus.CANCELED);

    var jsonOpts = new JsonSerializerOptions { WriteIndented = false };

    var orderData = Model.Select(o => new {
        orderId            = o.OrderId,
        orderTime          = o.OrderTime.ToString("dd MMM yyyy, hh:mm tt"),
        status             = o.CurrentStatus.ToString().ToUpper(),
        statusLabel        = StatusLabel(o.CurrentStatus),
        paymentMethod      = o.PaymentMethod,
        totalAmount        = o.TotalAmount.ToString("N2"),
        shopName           = o.OrderItems.FirstOrDefault()?.Product?.Seller?.ShopName ?? "Unknown Shop",
        shopInitial        = (o.OrderItems.FirstOrDefault()?.Product?.Seller?.ShopName ?? "S").Substring(0,1).ToUpper(),
        customerMessage    = o.CustomerMessage ?? "",
        cancelReason       = o.CancelReason ?? "",
        returnReason       = (o.ReturnReason != null && o.ReturnReason.Contains("||"))
                             ? o.ReturnReason[..o.ReturnReason.IndexOf("||")]
                             : (o.ReturnReason ?? ""),
        complaintText      = o.ComplaintText ?? "",
        complaintSubmitted = o.ComplaintSubmitted,
        reviewSubmitted    = o.ReviewSubmitted,
        address = o.Address == null ? null : new {
            recipientName = o.Address.RecipientName,
            phoneNumber   = o.Address.PhoneNumber,
            line1         = o.Address.AddressLine1,
            line2         = o.Address.AddressLine2 ?? "",
            city          = o.Address.City,
            postcode      = o.Address.Postcode,
            state         = o.Address.State
        },
        items = o.OrderItems.Select(item => new {
            orderItemId   = item.OrderItemId,
            productId     = item.ProductId,
            name          = item.Product?.Name ?? "",
            image         = item.Product?.ImagePath ?? "",
            images        = ParseImagePaths(item.Product?.ImagePathsJson, item.Product?.ImagePath),
            price         = item.Price.ToString("0.00"),
            qty           = item.Quantity,
            subtotal      = (item.Price * item.Quantity).ToString("0.00"),
            category      = item.Product?.Category?.Name ?? "",
            description   = item.Product?.Description ?? "",
            sku           = item.Product?.SKU ?? "",
            rating        = item.Product?.AverageRating ?? 0,
            selectedVariation = ParseVariationToString(item.SelectedVariation),
            allVariations     = ParseAllVariations(item.Product?.VariationsJson),
            // for return modal: max returnable qty
            maxReturnQty  = item.Quantity
        }).ToList()
    }).ToList();

    var orderDataJson = JsonSerializer.Serialize(orderData, jsonOpts);
}

@functions {
    string StatusLabel(EcommerceSystem.Models.OrderStatus s) => s switch {
        EcommerceSystem.Models.OrderStatus.PENDING       => "Pending",
        EcommerceSystem.Models.OrderStatus.PREPARING     => "Preparing",
        EcommerceSystem.Models.OrderStatus.SHIPPED       => "Shipped",
        EcommerceSystem.Models.OrderStatus.DELIVERED     => "Delivered",
        EcommerceSystem.Models.OrderStatus.RECEIVED      => "Received",
        EcommerceSystem.Models.OrderStatus.RETURN_REFUND => "Return / Refund",
        EcommerceSystem.Models.OrderStatus.CANCELED      => "Canceled",
        _ => s.ToString()
    };

    string ParseVariationToString(string? json)
    {
        if (string.IsNullOrWhiteSpace(json) || json == "{}" || json == "[]") return "";
        try {
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind == JsonValueKind.Object) {
                var parts = new List<string>();
                foreach (var prop in doc.RootElement.EnumerateObject())
                    parts.Add($"{prop.Name}: {prop.Value}");
                return string.Join(" · ", parts);
            }
        } catch { }
        return "";
    }

    List<string> ParseImagePaths(string? json, string? mainImage)
    {
        var list = new List<string>();
        if (!string.IsNullOrWhiteSpace(json) && json != "[]") {
            try {
                using var doc = JsonDocument.Parse(json);
                if (doc.RootElement.ValueKind == JsonValueKind.Array)
                    foreach (var el in doc.RootElement.EnumerateArray())
                        if (!string.IsNullOrWhiteSpace(el.GetString()))
                            list.Add(el.GetString()!);
            } catch { }
        }
        if (list.Count == 0 && !string.IsNullOrWhiteSpace(mainImage))
            list.Add(mainImage);
        return list;
    }

    List<object> ParseAllVariations(string? json)
    {
        var groups = new List<object>();
        if (string.IsNullOrWhiteSpace(json) || json == "[]") return groups;
        try {
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind == JsonValueKind.Array)
                foreach (var group in doc.RootElement.EnumerateArray()) {
                    var name   = group.TryGetProperty("name",   out var n) ? n.GetString() ?? "" : "";
                    var values = new List<object>();
                    if (group.TryGetProperty("values", out var vals) && vals.ValueKind == JsonValueKind.Array)
                        foreach (var v in vals.EnumerateArray()) {
                            var label = v.TryGetProperty("label", out var l) ? l.GetString() ?? "" : "";
                            var stock = v.TryGetProperty("stock", out var s) ? s.GetInt32() : 0;
                            values.Add(new { label, stock });
                        }
                    groups.Add(new { name, values });
                }
        } catch { }
        return groups;
    }

    List<string> ParseVariationTags(string? json)
    {
        var tags = new List<string>();
        if (string.IsNullOrWhiteSpace(json) || json == "{}" || json == "[]") return tags;
        try {
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind == JsonValueKind.Object)
                foreach (var prop in doc.RootElement.EnumerateObject())
                    tags.Add($"{prop.Name}: {prop.Value}");
        } catch { }
        return tags;
    }
}

<div class="ph-page">

    @if (TempData["OrderSuccess"] != null)
    {
        <div class="ph-toast" id="phToast">
            <i class="ti ti-circle-check"></i>
            @TempData["OrderSuccess"]
        </div>
    }

    <!-- ── Page Header ── -->
    <div class="ph-header">
        <div>
            <h1 class="ph-title">My Orders</h1>
            <p class="ph-subtitle">@Model.Count order@(Model.Count != 1 ? "s" : "") placed across all time</p>
        </div>
        <div class="ph-search-wrap">
            <i class="ti ti-search"></i>
            <input type="text" id="phSearch" placeholder="Search by order ID or product…" />
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="ph-empty">
            <div class="ph-empty-icon">
                <i class="ti ti-shopping-bag-x"></i>
            </div>
            <h2>No orders yet</h2>
            <p>You haven't placed any orders. Find something you love and it'll show up here.</p>
            <a href="/Customer/Home" class="ph-btn ph-btn-primary">
                <i class="ti ti-arrow-right"></i> Start Shopping
            </a>
        </div>
    }
    else
    {
        <!-- ── Toolbar ── -->
        <div class="ph-toolbar">
            <div class="ph-tabs" id="phTabs">
                <button class="ph-tab active" data-status="ALL">
                    All <span class="ph-badge">@Model.Count</span>
                </button>
                <button class="ph-tab" data-status="PENDING">
                    Pending <span class="ph-badge">@pendingCnt</span>
                </button>
                <button class="ph-tab" data-status="PREPARING">
                    Preparing <span class="ph-badge">@preparingCnt</span>
                </button>
                <button class="ph-tab" data-status="SHIPPED">
                    Shipped <span class="ph-badge">@shippedCnt</span>
                </button>
                <button class="ph-tab" data-status="DELIVERED">
                    Delivered <span class="ph-badge">@deliveredCnt</span>
                </button>
                <button class="ph-tab" data-status="RECEIVED">
                    Received <span class="ph-badge">@receivedCnt</span>
                </button>
                <button class="ph-tab" data-status="RETURN_REFUND">
                    Return/Refund <span class="ph-badge">@returnCnt</span>
                </button>
                <button class="ph-tab" data-status="CANCELED">
                    Canceled <span class="ph-badge">@canceledCnt</span>
                </button>
            </div>
        </div>

        <!-- ── Order Cards ── -->
        <div id="phOrderList">
            @foreach (var order in Model)
            {
                var statusKey     = order.CurrentStatus.ToString().ToUpper();
                var sellerName    = order.OrderItems.FirstOrDefault()?.Product?.Seller?.ShopName ?? "Unknown Shop";
                var sellerInitial = sellerName.Length > 0 ? sellerName[0].ToString().ToUpper() : "S";
                var itemCount     = order.OrderItems.Count;
                var searchHint    = order.OrderId + " " + string.Join(" ", order.OrderItems.Select(i => i.Product?.Name ?? ""));

                <div class="ph-card" data-order-id="@order.OrderId" data-status="@statusKey" data-search="@searchHint.ToLower()">

                    <!-- Card top bar -->
                    <div class="ph-card-bar">
                        <div class="ph-card-bar-left">
                            <span class="ph-order-id">#@order.OrderId</span>
                            <span class="ph-order-date">
                                <i class="ti ti-clock"></i>
                                @order.OrderTime.ToString("dd MMM yyyy")
                                &nbsp;·&nbsp;
                                @order.OrderTime.ToString("hh:mm tt")
                            </span>
                        </div>
                        <span class="ph-status-pill ph-s-@statusKey">
                            <span class="ph-status-dot"></span>
                            @StatusLabel(order.CurrentStatus)
                        </span>
                    </div>

                    <!-- Order timeline (progress bar) -->
                    @{
                        var steps = new[] { "PENDING", "PREPARING", "SHIPPED", "DELIVERED", "RECEIVED" };
                        int currentStep = Array.IndexOf(steps, statusKey);
                        bool isCanceled = statusKey == "CANCELED";
                        bool isReturn   = statusKey == "RETURN_REFUND";
                    }
                    @if (!isCanceled && !isReturn)
                    {
                        <div class="ph-progress">
                            @foreach (var (step, idx) in steps.Select((s, i) => (s, i)))
                            {
                                var stepClass = idx < currentStep ? "done"
                                              : idx == currentStep ? "active"
                                              : "upcoming";
                                var stepLabel = step switch {
                                    "PENDING"   => "Pending",
                                    "PREPARING" => "Preparing",
                                    "SHIPPED"   => "Shipped",
                                    "DELIVERED" => "Delivered",
                                    "RECEIVED"  => "Received",
                                    _ => step
                                };
                                var stepIcon = step switch {
                                    "PENDING"   => "ti-clock",
                                    "PREPARING" => "ti-package",
                                    "SHIPPED"   => "ti-truck",
                                    "DELIVERED" => "ti-map-pin",
                                    "RECEIVED"  => "ti-circle-check",
                                    _ => "ti-circle"
                                };
                                <div class="ph-progress-step @stepClass">
                                    <div class="ph-progress-node">
                                        <i class="ti @stepIcon"></i>
                                    </div>
                                    <div class="ph-progress-label">@stepLabel</div>
                                    @if (idx < steps.Length - 1)
                                    {
                                        <div class="ph-progress-line @(idx < currentStep ? "done" : "")"></div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <!-- Canceled notice -->
                    @if (isCanceled && !string.IsNullOrWhiteSpace(order.CancelReason))
                    {
                        <div class="ph-notice ph-notice-canceled">
                            <i class="ti ti-ban"></i>
                            <div>
                                <strong>Order Canceled</strong>
                                <span>@order.CancelReason</span>
                            </div>
                        </div>
                    }

                    <!-- Return/Refund notice -->
                    @if (isReturn && !string.IsNullOrWhiteSpace(order.ReturnReason))
                    {
                        // Strip the "||<json>" suffix — only show the human-readable reason
                        var returnDisplay = order.ReturnReason;
                        var rrSep = returnDisplay.IndexOf("||");
                        if (rrSep >= 0) returnDisplay = returnDisplay[..rrSep];

                        <div class="ph-notice ph-notice-return">
                            <i class="ti ti-refresh-alert"></i>
                            <div>
                                <strong>Return / Refund Initiated by Seller</strong>
                                <span>@returnDisplay</span>
                            </div>
                        </div>
                    }

                    <!-- Seller + items toggle -->
                    <div class="ph-card-seller">
                        <div class="ph-seller-avatar">@sellerInitial</div>
                        <span>Sold by <strong>@sellerName</strong></span>
                        <button class="ph-toggle-btn" onclick="toggleCollapse(this)">
                            <span><i class="ti ti-package"></i> @itemCount item@(itemCount != 1 ? "s" : "")</span>
                            <i class="ti ti-chevron-down ph-chevron"></i>
                        </button>
                    </div>

                    <!-- Collapsible items -->
                    <div class="ph-collapse">
                        @foreach (var item in order.OrderItems)
                        {
                            var vtags = ParseVariationTags(item.SelectedVariation);
                            <div class="ph-item">
                                <div class="ph-item-img">
                                    <img src="@item.Product?.ImagePath" alt="@item.Product?.Name"
                                         onerror="this.src='/images/placeholder.png'" />
                                </div>
                                <div class="ph-item-info">
                                    <div class="ph-item-name">@item.Product?.Name</div>
                                    @if (vtags.Any())
                                    {
                                        <div class="ph-item-vars">
                                            @foreach (var tag in vtags)
                                            { <span class="ph-var-tag">@tag</span> }
                                        </div>
                                    }
                                    <div class="ph-item-qty">Qty: @item.Quantity &nbsp;·&nbsp; RM @item.Price.ToString("0.00") each</div>
                                </div>
                                <div class="ph-item-total">RM @((item.Price * item.Quantity).ToString("0.00"))</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(order.CustomerMessage))
                        {
                            <div class="ph-customer-msg">
                                <i class="ti ti-message-circle"></i>
                                <span>@order.CustomerMessage</span>
                            </div>
                        }
                    </div>

                    <!-- Delivery toggle -->
                    <div class="ph-card-seller ph-card-delivery-toggle">
                        <i class="ti ti-map-pin" style="font-size:14px;color:#aaa"></i>
                        <span style="color:#aaa;font-size:12px;font-weight:500">Delivery</span>
                        <button class="ph-toggle-btn" onclick="toggleCollapse(this)">
                            <span>View address</span>
                            <i class="ti ti-chevron-down ph-chevron"></i>
                        </button>
                    </div>

                    <!-- Collapsible delivery -->
                    <div class="ph-collapse">
                        <div class="ph-delivery">
                            <div class="ph-delivery-row">
                                <span class="ph-delivery-label"><i class="ti ti-user"></i> Recipient</span>
                                <span>@order.DeliveryRecipientName</span>
                            </div>
                            <div class="ph-delivery-row">
                                <span class="ph-delivery-label"><i class="ti ti-phone"></i> Phone</span>
                                <span>@order.DeliveryPhoneNumber</span>
                            </div>
                            <div class="ph-delivery-row">
                                <span class="ph-delivery-label"><i class="ti ti-map-pin"></i> Address</span>
                                <span>
                                    @order.DeliveryAddressLine1@(!string.IsNullOrWhiteSpace(order.DeliveryAddressLine2) ? ", " + order.DeliveryAddressLine2 : ""),
                                    @order.DeliveryCity, @order.DeliveryPostcode, @order.DeliveryState
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Card footer -->
                    <div class="ph-card-footer">
                        <div class="ph-footer-payment">
                            <i class="ti ti-credit-card"></i>
                            <span>@order.PaymentMethod</span>
                        </div>
                        <div class="ph-footer-right">
                            <div class="ph-total-block">
                                <div class="ph-total-label">Order Total</div>
                                <div class="ph-total-amt">RM @order.TotalAmount.ToString("N2")</div>
                            </div>

                            <!-- Details button (always visible) -->
                            <button class="ph-btn ph-btn-ghost"
                                    onclick="openDrawer(@order.OrderId)">
                                <i class="ti ti-file-text"></i> Details
                            </button>

                            <!-- PENDING: Cancel button -->
                            @if (order.CurrentStatus == EcommerceSystem.Models.OrderStatus.PENDING)
                            {
                                <button class="ph-btn ph-btn-danger"
                                        onclick="openCancelModal(@order.OrderId)">
                                    <i class="ti ti-x"></i> Cancel Order
                                </button>
                            }

                            <!-- DELIVERED: Confirm Received button + Request Return/Refund button -->
                            @if (order.CurrentStatus == EcommerceSystem.Models.OrderStatus.DELIVERED)
                            {
                                <button class="ph-btn ph-btn-primary"
                                        onclick="confirmReceived(@order.OrderId, this)">
                                    <i class="ti ti-circle-check"></i> Order Received
                                </button>
                                <button class="ph-btn ph-btn-warning"
                                        onclick="openReturnModal(@order.OrderId)">
                                    <i class="ti ti-refresh-alert"></i> Request Return/Refund
                                </button>
                            }

                            <!-- RECEIVED: Write Review button -->
                            @if (order.CurrentStatus == EcommerceSystem.Models.OrderStatus.RECEIVED)
                            {
                                if (!order.ReviewSubmitted)
                                {
                                    <button class="ph-btn ph-btn-star js-write-review"
                                            onclick="openRatingModal(@order.OrderId)">
                                        <i class="ti ti-star"></i> Write Review
                                    </button>
                                }
                                else
                                {
                                    <span class="ph-btn ph-btn-done">
                                        <i class="ti ti-check"></i> Review Submitted
                                    </span>
                                }
                            }

                            <!-- RETURN_REFUND or RECEIVED: Complaint button -->
                            @if (order.CurrentStatus == EcommerceSystem.Models.OrderStatus.RETURN_REFUND
                              || order.CurrentStatus == EcommerceSystem.Models.OrderStatus.RECEIVED)
                            {
                                if (!order.ComplaintSubmitted)
                                {
                                    <button class="ph-btn ph-btn-ghost"
                                            onclick="openComplaintModal(@order.OrderId)">
                                        <i class="ti ti-alert-triangle"></i> Complaint
                                    </button>
                                }
                                else
                                {
                                    <span class="ph-btn ph-btn-done">
                                        <i class="ti ti-check"></i> Complaint Sent
                                    </span>
                                }
                            }
                        </div>
                    </div>

                </div><!-- /.ph-card -->
            }
        </div><!-- /#phOrderList -->

        <div id="phNoResults" class="ph-no-results" style="display:none">
            <i class="ti ti-search-off"></i>
            <p>No orders match your search.</p>
        </div>

    }
</div><!-- /.ph-page -->

<!-- ═══════════════════════════════════════════════════════════
     DRAWER  –  Order Detail
═══════════════════════════════════════════════════════════ -->
<div class="od-backdrop" id="odBackdrop" onclick="closeDrawer()"></div>
<aside class="od-drawer" id="odDrawer" role="dialog" aria-modal="true" aria-label="Order details">

    <div class="od-drawer-header">
        <div>
            <div class="od-drawer-title" id="odTitle"></div>
            <div class="od-drawer-date"  id="odDate"></div>
        </div>
        <div class="od-drawer-header-right">
            <span class="ph-status-pill" id="odBadge">
                <span class="ph-status-dot"></span>
                <span id="odBadgeLabel"></span>
            </span>
            <button class="od-close-btn" onclick="closeDrawer()" aria-label="Close">
                <i class="ti ti-x"></i>
            </button>
        </div>
    </div>

    <div class="od-drawer-body" id="odDrawerBody"></div>

</aside>


<!-- ═══════════════════════════════════════════════════════════
     MODAL  –  Cancel Order
═══════════════════════════════════════════════════════════ -->
<div class="ph-modal-backdrop" id="cancelBackdrop" onclick="closeCancelModal()"></div>
<div class="ph-modal" id="cancelModal">
    <div class="ph-modal-header">
        <i class="ti ti-ban" style="color:#ef4444;font-size:22px"></i>
        <h3>Cancel Order</h3>
        <button class="ph-modal-close" onclick="closeCancelModal()"><i class="ti ti-x"></i></button>
    </div>
    <p class="ph-modal-sub">Please let us know why you'd like to cancel. Your feedback helps us improve.</p>

    <div class="ph-reason-grid" id="cancelReasonGrid">
        <button class="ph-reason-chip" onclick="selectReason(this, 'cancelCustom')">Changed my mind</button>
        <button class="ph-reason-chip" onclick="selectReason(this, 'cancelCustom')">Found a better price</button>
        <button class="ph-reason-chip" onclick="selectReason(this, 'cancelCustom')">Ordered by mistake</button>
        <button class="ph-reason-chip" onclick="selectReason(this, 'cancelCustom')">Delivery too slow</button>
        <button class="ph-reason-chip" onclick="selectReason(this, 'cancelCustom')">Wrong item ordered</button>
        <button class="ph-reason-chip" onclick="selectReason(this, 'cancelCustom')">Other</button>
    </div>

    <div class="ph-textarea-wrap">
        <textarea id="cancelCustom" placeholder="Add details (optional)…" rows="3"></textarea>
    </div>

    <input type="hidden" id="cancelOrderId" />

    <div class="ph-modal-footer">
        <button class="ph-btn ph-btn-ghost" onclick="closeCancelModal()">Keep Order</button>
        <button class="ph-btn ph-btn-danger" onclick="submitCancel()">
            <i class="ti ti-x"></i> Confirm Cancel
        </button>
    </div>
</div>


<!-- ═══════════════════════════════════════════════════════════
     MODAL  –  Write Review / Rating
═══════════════════════════════════════════════════════════ -->
<div class="ph-modal-backdrop" id="ratingBackdrop" onclick="closeRatingModal()"></div>
<div class="ph-modal" id="ratingModal">
    <div class="ph-modal-header">
        <i class="ti ti-star" style="color:#f59e0b;font-size:22px"></i>
        <h3>Write a Review</h3>
        <button class="ph-modal-close" onclick="closeRatingModal()"><i class="ti ti-x"></i></button>
    </div>

    <div id="ratingItemsWrap"></div>

    <input type="hidden" id="ratingOrderId" />

    <div class="ph-modal-footer">
        <button class="ph-btn ph-btn-ghost" onclick="closeRatingModal()">Cancel</button>
        <button class="ph-btn ph-btn-star" onclick="submitRating()">
            <i class="ti ti-send"></i> Submit Review
        </button>
    </div>
</div>


<!-- ═══════════════════════════════════════════════════════════
     MODAL  –  Request Return / Refund  
═══════════════════════════════════════════════════════════ -->
<div class="ph-modal-backdrop" id="returnBackdrop" onclick="closeReturnModal()"></div>
<div class="ph-modal" id="returnModal" style="max-width:540px">
    <div class="ph-modal-header">
        <i class="ti ti-refresh-alert" style="color:#f97316;font-size:22px"></i>
        <h3>Request Return / Refund &nbsp;<span style="font-size:13px;font-weight:400;color:#9a98b6">(Request Return/Refund)</span></h3>
        <button class="ph-modal-close" onclick="closeReturnModal()"><i class="ti ti-x"></i></button>
    </div>
    <p class="ph-modal-sub">Select the item(s) affected and describe the issue. The seller will review your request.</p>

    <div id="returnItemsWrap"></div>

    <!-- ── Return Type ── -->
    <div style="margin-top:16px">
        <div style="font-family:'DM Sans',sans-serif;font-weight:700;font-size:13px;color:#1e1b4b;margin-bottom:8px">
            Return Type <span style="color:#ef4444">*</span>
        </div>
        <div class="ph-return-type-grid" id="returnTypeGrid">
            <button class="ph-return-type-chip" onclick="selectReturnType(this,'ReturnRefund')">
                <i class="ti ti-package-import" style="font-size:18px;color:#4f46e5;margin-bottom:4px"></i>
                <span style="font-weight:700;font-size:13px">Return &amp; Refund</span>
                <span style="font-size:11px;color:#9a98b6;line-height:1.3">Send item back, receive money refund</span>
            </button>
            <button class="ph-return-type-chip" onclick="selectReturnType(this,'ReturnReplace')">
                <i class="ti ti-replace" style="font-size:18px;color:#f97316;margin-bottom:4px"></i>
                <span style="font-weight:700;font-size:13px">Return &amp; Replace</span>
                <span style="font-size:11px;color:#9a98b6;line-height:1.3">Send item back, get correct one</span>
            </button>
            <button class="ph-return-type-chip" onclick="selectReturnType(this,'RefundOnly')">
                <i class="ti ti-coin" style="font-size:18px;color:#10b981;margin-bottom:4px"></i>
                <span style="font-weight:700;font-size:13px">Refund Only</span>
                <span style="font-size:11px;color:#9a98b6;line-height:1.3">Item missing / not received — no return needed</span>
            </button>
        </div>
    </div>
    <input type="hidden" id="returnTypeValue" />

    <!-- ── Return Reason ── -->
    <div style="margin-top:14px;font-family:'DM Sans',sans-serif;font-weight:700;font-size:13px;color:#1e1b4b;margin-bottom:8px">
        Reason <span style="color:#ef4444">*</span>
    </div>
    <div class="ph-reason-grid" id="returnReasonGrid">
        <button class="ph-reason-chip" onclick="selectReturnReason(this)">Wrong item received</button>
        <button class="ph-reason-chip" onclick="selectReturnReason(this)">Item not delivered</button>
        <button class="ph-reason-chip" onclick="selectReturnReason(this)">Damaged / defective</button>
        <button class="ph-reason-chip" onclick="selectReturnReason(this)">Item not as described</button>
        <button class="ph-reason-chip" onclick="selectReturnReason(this)">Missing parts / accessories</button>
        <button class="ph-reason-chip" onclick="selectReturnReason(this)">Other</button>
    </div>

    <div class="ph-textarea-wrap" style="margin-top:10px">
        <textarea id="returnCustom" placeholder="Describe the issue in detail…" rows="3"></textarea>
    </div>

    <input type="hidden" id="returnOrderId" />

    <div class="ph-modal-footer">
        <button class="ph-btn ph-btn-ghost" onclick="closeReturnModal()">Cancel</button>
        <button class="ph-btn ph-btn-warning" onclick="submitReturn()" id="returnSubmitBtn">
            <i class="ti ti-send"></i> Submit Request
        </button>
    </div>
</div>

<style>
.ph-return-type-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
