@model EcommerceSystem.Models.ViewModels.MyReportsViewModel
@using System.Text.Json
@using System.Globalization

<link rel="stylesheet" href="~/css/customer/reports.css" asp-append-version="true" />

@{
    ViewData["Title"] = "My Reports";
}

<div class="reports-page">

    <!-- Header -->
    <div class="reports-header">
        <h1 class="reports-title">My Reports</h1>
        <p class="reports-subtitle">Track all your product and review reports and their status</p>
    </div>

    <!-- Tabs -->
    <div class="reports-tabs">
        <button class="tab-btn active" id="productReportsTab" onclick="switchTab('productReports')">
            <i class="ti ti-flag" aria-hidden="true"></i>
            Product Reports
            <span class="tab-count">@Model.ProductReports.Count</span>
        </button>
        <button class="tab-btn" id="reviewReportsTab" onclick="switchTab('reviewReports')">
            <i class="ti ti-message-report" aria-hidden="true"></i>
            Review Reports
            <span class="tab-count">@Model.ReviewReports.Count</span>
        </button>
    </div>


    <!-- ═══════════════════════════════════════
         PRODUCT REPORTS TAB
         ═══════════════════════════════════════ -->
    <div id="productReports" class="tab-content active">
        @if (Model.ProductReports == null || Model.ProductReports.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="ti ti-flag-off" aria-hidden="true"></i>
                </div>
                <h3>No product reports yet</h3>
                <p>You haven't submitted any product reports. If you encounter an issue with a listing, please report it.</p>
                <a href="@Url.Action("Home", "Customer")" class="btn-browse">
                    <i class="ti ti-arrow-left" aria-hidden="true"></i> Browse Products
                </a>
            </div>
        }
        else
        {
            <div class="reports-list">
                @foreach (var report in Model.ProductReports)
                {
                    var reportDate = report.ReportedAt.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture);
                    var statusClass = (report.Status?.ToLower() ?? "pending").Replace(" ", "-");
                    var evidenceImages = new List<string>();

                    try
                    {
                        if (!string.IsNullOrEmpty(report.EvidenceImagePathsJson))
                            evidenceImages = JsonSerializer.Deserialize<List<string>>(report.EvidenceImagePathsJson) ?? new List<string>();
                    }
                    catch { }

                    <div class="report-card">
                        <div class="report-card-header">
                            <div class="report-info">
                                <h3 class="report-product-name">@(report.Product?.Name ?? "Product")</h3>
                                <p class="report-product-id">Product ID: @report.ProductId</p>
                            </div>
                            <span class="report-status status-@statusClass">
                                <i class="ti ti-circle-filled" aria-hidden="true"></i>
                                @report.Status
                            </span>
                        </div>

                        <div class="report-card-body">

                            <div class="report-row">
                                <label>Reason</label>
                                <span>@report.ReportReason</span>
                            </div>

                            <div class="report-divider"></div>

                            <div class="report-row">
                                <label>Description</label>
                                <p class="report-description">@report.ReportDescription</p>
                            </div>

                            @if (evidenceImages.Count > 0)
                            {
                                <div class="report-row">
                                    <label>Evidence Images</label>
                                    <div class="evidence-gallery">
                                        @foreach (var imagePath in evidenceImages)
                                        {
                                            <div class="evidence-item" onclick="openImageLightbox('@imagePath')" title="View image">
                                                <img src="@imagePath" alt="Evidence" />
                                                <div class="evidence-overlay">
                                                    <i class="ti ti-zoom-in" aria-hidden="true"></i>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="report-divider"></div>

                            <div class="report-row">
                                <label>Reported On</label>
                                <span>@reportDate</span>
                            </div>

                            @if (report.Status?.ToLower() == "resolved")
                            {
                                <div class="report-row">
                                    <label>Resolved On</label>
                                    <span>@(report.ResolvedAt?.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture) ?? "N/A")</span>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(report.AdminNotes))
                            {
                                <div class="report-row admin-section">
                                    <label>Admin Notes</label>
                                    <div class="admin-notes">
                                        <i class="ti ti-message-circle" aria-hidden="true"></i>
                                        <p>@report.AdminNotes</p>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>
                }
            </div>
        }
    </div>


    <!-- ═══════════════════════════════════════
         REVIEW REPORTS TAB
         ═══════════════════════════════════════ -->
    <div id="reviewReports" class="tab-content">
        @if (Model.ReviewReports == null || Model.ReviewReports.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="ti ti-message-off" aria-hidden="true"></i>
                </div>
                <h3>No review reports yet</h3>
                <p>You haven't submitted any review reports. If you see an inappropriate review, please report it.</p>
                <a href="@Url.Action("Home", "Customer")" class="btn-browse">
                    <i class="ti ti-arrow-left" aria-hidden="true"></i> Browse Products
                </a>
            </div>
        }
        else
        {
            <div class="reports-list">
                @foreach (var report in Model.ReviewReports)
                {
                    var reportDate = report.ReportedAt.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture);
                    var statusClass = (report.Status?.ToLower() ?? "pending").Replace(" ", "-");
                    int rating    = report.Review?.Rating ?? 0;
                    int emptyStars = 5 - rating;

                    <div class="report-card">
                        <div class="report-card-header">
                            <div class="report-info">
                                <h3 class="report-product-name">
                                    Reviewed by @(report.Review?.OrderItem?.Order?.Customer?.FullName ?? "Customer")
                                </h3>
                                <p class="report-product-id">
                                    Product: @(report.Review?.Product?.Name ?? "Unknown Product")
                                </p>
                            </div>
                            <span class="report-status status-@statusClass">
                                <i class="ti ti-circle-filled" aria-hidden="true"></i>
                                @report.Status
                            </span>
                        </div>

                        <div class="report-card-body">

                            <div class="report-row">
                                <label>Review Rating</label>
                                <span class="review-stars" aria-label="@rating out of 5 stars">
                                    @for (int i = 0; i < rating;      i++) { <i class="ti ti-star-filled" aria-hidden="true"></i> }
                                    @for (int i = 0; i < emptyStars;  i++) { <i class="ti ti-star"        aria-hidden="true"></i> }
                                </span>
                            </div>

                            @if (!string.IsNullOrEmpty(report.Review?.ReviewText))
                            {
                                <div class="report-row">
                                    <label>Review Text</label>
                                    <p class="review-text">"@report.Review.ReviewText"</p>
                                </div>
                            }

                            <div class="report-divider"></div>

                            <div class="report-row">
                                <label>Reason</label>
                                <span>@report.ReportReason</span>
                            </div>

                            <div class="report-row">
                                <label>Description</label>
                                <p class="report-description">@report.ReportDescription</p>
                            </div>

                            <div class="report-divider"></div>

                            <div class="report-row">
                                <label>Reported On</label>
                                <span>@reportDate</span>
                            </div>

                            @if (report.ResolvedAt.HasValue)
                            {
                                <div class="report-row">
                                    <label>Resolved On</label>
                                    <span>@report.ResolvedAt.Value.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture)</span>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(report.AdminNotes))
                            {
                                <div class="report-row admin-section">
                                    <label>Admin Notes</label>
                                    <div class="admin-notes">
                                        <i class="ti ti-message-circle" aria-hidden="true"></i>
                                        <p>@report.AdminNotes</p>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>
                }
            </div>
        }
    </div>

</div>


<!-- ═══════════════════════════════════════════════════════
     IMAGE LIGHTBOX
═══════════════════════════════════════════════════════ -->
<div id="imageLightbox" class="image-lightbox" hidden>
    <button class="lightbox-close" id="lightboxClose" aria-label="Close image">
        <i class="ti ti-x"></i>
    </button>
    <img id="lightboxImage" src="" alt="Evidence image" />
</div>

<script src="~/js/customer/reports.js" asp-append-version="true"></script>
