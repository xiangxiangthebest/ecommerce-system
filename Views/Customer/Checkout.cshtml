@model EcommerceSystem.ViewModels.Checkout
@using System.Text.Json

<link rel="stylesheet" href="~/css/customer/checkout.css" asp-append-version="true" />

@{
    var customer  = Model.Customer;
    var items     = Model.CartItems ?? new List<EcommerceSystem.Models.CartItem>();
    var addresses = Model.Addresses ?? new List<EcommerceSystem.Models.DeliveryField>();

    bool hasAddresses = addresses.Any();

    double merchandiseSubtotal = items.Sum(i => i.Price * i.Quantity);
    double shippingFeeBase     = merchandiseSubtotal >= 100 ? 0 : 10;
    double shippingSst         = Math.Round(shippingFeeBase * 0.08, 2);
    double totalPayment        = merchandiseSubtotal + shippingFeeBase + shippingSst;
}

<div class="checkout-page">

    <!-- Page title -->
    <div class="checkout-header">
        <a asp-action="Cart" class="back-link" id="backBtn"><i class="ti ti-arrow-left"></i></a>
        <h1 class="checkout-title">Checkout</h1>
        <span class="checkout-step-label">Review &amp; Place Order</span>
    </div>

    <form asp-action="PlaceOrder" method="post" id="checkoutForm">
        @{
            var source = (string)ViewBag.Source ?? "cart";
            var productId = ViewBag.ProductId;
        }

        @Html.AntiForgeryToken()

        <input type="hidden" name="source" value="@source" />
        <input type="hidden" name="productId" value="@productId" />

        @if (source == "product")
        {
            var item = Model.CartItems?.FirstOrDefault();
            if (item != null)
            {
                <input type="hidden" name="buyNowQuantity" value="@item.Quantity" />
                <input type="hidden" name="buyNowSelectedVariations" value="@item.SelectedVariations" />
            }
        }
        else
        {
            @foreach (var item in Model.CartItems ?? Enumerable.Empty<EcommerceSystem.Models.CartItem>())
            {
                <input type="hidden" name="selectedItemIds" value="@item.CartItemId" />
            }
        }

        <input type="hidden" name="SelectedVoucherId" id="SelectedVoucherId" value="" />

        <div class="checkout-layout">

            <!-- ══════════════════════════════
                 LEFT COLUMN
            ══════════════════════════════ -->
            <div class="checkout-left">

                <!-- 1. Delivery Address -->
                <section class="checkout-card">
                    <div class="card-heading">
                        <span class="card-num">1</span>
                        <div>
                            <h2 class="card-title">Delivery Address</h2>
                            <p class="card-sub">Where should we send your order?</p>
                        </div>
                    </div>

                    @if (!hasAddresses)
                    {
                        <!-- EMPTY STATE -->
                        <div class="empty-address">
                            <i class="ti ti-alert-circle"></i>
                            <div class="empty-address-text">
                                <p class="empty-address-title">No delivery address found</p>
                                <p class="empty-address-sub">
                                    Please update your delivery address at
                                    <a asp-controller="Customer" asp-action="Profile">Profile page</a>
                                    to continue.
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="saved-address-row">
                            @foreach (var addr in addresses.OrderByDescending(x => x.IsDefault))
                            {
                                <label class="saved-address-card @(addr.IsDefault ? "selected" : "")">
                                    <input type="radio"
                                           name="SelectedAddressId"
                                           value="@addr.AddressId"
                                           class="sr-only"
                                           @(addr.IsDefault ? "checked" : "")
                                           required />

                                    <div class="saved-addr-inner">

                                        <div class="saved-addr-icon">
                                            <i class="ti ti-map-pin"></i>
                                        </div>

                                        <div class="saved-addr-text">
                                            <div class="saved-addr-top">
                                                <span class="saved-addr-name">@addr.RecipientName</span>
                                                <span class="saved-addr-phone">@addr.PhoneNumber</span>

                                                @if (addr.IsDefault)
                                                {
                                                    <span class="saved-addr-badge">Default</span>
                                                }
                                            </div>

                                            <span class="saved-addr-line">
                                                @addr.AddressLine1
                                                @(!string.IsNullOrWhiteSpace(addr.AddressLine2) ? ", " + addr.AddressLine2 : "")
                                            </span>

                                            <span class="saved-addr-line">
                                                @addr.Postcode, @addr.City, @addr.State
                                            </span>
                                        </div>

                                    </div>
                                </label>
                            }
                        </div>

                        <div class="address-manage-link">
                            <a asp-controller="Customer" asp-action="Profile">
                                <i class="ti ti-settings"></i> Manage addresses in Profile
                            </a>
                        </div>
                    }
                </section>

                <!-- 2. Order Items -->
                <section class="checkout-card">
                    <div class="card-heading">
                        <span class="card-num">2</span>
                        <div>
                            <h2 class="card-title">Order Items</h2>
                            <p class="card-sub">@items.Count() @(items.Count() == 1 ? "item" : "items") from your cart</p>
                        </div>
                    </div>

                    @{
                        var grouped = items
                            .Where(i => i.Product != null)
                            .GroupBy(i => i.Product!.Seller?.ShopName ?? "Unknown Shop");
                    }

                    @foreach (var group in grouped)
                    {
                        <div class="seller-group">
                            <div class="seller-group-header">
                                <i class="ti ti-building-store"></i>
                                <span>@group.Key</span>
                            </div>

                            @foreach (var item in group)
                            {
                                var varDict = new Dictionary<string, string>();
                                if (!string.IsNullOrWhiteSpace(item.SelectedVariations) && item.SelectedVariations != "{}")
                                {
                                    try
                                    {
                                        varDict = JsonSerializer.Deserialize<Dictionary<string, string>>(item.SelectedVariations) ?? new();
                                    }
                                    catch { }
                                }

                                <div class="checkout-item">
                                    @if (!string.IsNullOrWhiteSpace(item.Product?.ImagePath))
                                    {
                                        <img src="@item.Product.ImagePath" alt="@item.Product.Name" class="checkout-item-img" />
                                    }
                                    else
                                    {
                                        <div class="checkout-item-img-placeholder"><i class="ti ti-photo"></i></div>
                                    }

                                    <div class="checkout-item-info">
                                        <span class="checkout-item-name">@(item.Product?.Name ?? "Product")</span>

                                        @if (varDict.Any())
                                        {
                                            <div class="checkout-item-vars">
                                                @foreach (var kv in varDict)
                                                {
                                                    <span class="variation-tag">@kv.Key: @kv.Value</span>
                                                }
                                            </div>
                                        }

                                        <span class="checkout-item-qty">Qty: @item.Quantity</span>
                                    </div>

                                    <div class="checkout-item-price">
                                        RM @((item.Price * item.Quantity).ToString("0.00"))
                                    </div>
                                </div>
                            }

                            <div class="seller-message-row">
                                <label class="form-label">
                                    <i class="ti ti-message-circle"></i>
                                    Message to @group.Key
                                    <span class="optional">(optional)</span>
                                </label>
                                <input type="text"
                                       name="SellerMessage_@(group.Key.Replace(" ", "_"))"
                                       class="form-input seller-msg-input"
                                       placeholder="Leave a note for the seller…"
                                       maxlength="200" />
                            </div>
                        </div>
                    }
                </section>

                <!-- 3. Payment Method -->
                <section class="checkout-card">
                    <div class="card-heading">
                        <span class="card-num">3</span>
                        <div>
                            <h2 class="card-title">Payment Method</h2>
                            <p class="card-sub">Choose how you'd like to pay</p>
                        </div>
                    </div>

                    <div class="payment-methods">

                        <label class="payment-option">
                            <input type="radio" name="PaymentMethod" value="FPX" class="sr-only pm-radio" />
                            <div class="pm-icon-wrap"><i class="ti ti-building-bank"></i></div>
                            <div class="pm-info">
                                <span class="pm-name">Online Banking (FPX)</span>
                                <span class="pm-desc">Maybank, CIMB, RHB, Public Bank &amp; more</span>
                            </div>
                            <div class="pm-check"><i class="ti ti-check"></i></div>
                        </label>

                        <label class="payment-option">
                            <input type="radio" name="PaymentMethod" value="Card" class="sr-only pm-radio" />
                            <div class="pm-icon-wrap"><i class="ti ti-credit-card"></i></div>
                            <div class="pm-info">
                                <span class="pm-name">Credit / Debit Card</span>
                                <span class="pm-desc">Visa, Mastercard, American Express</span>
                            </div>
                            <div class="pm-check"><i class="ti ti-check"></i></div>
                        </label>

                        <!-- Card sub-form -->
                        <div class="card-details-form" id="cardDetailsForm">
                            <div class="form-group">
                                <label class="form-label">Cardholder Name</label>
                                <input type="text" name="CardName" class="form-input" placeholder="Name as on card" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Card Number</label>
                                <div class="card-num-wrap">
                                    <input type="text" name="CardNumber" id="cardNumberInput"
                                           class="form-input" placeholder="0000 0000 0000 0000"
                                           maxlength="19" inputmode="numeric" />
                                    <span class="card-brand-icon"><i class="ti ti-credit-card" id="cardBrandIcon"></i></span>
                                </div>
                            </div>
                            <div class="form-row two-col">
                                <div class="form-group">
                                    <label class="form-label">Expiry Date</label>
                                    <input type="text" name="CardExpiry" id="cardExpiry"
                                           class="form-input" placeholder="MM / YY" maxlength="7" />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">CVV</label>
                                    <input type="password" name="CardCvv"
                                           class="form-input" placeholder="•••" maxlength="4" />
                                </div>
                            </div>
                        </div>

                        <label class="payment-option">
                            <input type="radio" name="PaymentMethod" value="COD" class="sr-only pm-radio" />
                            <div class="pm-icon-wrap"><i class="ti ti-cash"></i></div>
                            <div class="pm-info">
                                <span class="pm-name">Cash on Delivery</span>
                                <span class="pm-desc">Pay when your order arrives</span>
                            </div>
                            <div class="pm-check"><i class="ti ti-check"></i></div>
                        </label>

                        <label class="payment-option">
                            <input type="radio" name="PaymentMethod" value="EWallet" class="sr-only pm-radio" />
                            <div class="pm-icon-wrap"><i class="ti ti-wallet"></i></div>
                            <div class="pm-info">
                                <span class="pm-name">E-Wallet</span>
                                <span class="pm-desc">Touch 'n Go eWallet, GrabPay</span>
                            </div>
                            <div class="pm-check"><i class="ti ti-check"></i></div>
                        </label>

                    </div>
                </section>

            </div>

            <!-- ══════════════════════════════
                 RIGHT COLUMN
            ══════════════════════════════ -->
            <div class="checkout-right">

                <!-- Voucher -->
                <div class="voucher-wallet-card" id="voucherWalletCard">
                    <div class="voucher-wallet-header">
                        <span class="voucher-wallet-title">
                            <i class="ti ti-ticket" aria-hidden="true"></i>
                            Voucher
                        </span>
                        @if (Model.AvailableVouchers != null && Model.AvailableVouchers.Any())
                        {
                            <button type="button" class="voucher-browse-btn" id="voucherBrowseBtn">
                                <span id="voucherBrowseBtnLabel">@Model.AvailableVouchers.Count() available</span>
                                <i class="ti ti-chevron-down" id="voucherBrowseChevron"></i>
                            </button>
                        }
                    </div>

                    <!-- Manual code entry -->
                    <div class="voucher-input-row">
                        <input type="text" id="promoInput" name="PromoCode"
                            class="form-input voucher-code-input"
                            placeholder="Enter voucher code" />
                        <button type="button" class="voucher-apply-btn" id="applyPromoBtn">Apply</button>
                    </div>
                    <p class="promo-feedback" id="promoFeedback"></p>

                    <!-- Applied ticket display (hidden until a voucher is applied) -->
                    <div class="voucher-applied-ticket" id="voucherAppliedTicket" style="display:none;">
                        <div class="ticket-left">
                            <i class="ti ti-check-circle" aria-hidden="true"></i>
                        </div>
                        <div class="ticket-perf"></div>
                        <div class="ticket-right">
                            <span class="ticket-label">Voucher applied</span>
                            <span class="ticket-code" id="ticketCode"></span>
                            <span class="ticket-savings">− RM <span id="ticketSavings">0.00</span></span>
                        </div>
                        <button type="button" class="ticket-remove-btn" id="ticketRemoveBtn" title="Remove voucher">
                            <i class="ti ti-x"></i>
                        </button>
                    </div>

                    <!-- Voucher tray -->
                    @if (Model.AvailableVouchers != null && Model.AvailableVouchers.Any())
                    {
                        <div class="voucher-tray" id="voucherTray">
                            <p class="voucher-tray-label">Your vouchers</p>
                            <div class="voucher-tray-list">
                                @foreach (var cv in Model.AvailableVouchers)
                                {
                                    var minSpendValue = (double)(cv.Voucher?.MinimumSpend ?? 0m);
                                    var isDisabled = minSpendValue > 0 && minSpendValue > merchandiseSubtotal;
                                    var disabledLabel = isDisabled
                                        ? $"Min spend RM {minSpendValue:0}"
                                        : null;
                                    <button type="button"
                                            class="voucher-stub @(isDisabled ? "disabled" : "")"
                                            aria-disabled="@(isDisabled.ToString().ToLowerInvariant())"
                                            data-code="@cv.Voucher?.Code"
                                            data-value="@cv.Voucher?.DiscountValue"
                                            data-min="@cv.Voucher?.MinimumSpend"
                                            data-disabled="@(isDisabled.ToString().ToLowerInvariant())"
                                            data-vid="@cv.CustomerVoucherId">
                                        <div class="stub-accent"></div>
                                        <div class="stub-body">
                                            <span class="stub-name">@cv.Voucher?.Name</span>
                                            <span class="stub-code">@cv.Voucher?.Code</span>
                                            @if (isDisabled)
                                            {
                                                <span class="stub-note">
                                                    <i class="ti ti-lock"></i>@disabledLabel
                                                </span>
                                            }
                                        </div>
                                        <div class="stub-perf"></div>
                                        <div class="stub-value">
                                            <span class="stub-rm">RM</span>
                                            <span class="stub-amount">@((cv.Voucher?.IsPercentage == true) ? $"{cv.Voucher.DiscountValue:0}%" : cv.Voucher?.DiscountValue.ToString("0.00"))</span>
                                            <span class="stub-off">off</span>
                                        </div>
                                        <i class="ti ti-chevron-right stub-arrow" aria-hidden="true"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Payment details -->
                <div class="summary-card">
                    <div class="summary-card-header">
                        <i class="ti ti-receipt"></i> Payment Details
                    </div>

                    <div class="summary-lines">
                        <div class="summary-line">
                            <span>Merchandise Subtotal</span>
                            <span>RM <span id="sumMerchandise">@merchandiseSubtotal.ToString("0.00")</span></span>
                        </div>
                        <div class="summary-line">
                            <span>Shipping Subtotal <small>(excl. SST)</small></span>
                            <span>RM <span id="sumShippingBase">@shippingFeeBase.ToString("0.00")</span></span>
                        </div>
                        <div class="summary-line">
                            <span>Shipping Fee SST (8%)</span>
                            <span>RM <span id="sumShippingSst">@shippingSst.ToString("0.00")</span></span>
                        </div>
                        <div class="summary-line discount" id="lineShipDiscount" style="display:none;">
                            <span>Shipping Discount</span>
                            <span>− RM <span id="sumShipDiscount">0.00</span></span>
                        </div>
                        <div class="summary-line discount" id="lineVoucherDiscount" style="display:none;">
                            <span>Voucher Discount</span>
                            <span>− RM <span id="sumVoucherDiscount">0.00</span></span>
                        </div>
                    </div>

                    <div class="summary-divider"></div>

                    <div class="summary-total-row">
                        <span>Total Payment</span>
                        <span class="summary-total-amount">RM <span id="sumTotal">@totalPayment.ToString("0.00")</span></span>
                    </div>

                    <div class="summary-trust">
                        <div class="trust-item"><i class="ti ti-shield-check"></i><span>Secure checkout</span></div>
                        <div class="trust-item"><i class="ti ti-truck-delivery"></i><span>Fast delivery</span></div>
                        <div class="trust-item"><i class="ti ti-refresh"></i><span>7-day returns</span></div>
                    </div>
                </div>

                <!-- Hidden selected cart item ids -->
                @foreach (var item in Model.CartItems ?? Enumerable.Empty<EcommerceSystem.Models.CartItem>())
                {
                    <input type="hidden" name="selectedItemIds" value="@item.CartItemId" />
                }

                <button type="submit" class="btn-place-order" id="placeOrderBtn" disabled>
                    <span class="btn-place-order-inner">
                        <i class="ti ti-lock"></i> Place Order
                    </span>
                    <span class="btn-place-order-total">RM <span id="btnTotal">@totalPayment.ToString("0.00")</span></span>
                </button>

                <p class="checkout-guard-msg" id="checkoutGuardMsg"></p>

            </div>
        </div>
    </form>
</div>

<script>
    window.checkoutSource = "@ViewBag.Source";
    window.checkoutProductId = "@ViewBag.ProductId";
    window.availableVouchers = @Html.Raw(JsonSerializer.Serialize(Model.AvailableVouchers.Select(cv => new {
        Id = cv.CustomerVoucherId,
        Code = cv.Voucher?.Code,
        Name = cv.Voucher?.Name,
        DiscountValue = cv.Voucher?.DiscountValue,
        IsPercentage = cv.Voucher?.IsPercentage ?? false,
        MinimumSpend = cv.Voucher?.MinimumSpend,
        StartDate = cv.Voucher?.StartDate,
        EndDate = cv.Voucher?.EndDate
    })));
</script>

<script src="~/js/customer/checkout.js" asp-append-version="true"></script>