@model List<EcommerceSystem.Models.Notification>

<h2>Notifications</h2>

@if (!Model.Any())
{
    <p>No notifications yet.</p>
}
else
{
    foreach (var item in Model)
    {
        <div class="border p-3 mb-2 @(item.IsRead ? "" : "bg-light")">

            <h5>@item.Title</h5>

            <p>@item.Message</p>

            <small>
                @item.CreatedAt.ToString("dd MMM yyyy hh:mm tt")
            </small>

        </div>
    }
}