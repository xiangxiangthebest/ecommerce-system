@model EcommerceSystem.Models.Product
@using EcommerceSystem.Models
@using System.Text.Json
@using EcommerceSystem.DTOs

<link rel="stylesheet" href="~/css/customer/product-details.css" asp-append-version="true" />

@{
    var reviews    = ViewBag.Reviews as List<EcommerceSystem.Models.Review> ?? new List<EcommerceSystem.Models.Review>();
    var images     = ViewBag.Images as List<string> ?? new List<string>();
    var variations = ViewBag.Variations as List<VariationGroupDto> ?? new List<VariationGroupDto>();
    var firstImage = images.Count > 0 ? images[0] : Model.ImagePath;
    var shopInitial = (Model.Seller?.ShopName ?? "?").Substring(0, 1).ToUpper();

    var combos = new List<Product.VariationCombo>();
    try {
        combos = JsonSerializer.Deserialize<List<Product.VariationCombo>>(Model.VariationCombosJson ?? "[]")
                 ?? new List<Product.VariationCombo>();
    } catch { }

    bool hasVariations = variations.Count > 0;

    string stockClass, stockLabel;
    if (!hasVariations) {
        if (Model.StockQuantity <= 0)      { stockClass = "out-of-stock"; stockLabel = "Out of Stock"; }
        else if (Model.StockQuantity <= 5) { stockClass = "low-stock";    stockLabel = "Low Stock"; }
        else                               { stockClass = "in-stock";      stockLabel = "In Stock"; }
    } else {
        stockClass = "select-options"; stockLabel = "Select Options";
    }

    int fullStars  = (int)Math.Floor(Model.AverageRating);
    int emptyStars = 5 - fullStars;

    int totalVariationStock = hasVariations ? combos.Sum(c => c.Stock) : Model.StockQuantity;

    var variationGroupNamesJson = JsonSerializer.Serialize(variations.Select(v => v.Name).ToList());

    var breakdown = Enumerable.Range(1, 5).OrderByDescending(s => s).ToDictionary(
        s => s,
        s => reviews.Count(r => r.Rating == s)
    );
    int totalReviews = reviews.Count;
}

@if (TempData["CartSuccess"] != null)
{
    <div id="floatingAlert" class="floating-alert">@TempData["CartSuccess"]</div>
}

<div class="pd-page">
    <div class="pd-layout">

        <!-- LEFT: Gallery -->
        <div class="pd-gallery">
            <div class="pd-main-img-wrap">
                <img id="pdMainImg" src="@firstImage" alt="@Model.Name" class="pd-main-img" />
                <div class="pd-zoom-hint">
                    <i class="ti ti-zoom-in"></i> Hover to zoom
                </div>
            </div>

            @if (images.Count > 1)
            {
                <div class="pd-thumbnails">
                    @for (int i = 0; i < images.Count; i++)
                    {
                        <div class="pd-thumb @(i == 0 ? "active" : "")" data-src="@images[i]">
                            <img src="@images[i]" alt="@Model.Name view @(i + 1)" />
                        </div>
                    }
                </div>
            }
        </div>

        <!-- RIGHT: Info -->
        <div class="pd-info">

            <div class="pd-top-row">
                <span class="pd-category">@(Model.Category?.Name ?? "Uncategorised")</span>
                <div class="pd-badges">
                    <span id="pdStockBadge" class="pd-badge @stockClass">@stockLabel</span>
                </div>
            </div>

            <h1 class="pd-name">@Model.Name</h1>

            <!-- Rating row — stars + score + review trigger inline -->
            <div class="pd-rating-row">
                <div class="pd-stars">
                    @for (int s = 0; s < fullStars;  s++) { <span class="star">★</span> }
                    @for (int s = 0; s < emptyStars; s++) { <span class="star empty">★</span> }
                </div>
                <span class="pd-rating-text">@Model.AverageRating.ToString("0.0")</span>
                <div class="pd-rating-sep"></div>
                <button class="pd-review-trigger"
                        id="reviewTriggerBtn"
                        type="button"
                        aria-haspopup="dialog"
                        aria-expanded="false"
                        @(totalReviews == 0 ? "disabled" : "")>
                    @Model.ReviewCount review@(Model.ReviewCount == 1 ? "" : "s")
                    @if (totalReviews > 0)
                    {
                        <i class="ti ti-chevron-right" aria-hidden="true"></i>
                    }
                </button>
            </div>

            <div class="pd-divider"></div>

            <div class="pd-shop-row">
                <div class="pd-shop-avatar">@shopInitial</div>
                <span class="pd-shop-name">
                    Sold by <strong>@(Model.Seller?.ShopName ?? "Unknown Shop")</strong>
                </span>
            </div>

            <div class="pd-price-block">
                <div class="pd-price">RM @Model.Price.ToString("0.00")</div>
                <div class="pd-price-note">Price includes SST where applicable</div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.SKU))
            {
                <div class="pd-sku">SKU: @Model.SKU</div>
            }

            <div class="pd-divider"></div>

            <p class="pd-description">
                @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
            </p>

            @if (hasVariations)
            {
                <div class="pd-variations" id="pdVariations">
                    @for (int gi = 0; gi < variations.Count; gi++)
                    {
                        var group = variations[gi];
                        <div class="pd-variation-group" data-group-index="@gi">
                            <div class="pd-variation-label">@group.Name</div>
                            <div class="pd-variation-options">
                                @foreach (var val in group.Values)
                                {
                                    if (!string.IsNullOrWhiteSpace(val.ImagePath))
                                    {
                                        <div class="pd-variation-swatch"
                                             role="button"
                                             tabindex="0"
                                             title="@val.Label"
                                             data-group-index="@gi"
                                             data-label="@val.Label">
                                            <img src="@val.ImagePath" alt="@val.Label" />
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="pd-variation-btn"
                                                type="button"
                                                data-group-index="@gi"
                                                data-label="@val.Label">
                                            @val.Label
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
                <div id="pdVariationStockNote" class="pd-stock-variation-note" style="display:none;"></div>
            }

            <div class="pd-qty-row">
                <span class="pd-qty-label">Qty</span>
                <div class="pd-qty-control">
                    <button id="pdQtyMinus" class="pd-qty-btn" type="button">−</button>
                    <input id="pdQty" type="number" class="pd-qty-input"
                           min="1" max="@totalVariationStock" value="1" readonly />
                    <button id="pdQtyPlus" class="pd-qty-btn" type="button">+</button>
                </div>
                @if (!hasVariations && Model.StockQuantity > 0)
                {
                    <span class="pd-stock-note">@Model.StockQuantity left</span>
                }
            </div>

            <div class="pd-actions">
                <form asp-controller="Customer"
                      asp-action="AddToCart"
                      method="post"
                      onsubmit="return validateVariationsBeforeSubmit();">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId"        value="@Model.ProductId" />
                    <input type="hidden" id="selectedVariations" name="selectedVariations" value="{}" />
                    <input type="hidden" id="cartQuantity"       name="quantity" value="1" />
                    <button id="pdBtnCart"
                            type="submit"
                            class="pd-btn-cart"
                            @((!hasVariations && Model.StockQuantity <= 0) ? "disabled" : (hasVariations ? "disabled" : ""))>
                        @if (!hasVariations && Model.StockQuantity <= 0)
                        {
                            <i class="ti ti-shopping-cart-off"></i> <text>Out of Stock</text>
                        }
                        else
                        {
                            <i class="ti ti-shopping-cart-plus"></i> <text>Add to Cart</text>
                        }
                    </button>
                </form>

                <form asp-controller="Customer"
                      asp-action="BuyNow"
                      method="post"
                      onsubmit="return prepareBuyNow();">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId"              value="@Model.ProductId" />
                    <input type="hidden" id="buyNowSelectedVariations" name="selectedVariations" value="{}" />
                    <input type="hidden" id="buyNowQuantity"           name="quantity" value="1" />
                    <button id="pdBtnBuy"
                            type="submit"
                            class="pd-btn-buy"
                            @((!hasVariations && Model.StockQuantity <= 0) ? "disabled" : (hasVariations ? "disabled" : ""))>
                        <i class="ti ti-bolt"></i> Buy Now
                    </button>
                </form>
            </div>


       <form asp-controller="Chat" asp-action="StartConversation" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="sellerId" value="@Model.SellerId" />

    <input type="hidden" name="productId" value="@Model.ProductId" />

    <input type="hidden" id="chatVariationJson" name="variationJson" value="{}" />

    <button class="pd-chat-seller-btn" type="submit">
        <i class="ti ti-message"></i> Chat with Seller
    </button>
</form>

            <div class="pd-trust">
                <div class="pd-trust-item">
                    <i class="ti ti-truck-delivery"></i>
                    <span>Free shipping over RM100</span>
                </div>
                <div class="pd-trust-item">
                    <i class="ti ti-shield-check"></i>
                    <span>Secure checkout</span>
                </div>
                <div class="pd-trust-item">
                    <i class="ti ti-refresh"></i>
                    <span>7-day returns</span>
                </div>
            </div>

        </div><!-- /.pd-info -->
    </div><!-- /.pd-layout -->
</div><!-- /.pd-page -->

<!-- ═══════════════════════════════════════════
     REVIEWS MODAL — centred pop-out window
     ═══════════════════════════════════════════ -->
@if (totalReviews > 0)
{
    <div class="rv-overlay" id="rvBackdrop" role="dialog" aria-modal="true" aria-label="Customer reviews" hidden>
        <div class="rv-modal" id="rvPanel">

            <!-- Header -->
            <div class="rv-header">
                <div class="rv-header-top">
                    <p class="rv-title">Customer reviews</p>
                    <button class="rv-close" id="rvCloseBtn" aria-label="Close reviews" type="button">
                        <i class="ti ti-x" aria-hidden="true"></i>
                    </button>
                </div>

                <!-- Score + bar chart -->
                <div class="rv-summary">
                    <div class="rv-big-score">
                        <span class="rv-score-num">@Model.AverageRating.ToString("0.0")</span>
                        <div class="rv-score-stars" aria-label="@fullStars out of 5 stars">
                            @for (int s = 0; s < fullStars;  s++) { <span>★</span> }
                            @for (int s = 0; s < emptyStars; s++) { <span class="empty">★</span> }
                        </div>
                        <span class="rv-score-label">@totalReviews review@(totalReviews == 1 ? "" : "s")</span>
                    </div>
                    <div class="rv-bars" aria-label="Rating breakdown">
                        @foreach (var kv in breakdown)
                        {
                            double pct = totalReviews > 0 ? Math.Round((double)kv.Value / totalReviews * 100) : 0;
                            <div class="rv-bar-row">
                                <span class="rv-bar-num">@kv.Key</span>
                                <div class="rv-bar-track">
                                    <div class="rv-bar-fill" style="width:@pct%"></div>
                                </div>
                                <span class="rv-bar-pct">@((int)pct)%</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Filter chips -->
            <div class="rv-filters" role="group" aria-label="Filter by star rating">
                <button class="rv-chip active" data-filter="all" type="button">All</button>
                @foreach (var kv in breakdown.Where(k => k.Value > 0))
                {
                    <button class="rv-chip" data-filter="@kv.Key" type="button">
                        @kv.Key ★ <span class="rv-chip-count">@kv.Value</span>
                    </button>
                }
            </div>

            <!-- Review list -->
            <div class="rv-body" id="rvBody">
                @foreach (var r in reviews)
                {
                    <div class="rv-card" data-rating="@r.Rating">

                        <div class="rv-card-author">
                            <div class="rv-avatar">@(r.OrderItem?.Order?.Customer?.FullName?.Substring(0,1).ToUpper() ?? "C")</div>
                            <div class="rv-author-info">
                                <span class="rv-author-name">@(r.OrderItem?.Order?.Customer?.FullName ?? "Customer")</span>
                                <span class="rv-card-date">@r.CreatedAt.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>

                        <div class="rv-card-stars" aria-label="@r.Rating out of 5 stars">
                            @for (int i = 0; i < r.Rating; i++) { <span>★</span> }
                            @for (int i = 0; i < (5 - r.Rating); i++) { <span class="empty">★</span> }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(r.ReviewText))
                        {
                            <p class="rv-card-text">@r.ReviewText</p>
                        }
                        else
                        {
                            <p class="rv-card-text muted">No comment left.</p>
                        }

                    </div>
                }
                <div class="rv-empty" id="rvEmpty" style="display:none;">
                    <i class="ti ti-message-off" aria-hidden="true"></i>
                    No reviews for this rating.
                </div>
            </div>

        </div><!-- /.rv-modal -->
    </div><!-- /.rv-overlay -->
}

<script>
(function () {
    function qs(sel, root) { return (root || document).querySelector(sel); }
    function qsa(sel, root) { return Array.from((root || document).querySelectorAll(sel)); }

    /* ── Toast ── */
    function showToast(msg, type) {
        var t = document.createElement("div");
        t.className = "floating-alert" + (type === "error" ? " error" : "");
        t.textContent = msg;
        document.body.appendChild(t);
        setTimeout(function () { t.classList.add("hide"); setTimeout(function () { t.remove(); }, 500); }, 3000);
    }

    /* ── Auto-hide server alert ── */
    document.addEventListener("DOMContentLoaded", function () {
        var a = qs("#floatingAlert");
        if (!a) return;
        setTimeout(function () { a.classList.add("hide"); setTimeout(function () { a.remove(); }, 500); }, 3000);
    });

    /* ── Gallery ── */
    qsa(".pd-thumb").forEach(function (thumb) {
        thumb.addEventListener("click", function () {
            qs("#pdMainImg").src = thumb.getAttribute("data-src");
            qsa(".pd-thumb").forEach(function (t) { t.classList.remove("active"); });
            thumb.classList.add("active");
        });
    });

    /* ── Quantity ── */
    var qtyInput  = qs("#pdQty");
    var qtyHidden = qs("#cartQuantity");
    var btnMinus  = qs("#pdQtyMinus");
    var btnPlus   = qs("#pdQtyPlus");

    function clampQty(v) {
        return Math.min(Math.max(1, v), Math.max(1, parseInt(qtyInput.max || "1", 10)));
    }
    function setQty(v) {
        var c = clampQty(v);
        qtyInput.value = c;
        if (qtyHidden) qtyHidden.value = c;
    }
    if (btnMinus) btnMinus.addEventListener("click", function () { setQty(parseInt(qtyInput.value || "1", 10) - 1); });
    if (btnPlus)  btnPlus.addEventListener("click",  function () { setQty(parseInt(qtyInput.value || "1", 10) + 1); });

    /* ── Variations ── */
    var allCombos   = @Html.Raw(Model.VariationCombosJson ?? "[]");
    var groupNames  = @Html.Raw(variationGroupNamesJson);
    var totalGroups = groupNames.length;
    var selectedKeys = new Array(totalGroups).fill(null);

    var badge     = qs("#pdStockBadge");
    var stockNote = qs("#pdVariationStockNote");
    var btnCart   = qs("#pdBtnCart");
    var btnBuy    = qs("#pdBtnBuy");
    var hiddenSel = qs("#selectedVariations");

    function setBadge(state, text) {
        badge.className = "pd-badge " + state;
        badge.textContent = text;
    }
    function updateHiddenSelected() {
        var obj = {};
        for (var i = 0; i < totalGroups; i++) {
            if (selectedKeys[i] !== null) obj[groupNames[i]] = selectedKeys[i];
        }
        hiddenSel.value = JSON.stringify(obj);
    }
    function findMatchingComboStock() {
        var m = allCombos.find(function (c) {
            return Array.isArray(c.keys) && c.keys.length === totalGroups &&
                selectedKeys.every(function (k, i) { return c.keys[i] === k; });
        });
        return m ? (m.stock || 0) : 0;
    }
    function comboHasStockForPartial(partial) {
        return allCombos.some(function (c) {
            if (!Array.isArray(c.keys) || c.keys.length !== totalGroups) return false;
            for (var i = 0; i < totalGroups; i++) {
                if (partial[i] !== null && c.keys[i] !== partial[i]) return false;
            }
            return (c.stock || 0) > 0;
        });
    }
    function setButtonsEnabled(enabled) {
        if (btnCart)  btnCart.disabled  = !enabled;
        if (btnBuy)   btnBuy.disabled   = !enabled;
        if (btnMinus) btnMinus.disabled = !enabled;
        if (btnPlus)  btnPlus.disabled  = !enabled;
    }
    function updateOptionAvailability() {
        for (var gi = 0; gi < totalGroups; gi++) {
            var groupEl = qs('.pd-variation-group[data-group-index="' + gi + '"]');
            if (!groupEl) continue;
            qsa("[data-label]", groupEl).forEach(function (opt) {
                var trial = selectedKeys.slice();
                trial[gi] = opt.getAttribute("data-label");
                var avail = comboHasStockForPartial(trial);
                opt.classList.toggle("unavailable", !avail);
                if (opt.tagName === "BUTTON") {
                    opt.disabled = !avail;
                } else {
                    opt.setAttribute("aria-disabled", String(!avail));
                    opt.style.pointerEvents = avail ? "auto" : "none";
                }
            });
        }
    }

    function updateChatVariationJson() {
        var obj = {};
        for (var i = 0; i < totalGroups; i++) {
            if (selectedKeys[i] !== null) {
                obj[groupNames[i]] = selectedKeys[i];
            }
        }
        
        var chatInput = document.getElementById("chatVariationJson");
        if (chatInput) {
            chatInput.value = JSON.stringify(obj);
        }
    }

    function updateVariationUI() {
        updateChatVariationJson();
        var allSelected = selectedKeys.every(function (v) { return v !== null; });
        updateHiddenSelected();
        updateOptionAvailability();
        if (!allSelected) {
            setBadge("select-options", "Select Options");
            if (stockNote) stockNote.style.display = "none";
            setButtonsEnabled(false);
            return;
        }
        var stock = findMatchingComboStock();
        if (stock <= 0)      setBadge("out-of-stock", "Out of Stock");
        else if (stock <= 5) setBadge("low-stock",    "Low Stock");
        else                 setBadge("in-stock",      "In Stock");
        if (stockNote) {
            stockNote.style.display = "block";
            stockNote.textContent = stock > 0 ? (stock + " left for this option") : "This combination is out of stock";
        }
        qtyInput.max = Math.max(1, stock);
        setQty(parseInt(qtyInput.value || "1", 10));
        setButtonsEnabled(stock > 0);
    }
    function handleVariationClick(el) {
        var gi = parseInt(el.getAttribute("data-group-index"), 10);
        var label = el.getAttribute("data-label");
        if (isNaN(gi) || !label) return;
        var groupEl = el.closest(".pd-variation-group");
        if (!groupEl) return;
        qsa(".pd-variation-btn, .pd-variation-swatch", groupEl).forEach(function (x) { x.classList.remove("active"); });
        el.classList.add("active");
        selectedKeys[gi] = label;
        updateVariationUI();
    }
    qsa(".pd-variation-btn, .pd-variation-swatch").forEach(function (el) {
        el.addEventListener("click", function () { handleVariationClick(el); });
        el.addEventListener("keydown", function (e) {
            if (e.key === "Enter" || e.key === " ") { e.preventDefault(); handleVariationClick(el); }
        });
    });
    if (totalGroups > 0) { setButtonsEnabled(false); updateOptionAvailability(); }

    window.validateVariationsBeforeSubmit = function () {
        if (totalGroups <= 0) return true;
        if (!selectedKeys.every(function (v) { return v !== null; })) {
            showToast("Please select all product variations before adding to cart.", "error");
            return false;
        }
        if (findMatchingComboStock() <= 0) {
            showToast("This variation combination is out of stock.", "error");
            return false;
        }
        updateHiddenSelected();
        setQty(parseInt(qtyInput.value || "1", 10));
        return true;
    };
    window.prepareBuyNow = function () {
        if (!window.validateVariationsBeforeSubmit()) return false;
        var qty = qs("#pdQty") ? qs("#pdQty").value : "1";
        qs("#buyNowQuantity").value = qty;
        qs("#buyNowSelectedVariations").value = qs("#selectedVariations").value;
        return true;
    };

    /* ── Reviews modal ── */
    var backdrop   = qs("#rvBackdrop");
    var triggerBtn = qs("#reviewTriggerBtn");
    var closeBtn   = qs("#rvCloseBtn");

    if (backdrop && triggerBtn) {
        function openModal() {
            backdrop.hidden = false;
            requestAnimationFrame(function () { backdrop.classList.add("open"); });
            triggerBtn.setAttribute("aria-expanded", "true");
            if (closeBtn) closeBtn.focus();
            document.body.style.overflow = "hidden";
        }
        function closeModal() {
            backdrop.classList.remove("open");
            backdrop.addEventListener("transitionend", function () {
                backdrop.hidden = true;
                document.body.style.overflow = "";
                triggerBtn.setAttribute("aria-expanded", "false");
                triggerBtn.focus();
            }, { once: true });
        }

        triggerBtn.addEventListener("click", openModal);
        triggerBtn.addEventListener("keydown", function (e) {
            if (e.key === "Enter" || e.key === " ") { e.preventDefault(); openModal(); }
        });
        if (closeBtn) closeBtn.addEventListener("click", closeModal);
        backdrop.addEventListener("click", function (e) { if (e.target === backdrop) closeModal(); });
        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && !backdrop.hidden) closeModal();
        });

        /* Filter chips */
        var cards  = qsa(".rv-card");
        var empty  = qs("#rvEmpty");
        var chips  = qsa(".rv-chip");

        chips.forEach(function (chip) {
            chip.addEventListener("click", function () {
                chips.forEach(function (c) { c.classList.remove("active"); });
                chip.classList.add("active");
                var filter = chip.dataset.filter;
                var visible = 0;
                cards.forEach(function (card) {
                    var show = filter === "all" || card.dataset.rating === filter;
                    card.style.display = show ? "" : "none";
                    if (show) visible++;
                });
                if (empty) empty.style.display = visible === 0 ? "flex" : "none";
                var body = qs("#rvBody");
                if (body) body.scrollTop = 0;
            });
        });
    }
})();
</script>
