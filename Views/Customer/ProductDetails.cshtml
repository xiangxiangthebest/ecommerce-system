@model EcommerceSystem.Models.Product
@using EcommerceSystem.Models
@using System.Text.Json
@using EcommerceSystem.DTOs

<link rel="stylesheet" href="~/css/customer/product-details.css" asp-append-version="true" />

@{
    var reviews    = ViewBag.Reviews as List<EcommerceSystem.Models.Review> ?? new List<EcommerceSystem.Models.Review>();
    var images     = ViewBag.Images as List<string> ?? new List<string>();
    var variations = ViewBag.Variations as List<VariationGroupDto> ?? new List<VariationGroupDto>();
    var firstImage = images.Count > 0 ? images[0] : Model.ImagePath;
    var shopInitial = (Model.Seller?.ShopName ?? "?").Substring(0, 1).ToUpper();

    var combos = new List<Product.VariationCombo>();
    try {
        combos = JsonSerializer.Deserialize<List<Product.VariationCombo>>(Model.VariationCombosJson ?? "[]")
                 ?? new List<Product.VariationCombo>();
    } catch { }

    bool hasVariations = variations.Count > 0;

    bool hasDiscount = Model.DiscountPercentage > 0;

    string stockClass, stockLabel;
    if (!hasVariations) {
        if (Model.StockQuantity <= 0)      { stockClass = "out-of-stock"; stockLabel = "Out of Stock"; }
        else if (Model.StockQuantity <= 5) { stockClass = "low-stock";    stockLabel = "Low Stock"; }
        else                               { stockClass = "in-stock";      stockLabel = "In Stock"; }
    } else {
        stockClass = "select-options"; stockLabel = "Select Options";
    }

    int fullStars  = (int)Math.Floor(Model.AverageRating);
    int emptyStars = 5 - fullStars;

    int totalVariationStock = hasVariations ? combos.Sum(c => c.Stock) : Model.StockQuantity;

    var variationGroupNamesJson = JsonSerializer.Serialize(variations.Select(v => v.Name).ToList());

    var breakdown = Enumerable.Range(1, 5).OrderByDescending(s => s).ToDictionary(
        s => s,
        s => reviews.Count(r => r.Rating == s)
    );
    int totalReviews = reviews.Count;
}

@functions {
    List<string> ParseReviewImages(string? json)
    {
        if (string.IsNullOrWhiteSpace(json) || json == "[]") return new List<string>();
        try { return JsonSerializer.Deserialize<List<string>>(json) ?? new List<string>(); }
        catch { return new List<string>(); }
    }
}


@* ── Server-rendered toast (cart success, etc.) ── *@
@if (TempData["CartSuccess"] != null)
{
    <div id="floatingAlert" class="floating-alert">@TempData["CartSuccess"]</div>
}


<div class="pd-page">
    <div class="pd-layout">

        <!-- ════════════════════════════════
             LEFT: Gallery
             ════════════════════════════════ -->
        <div class="pd-gallery">
            <div class="pd-main-img-wrap" id="pdMainImgWrap" title="Click to enlarge">
                <img id="pdMainImg" src="@firstImage" alt="@Model.Name" class="pd-main-img" />
                <div class="pd-zoom-hint">
                    <i class="ti ti-zoom-in"></i> Click to enlarge
                </div>
            </div>

            @if (images.Count > 1)
            {
                <div class="pd-thumbnails">
                    @for (int i = 0; i < images.Count; i++)
                    {
                        <div class="pd-thumb @(i == 0 ? "active" : "")" data-src="@images[i]">
                            <img src="@images[i]" alt="@Model.Name view @(i + 1)" />
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ════════════════════════════════
             RIGHT: Info
             ════════════════════════════════ -->
        <div class="pd-info">

            <div class="pd-top-row">
                <span class="pd-category">@(Model.Category?.Name ?? "Uncategorised")</span>
                <div class="pd-badges">
                    <span id="pdStockBadge" class="pd-badge @stockClass">@stockLabel</span>
                </div>
            </div>

            <h1 class="pd-name">@Model.Name</h1>

            <div class="pd-rating-row">
                <div class="pd-stars">
                    @for (int s = 0; s < fullStars;  s++) { <span class="star">★</span> }
                    @for (int s = 0; s < emptyStars; s++) { <span class="star empty">★</span> }
                </div>
                <span class="pd-rating-text">@Model.AverageRating.ToString("0.0")</span>
                <div class="pd-rating-sep"></div>
                <button class="pd-review-trigger"
                        id="reviewTriggerBtn"
                        type="button"
                        aria-haspopup="dialog"
                        aria-expanded="false"
                        @(totalReviews == 0 ? "disabled" : "")>
                    @Model.ReviewCount review@(Model.ReviewCount == 1 ? "" : "s")
                    @if (totalReviews > 0)
                    {
                        <i class="ti ti-chevron-right" aria-hidden="true"></i>
                    }
                </button>
            </div>

            <div class="pd-divider"></div>

            <div class="pd-chat-section">
                <div class="pd-chat-seller-info">
                    <div class="pd-chat-avatar">@shopInitial</div>
                    <div class="pd-chat-meta">
                        <span class="pd-chat-meta-name">@(Model.Seller?.ShopName ?? "Unknown Shop")</span>
                        <span class="pd-chat-meta-sub">
                            <span class="pd-chat-online-dot"></span>@(Model.Seller?.State ?? "Unknown location")
                        </span>
                    </div>
                </div>

                <form asp-controller="Chat" asp-action="CustomerStartConversation" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="sellerId" value="@Model.SellerId" />
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <input type="hidden" id="chatVariationJson" name="variationJson" value="{}" />
                    <button class="pd-chat-seller-btn" type="submit">
                        <i class="ti ti-message-circle-2"></i>
                        Chat with Seller
                    </button>
                </form>
            </div>

            <div class="pd-price-block">
                @if (hasDiscount) {
                    <div class="pd-original-price">RM @Model.OriginalPrice.ToString("0.00")</div>
                }
                <div class="pd-price-row">
                    <div class="pd-price">RM @Model.Price.ToString("0.00")</div>
                    @if (hasDiscount) {
                        <span class="pd-discount-badge">-@Model.DiscountPercentage%</span>
                    }
                </div>
                <div class="pd-price-note">Price includes SST where applicable</div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.SKU))
            {
                <div class="pd-sku">SKU: @Model.SKU</div>
            }

            <div class="pd-divider"></div>

            <p class="pd-description">
                @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
            </p>

            @* ── Variations ── *@
            @if (hasVariations)
            {
                <div class="pd-variations" id="pdVariations">
                    @for (int gi = 0; gi < variations.Count; gi++)
                    {
                        var group = variations[gi];
                        <div class="pd-variation-group" data-group-index="@gi">
                            <div class="pd-variation-label">
                                @group.Name
                            </div>
                            <div class="pd-variation-options">
                                @foreach (var val in group.Values)
                                {
                                    if (!string.IsNullOrWhiteSpace(val.ImagePath))
                                    {
                                        <div class="pd-variation-swatch"
                                             role="button"
                                             tabindex="0"
                                             title="@val.Label"
                                             data-group-index="@gi"
                                             data-label="@val.Label"
                                             data-image="@val.ImagePath">
                                            <img src="@val.ImagePath" alt="@val.Label" />
                                            <span class="pd-swatch-label">@val.Label</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="pd-variation-btn"
                                                type="button"
                                                data-group-index="@gi"
                                                data-label="@val.Label">
                                            @val.Label
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
                <div id="pdVariationStockNote" class="pd-stock-variation-note" style="display:none;"></div>
            }

            <div class="pd-qty-row">
                <span class="pd-qty-label">Qty</span>
                <div class="pd-qty-control">
                    <button id="pdQtyMinus" class="pd-qty-btn" type="button">−</button>
                    <input id="pdQty" type="number" class="pd-qty-input"
                           min="1" max="@totalVariationStock" value="1" readonly />
                    <button id="pdQtyPlus" class="pd-qty-btn" type="button">+</button>
                </div>
                @if (!hasVariations && Model.StockQuantity > 0)
                {
                    <span class="pd-stock-note">@Model.StockQuantity left</span>
                }
            </div>

            <div class="pd-actions">
                <form asp-controller="Customer"
                      asp-action="AddToCart"
                      method="post"
                      onsubmit="return validateVariationsBeforeSubmit();">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId"        value="@Model.ProductId" />
                    <input type="hidden" id="selectedVariations" name="selectedVariations" value="{}" />
                    <input type="hidden" id="cartQuantity"       name="quantity" value="1" />
                    <input type="hidden" name="returnUrl" value="@Url.Action("ProductDetails","Customer", new { id = Model.ProductId })" />

                    <button id="pdBtnCart"
                            type="submit"
                            class="pd-btn-cart"
                            @((!hasVariations && Model.StockQuantity <= 0) ? "disabled" : (hasVariations ? "disabled" : ""))>
                        @if (!hasVariations && Model.StockQuantity <= 0)
                        {
                            <i class="ti ti-shopping-cart-off"></i> <text>Out of Stock</text>
                        }
                        else
                        {
                            <i class="ti ti-shopping-cart-plus"></i> <text>Add to Cart</text>
                        }
                    </button>
                </form>

                <form asp-controller="Customer"
                      asp-action="BuyNow"
                      method="post"
                      onsubmit="return prepareBuyNow();">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId"              value="@Model.ProductId" />
                    <input type="hidden" id="buyNowSelectedVariations" name="selectedVariations" value="{}" />
                    <input type="hidden" id="buyNowQuantity"           name="quantity" value="1" />
                    <button id="pdBtnBuy"
                            type="submit"
                            class="pd-btn-buy"
                            @((!hasVariations && Model.StockQuantity <= 0) ? "disabled" : (hasVariations ? "disabled" : ""))>
                        <i class="ti ti-bolt"></i> Buy Now
                    </button>
                </form>

                <button id="pdBtnReport"
                        type="button"
                        class="pd-btn-report"
                        aria-haspopup="dialog"
                        aria-expanded="false">
                    <i class="ti ti-flag"></i> Report Product
                </button>
            </div>
            
            <div class="pd-trust">
                <div class="pd-trust-item">
                    <i class="ti ti-truck-delivery"></i>
                    <span>Free shipping over RM100</span>
                </div>
                <div class="pd-trust-item">
                    <i class="ti ti-shield-check"></i>
                    <span>Secure checkout</span>
                </div>
                <div class="pd-trust-item">
                    <i class="ti ti-refresh"></i>
                    <span>7-day returns</span>
                </div>
            </div>

        </div><!-- /.pd-info -->
    </div><!-- /.pd-layout -->
</div><!-- /.pd-page -->


<!-- ════════════════════════════════════════════════════
     GALLERY IMAGE LIGHTBOX
     ════════════════════════════════════════════════════ -->
<div id="pdImgLightbox" class="pd-img-lightbox" hidden>
    <button class="pd-img-lightbox-close" id="pdImgLightboxClose" aria-label="Close image">
        <i class="ti ti-x"></i>
    </button>
    <img id="pdImgLightboxImg" src="" alt="Product image" />
</div>


<!-- ════════════════════════════════════════════════════
     REPORT PRODUCT MODAL
     ════════════════════════════════════════════════════ -->
<div id="reportProductBackdrop" class="report-overlay" role="dialog" aria-modal="true" aria-label="Report product" hidden>
    <div class="report-modal" id="reportPanel">
        <div class="report-header">
            <h2 class="report-title">Report This Product</h2>
            <button class="report-close" id="reportCloseBtn" aria-label="Close report form" type="button">
                <i class="ti ti-x" aria-hidden="true"></i>
            </button>
        </div>

        <form id="reportProductForm" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@Model.ProductId" />

            <div class="form-group">
                <label for="reportReason">Report Reason <span class="required">*</span></label>
                <select id="reportReason" name="reportReason" required class="form-control">
                    <option value="">-- Select a reason --</option>
                    <option value="Counterfeit">Counterfeit Product</option>
                    <option value="Damaged">Product Damaged/Defective</option>
                    <option value="Misleading">Misleading Description</option>
                    <option value="InappropriateContent">Inappropriate Content</option>
                    <option value="FalseAdvertising">False Advertising</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div class="form-group">
                <label for="reportDescription">Description <span class="required">*</span></label>
                <textarea id="reportDescription" 
                          name="reportDescription" 
                          required 
                          class="form-control" 
                          rows="4" 
                          placeholder="Please provide details about your report (min 20 characters)"
                          minlength="20"
                          maxlength="500"></textarea>
                <small class="form-text">20-500 characters</small>
            </div>

            <div class="form-group">
                <label for="reportEvidence">Evidence Images</label>
                <div class="file-upload-area" id="fileUploadArea">
                    <input type="file" 
                           id="reportEvidence" 
                           name="evidenceFiles" 
                           multiple 
                           accept="image/*" 
                           class="file-input" />
                    <div class="upload-label">
                        <i class="ti ti-cloud-upload"></i>
                        <p>Click to upload or drag and drop</p>
                        <small>PNG, JPG, GIF (max 4 images, 5MB each)</small>
                    </div>
                </div>
                <div id="filePreview" class="file-preview"></div>
            </div>

            <div class="form-actions">
                <button type="button" id="reportCancelBtn" class="btn-cancel">Cancel</button>
                <button type="submit" id="reportSubmitBtn" class="btn-submit">Submit Report</button>
            </div>
        </form>
    </div>
</div>


<!-- ════════════════════════════════════════════════════
     REVIEWS MODAL
     ════════════════════════════════════════════════════ -->
@if (totalReviews > 0)
{
    <div class="rv-overlay" id="rvBackdrop" role="dialog" aria-modal="true" aria-label="Customer reviews" hidden>
        <div class="rv-modal" id="rvPanel">

            <div class="rv-header">
                <div class="rv-header-top">
                    <p class="rv-title">Customer reviews</p>
                    <button class="rv-close" id="rvCloseBtn" aria-label="Close reviews" type="button">
                        <i class="ti ti-x" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="rv-summary">
                    <div class="rv-big-score">
                        <span class="rv-score-num">@Model.AverageRating.ToString("0.0")</span>
                        <div class="rv-score-stars" aria-label="@fullStars out of 5 stars">
                            @for (int s = 0; s < fullStars;  s++) { <span>★</span> }
                            @for (int s = 0; s < emptyStars; s++) { <span class="empty">★</span> }
                        </div>
                        <span class="rv-score-label">@totalReviews review@(totalReviews == 1 ? "" : "s")</span>
                    </div>
                    <div class="rv-bars" aria-label="Rating breakdown">
                        @foreach (var kv in breakdown)
                        {
                            double pct = totalReviews > 0 ? Math.Round((double)kv.Value / totalReviews * 100) : 0;
                            <div class="rv-bar-row">
                                <span class="rv-bar-num">@kv.Key</span>
                                <div class="rv-bar-track">
                                    <div class="rv-bar-fill" style="width:@pct%"></div>
                                </div>
                                <span class="rv-bar-pct">@((int)pct)%</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="rv-filters" role="group" aria-label="Filter by star rating">
                <button class="rv-chip active" data-filter="all" type="button">All</button>
                @foreach (var kv in breakdown.Where(k => k.Value > 0))
                {
                    <button class="rv-chip" data-filter="@kv.Key" type="button">
                        @kv.Key ★ <span class="rv-chip-count">@kv.Value</span>
                    </button>
                }
            </div>

            <div class="rv-body" id="rvBody">
                @foreach (var r in reviews)
                {
                    <div class="rv-card" data-rating="@r.Rating">
                        <div class="rv-card-author">
                            <div class="rv-avatar">@(r.OrderItem?.Order?.Customer?.FullName?.Substring(0, 1).ToUpper() ?? "C")</div>
                            <div class="rv-author-info">
                                <span class="rv-author-name">@(r.OrderItem?.Order?.Customer?.FullName ?? "Customer")</span>
                                <span class="rv-card-date">@r.CreatedAt.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>

                        <div class="rv-card-stars" aria-label="@r.Rating out of 5 stars">
                            @for (int i = 0; i < r.Rating; i++) { <span>★</span> }
                            @for (int i = 0; i < (5 - r.Rating); i++) { <span class="empty">★</span> }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(r.ReviewText))
                        {
                            <p class="rv-card-text">@r.ReviewText</p>
                        }
                        else
                        {
                            <p class="rv-card-text muted">No comment left.</p>
                        }

                        @{
                            var reviewImgs = ParseReviewImages(r.ReviewImagePathsJson);
                        }
                        @if (reviewImgs.Any())
                        {
                            <div class="rv-photos">
                                @foreach (var img in reviewImgs.Take(4))
                                {
                                    <div class="rv-photo-thumb"
                                         onclick="rvOpenLightbox('@img')"
                                         title="View image">
                                        <img src="@img" alt="Review photo" onerror="this.style.display='none'" />
                                        <div class="rv-photo-overlay">
                                            <i class="ti ti-zoom-in"></i>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                <div class="rv-empty" id="rvEmpty" style="display:none;">
                    <i class="ti ti-message-off" aria-hidden="true"></i>
                    No reviews for this rating.
                </div>
            </div>

        </div>
    </div>
}


<!-- ════════════════════════════════════════════════════
     REVIEW IMAGE LIGHTBOX
     ════════════════════════════════════════════════════ -->
<div id="rvLightbox" class="rv-lightbox" onclick="rvCloseLightbox()" hidden>
    <button class="rv-lightbox-close" onclick="rvCloseLightbox(); event.stopPropagation();">
        <i class="ti ti-x"></i>
    </button>
    <img id="rvLightboxImg" src="" alt="Review image" onclick="event.stopPropagation()" />
</div>

<script>
  window.__PD = {
    allCombos: @Html.Raw(Model.VariationCombosJson ?? "[]"),
    groupNames: @Html.Raw(variationGroupNamesJson)
  };

  // Report Product Modal Functionality
  document.addEventListener('DOMContentLoaded', function() {
    const reportBtn = document.getElementById('pdBtnReport');
    const reportBackdrop = document.getElementById('reportProductBackdrop');
    const reportForm = document.getElementById('reportProductForm');
    const reportCloseBtn = document.getElementById('reportCloseBtn');
    const reportCancelBtn = document.getElementById('reportCancelBtn');
    const fileInput = document.getElementById('reportEvidence');
    const fileUploadArea = document.getElementById('fileUploadArea');
    const filePreview = document.getElementById('filePreview');

    if (!reportBtn) return;

    // Open modal
    reportBtn.addEventListener('click', () => {
      reportBackdrop.hidden = false;
      document.body.style.overflow = 'hidden';
    });

    // Close modal
    function closeReportModal() {
      reportBackdrop.hidden = true;
      document.body.style.overflow = 'auto';
      reportForm.reset();
      filePreview.innerHTML = '';
    }

    reportCloseBtn.addEventListener('click', closeReportModal);
    reportCancelBtn.addEventListener('click', closeReportModal);
    reportBackdrop.addEventListener('click', (e) => {
      if (e.target === reportBackdrop) closeReportModal();
    });

    // File upload handling
    fileUploadArea.addEventListener('click', () => fileInput.click());
    
    fileUploadArea.addEventListener('dragover', (e) => {
      e.preventDefault();
      fileUploadArea.classList.add('dragover');
    });

    fileUploadArea.addEventListener('dragleave', () => {
      fileUploadArea.classList.remove('dragover');
    });

    fileUploadArea.addEventListener('drop', (e) => {
      e.preventDefault();
      fileUploadArea.classList.remove('dragover');
      fileInput.files = e.dataTransfer.files;
      updateFilePreview();
    });

    fileInput.addEventListener('change', updateFilePreview);

    function updateFilePreview() {
      filePreview.innerHTML = '';
      const files = Array.from(fileInput.files).slice(0, 4);

      if (files.length === 0) return;

      files.forEach((file, index) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const div = document.createElement('div');
          div.className = 'preview-item';
          div.innerHTML = `
            <img src="${e.target.result}" alt="Preview ${index + 1}" />
            <button type="button" class="remove-file" data-index="${index}">×</button>
          `;
          filePreview.appendChild(div);
        };
        reader.readAsDataURL(file);
      });
    }

    // Form submission
    reportForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(reportForm);
      const submitBtn = document.getElementById('reportSubmitBtn');
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<i class="ti ti-loader-2"></i> Submitting...';

      try {
        const response = await fetch('/Customer/ReportProduct', {
          method: 'POST',
          body: formData
        });

        const result = await response.json();

        if (result.success) {
          alert(result.message);
          closeReportModal();
        } else {
          alert('Error: ' + (result.message || 'Failed to submit report'));
        }
      } catch (error) {
        alert('Error: ' + error.message);
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = 'Submit Report';
      }
    });
  });
</script>

<script src="~/js/customer/product-details.js" asp-append-version="true"></script>