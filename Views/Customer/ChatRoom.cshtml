@model EcommerceSystem.Models.ChatRoom
@using System.Security.Claims

@{
    ViewData["Title"] = "Chat";
    Layout = "~/Views/Customer/_CustomerLayout.cshtml";

    var currentUserId = int.Parse(User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "0");
    var sellerName    = Model.Seller?.ShopName ?? "Seller";
    var sellerInitial = !string.IsNullOrEmpty(sellerName) ? sellerName[0].ToString().ToUpper() : "S";
    var isSeller      = User.HasClaim(c => c.Type == "SellerId") || User.IsInRole("Seller");
    var chatProduct   = ViewBag.ChatProduct as EcommerceSystem.Models.Product;
}

<link rel="stylesheet" href="~/css/customer/chat-room.css" asp-append-version="true" />

@* Inject runtime config for chat-room.js *@
<script>
    window.ChatConfig = {
        sellerId:          @Model.SellerId,
        chatRoomId:        @Model.ChatRoomId,
        isSeller:          @(isSeller ? "true" : "false"),
        chatProductId:     '@(chatProduct?.ProductId.ToString() ?? "")',
        chatProductName:   '@Html.Raw(chatProduct?.Name?.Replace("'", "\\'").Replace("\"", "\\\"") ?? "")',
        chatProductPrice:  '@(chatProduct?.Price.ToString() ?? "")',
        chatProductImage:  '@(chatProduct?.ImagePath ?? "")'
    };
</script>

<div class="chat-room-page">
    <div class="chat-card">

        <!-- ═══ HEADER ═══ -->
        <div class="chat-header">
            <a asp-controller="Chat" asp-action="CustomerInbox" class="chat-header-back">
                <i class="ti ti-arrow-left"></i>
            </a>

            <div class="chat-header-avatar">@sellerInitial</div>

            <div class="chat-header-info">
                <h6 class="chat-header-name">@sellerName</h6>
                <p class="chat-header-sub">
                    <span class="online-dot"></span> Online
                </p>
            </div>
        </div>

        <!-- ═══ MESSAGE BODY ═══ -->
        <div class="chat-body" id="chatBody">

            @if (!Model.Messages.Any())
            {
                <div class="chat-empty">
                    <i class="ti ti-message-circle"></i>
                    <p>Say hello to <strong>@sellerName</strong>!</p>
                    @if (chatProduct != null)
                    {
                        <p style="font-size:12px; color:#ccc; margin:0;">Ask about the product below ↓</p>
                    }
                </div>
            }
            else
            {
                @foreach (var msg in Model.Messages.OrderBy(m => m.SentAt))
                {
                    var isMyMessage = msg.SenderId == currentUserId;
                    var rowClass    = isMyMessage ? "sent" : "received";

                    <div class="msg-row @rowClass">

                        @* Tiny avatar on received messages *@
                        @if (!isMyMessage)
                        {
                            <div class="msg-tiny-avatar">@sellerInitial</div>
                        }

                        @* ── Product card ── *@
                        @if (msg.MessageText != null && msg.MessageText.StartsWith("[PRODUCT_CARD]"))
                        {
                            <div class="msg-product-card">
                                @Html.Raw(msg.MessageText.Replace("[PRODUCT_CARD]", ""))
                            </div>
                        }

                        @* ── Order card ── *@
                        else if (msg.MessageText != null && msg.MessageText.StartsWith("[ORDER_TAG]"))
                        {
                            var parts     = msg.MessageText.Split('|');
                            var orderId   = parts.Length > 1 ? parts[1] : "0";
                            var totalAmt  = parts.Length > 2 ? parts[2] : "0.00";
                            var orderImg  = parts.Length > 3 ? parts[3] : "/images/default-order.png";
                            var coverName = parts.Length > 4 ? parts[4] : "Ordered Item";

                            <div class="msg-order-card" data-order-id="@orderId">
                                <a href="/Customer/PurchaseHistory?searchString=@orderId" class="msg-card-link">
                                    <div class="msg-card-chip">
                                        <span class="chip-label">
                                            <i class="ti ti-receipt" style="font-size:12px"></i> Order
                                        </span>
                                        <span class="chip-action">Track order →</span>
                                    </div>
                                    <div class="msg-card-body">
                                        <img src="@orderImg" class="msg-card-thumb"
                                             onerror="this.src='/images/default-order.png'" />
                                        <div class="msg-card-info">
                                            <p class="msg-card-title">Order #@orderId</p>
                                            <p class="msg-card-sub">@coverName</p>
                                        </div>
                                    </div>
                                    <div class="msg-card-footer">
                                        <span class="msg-card-price">RM @totalAmt</span>
                                        <span class="msg-card-view">
                                            View <i class="ti ti-chevron-right" style="font-size:13px"></i>
                                        </span>
                                    </div>
                                </a>
                            </div>
                        }

                        @* ── Image card ── *@
                        else if (msg.MessageText != null && msg.MessageText.StartsWith("[IMAGE_CARD]"))
                        {
                            <div class="msg-image-bubble" onclick="previewChatImage(this)">
                                @Html.Raw(msg.MessageText.Replace("[IMAGE_CARD]", ""))
                            </div>
                        }

                        @* ── Plain text ── *@
                        else if (msg.MessageText != null)
                        {
                            <div class="msg-bubble">@msg.MessageText</div>
                        }

                        <span class="msg-time">@msg.SentAt.ToLocalTime().ToString("HH:mm")</span>

                    </div>
                }
            }
        </div>

        <!-- ═══ FOOTER ═══ -->
        <div class="chat-footer">

            @* Product preview bar – shown when entering from a product page *@
            @if (chatProduct != null)
            {
                <div class="product-preview-bar">
                    <img src="@chatProduct.ImagePath" class="pp-thumb" alt="product"
                         onerror="this.src='/images/default-product.jpg'" />
                    <div class="pp-info">
                        <p class="pp-name">@chatProduct.Name</p>
                        <p class="pp-price">RM @chatProduct.Price</p>
                    </div>
                    <button class="pp-send-btn" type="button" id="sendProductLinkBtn">
                        <i class="ti ti-send"></i> Send
                    </button>
                </div>
            }

            @* Input row *@
            <div class="chat-input-row">
                <button class="chat-attach-btn" type="button" id="attachToggleBtn" title="Attachments">
                    <i class="ti ti-plus"></i>
                </button>

                <form asp-action="SendMessage" asp-controller="Chat" method="post"
                      id="chatForm" style="display:contents;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="chatRoomId" value="@Model.ChatRoomId" />
                    <input type="hidden" name="sellerId"   value="@Model.SellerId" />
                    <input type="text"   name="message"    id="messageInput"
                           class="chat-text-input"
                           placeholder="Type a message…"
                           autocomplete="off"
                           required />
                    <button type="submit" class="chat-send-btn" title="Send">
                        <i class="ti ti-send"></i>
                    </button>
                </form>
            </div>

            @* Attach panel *@
            <div class="attach-panel" id="attachPanel">
                <div class="attach-grid">
                    <div class="attach-item" id="attachPhotoBtn">
                        <i class="ti ti-photo" style="color:#1D9E75"></i>
                        <span>Image</span>
                    </div>
                    <div class="attach-item"
                         data-bs-toggle="modal" data-bs-target="#sellerProductsModal">
                        <i class="ti ti-shopping-bag" style="color:#BA7517"></i>
                        <span>Product</span>
                    </div>
                    <div class="attach-item"
                         data-bs-toggle="modal" data-bs-target="#customerOrdersModal">
                        <i class="ti ti-receipt" style="color:#185FA5"></i>
                        <span>Order</span>
                    </div>
                </div>
                <input type="file" id="photoFileInput" accept="image/*" class="d-none" />
            </div>

        </div>

    </div>
</div>

<!-- ═══ MODALS ═══ -->

<div class="modal fade" id="sellerProductsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">
                    <i class="ti ti-shopping-bag"></i> Send a Product
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="sellerProductsContainer">
                <div class="modal-state"><i class="ti ti-loader"></i>Loading products…</div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="customerOrdersModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">
                    <i class="ti ti-receipt"></i> Send an Order
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="customerOrdersContainer">
                <div class="modal-state"><i class="ti ti-loader"></i>Loading orders…</div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-body p-0 text-center position-relative">
                <button type="button" class="preview-close-btn" data-bs-dismiss="modal">
                    <i class="ti ti-x"></i>
                </button>
                <img id="previewModalImage" src="" class="img-fluid" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/customer/chat-room.js" asp-append-version="true"></script>
}
