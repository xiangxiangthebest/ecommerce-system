@model List<EcommerceSystem.ViewModels.ChatBoxListMV>

@{
    ViewData["Title"] = "我的收件箱";
}

<div class="container mt-4">
    <h2 class="mb-4"><i class="bi bi-chat-dots"></i> 消息中心</h2>

    <div class="list-group shadow-sm rounded">
        @if (Model == null || !Model.Any())
        {
            <div class="list-group-item text-center text-muted py-5">
                <i class="bi bi-chat-left-text fs-1 d-block mb-2"></i>
                暂无聊天记录
            </div>
        }
        else
        {
            foreach (var item in Model)
            {
                <a href="@Url.Action("Conversation", "Chat", new { id = item.ChatRoomId })" 
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3 border-start-0 border-end-0">
                    
                    <div class="d-flex align-items-center w-70">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px; min-width: 45px;">
                            <span class="fw-bold">@((item.SellerName ?? item.CustomerName ?? "U")[0].ToString().ToUpper())</span>
                        </div>
                        
                        <div class="text-truncate">
                            <h6 class="mb-1 fw-bold text-dark">@(item.SellerName ?? item.CustomerName ?? "未知用户")</h6>
                            <p class="mb-0 text-muted small text-truncate">
                                @(string.IsNullOrEmpty(item.LastMessage) ? "[暂无消息]" : item.LastMessage)
                            </p>
                        </div>
                    </div>

                    <div class="text-end" style="min-width: 80px;">
                        <small class="text-muted d-block mb-1">
                            @(item.LastMessageTime.HasValue ? item.LastMessageTime.Value.ToLocalTime().ToString("MM-dd HH:mm") : "")
                        </small>
                        @if (item.UnreadCount > 0)
                        {
                            <span class="badge bg-danger rounded-pill">@item.UnreadCount</span>
                        }
                    </div>
                </a>
            }
        }
    </div>
</div>

<style>
    .list-group-item-action:hover {
        background-color: #f8f9fa;
        transition: background 0.2s ease;
    }
    .w-70 { width: 75%; }
</style>