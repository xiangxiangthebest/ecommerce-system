@model EcommerceSystem.Models.ViewModels.ChangePasswordViewModel

<link rel="stylesheet" href="~/css/customer/change-password.css" asp-append-version="true" />

<div class="change-password-page">

    <div class="password-card">

        <h2>Change Password</h2>
        <p class="card-subtitle">Keep your account secure</p>

        <form asp-action="ChangePassword" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Current Password -->
            <div class="form-group">
                <label asp-for="OldPassword"></label>
                <div class="password-wrapper">
                    <input asp-for="OldPassword" class="form-control" />
                    <span class="toggle-password" onclick="togglePassword(this)">
                        <i class="fa-solid fa-eye"></i>
                    </span>
                </div>
                <span asp-validation-for="OldPassword" class="text-danger"></span>
            </div>

            <!-- New Password -->
            <div class="form-group">
                <label asp-for="NewPassword"></label>
                <div class="password-wrapper">
                    <input asp-for="NewPassword" class="form-control" />
                    <span class="toggle-password" onclick="togglePassword(this)">
                        <i class="fa-solid fa-eye"></i>
                    </span>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <!-- Confirm Password -->
            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <div class="password-wrapper">
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span class="toggle-password" onclick="togglePassword(this)">
                        <i class="fa-solid fa-eye"></i>
                    </span>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="btn-area">
                <a asp-action="Profile" class="btn-back">
                    Back
                </a>

                <button type="submit" class="btn-save">
                    Change Password
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/customer/change-password.js" asp-append-version="true"></script>
}