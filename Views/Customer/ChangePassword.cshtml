@model EcommerceSystem.ViewModels.ChangePasswordViewModel

<link rel="stylesheet" href="~/css/customer/change-password.css" asp-append-version="true" />

<div class="change-password-page">

    <div class="password-card">

        <h2>Change Password</h2>
        <p class="card-subtitle">Keep your account secure</p>

        <form asp-action="ChangePassword" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- CURRENT PASSWORD -->
            <div class="form-group">
                <label>Current Password</label>

                <div class="password-wrapper">
                    <input asp-for="OldPassword" type="password"
                           id="oldPassword" class="form-control" />

                    <span class="toggle-password"
                          onclick="togglePassword('oldPassword', this)">

                        <!-- Eye -->
                        <svg class="eye-icon" viewBox="0 0 24 24">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>

                        <!-- Eye off -->
                        <svg class="eye-off-icon" viewBox="0 0 24 24" style="display:none">
                            <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/>
                            <line x1="1" y1="1" x2="23" y2="23"/>
                        </svg>

                    </span>
                </div>

                <span asp-validation-for="OldPassword" class="text-danger"></span>
            </div>

            <!-- NEW PASSWORD -->
            <div class="form-group">
                <label>New Password</label>

                <div class="password-wrapper">
                    <input asp-for="NewPassword" type="password"
                           id="newPassword" class="form-control" />

                    <span class="toggle-password"
                          onclick="togglePassword('newPassword', this)">

                        <svg class="eye-icon" viewBox="0 0 24 24">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>

                        <svg class="eye-off-icon" viewBox="0 0 24 24" style="display:none">
                            <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/>
                            <line x1="1" y1="1" x2="23" y2="23"/>
                        </svg>

                    </span>
                </div>

                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <!-- CONFIRM PASSWORD -->
            <div class="form-group">
                <label>Confirm Password</label>

                <div class="password-wrapper">
                    <input asp-for="ConfirmPassword" type="password"
                           id="confirmPassword" class="form-control" />

                    <span class="toggle-password"
                          onclick="togglePassword('confirmPassword', this)">

                        <svg class="eye-icon" viewBox="0 0 24 24">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>

                        <svg class="eye-off-icon" viewBox="0 0 24 24" style="display:none">
                            <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/>
                            <line x1="1" y1="1" x2="23" y2="23"/>
                        </svg>

                    </span>
                </div>

                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <!-- BUTTONS -->
            <div class="btn-area">
                <a asp-action="Profile" class="btn-back">Back</a>
                <button type="submit" class="btn-save">Change Password</button>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/customer/change-password.js" asp-append-version="true"></script>
}