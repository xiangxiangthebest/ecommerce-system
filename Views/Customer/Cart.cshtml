@model EcommerceSystem.Models.Cart
@using System.Text.Json

<link rel="stylesheet" href="~/css/customer/cart.css" asp-append-version="true" />

@{
    var items        = Model.CartItems ?? new List<EcommerceSystem.Models.CartItem>();
    int itemCount    = items.Sum(i => i.Quantity);
    double subtotal  = items.Sum(i => i.Price * i.Quantity);
    double shipping  = subtotal >= 100 ? 0 : 10;
    double total     = subtotal + shipping;
}

<div class="cart-page">

    <!-- Header -->
    <div class="cart-header">
        <h1 class="cart-title">Your Cart</h1>
        <span id="cartItemBadge" class="cart-count-badge">@itemCount @(itemCount == 1 ? "item" : "items")</span>
    </div>

    @if (!items.Any())
    {
        <!-- Empty state -->
        <div class="cart-empty">
            <div class="cart-empty-icon"><i class="ti ti-shopping-cart-off"></i></div>
            <p class="cart-empty-title">Your cart is empty</p>
            <p class="cart-empty-sub">Looks like you haven't added anything yet.</p>
            <a asp-action="Home" class="btn-shop-now">
                <i class="ti ti-arrow-left"></i> Continue Shopping
            </a>
        </div>
    }
    else
    {
        <div class="cart-layout">

            <!-- ── Items column ── -->
            <div class="cart-items-col">

                <!-- Column headers (desktop) -->
                <div class="cart-items-header">
                    <span class="col-check">
                        <input type="checkbox" id="selectAll" title="Select all" />
                    </span>
                    <span>Product</span>
                    <span>Unit Price</span>
                    <span>Quantity</span>
                    <span>Subtotal</span>
                    <span></span>
                </div>

                @foreach (var item in items)
                {
                    var product = item.Product;

                    // Parse selected variations
                    var varDict = new Dictionary<string, string>();
                    if (!string.IsNullOrWhiteSpace(item.SelectedVariations)
                        && item.SelectedVariations != "{}")
                    {
                        try {
                            varDict = JsonSerializer.Deserialize<Dictionary<string, string>>(item.SelectedVariations)
                                        ?? new();
                        } catch { }
                    }

                    <div class="cart-item" data-item-id="@item.CartItemId" data-price="@item.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">

                        <!-- Checkbox -->
                        <div class="cart-item-check">
                            <input type="checkbox" class="item-checkbox" value="@item.CartItemId" />
                        </div>

                        <!-- Product -->
                        <div class="cart-item-product">
                            @if (!string.IsNullOrWhiteSpace(product?.ImagePath))
                            {
                                <img src="@product.ImagePath"
                                     alt="@product.Name"
                                     class="cart-item-img" />
                            }
                            else
                            {
                                <div class="cart-item-img-placeholder">
                                    <i class="ti ti-photo"></i>
                                </div>
                            }

                            <div class="cart-item-details">
                                <span class="cart-item-name">@(product?.Name ?? "Product")</span>
                                <span class="cart-item-shop">
                                    @(product?.Seller?.ShopName ?? "Unknown Shop")
                                </span>

                                @if (varDict.Any())
                                {
                                    <div class="cart-item-variations">
                                        @foreach (var kv in varDict)
                                        {
                                            <span class="variation-tag">@kv.Key: @kv.Value</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Unit price -->
                        <div class="cart-item-price">
                            RM @item.Price.ToString("0.00")
                        </div>

                        <!-- Quantity stepper (AJAX) -->
                        <div class="cart-item-qty">
                            <div class="qty-control">
                                <button type="button"
                                        class="qty-btn qty-minus"
                                        data-item-id="@item.CartItemId">−</button>
                                <input type="number"
                                       class="qty-value"
                                       value="@item.Quantity"
                                       min="1"
                                       readonly />
                                <button type="button"
                                        class="qty-btn qty-plus"
                                        data-item-id="@item.CartItemId">+</button>
                            </div>
                        </div>

                        <!-- Subtotal -->
                        <div class="cart-item-subtotal">
                            RM <span class="item-subtotal-value">@((item.Price * item.Quantity).ToString("0.00"))</span>
                        </div>

                        <!-- Remove (AJAX) -->
                        <div class="cart-item-remove">
                            <button type="button"
                                    class="remove-btn btn-remove-ajax"
                                    data-item-id="@item.CartItemId"
                                    title="Remove item">
                                <i class="ti ti-trash"></i>
                            </button>
                        </div>

                    </div>
                }

            </div>

            <!-- ── Summary card ── -->
            <div class="cart-summary">

                <div class="summary-header">Order Summary</div>

                <div class="summary-body">

                    <div class="summary-row">
                        <span class="label">Subtotal (<span id="summaryItemCount">0</span> <span id="summaryItemWord">items</span>)</span>
                        <span class="value">RM <span id="summarySubtotal">0.00</span></span>
                    </div>

                    <div class="summary-row" id="shippingRow">
                        <span class="label">Shipping</span>
                        <span class="value" id="shippingValue">RM 0.00</span>
                    </div>

                    <div class="summary-row" id="freeShippingHint" style="display:none;">
                        <span class="label" style="font-size:11px;color:#bbb;" id="freeShippingHintText"></span>
                    </div>

                    <div class="summary-divider"></div>

                    <div class="summary-row total">
                        <span class="label">Total</span>
                        <span class="value">RM <span id="summaryTotal">0.00</span></span>
                    </div>

                </div>

                <div class="summary-footer">
                    <form id="checkoutForm" method="get" asp-action="Checkout">
                        <input type="hidden" name="selectedItems" id="selectedItemsInput" />
                        <input type="hidden" name="source" value="cart" />
                        <button type="submit" class="btn-checkout" id="checkoutBtn">
                            <i class="ti ti-lock"></i> Checkout
                        </button>
                    </form>
                    <a asp-action="Home" class="btn-continue">
                        <i class="ti ti-arrow-left"></i> Continue shopping
                    </a>
                </div>

                <div class="summary-trust">
                    <div class="trust-item">
                        <i class="ti ti-shield-check"></i>
                        <span>Secure</span>
                    </div>
                    <div class="trust-item">
                        <i class="ti ti-truck-delivery"></i>
                        <span>Fast delivery</span>
                    </div>
                    <div class="trust-item">
                        <i class="ti ti-refresh"></i>
                        <span>7-day returns</span>
                    </div>
                </div>

            </div>

        </div>
    }

</div>

<script>
    window.initialCartItemCount = @itemCount;
</script>

<script src="~/js/customer/cart.js" asp-append-version="true"></script>